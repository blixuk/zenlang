/!
  tools/zar/src/ui.zl - Terminal UI styling, tables, and colors for zar.
!/

use zen.text.string as Str

let COLOR_RESET   -> `\x1b[0m`
let COLOR_BOLD    -> `\x1b[1m`
let COLOR_DIM     -> `\x1b[2m`
let COLOR_CYAN    -> `\x1b[1;36m`
let COLOR_GREEN   -> `\x1b[1;32m`
let COLOR_YELLOW  -> `\x1b[1;33m`
let COLOR_RED     -> `\x1b[1;31m`
let COLOR_MAGENTA -> `\x1b[1;35m`
let COLOR_BLUE    -> `\x1b[1;34m`

export function banner() {
    writeln(COLOR_CYAN + `  ╔══════════════════════════════════════════════════════╗` + COLOR_RESET)
    writeln(COLOR_CYAN + `  ║ ` + COLOR_BOLD + `⚡ ZAR - Next-Gen Pure Zenlang Archive Platform` + COLOR_RESET + COLOR_CYAN + `      ║` + COLOR_RESET)
    writeln(COLOR_CYAN + `  ╚══════════════════════════════════════════════════════╝` + COLOR_RESET)
}

export function cyan(s) { <- COLOR_CYAN + s + COLOR_RESET }
export function green(s) { <- COLOR_GREEN + s + COLOR_RESET }
export function yellow(s) { <- COLOR_YELLOW + s + COLOR_RESET }
export function red(s) { <- COLOR_RED + s + COLOR_RESET }
export function magenta(s) { <- COLOR_MAGENTA + s + COLOR_RESET }
export function bold(s) { <- COLOR_BOLD + s + COLOR_RESET }

export function print_info(msg) {
    writeln(COLOR_BLUE + `[i] ` + COLOR_RESET + msg)
}

export function print_success(msg) {
    writeln(COLOR_GREEN + `[✓] ` + COLOR_RESET + msg)
}

export function print_warn(msg) {
    writeln(COLOR_YELLOW + `[!] ` + COLOR_RESET + msg)
}

export function print_error(msg) {
    writeln(COLOR_RED + `[✗] ` + COLOR_RESET + msg)
}

export function format_bytes(bytes) {
    when bytes == Nothing { <- `0 B` }
    let b -> Integer(bytes)
    when b < 1024 {
        <- String(b) + ` B`
    }
    when b < 1048576 {
        let kb -> (b * 10) / 1024
        let int_p -> Integer(kb / 10)
        let dec_p -> Integer(kb % 10)
        <- String(int_p) + `.` + String(dec_p) + ` KB`
    }
    let mb -> (b * 10) / 1048576
    let int_p -> Integer(mb / 10)
    let dec_p -> Integer(mb % 10)
    <- String(int_p) + `.` + String(dec_p) + ` MB`
}

function _pad_right(s, width) {
    let out -> s
    do while Str.length(out) < width {
        out -> out + ` `
    }
    <- out
}

function _pad_left(s, width) {
    let out -> s
    do while Str.length(out) < width {
        out -> ` ` + out
    }
    <- out
}

export function print_table(headers, rows) {
    let col_count -> headers.length
    when col_count == 0 { <- Nothing }

    let widths -> []
    for h in headers {
        widths.append(Str.length(h))
    }

    for row in rows {
        let idx -> 0
        do while idx < col_count and idx < row.length {
            let cell_len -> Str.length(row[idx])
            when cell_len > widths[idx] {
                widths[idx] -> cell_len
            }
            idx -> idx + 1
        }
    }

    // Top border
    let top -> `┌`
    let i -> 0
    do while i < col_count {
        top -> top + Str.repeat(`─`, widths[i] + 2)
        when i + 1 < col_count { top -> top + `┬` }
        i -> i + 1
    }
    top -> top + `┐`
    writeln(COLOR_DIM + top + COLOR_RESET)

    // Header row
    let header_line -> `│`
    i -> 0
    do while i < col_count {
        header_line -> header_line + ` ` + COLOR_BOLD + _pad_right(headers[i], widths[i]) + COLOR_RESET + ` │`
        i -> i + 1
    }
    writeln(header_line)

    // Separator
    let sep -> `├`
    i -> 0
    do while i < col_count {
        sep -> sep + Str.repeat(`─`, widths[i] + 2)
        when i + 1 < col_count { sep -> sep + `┼` }
        i -> i + 1
    }
    sep -> sep + `┤`
    writeln(COLOR_DIM + sep + COLOR_RESET)

    // Data rows
    for row in rows {
        let line -> `│`
        i -> 0
        do while i < col_count {
            let val -> ``
            when i < row.length { val -> row[i] }
            let pad_val -> _pad_right(val, widths[i])
            when i == 1 or i == 2 or i == 3 {
                pad_val -> _pad_left(val, widths[i])
            }
            line -> line + ` ` + pad_val + ` │`
            i -> i + 1
        }
        writeln(line)
    }

    // Bottom border
    let bot -> `└`
    i -> 0
    do while i < col_count {
        bot -> bot + Str.repeat(`─`, widths[i] + 2)
        when i + 1 < col_count { bot -> bot + `┴` }
        i -> i + 1
    }
    bot -> bot + `┘`
    writeln(COLOR_DIM + bot + COLOR_RESET)
}
