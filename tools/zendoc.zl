import zen.io.file as f
import zen.io.io as io
import zen.text.string as str
import zen.text.zenmark as zm

/!
 ZenDoc Generator v2.1.
 Added Class/Method tracking and better formatting.
 !/

function walk(path, callback) {
    when f.is_dir(path) {
        let items -> f.list_dir(path)
        do for item in items {
            // Skip hidden files/folders
            when not item.starts_with(`.`) {
                let full_path -> path + `/` + item
                walk(full_path, callback)
            }
        }
    } or when path.ends_with(`.zl`) {
        callback(path)
    }
}

function process_file(path) {
    let content -> f.read(path)
    let module_name -> path.replace(`lib/`, ``).replace(`.zl`, ``).replace(`/`, `.`)
    
    io.writeln(`# Module: ` + module_name)
    io.writeln(``)
    
    let i -> 0
    let len -> content.length
    let module_doc_found -> false
    let current_class -> ``
    
    do while i < len {
        let start -> content.find(`/!`, i)
        when start == -1 { break }
        
        let end -> content.find(`!/`, start + 2)
        when end == -1 { break }
        
        let doc_text -> content.slice(start + 2, end)
        let doc -> zm.parse(doc_text)
        
        // Peek ahead for code association
        let next_pos -> end + 2
        let next_chunk -> content.slice(next_pos, next_pos + 150).trim()
        
        let name -> ``
        let type -> ``
        
        when next_chunk.starts_with(`function `) {
            type -> `Function`
            let p_idx -> next_chunk.find(`(`)
            when p_idx > 9 {
                name -> next_chunk.slice(9, p_idx).trim()
            }
        } or when next_chunk.starts_with(`class `) {
            type -> `Class`
            let b_idx -> next_chunk.find(`{`)
            when b_idx > 6 {
                name -> next_chunk.slice(6, b_idx).trim()
                current_class -> name
            }
        } or when next_chunk.starts_with(`let `) {
            type -> `Constant`
            let a_idx -> next_chunk.find(`->`)
            when a_idx > 4 {
                name -> next_chunk.slice(4, a_idx).trim()
            }
        }
        
        when doc.summary != `` {
            when name != `` {
                when type == `Function` and current_class != `` {
                    io.writeln(`## Method: \`` + current_class + `.` + name + `\``)
                } or {
                    io.writeln(`## ` + type + `: \`` + name + `\``)
                }
                io.writeln(``)
                io.writeln(doc.summary)
                io.writeln(``)
            } or {
                // If it's the first doc block and no name found, assume module doc
                when not module_doc_found {
                    io.writeln(`> ` + doc.summary)
                    io.writeln(``)
                    module_doc_found -> true
                } or {
                    io.writeln(`### Description`)
                    io.writeln(``)
                    io.writeln(doc.summary)
                    io.writeln(``)
                }
            }
            
            let params -> doc.params.keys()
            when params.length > 0 {
                io.writeln(`**Parameters:**`)
                do for p in params {
                    io.writeln(`- \`` + p + `\`: ` + doc.params[p])
                }
                io.writeln(``)
            }
            
            when doc.returns != nothing {
                io.writeln(`**Returns:** ` + doc.returns)
                io.writeln(``)
            }
            
            let extras -> doc.extra_sections.keys()
            do for ex in extras {
                io.writeln(`#### ` + ex.substring(0, 1).to_upper() + ex.substring(1))
                io.writeln(doc.extra_sections[ex])
                io.writeln(``)
            }
            
            io.writeln(`---`)
            io.writeln(``)
        }
        
        i -> end + 2
    }
}

function main() {
    io.writeln(`# Zenlang Standard Library API Reference`)
    io.writeln(`*Generated by ZenDoc v2.1*`)
    io.writeln(``)
    
    let lib_path -> `lib/zen`
    walk(lib_path, process_file)
}
