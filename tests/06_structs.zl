structure Point {
    x: Integer
    y: Integer
}

structure Rect {
    origin: Point
    width: Integer
    height: Integer
}

function test_structs() {
    let p -> Point { x -> 10, y -> 20 }
    ! p.x == 10
    ! p.y == 20
    
    p.x -> 30
    ! p.x == 30
    
    let r -> Rect { origin -> p, width -> 100, height -> 50 }
    ! r.origin.x == 30
    ! r.width == 100
    
    r.origin.y -> 40
    ! r.origin.y == 40
}

function main() {
    test_structs()
    io.write(`06_structs passed!\n`)
}
