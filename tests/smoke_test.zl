// tests/smoke_test.zl

// 1. Comments
// Single line
/* Multi
   Line */


import zen.io.io


// 2. Variables

// Typed Tests
let a : Integer -> 30
let b : Decimal -> 3.14
let c : Boolean -> True
let d : String -> `Hello`
let e : Rune -> `a`
//let f : Variant -> Nothing

// Untyped Tests
let x -> 10
let y : Integer -> 20

// 3. Control Flow
when x == 10 {
    y -> 30
} or {
    y -> 40
}

do while x > 0 {
    x -> x - 1
}

// 4. Functions
function add(a: Integer, b: Integer) : Integer {
    <- a + b
}

function sub(a: Integer, b: Integer) : Integer {
    <- a - b
}

// 5. Structure
structure MyVector {
    x: Integer,
    y: Integer
}

structure MyOtherVector {
    x: Integer,
    y: Integer
}

let my_other_vector -> MyOtherVector(10, 20)

io.write(`\nvariable: x: `)
io.write(x) // Should display '0'
io.write(`\nvariable: y: `)
io.write(y) // Should display '30'

io.write(`\nfunction: add: `)
io.write(add(50, 10)) // Should display '60'

io.write(`\nfunction: sub: `)
io.write(sub(50, 10)) // Should display '40'

let my_vector -> MyVector(0, 0)

io.write(`\nstructure: my_vector: `)
io.write(`MyVector`) // need a way to display structures
io.write(`\nstructure: my_vector.x: `)
io.write(my_vector.x) // Should display '0'
io.write(`\nstructure: my_vector.y: `)
io.write(my_vector.y) // Should display '0'

io.write(`\nstructure: my_other_vector: `)
io.write(`MyOtherVector`) // need a way to display structures
io.write(`\nstructure: my_other_vector.x: `)
io.write(my_other_vector.x) // Should display '10'
io.write(`\nstructure: my_other_vector.y: `)
io.write(my_other_vector.y) // Should display '20'

io.write(`\n`)
