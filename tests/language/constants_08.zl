from zen.io import write

function assert_eq(a, b, message) {
    when a != b {
        write(`[FAIL] ` + message + `: Expected ` + a + `, got ` + b)
        raise `AssertionFailed`
    }
}

// Test global constant
set PI -> 3.14159

function test_constants() {
    write(`Testing constants...`)
    assert_eq(PI, 3.14159, `global constant value`)
    
    // Constant in local scope
    set EPSILON -> 0.0001
    assert_eq(EPSILON, 0.0001, `local constant value`)
    
    write(`Constants Passed`)
}

test_constants()
