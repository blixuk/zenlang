// Test Negative Indexing and Sequence Slicing across Lists and Strings

let xs -> [10, 20, 30, 40, 50]
let s -> `hello world`

// 1. Negative Indexing
writeln(xs[-1])
writeln(xs[-2])
writeln(s[-1])
writeln(s[-5])

// 2. List Slicing
let sub1 -> xs[1:4]
writeln(sub1.length)
writeln(sub1[0])
writeln(sub1[1])
writeln(sub1[2])

let sub_start -> xs[:3]
writeln(sub_start.length)
writeln(sub_start[0])
writeln(sub_start[2])

let sub_end -> xs[2:]
writeln(sub_end.length)
writeln(sub_end[0])
writeln(sub_end[2])

let sub_step -> xs[::2]
writeln(sub_step.length)
writeln(sub_step[0])
writeln(sub_step[1])
writeln(sub_step[2])

let sub_rev -> xs[::-1]
writeln(sub_rev.length)
writeln(sub_rev[0])
writeln(sub_rev[4])

let sub_neg_bounds -> xs[-3:-1]
writeln(sub_neg_bounds.length)
writeln(sub_neg_bounds[0])
writeln(sub_neg_bounds[1])

// 3. String Slicing
writeln(s[0:5])
writeln(s[:5])
writeln(s[6:])
writeln(s[::-1])
writeln(s[::2])
writeln(s[4:1:-1])

// 4. Boundary Clamping
let clamped_high -> xs[0:100]
writeln(clamped_high.length)
let clamped_low -> xs[-100:2]
writeln(clamped_low.length)

writeln(`slicing tests passed!`)
