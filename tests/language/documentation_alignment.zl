function run_alignment_tests() {
    write(`Running Documentation Alignment Tests...`)
    test_logic_operators()
    test_bitwise_operators()
    test_collection_literals()
    test_inheritance()
    test_string_prefixes()
    // test_do_when() // Verification of syntax parity
    write(`Documentation Alignment Tests Passed!`)
}

run_alignment_tests()
