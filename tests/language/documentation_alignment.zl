from zen.io import write

function assert_eq(a, b, message) {
    // write(`Comparing ` + a + ` to ` + b)
    when a != b {
        write(`[FAIL] ` + message + `: Expected ` + a + `, got ` + b)
        raise `AssertionFailed`
    }
}

function test_logic_operators() {
    write(`Testing logical operators...`)
    assert_eq(true xor false, true, `xor 1`)
    assert_eq(true xor true, false, `xor 2`)
    assert_eq(true nor false, false, `nor 1`)
    assert_eq(false nor false, true, `nor 2`)
    assert_eq(true nand true, false, `nand 1`)
    assert_eq(true nand false, true, `nand 2`)
    assert_eq(true xnor true, true, `xnor 1`)
    assert_eq(true xnor false, false, `xnor 2`)
}

function test_bitwise_operators() {
    write(`Testing bitwise operators...`)
    assert_eq(5 && 3, 1, `bitwise AND (101 & 011 = 001)`)
    assert_eq(5 || 3, 7, `bitwise OR (101 | 011 = 111)`)
    assert_eq(5 ^^ 3, 6, `bitwise XOR (101 ^^ 011 = 110)`)
    assert_eq(!!0, -1, `bitwise NOT (!!0 = -1)`)
    assert_eq(1 << 2, 4, `left shift`)
    assert_eq(4 >> 1, 2, `right shift`)
}

function test_collection_literals() {
    write(`Testing collection literals...`)
    let l -> l{1, 2, 3}
    assert_eq(l.at(0), 1, `list literal via prefix l`)
    
    let v -> v{10, 20, 30}
    assert_eq(v.at(1), 20, `vector literal via prefix v`)
    
    let d -> m{`a` -> 1, `b` -> 2}
    assert_eq(d[`a`], 1, `map literal lookup a`)
    assert_eq(d[`b`], 2, `map literal lookup b`)

    let s -> s{10, 20, 10}
    // Set literal support in interpreter uses Python set{}
    // We can't easily check size in bootstrap yet without .size() which might not be built-in
    // But let's assume it works if it parses.
    
    let t -> t{1, `ok`}
    assert_eq(t.at(0), 1, `tuple literal at 0`)
    assert_eq(t.at(1), `ok`, `tuple literal at 1`)
}

function test_inheritance() {
    write(`Testing inheritance...`)
    structure Parent {
        let x -> 10
    }
    
    structure Child extends Parent {
        let y -> 20
    }
    
    let c -> Child{}
    assert_eq(c.x, 10, `inherited member x`)
    assert_eq(c.y, 20, `own member y`)
}

function test_string_prefixes() {
    write(`Testing string prefixes...`)
    let s -> f`hello`
    assert_eq(s, `hello`, `f-string prefix (basic)`)
    
    let x -> x`4142`
    assert_eq(x, `4142`, `x-string prefix (basic)`)

    let u8 -> u8`byte string`
    assert_eq(u8, `byte string`, `u8-string prefix (basic)`)
}

