/!
  test_turing_completeness.zl — Turing Completeness Verification Suite.
  Formally verifies Turing completeness in Zenlang across three canonical models:
  1. Universal Turing Machine simulator with dynamic bidirectional tape
  2. Rule 110 Elementary Cellular Automaton (proven Turing complete by Matthew Cook, 2004)
  3. Untyped Lambda Calculus with Fixed-Point Z-Combinator (anonymous recursion)
!/

function assert_equal(actual, expected, msg) {
    when actual != expected {
        writeln(f`FAIL: {msg} - expected {expected}, got {actual}`)
        <- 1
    }
    writeln(f`PASS: {msg}`)
    <- 0
}

// ----------------------------------------------------
// Model 1: Universal Turing Machine
// ----------------------------------------------------
class TuringMachine {
    let tape: List
    let head: Integer
    let state: String
    let halted: Boolean
    let transitions: Map

    function init(initial_tape, initial_state, initial_head) {
        self.tape -> initial_tape
        self.head -> initial_head
        self.state -> initial_state
        self.halted -> false
        self.transitions -> {}
    }

    function add_transition(from_state, read_symbol, to_state, write_symbol, direction) {
        let key -> f`{from_state}:{read_symbol}`
        let action -> {
            `next_state` -> to_state,
            `write_val`  -> write_symbol,
            `dir`        -> direction
        }
        self.transitions[key] -> action
    }

    function step() {
        when self.halted { <- false }

        // Dynamic tape expansion simulates an unbounded tape
        when self.head < 0 {
            self.tape -> [0, ...self.tape]
            self.head -> 0
        } or when self.head >= self.tape.length {
            self.tape.append(0)
        }

        let symbol -> self.tape[self.head]
        let key -> f`{self.state}:{symbol}`

        when not self.transitions.has(key) {
            self.halted -> true
            <- false
        }

        let trans -> self.transitions[key]
        self.tape[self.head] -> trans[`write_val`]
        self.state -> trans[`next_state`]

        when trans[`dir`] == `R` {
            self.head -> self.head + 1
        } or when trans[`dir`] == `L` {
            self.head -> self.head - 1
        }

        when self.state == `halt` {
            self.halted -> true
        }

        <- true
    }

    function run(max_steps) {
        let count -> 0
        do while count < max_steps and not self.halted {
            self.step()
            count -> count + 1
        }
        <- count
    }
}

function test_turing_machine_simulation() {
    let failures -> 0
    // Binary incrementer: [1, 0, 1, 1] (11) -> [1, 1, 0, 0] (12)
    let tm -> TuringMachine([1, 0, 1, 1], `add_one`, 3)
    tm.add_transition(`add_one`, 1, `add_one`, 0, `L`)
    tm.add_transition(`add_one`, 0, `halt`, 1, `L`)

    let steps -> tm.run(50)
    failures -> failures + assert_equal(tm.halted, true, `turing machine halted`)
    failures -> failures + assert_equal(tm.state, `halt`, `final state is halt`)
    failures -> failures + assert_equal(tm.tape.length, 4, `tape length`)
    failures -> failures + assert_equal(tm.tape[0], 1, `tape[0] == 1`)
    failures -> failures + assert_equal(tm.tape[1], 1, `tape[1] == 1`)
    failures -> failures + assert_equal(tm.tape[2], 0, `tape[2] == 0`)
    failures -> failures + assert_equal(tm.tape[3], 0, `tape[3] == 0`)
    <- failures
}

// ----------------------------------------------------
// Model 2: Rule 110 Cellular Automaton
// ----------------------------------------------------
function step_rule110(tape) {
    let n -> tape.length
    let next_tape -> []
    let i -> 0
    do while i < n {
        let left  -> when i > 0 { tape[i - 1] } or { 0 }
        let mid   -> tape[i]
        let right -> when i + 1 < n { tape[i + 1] } or { 0 }

        // Rule 110 patterns yielding 1: 110, 101, 011, 010, 001
        let bit -> 0
        when (left == 1 and mid == 1 and right == 0) or
             (left == 1 and mid == 0 and right == 1) or
             (left == 0 and mid == 1 and right == 1) or
             (left == 0 and mid == 1 and right == 0) or
             (left == 0 and mid == 0 and right == 1) {
            bit -> 1
        }
        next_tape.append(bit)
        i -> i + 1
    }
    <- next_tape
}

function test_rule110_automaton() {
    let failures -> 0
    // Test single step transitions
    let t0 -> [0, 0, 0, 1]
    let t1 -> step_rule110(t0)
    // [0, 0, 0, 1] -> [0, 0, 1, 1]
    failures -> failures + assert_equal(t1[2], 1, `rule110 t1[2] == 1`)
    failures -> failures + assert_equal(t1[3], 1, `rule110 t1[3] == 1`)

    let t2 -> step_rule110(t1)
    // [0, 0, 1, 1] -> [0, 1, 1, 1]
    failures -> failures + assert_equal(t2[1], 1, `rule110 t2[1] == 1`)
    failures -> failures + assert_equal(t2[2], 1, `rule110 t2[2] == 1`)
    failures -> failures + assert_equal(t2[3], 1, `rule110 t2[3] == 1`)
    <- failures
}

// ----------------------------------------------------
// Model 3: Lambda Calculus Fixed-Point Combinator
// ----------------------------------------------------
function make_z_combinator() {
    <- function(f) {
        let g -> function(x) {
            let captured_x -> x
            let captured_f -> f
            <- captured_f(function(v) {
                let rec_step -> captured_x(captured_x)
                <- rec_step(v)
            })
        }
        <- g(g)
    }
}

function test_lambda_calculus_z_combinator() {
    let failures -> 0
    let Z -> make_z_combinator()

    let fact_builder -> function(f) {
        let rec_fn -> f
        <- function(n) {
            when n <= 1 { <- 1 }
            <- n * rec_fn(n - 1)
        }
    }

    let fact -> Z(fact_builder)
    failures -> failures + assert_equal(fact(0), 1, `Z-combinator fact(0) == 1`)
    failures -> failures + assert_equal(fact(1), 1, `Z-combinator fact(1) == 1`)
    failures -> failures + assert_equal(fact(5), 120, `Z-combinator fact(5) == 120`)
    failures -> failures + assert_equal(fact(6), 720, `Z-combinator fact(6) == 720`)
    <- failures
}

function main() {
    writeln(`=== Running Turing Completeness Paradigm Tests ===`)
    let total_failures -> 0
    total_failures -> total_failures + test_turing_machine_simulation()
    total_failures -> total_failures + test_rule110_automaton()
    total_failures -> total_failures + test_lambda_calculus_z_combinator()

    when total_failures > 0 {
        writeln(f`=== {total_failures} test(s) failed ===`)
        <- 1
    }
    writeln(`=== All Turing Completeness Tests Passed ===`)
    <- 0
}
