import zen.io.io as io

enumerator Option {
    Nothing,
    Something(value)
}

function print_option(opt) {
    when opt {
        is Option.Something(v) {
            io.write(`Got something: `)
            io.writeln(v)
        }
        is Option.Nothing {
            io.writeln(`Nothing`)
        }
        or {
            io.writeln(`Not an option`)
        }
    }
}

function main() {
    let s -> Option.Something(42)
    let n -> Option.Nothing

    io.write(`Testing ADT Option...\n`)
    print_option(s)
    print_option(n)
    print_option(123.45)
}
