import zen.io as IO
import zen.text as Text
import zen.string as Str

function test_word_semantic() {
    IO.info(`--- Testing Word Semantics ---`)
    
    let w1 -> Text.Word { text -> `ZENLANG` }
    IO.info(`  Word: ` + w1.text)
    IO.info(`  Is uppercase: ` + Str.to_string(Text.Word.is_uppercase(w1)))
    
    let w2 -> Text.Word { text -> `calm` }
    IO.info(`  Word: ` + w2.text)
    let w2_cap -> Text.Word.capitalize(w2)
    IO.info(`  Capitalized: ` + w2_cap.text)
}

function test_sentence_semantic() {
    IO.info(`--- Testing Sentence Semantics ---`)
    
    let s -> Text.Sentence { text -> `Zenlang is calm and deliberate.` }
    IO.info(`  Sentence: ` + s.text)
    
    let count -> Text.Sentence.count_words(s)
    IO.info(`  Word count: ` + Str.to_string(count))
    
    let words -> Text.Sentence.to_words(s)
    do for w in words {
        IO.info(`    Word: ` + w.text)
    }
}

function test_paragraph_semantic() {
    IO.info(`--- Testing Paragraph Semantics ---`)
    
    let p -> Text.Paragraph { text -> `Zenlang is a modern, Unix-native programming language designed for simplicity, composition, and developer control.` }
    IO.info(`  Original Paragraph: ` + p.text)
    
    let wrapped -> Text.Paragraph.wrap(p, 30)
    IO.info(`  Wrapped Paragraph (30 chars):`)
    IO.info(wrapped.text)
}

function zen_entry() {
    test_word_semantic()
    test_sentence_semantic()
    test_paragraph_semantic()
}
