from zen.io import write

import zen.string as s

let text -> `  Hello, ZenLang!  `
write(`Original: [` + text + `]`)

let trimmed -> s.trim(text)
write(`Trimmed: [` + trimmed + `]`)

let lower -> s.to_lower(trimmed)
write(`Lower: ` + lower)

let upper -> s.to_upper(trimmed)
write(`Upper: ` + upper)

let sub -> s.substring(trimmed, 0, 5)
write(`First 5: ` + sub)

when s.starts_with(trimmed, `Hello`) {
    write(`Starts with Hello`)
}

when s.ends_with(trimmed, `!`) {
    write(`Ends with !`)
}

let parts -> s.split(`one,two,three`, `,`)
write(`Split length: ` + s.length(parts))

let joined -> s.join(parts, `-`)
write(`Joined: ` + joined)

write(`Index of Zen: ` + s.index_of(trimmed, `Zen`))
write(`Char at 0: ` + s.at(trimmed, 0))
