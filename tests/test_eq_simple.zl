import zen.io.io as io

function test_eq(a, b) {
    io.write_line("a = " + a + ", b = " + b)
    let is_diff -> (a != b)
    io.write_line("a != b is: " + is_diff)
    when a != b {
        io.write_line("INSIDE WHEN: a != b is true!")
        <- false
    } or {
        io.write_line("INSIDE OR: a == b is true!")
        <- true
    }
}

function main() {
    test_eq(5, 5)
    test_eq(0, 0)
    test_eq(4, 4)
}

main()
