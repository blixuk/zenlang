import zen.test as test
import zen.time as time

function test_clock_functions() {
    let start -> time.monotonic()
    let duration -> Duration { seconds -> 0.01 }
    time.sleep(0.01)
    let end -> time.monotonic()

    let pass -> test.assert_equal(duration.seconds, 0.01, `Duration should store the provided seconds value`)
    pass -> pass and test.assert_true(time.now() > 0, `now should return a positive timestamp`)
    pass -> pass and test.assert_true(time.wallclock() > 0, `wallclock should return a positive timestamp`)
    pass -> pass and test.assert_true(end >= start, `monotonic should not move backwards`)
    <- pass
}

function test_timer() {
    let timer -> time.Timer()
    timer.start()
    time.sleep(0.01)

    let elapsed -> timer.elapsed()
    let elapsed_ms -> timer.elapsed_ms()
    timer.stop()

    let pass -> test.assert_true(elapsed > 0, `elapsed should be positive after the timer runs`)
    pass -> pass and test.assert_true(elapsed_ms >= 5, `elapsed_ms should reflect the sleep duration`)
    <- pass
}

function compute_something() {
    let sum -> 0
    let i -> 0
    do while i < 1000 {
        sum -> sum + i
        i -> i + 1
    }
    <- sum
}

function test_duration_and_formatting() {
    let d1 -> time.seconds(10)
    let d2 -> time.milliseconds(500)
    let d3 -> time.duration_add(d1, d2)
    let pass -> test.assert_equal(d3.seconds, 10.5, `duration_add`)
    pass -> pass and test.assert_equal(time.duration_to_ms(d2), 500.0, `duration_to_ms`)

    let d_sub -> time.duration_sub(d1, time.seconds(3))
    pass -> pass and test.assert_equal(d_sub.seconds, 7.0, `duration_sub`)

    let d_mul -> time.duration_mul(time.seconds(5), 3)
    pass -> pass and test.assert_equal(d_mul.seconds, 15.0, `duration_mul`)

    // Test known epoch: 1700000000 = 2023-11-14T22:13:20Z
    let iso -> time.format_iso(1700000000)
    pass -> pass and test.assert_equal(iso, `2023-11-14T22:13:20Z`, `format_iso`)

    let dt -> time.format_date(1700000000)
    pass -> pass and test.assert_equal(dt, `2023-11-14`, `format_date`)

    let tm -> time.format_time(1700000000)
    pass -> pass and test.assert_equal(tm, `22:13:20`, `format_time`)

    let m_res -> time.measure(compute_something)
    pass -> pass and test.assert_equal(m_res[`result`], 499500, `measure result`)
    pass -> pass and test.assert_true(m_res[`seconds`] >= 0, `measure duration non-negative`)

    <- pass
}

function run_tests() {
    let tests -> [
        {`name` -> `Time.clock_functions`, `fn` -> test_clock_functions},
        {`name` -> `Time.timer`, `fn` -> test_timer},
        {`name` -> `Time.duration_and_formatting`, `fn` -> test_duration_and_formatting}
    ]

    <- test.run_suite(`Time Library`, tests)
}

function main() {
    when run_tests() {
        <- 0
    } or {
        <- 1
    }
}
