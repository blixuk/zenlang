import zen.io.io as io
import zen.test as test

function test_output_helpers() {
    io.write(``)
    io.write_line(``)
    io.writeln(``)
    io.write_raw(``)
    io.flush()
    io.info(`io.info smoke`)
    io.warn(`io.warn smoke`)
    io.error(`io.error smoke`)
    io.debug(`io.debug smoke`)
    <- test.assert_true(true, `output helpers should be callable`)
}

function test_input_helpers() {
    let pass -> test.assert_true(io.read != Nothing, `io.read should be callable`)
    pass -> pass and test.assert_true(io.read_line != Nothing, `io.read_line should be defined`)
    pass -> pass and test.assert_true(io.readln != Nothing, `io.readln should be defined`)
    pass -> pass and test.assert_true(io.read_exact != Nothing, `io.read_exact should be callable`)
    <- pass
}

function run_tests() {
    let tests -> [
        {`name` -> `IO.output_helpers`, `fn` -> test_output_helpers},
        {`name` -> `IO.input_helpers`, `fn` -> test_input_helpers}
    ]

    <- test.run_suite(`IO Library`, tests)
}

function main() {
    when run_tests() {
        <- 0
    } or {
        <- 1
    }
}
