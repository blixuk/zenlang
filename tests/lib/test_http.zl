/!
  zen.net.http dual-path (offline-safe).
  Run:
    python3 bootstrap/Zen.py tests/lib/test_http.zl
    python3 bootstrap/Zen.py -g tests/lib/test_http.zl
!/

use zen.net.http as http
use zen.io.file as file
use zen.sys.process as process
use zen.test as test
use zen.text.string as Str

let fixture -> `tests/lib/.tmp_http_body.txt`

function cleanup() {
    when file.exists(fixture) {
        file.remove(fixture)
    }
}

function test_helpers_and_file_url() {
    cleanup()
    file.write(fixture, `hello_http_body`)

    // Absolute file:// URL for curl (native) and urllib (interpret)
    let cwd -> Str.trim(process.shell(`pwd`))
    let url -> `file://` + cwd + `/` + fixture

    let r -> http.get(url)
    let pass -> test.assert_true(http.ok(r), `file url ok status`)
    pass -> pass and test.assert_equal(http.status(r), 200, `status 200`)
    pass -> pass and test.assert_equal(http.body(r), `hello_http_body`, `body matches`)

    // Helper map access
    pass -> pass and test.assert_equal(r[`status`], 200, `map status`)
    cleanup()
    <- pass
}

function test_connection_error_shape() {
    // Closed port — offline transport error, stable map shape
    let r -> http.get(`http://127.0.0.1:1/`)
    let pass -> test.assert_true(r[`status`] != Nothing, `has status`)
    pass -> pass and test.assert_true(r[`body`] != Nothing, `has body`)
    // status is -1 or connection error code, not 200
    pass -> pass and test.assert_true(http.ok(r) == false, `not ok`)
    pass -> pass and test.assert_true(http.status(r) != 200, `not 200`)
    <- pass
}

function test_request_post_shape() {
    // POST against closed port still returns structured map (no hang with short timeout)
    let r -> http.post(`http://127.0.0.1:1/`, `payload`, {`Content-Type` -> `text/plain`})
    let pass -> test.assert_true(r[`status`] != Nothing, `post has status`)
    pass -> pass and test.assert_false(http.ok(r), `post not ok`)
    <- pass
}

function test_http_status_predicates_and_text() {
    let pass -> test.assert_true(http.is_success({`status` -> 200}), `200 is success`)
    pass -> pass and test.assert_true(http.is_success({`status` -> 204}), `204 is success`)
    pass -> pass and test.assert_false(http.is_success({`status` -> 404}), `404 not success`)

    pass -> pass and test.assert_true(http.is_redirect({`status` -> 301}), `301 is redirect`)
    pass -> pass and test.assert_true(http.is_redirect({`status` -> 302}), `302 is redirect`)
    pass -> pass and test.assert_false(http.is_redirect({`status` -> 200}), `200 not redirect`)

    pass -> pass and test.assert_true(http.is_client_error({`status` -> 400}), `400 is client error`)
    pass -> pass and test.assert_true(http.is_client_error({`status` -> 404}), `404 is client error`)
    pass -> pass and test.assert_false(http.is_client_error({`status` -> 500}), `500 not client error`)

    pass -> pass and test.assert_true(http.is_server_error({`status` -> 500}), `500 is server error`)
    pass -> pass and test.assert_true(http.is_server_error({`status` -> 503}), `503 is server error`)
    pass -> pass and test.assert_false(http.is_server_error({`status` -> 404}), `404 not server error`)

    pass -> pass and test.assert_equal(http.status_text(200), `OK`, `status_text 200`)
    pass -> pass and test.assert_equal(http.status_text(404), `Not Found`, `status_text 404`)
    pass -> pass and test.assert_equal(http.status_text(500), `Internal Server Error`, `status_text 500`)
    pass -> pass and test.assert_equal(http.status_text({`status` -> 201}), `Created`, `status_text map 201`)
    <- pass
}

function test_http_auth_and_json_helpers() {
    let b_auth -> http.bearer_auth(`my_secret_token_123`)
    let pass -> test.assert_equal(b_auth[`Authorization`], `Bearer my_secret_token_123`, `bearer_auth header`)

    let basic -> http.basic_auth(`admin`, `secret`)
    pass -> pass and test.assert_true(Str.starts_with(basic[`Authorization`], `Basic `), `basic_auth header starts with Basic`)

    // JSON response parsing
    let mock_resp -> {
        `status` -> 200,
        `body` -> `{"user":"alice","id":42,"active":true}`,
        `headers` -> { `Content-Type` -> `application/json`, `X-Custom-ID` -> `abc999` }
    }
    let data -> http.json_body(mock_resp)
    pass -> pass and test.assert_true(data != Nothing, `json_body non-nothing`)
    pass -> pass and test.assert_equal(data[`user`], `alice`, `json user`)
    pass -> pass and test.assert_equal(data[`id`], 42, `json id`)
    pass -> pass and test.assert_equal(data[`active`], true, `json active`)

    // Case-insensitive header lookup
    let h1 -> http.header(mock_resp, `content-type`, ``)
    pass -> pass and test.assert_equal(h1, `application/json`, `header case-insensitive content-type`)
    let h2 -> http.header(mock_resp, `X-CUSTOM-ID`, ``)
    pass -> pass and test.assert_equal(h2, `abc999`, `header case-insensitive custom`)
    let h3 -> http.header(mock_resp, `missing-hdr`, `default_val`)
    pass -> pass and test.assert_equal(h3, `default_val`, `header default fallback`)
    <- pass
}

function run_tests() {
    let tests -> [
        {`name` -> `Http.file_url`, `fn` -> test_helpers_and_file_url},
        {`name` -> `Http.error_shape`, `fn` -> test_connection_error_shape},
        {`name` -> `Http.post_shape`, `fn` -> test_request_post_shape},
        {`name` -> `Http.status_predicates`, `fn` -> test_http_status_predicates_and_text},
        {`name` -> `Http.auth_and_json`, `fn` -> test_http_auth_and_json_helpers}
    ]
    <- test.run_suite(`HTTP Library`, tests)
}

function main() {
    when run_tests() {
        <- 0
    } or {
        <- 1
    }
}
