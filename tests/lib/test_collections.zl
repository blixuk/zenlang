import zen.test as test
import zen.collections.set as set_mod
import zen.collections.stack as stack_mod
import zen.collections.queue as queue_mod

function test_map() {
    let d -> {`a` -> 1, `b` -> 2}
    let pass -> test.assert_true(d.has(`a`), `map should have key 'a'`)
    pass -> pass and test.assert_false(d.has(`c`), `map should not have key 'c'`)
    
    let keys -> d.keys()
    pass -> pass and test.assert_equal(keys.length, 2, `keys length should be 2`)
    
    let values -> d.values()
    pass -> pass and test.assert_equal(values.length, 2, `values length should be 2`)
    
    <- pass
}

function test_set() {
    let s -> set_mod.Set.from_list([1, 2, 2, 3])
    let pass -> test.assert_equal(s.size(), 3, `set size should be 3`)
    pass -> pass and test.assert_true(s.has(2), `set should have 2`)
    pass -> pass and test.assert_false(s.has(4), `set should not have 4`)
    <- pass
}

function test_stack() {
    let s -> stack_mod.Stack()
    s.push(10)
    s.push(20)
    let pass -> test.assert_equal(s.size(), 2, `stack size should be 2`)
    pass -> pass and test.assert_equal(s.pop(), 20, `pop should return 20`)
    pass -> pass and test.assert_equal(s.peek(), 10, `peek should return 10`)
    <- pass
}

function test_queue() {
    let q -> queue_mod.Queue()
    q.enqueue(10)
    q.enqueue(20)
    let pass -> test.assert_equal(q.size(), 2, `queue size should be 2`)
    pass -> pass and test.assert_equal(q.dequeue(), 10, `dequeue should return 10`)
    pass -> pass and test.assert_equal(q.peek(), 20, `peek should return 20`)
    <- pass
}

function run_tests() {
    <- test.run_suite(`Collections Library`, [
        {`name` -> `Coll.Map`, `fn` -> test_map},
        {`name` -> `Coll.Set`, `fn` -> test_set},
        {`name` -> `Coll.Stack`, `fn` -> test_stack},
        {`name` -> `Coll.Queue`, `fn` -> test_queue}
    ])
}

function main() {
    when run_tests() {
        <- 0
    } or {
        <- 1
    }
}
