import zen.test as test

function test_assert_helpers() {
    let pass -> test.assert_equal(2 + 2, 4, `assert_equal should compare values`)
    pass -> pass and test.assert_true(true, `assert_true should accept true`)
    pass -> pass and test.assert_false(false, `assert_false should accept false`)
    <- pass
}

function test_runner_helpers() {
    let single -> test.run_unit(`unit pass`, function() {
        <- true
    })

    let suite -> test.run_suite(`Nested Suite`, [
        {`name` -> `nested pass a`, `fn` -> function() { <- true }},
        {`name` -> `nested pass b`, `fn` -> function() { <- true }}
    ])

    let pass -> test.assert_true(single, `run_unit should return true for passing tests`)
    pass -> pass and test.assert_true(suite, `run_suite should return true when all nested tests pass`)
    <- pass
}

function run_tests() {
    let tests -> [
        {`name` -> `Test.assert_helpers`, `fn` -> test_assert_helpers},
        {`name` -> `Test.runner_helpers`, `fn` -> test_runner_helpers}
    ]

    <- test.run_suite(`Test Library`, tests)
}

function main() {
    when run_tests() {
        <- 0
    } or {
        <- 1
    }
}
