import zen.ui.table as table
import zen.test.test as test
import zen.text.string as Str
import zen.io.io as IO

function test_table_basic() {
    let headers -> [`ID`, `Name`, `Role`]
    let rows -> [
        [1, `Alice`, `Admin`],
        [2, `Bob`, `Developer`],
        [3, `Charlie`, `Designer`]
    ]
    
    let rendered -> table.format_table(headers, rows, { `style` -> `unicode` })
    test.assert_true(Str.contains(rendered, `Alice`), `contains Alice`)
    test.assert_true(Str.contains(rendered, `Developer`), `contains Developer`)
    test.assert_true(Str.contains(rendered, `┌`), `contains Unicode top border`)
    test.assert_true(Str.contains(rendered, `└`), `contains Unicode bottom border`)
    <- true
}

function test_table_styles() {
    let headers -> [`Metric`, `Value`]
    let rows -> [
        [`CPU`, `45%`],
        [`RAM`, `62%`]
    ]
    
    let ascii_t -> table.format_table(headers, rows, { `style` -> `ascii` })
    test.assert_true(Str.contains(ascii_t, `+`), `ascii has +`)
    test.assert_true(Str.contains(ascii_t, `|`), `ascii has |`)
    
    let rounded_t -> table.format_table(headers, rows, { `style` -> `rounded` })
    test.assert_true(Str.contains(rounded_t, `╭`), `rounded has ╭`)
    test.assert_true(Str.contains(rounded_t, `╯`), `rounded has ╯`)
    
    let md_t -> table.format_table(headers, rows, { `style` -> `markdown` })
    test.assert_true(Str.starts_with(md_t, `|`), `markdown starts with |`)
    <- true
}

function test_table_class() {
    let t -> table.Table([`Key`, `Val`], { `style` -> `ascii` })
    t.add_row([`host`, `127.0.0.1`])
    t.add_row([`port`, 8080])
    
    let res -> t.render()
    test.assert_true(Str.contains(res, `127.0.0.1`), `table class render host`)
    test.assert_true(Str.contains(res, `8080`), `table class render port`)
    <- true
}

function main() {
    IO.info(`--- Running Suite: UI Table ---`)
    test.run_unit(`test_table_basic`, test_table_basic)
    test.run_unit(`test_table_styles`, test_table_styles)
    test.run_unit(`test_table_class`, test_table_class)
    IO.info(`--- UI Table: 3/3 passed ---`)
    <- 0
}
