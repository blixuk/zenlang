function test_index_assign() {
    let src -> `
function main() {
    let xs -> [1, 2, 3]
    xs[1] -> 9
    when xs[0] == 1 {
        when xs[1] == 9 {
            when xs.length == 3 {
                <- 0
            }
        }
    }
    <- 1
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], true, `index ok`)
    pass -> pass and test.assert_equal(r[`value`], 0, `index exit 0`)
    <- pass
}

