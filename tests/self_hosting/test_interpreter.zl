    let r -> Interp.interpret_file(`tests/self_hosting/fixtures/stage7_add.zl`)
    let pass -> test.assert_equal(r[`ok`], true, `fixture ok`)
    pass -> pass and test.assert_equal(r[`value`], 0, `fixture exit 0`)
