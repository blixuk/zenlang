function test_list_length() {
    let src -> `
function main() {
    let xs -> [7, 8, 9]
    when xs.length == 3 {
        when xs[2] == 9 {
            <- 0
        }
    }
    <- 1
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], true, `len ok`)
    pass -> pass and test.assert_equal(r[`value`], 0, `len exit 0`)
    <- pass
}

function run_tests() {
    // Driver.interpret CLI covered under bootstrap host:
    //   python3 bootstrap/Zen.py selfhost/zen.zl interpret fixtures/stage7_add.zl
    // (avoid importing Driver here so -g does not pull entire CLink/Codegen graph)
    let tests -> [
        {`name` -> `Interp.add_main`, `fn` -> test_add_main},
        {`name` -> `Interp.undefined`, `fn` -> test_undefined},
        {`name` -> `Interp.when_else`, `fn` -> test_when_else},
        {`name` -> `Interp.nested_call`, `fn` -> test_nested_call},
        {`name` -> `Interp.compare`, `fn` -> test_compare_ops},
        {`name` -> `Interp.fixture_stage7`, `fn` -> test_fixture_stage7},
        {`name` -> `Interp.import_graph`, `fn` -> test_import_graph},
        {`name` -> `Interp.for_sum`, `fn` -> test_for_sum},
        {`name` -> `Interp.index_assign`, `fn` -> test_index_assign},
        {`name` -> `Interp.map_roundtrip`, `fn` -> test_map_roundtrip},
        {`name` -> `Interp.str_import`, `fn` -> test_str_import},
        {`name` -> `Interp.list_length`, `fn` -> test_list_length},
        {`name` -> `Interp.nothing_default`, `fn` -> test_nothing_default},
        {`name` -> `Interp.pattern_bind`, `fn` -> test_pattern_bind},
        {`name` -> `Interp.class_counter`, `fn` -> test_class_counter},
        {`name` -> `Interp.class_inherit`, `fn` -> test_class_inherit},
        {`name` -> `Interp.closure_add`, `fn` -> test_closure_add},
        {`name` -> `Interp.enum_color`, `fn` -> test_enum_color},
        {`name` -> `Interp.enum_payload`, `fn` -> test_enum_payload},
        {`name` -> `Interp.with_region`, `fn` -> test_with_region},
        {`name` -> `Interp.class_dispatch`, `fn` -> test_class_dispatch},
        {`name` -> `Interp.closure_nested`, `fn` -> test_closure_nested}
    ]
    <- test.run_suite(`Selfhost Interpreter`, tests)
}

function main() {
    when run_tests() {
        <- 0
    } or {
        <- 1
    }
}
