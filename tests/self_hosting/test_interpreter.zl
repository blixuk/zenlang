/!
 Endgame #5: selfhost AST interpreter dual-path smoke.
 !/

import compiler.Interpreter as Interp
import zen.test as test
import zen.text.string as Str

function test_add_main() {
    let src -> `
function add(a, b) {
    <- a + b
}

function main() {
    let x -> add(2, 3)
    when x == 5 {
        <- 0
    }
    <- 1
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], true, `ok`)
    pass -> pass and test.assert_equal(r[`value`], 0, `main returns 0`)
    pass -> pass and test.assert_equal(r[`error`], Nothing, `no error`)
    <- pass
}

function test_undefined() {
    let src -> `
function main() {
    <- missing_name
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], false, `not ok`)
    let err -> Str.to_string(r[`error`])
    pass -> pass and test.assert_equal(Str.contains(err, `Undefined`), true, `undefined msg`)
    <- pass
}

function test_when_else() {
    let src -> `
function main() {
    let x -> 2
    when x == 1 {
        <- 10
    } or {
        <- 20
    }
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], true, `when ok`)
    pass -> pass and test.assert_equal(r[`value`], 20, `else branch`)
    <- pass
}

function test_nested_call() {
    let src -> `
function double(n) {
    <- n * 2
}

function main() {
    <- double(double(3))
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], true, `nested ok`)
    pass -> pass and test.assert_equal(r[`value`], 12, `3*2*2`)
    <- pass
}

function test_compare_ops() {
    let src -> `
function main() {
    when 3 < 5 and 5 != 4 {
        <- 1
    }
    <- 0
}
`
    let r -> Interp.interpret_source(src)
    let pass -> test.assert_equal(r[`ok`], true, `cmp ok`)
    pass -> pass and test.assert_equal(r[`value`], 1, `cmp true`)
    <- pass
}

