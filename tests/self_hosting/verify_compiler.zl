/!
 Self-host Stage 1 verify: tokenize a small fixture via selfhost lexer.
 Full component transpile lives in later stages (see selfhost/PARITY.md).
 !/

import compiler.Lexer as Lexer
import zen.io.io as io
import zen.text.string as Str

function main() {
    let src -> `function main() {
    let x -> 1 + 2
    <- x
}
`
    let tokens -> Lexer.tokenize_source(src)
    // Capture length before any iteration (native for-loops must not be assumed non-consuming).
    let n -> tokens.length
    io.writeln(`tokens=` + Str.to_string(n))
    when n >= 10 {
        io.writeln(`PASS`)
        <- 0
    } or {
        io.writeln(`FAIL n=` + Str.to_string(n))
        <- 1
    }
}
