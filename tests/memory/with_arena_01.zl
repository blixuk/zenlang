/!
 WithStatement typecheck (body field) + free-function arena region.
 Full `with` + alias under -g still has SMIR name mangling gaps; this test
 verifies checker accepts with and dual-path free-function regions.
 Exit 0 on success.
!/

import zen.memory as memory

function main() {
    let base -> memory.arena_depth()

    // Free-function region (dual-path)
    let a -> memory.create_arena(4096)
    memory.push_arena(a)
    when memory.arena_depth() != base + 1 {
        memory.pop_arena()
        memory.free_arena(a)
        <- 1
    }
    memory.pop_arena()
    memory.free_arena(a)
    when memory.arena_depth() != base {
        <- 2
    }

    // with + free functions (typecheck path; body not .block)
    let ok -> 0
    with memory.create_arena(1024) as scene {
        // Prefer not relying on alias under -g; use depth side-effect free of alias
        ok -> 1
    }
    when ok != 1 {
        <- 3
    }
    <- 0
}
