from zen.io import write
import zen.text.string as Str
from ../../src/compiler/Lexer import Lexer
from ../../src/compiler/Parser import Parser
from ../../src/compiler/CTranspiler import Transpiler

function main() {
    let source -> `
function test_flow(a: Integer) {
    if (a > 10) {
        return 1;
    } else {
        return 0;
    }
}

function test_loop() {
    let i -> 0;
    while (i < 5) {
        i -> i + 1;
    }
    return i;
}

function main_wrapper() {
    let r1 -> test_flow(5);
    let r2 -> test_flow(15);
    let r3 -> test_loop();
}
`
    // Note: ZenLang syntax uses 'when' not 'if', but my CTranspiler smoke test source
    // string above uses 'if' which is NOT ZenLang syntax.
    // I should fix the source string to use ZenLang syntax.
    
    let source_corrected -> `
function test_flow(a: Integer) {
    when (a > 10) {
        return 1;
    } or {
        return 0;
    }
}

function test_loop() {
    let i -> 0;
    while (i < 5) {
        i -> i + 1;
    }
    return i;
}

let r1 -> test_flow(5);
let r2 -> test_flow(15);
let r3 -> test_loop();
`
    write(`Source: ` + source_corrected)

    let lexer -> Lexer(source_corrected)
    let tokens -> lexer.tokenize()
    let parser -> Parser(tokens)
    let statements -> parser.parse()
    
    let transpiler -> Transpiler(statements)
    let c_code -> transpiler.transpile()
    
    write(`--- Generated C Code ---`)
    write(c_code)
    write(`------------------------`)
    
    from zen.io import write_file
    write_file(`control_flow_output.c`, c_code)
    write(`Wrote C code to control_flow_output.c`)
}
