from ../../src/compiler/Lexer import Lexer
from ../../src/compiler/Parser import Parser
from zen.io import write
from zen.io import read_file
import zen.string as s

function test_parse_file(path: String) {
    write(`Parsing ` + path + `...`)
    let source -> read_file(path)
    
    let lexer -> Lexer(source)
    let tokens -> lexer.tokenize()
    
    let parser -> Parser(tokens)
    let statements -> parser.parse()
    
    write(`Successfully parsed ` + path + `!`)
}

function main() {
    write(`-- Starting Self-Hosting Verification --`)
    
    // We need absolute paths or relative paths that resolve correctly from where Zen.py is run
    // Assuming run from root of repo:
    test_parse_file(`src/compiler/Token.zl`)
    test_parse_file(`src/compiler/AST.zl`)
    test_parse_file(`src/compiler/Lexer.zl`)
    test_parse_file(`src/compiler/Parser.zl`)
    
    write(`-- Self-Hosting Verification Complete --`)
}
