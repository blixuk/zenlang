from zen.io import write
import zen.string as Str
from ../../src/compiler/Lexer import Lexer
from ../../src/compiler/Parser import Parser
from ../../src/compiler/CTranspiler import Transpiler

function main() {
    let source -> `
class Dog {
    age: Integer
    
    function bark() {
        return 42;
    }
    
    function get_age() {
        return self.age;
    }
}

function test_classes() {
    let d: Dog -> create_dog(5);
    let a -> d.get_age();
    let b -> d.bark();
    return a + b;
}

function main_wrapper() {
    test_classes();
    return 0;
}
`
    write(`Source: ` + source)

    let lexer -> Lexer(source)
    let tokens -> lexer.tokenize()
    let parser -> Parser(tokens)
    let statements -> parser.parse()
    
    let transpiler -> Transpiler(statements)
    let c_code -> transpiler.transpile()
    
    // Inject prototype and helper
    let prototype -> `Dog* create_dog(long long age);`
    let parts -> Str.split(c_code, `long long test_classes`)
    let final_c_code -> parts.get(0) + prototype + `\nlong long test_classes` + parts.get(1)
    
    final_c_code -> final_c_code + `
// Helper injection
Dog* create_dog(long long age) {
    Dog* d = malloc(sizeof(Dog));
    d->age = age;
    return d;
}
`
    
    write(`--- Generated C Code ---`)
    write(final_c_code)
    write(`------------------------`)
    
    from zen.io import write_file
    write_file(`classes_output.c`, final_c_code)
    write(`Wrote C code to classes_output.c`)
}
