import `compiler/Lexer` as Lexer
import `compiler/Parser` as Parser
import `compiler/CTranspiler` as CTranspiler
import `compiler/Token` as TokenRec
import `lib/zen/io` as IO
import `lib/zen/string` as Str
import `lib/zen/sys` as Sys

function compile(source_path: String, output_path: String) {
    let source -> IO.read_file(source_path)
    
    let l -> Lexer.Lexer(source)
    let tokens -> l.tokenize()
    
    let p -> Parser.Parser(tokens)
    let ast -> p.parse()
    
    let t -> CTranspiler.Transpiler(ast)
    let c_code -> t.transpile_source(``)
    
    IO.write_file(output_path, c_code)
}

function main() {
    let args -> Sys.get_args()
    when (args.length < 3) {
        IO.write(`Usage: zen <source.zl> <output.c>`)
        Sys.exit(1)
    }
    
    let source_path -> args[1]
    let output_path -> args[2]
    
    compile(source_path, output_path)
    IO.write(`Compiled ` + source_path + ` to ` + output_path)
}
