from `compiler/Token` import TokenType
import `lib/zen/string` as Str

class Lexer {
    let source: String
    let tokens: List
    let current: Integer
    let line: Integer
    let column: Integer

    function init(source: String) {
        self.source -> source
        self.tokens -> []
        self.current -> 0
        self.line -> 1
        self.column -> 1
    }


    function peek(offset: Integer) : String {
        let pos -> self.current + offset
        when pos >= Str.length(self.source) {
            <- ``
        }
        <- Str.at(self.source, pos)
    }

    function advance() : String {
        let char : String -> self.peek(0)
        self.current -> self.current + 1
        
        when char = `\n` {
            self.line -> self.line + 1
            self.column -> 1
        } or {
            self.column -> self.column + 1
        }
        
        <- char
    }

    function is_at_end() : Boolean {
        <- self.current >= Str.length(self.source)
    }

    function is_digit(c: String) : Boolean {
        <- Str.index_of(`0123456789`, c) != -1
    }

    function is_alpha(c: String) : Boolean {
        <- Str.index_of(`abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_`, c) != -1
    }

    function is_alphanumeric(c: String) : Boolean {
        <- self.is_alpha(c) or self.is_digit(c)
    }

    function tokenize() : List {
        while not self.is_at_end() {
            self.scan_token()
        }
        
        let eof_token : Token -> Token {
            kind: TokenType.TK_EOF,
            value: ``,
            line: self.line,
            column: self.column,
            end_line: self.line,
            end_column: self.column
        }
        let toks : List -> self.tokens
        toks.append(eof_token)
        <- self.tokens
    }

    function scan_token() {
        let char : String -> self.advance()
        
        when char = ` ` or char = `\r` or char = `\t` or char = `\n` {
            // Skip whitespace
        } or when char = `(` {
            self.add_token(TokenType.LEFT_PAREN, `(`)
        } or when char = `)` {
            self.add_token(TokenType.RIGHT_PAREN, `)`)
        } or when char = `{` {
            self.add_token(TokenType.LEFT_BRACE, `{`)
        } or when char = `}` {
            self.add_token(TokenType.RIGHT_BRACE, `}`)
        } or when char = `[` {
            self.add_token(TokenType.LEFT_BRACKET, `[`)
        } or when char = `]` {
            self.add_token(TokenType.RIGHT_BRACKET, `]`)
        } or when char = `,` {
            self.add_token(TokenType.COMMA, `,`)
        } or when char = `.` {
            self.add_token(TokenType.DOT, `.`)
        } or when char = `-` {
            when self.peek(0) = `>` {
                self.advance()
                self.add_token(TokenType.ASSIGNMENT, `->`)
            } or when self.peek(0) = `-` {
                self.advance()
                self.add_token(TokenType.DECREMENT, `--`)
            } or {
                self.add_token(TokenType.SUBTRACTION, `-`)
            }
        } or when char = `+` {
            when self.peek(0) = `+` {
                self.advance()
                self.add_token(TokenType.INCREMENT, `++`)
            } or {
                self.add_token(TokenType.ADDITION, `+`)
            }
        } or when char = `*` {
            when self.peek(0) = `*` {
                 self.advance()
                 self.add_token(TokenType.POWER, `**`)
            } or {
                 self.add_token(TokenType.MULTIPLICATION, `*`)
            }
        } or when char = `/` {
            when self.peek(0) = `/` {
                // Line comment
                while self.peek(0) != `\n` and not self.is_at_end() {
                    self.advance()
                }
            } or when self.peek(0) = `*` {
                self.advance() // consume *
                while not self.is_at_end() {
                    when self.peek(0) = `*` and self.peek(1) = `/` {
                        self.advance() // *
                        self.advance() // /
                        break
                    }
                    self.advance()
                }
            } or {
                self.add_token(TokenType.DIVISION, `/`)
            }
        } or when char = `=` {
            when self.peek(0) = `=` {
                self.advance()
                self.add_token(TokenType.EQUAL_EQUAL, `==`)
            } or {
                self.add_token(TokenType.EQUAL, `=`)
            }
        } or when char = `!` {
            when self.peek(0) = `=` {
                self.advance()
                self.add_token(TokenType.NOT_EQUAL, `!=`)
            } or when self.peek(0) = `!` {
                self.advance()
                self.add_token(TokenType.BITWISE_NOT, `!!`)
            } or when self.peek(0) = `|` {
                self.advance()
                self.add_token(TokenType.BITWISE_NOR, `!|`)
            } or when self.peek(0) = `&` {
                self.advance()
                self.add_token(TokenType.BITWISE_NAND, `!&`)
            } or when self.peek(0) = `^` {
                self.advance()
                self.add_token(TokenType.BITWISE_XNOR, `!^`)
            } or {
                self.add_token(TokenType.ASSERT, `!`) // Also used for NOT, context dependent or separated
            }
        } or when char = `<` {
            when self.peek(0) = `=` {
                self.advance()
                self.add_token(TokenType.LESS_THAN_OR_EQUAL, `<=`)
            } or when self.peek(0) = `-` {
                self.advance()
                self.add_token(TokenType.RETURN, `<-`)
            } or when self.peek(0) = `<` {
                self.advance()
                self.add_token(TokenType.BITWISE_LSHIFT, `<<`)
            } or {
                self.add_token(TokenType.LESS_THAN, `<`)
            }
        } or when char = `>` {
            when self.peek(0) = `=` {
                self.advance()
                self.add_token(TokenType.GREATER_THAN_OR_EQUAL, `>=`)
            } or when self.peek(0) = `>` {
                self.advance()
                self.add_token(TokenType.BITWISE_RSHIFT, `>>`)
            } or {
                self.add_token(TokenType.GREATER_THAN, `>`)
            }
        } or when char = `:` {
            when self.peek(0) = `>` {
                self.advance()
                self.add_token(TokenType.TYPE_LET, `:>`)
            } or {
                self.add_token(TokenType.TYPE_SET, `:`)
            }
        } or when char = `%` {
            when self.peek(0) = `%` {
                self.advance()
                self.add_token(TokenType.BITWISE_MOD, `%%`)
            } or {
                self.add_token(TokenType.MODULO, `%`)
            }
        } or when char = `^` {
            when self.peek(0) = `^` {
                self.advance()
                self.add_token(TokenType.BITWISE_XOR, `^^`)
            } or {
                self.add_token(TokenType.RAISE, `^`)
            }
        } or when char = `?` {
            self.add_token(TokenType.CHECK, `?`)
        } or when char = `&` {
             when self.peek(0) = `&` {
                self.advance()
                self.add_token(TokenType.BITWISE_AND, `&&`)
             }
        } or when char = `|` {
             when self.peek(0) = `|` {
                self.advance()
                self.add_token(TokenType.BITWISE_OR, `||`)
             }
        } or when char = `;` {
            self.add_token(TokenType.SEMICOLON, `;`)
        } or when char = `\`` {
            self.string(`\``)
        } or when char = `"` {
            self.string(`"`)
        } or when char = `'` {
            self.rune()
        } or {
            when self.is_digit(char) {
                self.number(char)
            } or when self.is_alpha(char) {
                self.identifier(char)
            } or {
                self.add_token(TokenType.ERROR, `Unexpected character: ` + char)
            }
        }
    }

    function add_token(kind: TokenType, value: Variant) {
        let toks : List -> self.tokens
        let token : Token -> Token {
            kind: kind,
            value: value,
            line: self.line,
            column: self.column,
            end_line: self.line,
            end_column: self.column
        }
        toks.append(token)
    }

    function string(quote: String) {
        let value : String -> ``
        while self.peek(0) != quote and not self.is_at_end() {
            let char : String -> self.advance()
            when char = `\\` {
                let escape : String -> self.advance()
                when escape = `n` { value -> value + `\n` }
                or when escape = `r` { value -> value + `\r` }
                or when escape = `t` { value -> value + `\t` }
                or when escape = `\\` { value -> value + `\\` }
                or when escape = `\`` { value -> value + `\`` }
                or { value -> value + `\\` + escape }
            } or {
                value -> value + char
            }
        }
        
        when self.is_at_end() {
            self.add_token(TokenType.ERROR, `Unterminated string`)
        } or {
            self.advance() // closing quote
            self.add_token(TokenType.STRING, value)
        }
    }

    function rune() {
        let value : String -> self.advance()
        when value = `\\` {
            let escape : String -> self.advance()
            when escape = `n` { value -> `\n` }
            or when escape = `r` { value -> `\r` }
            or when escape = `t` { value -> `\t` }
            or when escape = `\\` { value -> `\\` }
            or when escape = `'` { value -> `'` }
            or { value -> `\\` + escape }
        }
        
        when self.peek(0) = `'` {
            self.advance() // closing '
            self.add_token(TokenType.RUNE, value)
        } or {
            self.add_token(TokenType.ERROR, `Unterminated character`)
        }
    }

    function number(first: String) {
        let value : String -> first
        while self.is_digit(self.peek(0)) {
            value -> value + self.advance()
        }
        
        when self.peek(0) = `.` and self.is_digit(self.peek(1)) {
            value -> value + self.advance()
            while self.is_digit(self.peek(0)) {
                value -> value + self.advance()
            }
            self.add_token(TokenType.DECIMAL, value)
        } or {
            self.add_token(TokenType.INTEGER, value)
        }
    }

    function identifier(first: String) {
        let value : String -> first
        while self.is_alphanumeric(self.peek(0)) {
            value -> value + self.advance()
        }
        
        let kind -> TokenType.IDENTIFIER
        // Keywords check
        when (value = `function` or value = `class` or value = `structure` or 
             value = `enumerator` or value = `let` or value = `set` or value = `return` or 
             value = `when` or value = `while` or value = `do` or 
             value = `until` or value = `for` or value = `in` or 
             value = `break` or value = `continue` or value = `import` or 
             value = `from` or value = `as` or 
             value = `true` or value = `false` or value = `nothing` or
             value = `if` or value = `defer`) {
            kind -> TokenType.KEYWORD
        } or when value = `and` {
            kind -> TokenType.AND
        } or when value = `or` {
            kind -> TokenType.OR
        } or when value = `not` {
            kind -> TokenType.NOT
        } or when value = `xor` {
            kind -> TokenType.XOR
        } or when value = `nor` {
            kind -> TokenType.NOR
        } or when value = `nand` {
            kind -> TokenType.NAND
        } or when value = `xnor` {
            kind -> TokenType.XNOR
        } or when value = `check` {
            kind -> TokenType.TK_CHECK
        } or when value = `raise` {
            kind -> TokenType.TK_RAISE
        } or when value = `assert` {
            kind -> TokenType.TK_ASSERT
        } or when value = `case` {
            kind -> TokenType.TK_CASE
        } or when value = `Integer` or value = `Decimal` or value = `String` or 
                  value = `Boolean` or value = `Void` or value = `Variant` or 
                  value = `List` {
            kind -> TokenType.TYPE
        }
        
        self.add_token(kind, value)
    }
}
