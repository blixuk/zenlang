enumerator TokenType {
    KEYWORD -> `KEYWORD`,
    IDENTIFIER -> `IDENTIFIER`,
    LITERAL -> `LITERAL`,
    OPERATOR -> `OPERATOR`,
    TYPE -> `TYPE`,
    UNKNOWN -> `UNKNOWN`,
    COMMENT -> `COMMENT`,
    ERROR -> `ERROR`,
    VOID -> `VOID`,
    NOTHING -> `NOTHING`,
    VARIANT -> `VARIANT`,
    INTEGER -> `INTEGER`,
    DECIMAL -> `DECIMAL`,
    STRING -> `STRING`,
    RUNE -> `RUNE`,
    BOOLEAN -> `BOOLEAN`,
    TK_STRUCTURE -> `TK_STRUCTURE`,
    TK_FUNCTION -> `TK_FUNCTION`,
    TK_CLASS -> `TK_CLASS`,
    TK_ENUMERATOR -> `TK_ENUMERATOR`,
    TK_LIST -> `TK_LIST`,
    TUPLE -> `TUPLE`,
    VECTOR -> `VECTOR`,
    DICTIONARY -> `DICTIONARY`,
    TK_SET -> `TK_SET`,
    ITERATOR -> `ITERATOR`,
    ITERABLE -> `ITERABLE`,
    AUTO -> `AUTO`,
    LEFT_PAREN -> `LEFT_PAREN`,
    RIGHT_PAREN -> `RIGHT_PAREN`,
    LEFT_BRACE -> `LEFT_BRACE`,
    RIGHT_BRACE -> `RIGHT_BRACE`,
    LEFT_BRACKET -> `LEFT_BRACKET`,
    RIGHT_BRACKET -> `RIGHT_BRACKET`,
    COMMA -> `COMMA`,
    DOT -> `DOT`,
    SEMICOLON -> `SEMICOLON`,
    TYPE_SET -> `TYPE_SET`,
    TYPE_LET -> `TYPE_LET`,
    ASSIGNMENT -> `ASSIGNMENT`,
    RETURN -> `RETURN`,
    ADDITION -> `ADDITION`,
    SUBTRACTION -> `SUBTRACTION`,
    MULTIPLICATION -> `MULTIPLICATION`,
    DIVISION -> `DIVISION`,
    MODULO -> `MODULO`,
    AND -> `AND`,
    OR -> `OR`,
    NOT -> `NOT`,
    XOR -> `XOR`,
    NOR -> `NOR`,
    NAND -> `NAND`,
    XNOR -> `XNOR`,
    INCREMENT -> `INCREMENT`,
    DECREMENT -> `DECREMENT`,
    EQUAL -> `EQUAL`,
    NOT_EQUAL -> `NOT_EQUAL`,
    GREATER_THAN -> `GREATER_THAN`,
    LESS_THAN -> `LESS_THAN`,
    GREATER_THAN_OR_EQUAL -> `GREATER_THAN_OR_EQUAL`,
    LESS_THAN_OR_EQUAL -> `LESS_THAN_OR_EQUAL`,
    EQUAL_EQUAL -> `EQUAL_EQUAL`,
    TK_EOF -> `EOF`,
    CHECK -> `CHECK`,
    RAISE -> `RAISE`,
    ASSERT -> `ASSERT`,
    POWER -> `EXPONENTIATION`,
    BITWISE_AND -> `BITWISE_AND`,
    BITWISE_OR -> `BITWISE_OR`,
    BITWISE_NOT -> `BITWISE_NOT`,
    BITWISE_XOR -> `BITWISE_XOR`,
    BITWISE_NOR -> `BITWISE_NOR`,
    BITWISE_NAND -> `BITWISE_NAND`,
    BITWISE_XNOR -> `BITWISE_XNOR`,
    BITWISE_LSHIFT -> `BITWISE_LEFT_SHIFT`,
    BITWISE_RSHIFT -> `BITWISE_RIGHT_SHIFT`,
    BITWISE_MOD -> `BITWISE_MOD`,
    TK_CASE -> `TK_CASE`,
    TK_CHECK -> `TK_CHECK`,
    TK_RAISE -> `TK_RAISE`,
    TK_ASSERT -> `TK_ASSERT`
}

structure Token {
    kind: TokenType,
    value: Variant,
    line: Integer,
    column: Integer,
    end_line: Integer,
    end_column: Integer
}
