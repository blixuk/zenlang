import ../compiler/Types as CompilerTypes
import ../compiler/AST as AST
from ../lib/zen/io import write

class Checker {
    let ast: List
    let source_path: String
    let scope: Object
    let global_scope: Object
    let typevariable_counter: Integer

    function init(ast: List, source_path: String) {
        self.ast -> ast
        self.source_path -> source_path
        self.global_scope -> CompilerTypes.ZenScope(nothing)
        self.scope -> self.global_scope
        self.typevariable_counter -> 0
        self.register_builtins()
    }

    function register_builtins() {
        self.global_scope.define(CompilerTypes.ZenSymbol(
            `write`,
            CompilerTypes.ZenFunctionType(`write`, [], CompilerTypes.ZenVoidType()),
            False,
            CompilerTypes.SymbolKind.FUNCTION,
            0
        ))
    }

    function new_typevariable() {
        write(`Debug: Entering new_typevariable`)
        let tv -> CompilerTypes.ZenTypeVariable(
            self.typevariable_counter,
            nothing
        )
        write(`Debug: Created ZenTypeVariable`)
        self.typevariable_counter -> self.typevariable_counter + 1
        <- CompilerTypes.ZenVariableType(tv)
    }

    function check_program() {
        let statements -> self.ast
        for statement in statements {
            self.check_statement(statement)
        }
    }

    function check_statement(statement: Object) {
        when statement.kind = AST.ASTKind.LET_STATEMENT {
            self.check_let_statement(statement)
        }
        when statement.kind = AST.ASTKind.EXPRESSION_STATEMENT {
            self.check_expression(statement.expression)
        }
        when statement.kind = AST.ASTKind.FUNCTION_STATEMENT {
            self.check_function_statement(statement)
        }
        when statement.kind = AST.ASTKind.BLOCK_STATEMENT {
            self.check_block_statement(statement)
        }
        when statement.kind = AST.ASTKind.RETURN_STATEMENT {
            self.check_return_statement(statement)
        }
    }

    function check_let_statement(statement: Object) {
        let declared_type -> self.new_typevariable()
        
        let value_type -> nothing
        when (statement.initializer != nothing) {
            value_type -> self.check_expression(statement.initializer)
        }
        
        when (not value_type) {
             value_type -> self.new_typevariable()
        }
        
        self.scope.define(CompilerTypes.ZenSymbol(
            statement.name.value,
            value_type,
            True, 
            CompilerTypes.SymbolKind.VARIABLE,
            self.scope.level
        ))
    }

    function check_function_statement(statement: Object) {
        let function_type -> CompilerTypes.ZenFunctionType(
            statement.name.value,
            [], 
            CompilerTypes.ZenVoidType() 
        )
        self.scope.define(CompilerTypes.ZenSymbol(
            statement.name.value,
            function_type,
            False,
            CompilerTypes.SymbolKind.FUNCTION,
            self.scope.level
        ))
        let old_scope -> self.scope
        self.scope -> CompilerTypes.ZenScope(old_scope)
        self.check_block_statement(statement.body)
        self.scope -> old_scope
    }

    function check_block_statement(statement: Object) {
        let old_scope -> self.scope
        self.scope -> CompilerTypes.ZenScope(old_scope)
        for stmt in statement.statements {
            self.check_statement(stmt)
        }
        self.scope -> old_scope
    }

    function check_return_statement(statement: Object) {
        when statement.value {
            self.check_expression(statement.value)
        }
    }

    function check_expression(expression: Object) {
        when expression.kind = AST.ASTKind.LITERAL_EXPRESSION {
            let val -> expression.value
            <- CompilerTypes.ZenIntegerType()
        } or when expression.kind = AST.ASTKind.VARIABLE_EXPRESSION {
            let name -> expression.name.value
            let symbol -> self.scope.lookup(name)
            when symbol {
                <- symbol.data_type
            } or when True {
                write(`Undefined variable: ` + name)
                <- CompilerTypes.ZenUnknownType()
            }
        }
        <- CompilerTypes.ZenUnknownType()
    }
}
