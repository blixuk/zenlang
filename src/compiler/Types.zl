from ../../lib/zen/io import write
// write(`DEBUG: Types module executing`)

enumerator SymbolKind {
    VARIABLE,
    FUNCTION,
    PARAMETER,
    MEMBER,
    STRUCTURE,
    ENUMERATOR,
    GENERIC
}

enumerator TypeKind {
    INTEGER,
    DECIMAL,
    STRING,
    BOOLEAN,
    VOID,
    VARIANT,
    UNKNOWN,
    VARIABLE,
    FUNCTION,
    STRUCTURE,
    LIST
}

// Base Type Class
class ZenType {
    let kind: TypeKind
}

class ZenIntegerType extends ZenType {
    function init() {
        self.kind -> TypeKind.INTEGER
    }
}

class ZenDecimalType extends ZenType {
    function init() {
        self.kind -> TypeKind.DECIMAL
    }
}

class ZenStringType extends ZenType {
    function init() {
        self.kind -> TypeKind.STRING
    }
}

class ZenBooleanType extends ZenType {
    function init() {
        self.kind -> TypeKind.BOOLEAN
    }
}

class ZenVoidType extends ZenType {
    function init() {
        self.kind -> TypeKind.VOID
    }
}

class ZenVariantType extends ZenType {
    function init() {
        self.kind -> TypeKind.VARIANT
    }
}

class ZenUnknownType extends ZenType {
    function init() {
        self.kind -> TypeKind.UNKNOWN
    }
}

class ZenTypeVariable {
    let id: Integer
    let bound: ZenType

    function init(id: Integer, bound: ZenType) {
        self.id -> id
        self.bound -> bound
    }
}

class ZenVariableType extends ZenType {
    let type_variable: ZenTypeVariable
    
    function init(tv: ZenTypeVariable) {
        self.kind -> TypeKind.VARIABLE
        self.type_variable -> tv
    }
}

class ZenFunctionType extends ZenType {
    let name: String
    let parameters: List
    let return_type: ZenType

    function init(name: String, parameters: List, return_type: ZenType) {
        self.kind -> TypeKind.FUNCTION
        self.name -> name
        self.parameters -> parameters
        self.return_type -> return_type
    }
}

class ZenStructureType extends ZenType {
    let name: String
    let members: Dictionary

    function init(name: String, members: Dictionary) {
        self.kind -> TypeKind.STRUCTURE
        self.name -> name
        self.members -> members
    }
}

class ZenListType extends ZenType {
    let element_type: ZenType

    function init(element_type: ZenType) {
        self.kind -> TypeKind.LIST
        self.element_type -> element_type
    }
}

class ZenSymbol {
    let name: String
    let data_type: ZenType
    let mutable: Boolean
    let kind: SymbolKind
    let scope_level: Integer

    function init(name: String, data_type: ZenType, mutable: Boolean, kind: SymbolKind, scope_level: Integer) {
        self.name -> name
        self.data_type -> data_type
        self.mutable -> mutable
        self.kind -> kind
        self.scope_level -> scope_level
    }
}

class ZenScope {
    let symbols: List
    let parent_scope: ZenScope
    let level: Integer

    function init(parent_scope: ZenScope) {
        self.symbols -> []
        self.parent_scope -> parent_scope
        when parent_scope {
            self.level -> parent_scope.level + 1
        } or when True {
            self.level -> 0
        }
    }

    function define(symbol: ZenSymbol) {
        // Use list concatenation as a workaround if append/push is not exposed
        self.symbols -> self.symbols + [symbol]
    }

    function lookup(name: String) {
        let i -> 0
        // let len -> typeof(self.symbols) // Unused and causes runtime error
        
        // ZenLang for loop support for lists
        for sym in self.symbols {
            when sym.name = name {
                <- sym
            }
        }
        
        when self.parent_scope {
            <- self.parent_scope.lookup(name)
        }
        
        <- nothing
    }
}
