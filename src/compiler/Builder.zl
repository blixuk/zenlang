import `lib/zen/io` as IO
import `lib/zen/string` as Str
import `lib/zen/sys` as Sys
import `compiler/Lexer` as Lexer
import `compiler/Parser` as Parser
import `compiler/CTranspiler` as CTranspiler
import `compiler/Module/Resolver` as Resolver
import `compiler/Module/DependencyGraph` as DependencyGraph
from `compiler/AST` import ASTNode, ASTKind, ImportStatement
import `compiler/Token` as TokenModule

class Builder {
    let project_root: String
    let config: Map

    function init(project_root: String) {
        self.project_root -> project_root
        self.config -> {}
    }

    function find_zbuild() : String {
        let path: String -> self.project_root + `/.zbuild`
        when (IO.exists(path)) {
            <- path
        }
        <- ``
    }

    function parse_zbuild(path: String) : Boolean {
        let content: String -> IO.read_file(path)
        let lines: List -> Str.split(content, `\n`)
        
        for line_raw in lines {
            let line: String -> Str.trim(line_raw)
            when (line = `` or Str.starts_with(line, `#`)) {
                // Skip
            } or {
                let parts: List -> Str.split(line, `:`)
                when (parts.length >= 2) {
                    let key: String -> Str.trim(parts[0])
                    let val: String -> Str.trim(parts[1])
                    // Basic quote stripping
                    val -> Str.replace(val, `"`, ``)
                    val -> Str.replace(val, `'`, ``)
                    let cfg: Map -> self.config
                    cfg[key] -> val
                }
            }
        }
        <- True
    }

    function build_dependency_graph(path, resolver, graph, visited) {
        for v in visited {
            when (v = path) { <- nothing }
        }
        visited.append(path)
        graph.add_node(path)
        
        let src: String -> IO.read_file(path)
        let lex: Lexer -> Lexer.Lexer(src)
        let toks: List -> lex.tokenize()
        let par: Parser -> Parser.Parser(toks, path)
        let ast: List -> par.parse()
        
        for stmt in ast {
            let node: ASTNode -> stmt
            when (stmt.kind = ASTKind.IMPORT_STATEMENT) {
                 let resolved: String -> resolver.resolve(stmt.path.value)
                 when (resolved != ``) {
                     graph.add_edge(path, resolved)
                     self.build_dependency_graph(resolved, resolver, graph, visited)
                 }
            } or when (stmt.kind = ASTKind.FROM_IMPORT_STATEMENT) {
                 let resolved: String -> resolver.resolve(stmt.path.value)
                 when (resolved != ``) {
                     graph.add_edge(path, resolved)
                     self.build_dependency_graph(resolved, resolver, graph, visited)
                 }
            }
        }
    }

    function build() : Boolean {
        let zbuild_path: String -> self.find_zbuild()
        when (zbuild_path = ``) {
            IO.error(`Error: No .zbuild file found in ` + self.project_root + `\n`)
            <- False
        }

        self.parse_zbuild(zbuild_path)
        
        let name: String -> `unnamed`
        when (self.config.has(`name`)) { name -> self.config[`name`] }
        IO.write(`--- Building Project: ` + name + ` ---\n`)

        when (not self.config.has(`entry`)) {
            IO.error(`Error: .zbuild must specify an 'entry' point\n`)
            <- False
        }
        let entry_rel: String -> self.config[`entry`]
        let entry_abs: String -> self.project_root + `/` + entry_rel
        
        when (not IO.exists(entry_abs)) {
            IO.error(`Error: Entry point not found at ` + entry_abs + `\n`)
            <- False
        }

        let root_dir: String -> self.project_root
        let resolver: Resolver -> Resolver.Resolver([root_dir, root_dir + `/src` ])
        let graph: DependencyGraph -> DependencyGraph.DependencyGraph()
        
        IO.write(`  [1/4] Analyzing dependencies...\n`)
        self.build_dependency_graph(entry_abs, resolver, graph, [])
        let order: List -> graph.get_compilation_order()
        
        IO.write(`  [2/4] Transpiling modules...\n`)
        let generated_files: List -> []
        
        for module_path in order {
            IO.write(`    Transpiling: ` + module_path + `\n`)
            let src: String -> IO.read_file(module_path)
            let lex: Lexer -> Lexer.Lexer(src)
            let toks: List -> lex.tokenize()
            let par: Parser -> Parser.Parser(toks, module_path)
            let statements: List -> par.parse()
            
            let transpiler: CTranspiler.Transpiler -> CTranspiler.Transpiler(statements)
            
            // Collect classes from dependencies for this module
            // This is a bit inefficient (re-parsing), but works for now.
            for dep_path in order {
                when (dep_path != module_path) {
                    let dep_src: String -> IO.read_file(dep_path)
                    let dep_lex: Lexer -> Lexer.Lexer(dep_src)
                    let dep_toks: List -> dep_lex.tokenize()
                    let dep_par: Parser -> Parser.Parser(dep_toks, dep_path)
                    let dep_statements: List -> dep_par.parse()
                    transpiler.collect_classes(dep_statements)
                }
            }

            // Generate unique name for C file
            let out_base: String -> Str.replace(module_path, `/`, `_`)
            out_base -> Str.replace(out_base, `.zl`, ``)
            let c_path: String -> self.project_root + `/build/` + out_base + `.c`
            let h_path: String -> self.project_root + `/build/` + out_base + `.h`
            
            let guard_name: String -> Str.to_upper(out_base) + `_H`
            let include_name: String -> out_base + `.h`
            
            let h_code: String -> transpiler.transpile_header(guard_name)
            let c_code: String -> transpiler.transpile_source(include_name)
            
            IO.write_file(h_path, h_code)
            IO.write_file(c_path, c_code)
            generated_files.append(c_path)
        }

        IO.write(`  [3/4] Linking with GCC...\n`)
        let output_rel: String -> `bin/out`
        when (self.config.has(`output`)) { output_rel -> self.config[`output`] }
        let output_abs: String -> self.project_root + `/` + output_rel
        
        let gcc_cmd: String -> `gcc -o ` + output_abs + ` `
        for f in generated_files {
            gcc_cmd -> gcc_cmd + f + ` `
        }
        
        // Add runtime and includes
        gcc_cmd -> gcc_cmd + `-I` + self.project_root + `/runtime `
        gcc_cmd -> gcc_cmd + `-I` + self.project_root + `/build `
        
        // Link runtime (this needs to be smarter, maybe a precompiled lib)
        // For now, let's assume we link some core runtime files
        // gcc_cmd -> gcc_cmd + self.project_root + `/runtime/core.c ...`
        
        IO.write(`    Executing: ` + gcc_cmd + `\n`)
        let status: Integer -> Sys.exec(gcc_cmd)
        when (status != 0) {
            IO.error(`Error: GCC linking failed with status ` + Str.to_string(status) + `\n`)
            <- False
        }

        IO.write(`  [4/4] Build complete: ` + output_abs + `\n`)
        <- True
    }
}
