import `lib/zen/io` as IO
import `lib/zen/sys` as Sys
import `lib/zen/string` as Str
import `compiler/Builder` as Builder
import `compiler/Lexer` as Lexer
import `compiler/Parser` as Parser
import `compiler/CTranspiler` as CTranspiler
import `compiler/Module/Resolver` as Resolver
import `compiler/Module/DependencyGraph` as DependencyGraph
from `compiler/TestRunner` import TestRunner
from `compiler/AST` import ASTNode, ASTKind, ImportStatement
import `compiler/Token` as TokenModule

function get_dirname(path: String) : String {
    let parts: List -> Str.split(path, `/`)
    let len: Integer -> parts.length
    when (len <= 1) { <- `.` }
    
    let result: String -> ``
    let i: Integer -> 0
    while (i < len - 1) {
        let part: String -> parts[i]
        when (i > 0) { result -> result + `/` }
        result -> result + part
        i -> i + 1
    }
    
    when (Str.starts_with(path, `/`)) {
        result -> `/` + result
    }
    
    <- result
}

function build_dependency_graph(path, resolver, graph, visited) {
    for v in visited {
        when (v = path) { <- nothing }
    }
    visited.append(path)
    graph.add_node(path)
    
    let src: String -> IO.read_file(path)
    let lex: Lexer -> Lexer.Lexer(src)
    let toks: List -> lex.tokenize()
    let par: Parser -> Parser.Parser(toks, path)
    let ast: List -> par.parse()
    
    for stmt in ast {
        let node: ASTNode -> stmt
        when (stmt.kind = ASTKind.IMPORT_STATEMENT) {
             let resolved: String -> resolver.resolve(stmt.path.value)
             when (resolved != ``) {
                 graph.add_edge(path, resolved)
                 build_dependency_graph(resolved, resolver, graph, visited)
             }
        } or when (stmt.kind = ASTKind.FROM_IMPORT_STATEMENT) {
             let resolved: String -> resolver.resolve(stmt.path.value)
             when (resolved != ``) {
                 graph.add_edge(path, resolved)
                 build_dependency_graph(resolved, resolver, graph, visited)
             }
        }
    }
}

function main() {
    let args: List -> Sys.get_args()
    
    when args.length < 2 {
        IO.write(`Usage: zen <source_file> [output_file]\n`)
        IO.write(`       zen build [project_dir]\n`)
        IO.write(`       zen test [test_dir]\n`)
        Sys.exit(1)
    }

    let command: String -> args[1]
    
    when (command = `test`) {
        let test_dir: String -> `.`
        when (args.length > 2) {
             test_dir -> args[2]
        }
        let runner: TestRunner -> TestRunner.TestRunner()
        runner.run(test_dir)
        Sys.exit(0)
    }

    when (command = `build`) {
        let project_dir: String -> Sys.get_cwd()
        when (args.length > 2) {
             project_dir -> args[2]
        }
        let b: Builder.Builder -> Builder.Builder(project_dir)
        let success: Boolean -> b.build()
        when (success) {
            Sys.exit(0)
        } or {
            Sys.exit(1)
        }
    }

    let source_path: String -> command
    IO.write(`Compiling: ` + source_path + `\n`)

    let source: String -> IO.read_file(source_path)
    let root_path: String -> get_dirname(source_path)
    
    let resolver: Resolver -> Resolver.Resolver([root_path])
    let graph: DependencyGraph -> DependencyGraph.DependencyGraph()
    
    // Build graph to find classes in dependencies
    build_dependency_graph(source_path, resolver, graph, [])
    let order: List -> graph.get_compilation_order()
    
    // Parse ONLY the target file for transpilation
    let lex: Lexer -> Lexer.Lexer(source)
    let toks: List -> lex.tokenize()
    let par: Parser -> Parser.Parser(toks, source_path)
    let target_statements: List -> par.parse()
    
    let transpiler: CTranspiler.Transpiler -> CTranspiler.Transpiler(target_statements)
    
    // Pre-populate class names from dependencies to help method call resolution
    for module_path in order {
        when (module_path != source_path) {
            let dep_src: String -> IO.read_file(module_path)
            let dep_lex: Lexer -> Lexer.Lexer(dep_src)
            let dep_toks: List -> dep_lex.tokenize()
            let dep_par: Parser -> Parser.Parser(dep_toks, module_path)
            let dep_statements: List -> dep_par.parse()
            transpiler.collect_classes(dep_statements)
        }
    }
    
    let out_path: String -> `out.c`
    when args.length > 2 {
        out_path -> args[2]
    }
    
    // Calculate header path and guard name
    let header_path -> Str.replace(out_path, `.c`, `.h`)
    let parts: List -> Str.split(out_path, `/`)
    let filename: String -> parts[parts.length - 1]
    let base_name: String -> Str.replace(filename, `.c`, ``)
    let guard_name: String -> Str.to_upper(base_name) + `_H`
    let include_name: String -> Str.replace(filename, `.c`, `.h`)

    let header_code: String -> transpiler.transpile_header(guard_name)
    let source_code: String -> transpiler.transpile_source(include_name)
    
    IO.write_file(header_path, header_code)
    IO.write(`Header written to: ` + header_path + `\n`)
    
    IO.write_file(out_path, source_code)
    IO.write(`Source written to: ` + out_path + `\n`)
}
