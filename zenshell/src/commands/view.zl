/!
  zenshell - File Viewer & Inspector Command (view)
!/

import zen.io.file as file
import zen.util.table as utbl
import zen.text.string as Str
import ui.theme as color
import core.command as cmd_base

function handle_view_default(args, c) {
    when args == Nothing or args.length == 0 {
        <- color.yellow(`Usage: view <file_path>`)
    }
    let filepath -> args[0]
    when not __builtin_file.is_file(filepath) {
        <- color.red(`Error: File not found: ` + filepath)
    }

    let content -> __builtin_file.read(filepath)
    when content == Nothing {
        <- color.red(`Error: Unable to read ` + filepath)
    }

    let raw_lines -> Str.split(content, `\n`)
    let rows -> []
    let i -> 0
    let n -> raw_lines.length
    do while i < n {
        let l -> raw_lines[i]
        let line_num -> color.dim(Str.to_string(i + 1))
        rows.append([line_num, l])
        i -> i + 1
    }

    let headers -> [`#`, filepath]
    <- utbl.render_table(headers, rows, {`border_style` -> `rounded`})
}

function handle_view_head(args, c) {
    when args.length == 0 {
        <- color.yellow(`Usage: view head <file_path> [count=10]`)
    }
    let filepath -> args[0]
    let max_lines -> when (args.length > 1) { Integer(args[1]) } or { 10 }
    when max_lines == Nothing or max_lines < 1 { max_lines -> 10 }

    when not __builtin_file.is_file(filepath) {
        <- color.red(`Error: File not found: ` + filepath)
    }

    let content -> __builtin_file.read(filepath)
    let raw_lines -> Str.split(content, `\n`)
    let rows -> []
    let i -> 0
    let limit -> when (raw_lines.length < max_lines) { raw_lines.length } or { max_lines }
    do while i < limit {
        rows.append([color.dim(Str.to_string(i + 1)), raw_lines[i]])
        i -> i + 1
    }

    let headers -> [`#`, filepath + ` (head ` + Str.to_string(limit) + `)`]
    <- utbl.render_table(headers, rows, {`border_style` -> `rounded`})
}

function handle_view_tail(args, c) {
    when args.length == 0 {
        <- color.yellow(`Usage: view tail <file_path> [count=10]`)
    }
    let filepath -> args[0]
    let max_lines -> when (args.length > 1) { Integer(args[1]) } or { 10 }
    when max_lines == Nothing or max_lines < 1 { max_lines -> 10 }

    when not __builtin_file.is_file(filepath) {
        <- color.red(`Error: File not found: ` + filepath)
    }

    let content -> __builtin_file.read(filepath)
    let raw_lines -> Str.split(content, `\n`)
    let n -> raw_lines.length
    let start -> when (n > max_lines) { n - max_lines } or { 0 }
    let rows -> []
    let i -> start
    do while i < n {
        rows.append([color.dim(Str.to_string(i + 1)), raw_lines[i]])
        i -> i + 1
    }

    let headers -> [`#`, filepath + ` (tail ` + Str.to_string(n - start) + `)`]
    <- utbl.render_table(headers, rows, {`border_style` -> `rounded`})
}

function handle_view_linecount(args, c) {
    when args.length == 0 {
        <- color.yellow(`Usage: view linecount <file_path>`)
    }
    let filepath -> args[0]
    when not __builtin_file.is_file(filepath) {
        <- color.red(`Error: File not found: ` + filepath)
    }
    let content -> __builtin_file.read(filepath)
    let lines_count -> Str.split(content, `\n`).length
    let headers -> [`File`, `Line Count`]
    let rows -> [[color.cyan(filepath), color.green(Str.to_string(lines_count))]]
    <- utbl.render_table(headers, rows, {`border_style` -> `rounded`})
}

function handle_view_wordcount(args, c) {
    when args.length == 0 {
        <- color.yellow(`Usage: view wordcount <file_path>`)
    }
    let filepath -> args[0]
    when not __builtin_file.is_file(filepath) {
        <- color.red(`Error: File not found: ` + filepath)
    }
    let content -> __builtin_file.read(filepath)
    let words -> Str.split(content, ` `)
    let count -> 0
    do for w in words {
        when Str.trim(w) != `` {
            count -> count + 1
        }
    }
    let headers -> [`File`, `Word Count`]
    let rows -> [[color.cyan(filepath), color.green(Str.to_string(count))]]
    <- utbl.render_table(headers, rows, {`border_style` -> `rounded`})
}

export function create_view_command(ctx) {
    let cmd -> cmd_base.Command(`view`, `Inspect and view files in styled Unicode boxes`)
    cmd.set_default(handle_view_default)
    cmd.add_subcommand(`head`, `View the first N lines of a file (default 10)`, handle_view_head)
    cmd.add_subcommand(`tail`, `View the last N lines of a file (default 10)`, handle_view_tail)
    cmd.add_subcommand(`linecount`, `Count lines in a file`, handle_view_linecount)
    cmd.add_subcommand(`wordcount`, `Count words in a file`, handle_view_wordcount)
    <- cmd
}
