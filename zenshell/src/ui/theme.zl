/!
  zenshell - Terminal UI ANSI Styling & Colors
!/

export function red(s) { <- `\x1b[31m` + s + `\x1b[0m` }
export function green(s) { <- `\x1b[32m` + s + `\x1b[0m` }
export function yellow(s) { <- `\x1b[33m` + s + `\x1b[0m` }
export function blue(s) { <- `\x1b[34m` + s + `\x1b[0m` }
export function magenta(s) { <- `\x1b[35m` + s + `\x1b[0m` }
export function cyan(s) { <- `\x1b[36m` + s + `\x1b[0m` }
export function bold(s) { <- `\x1b[1m` + s + `\x1b[0m` }
export function dim(s) { <- `\x1b[2m` + s + `\x1b[0m` }
