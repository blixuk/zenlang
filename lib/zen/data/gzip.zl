/!
  zen.data.gzip - Pure Zenlang GZIP (RFC 1952) Compression and Decompression.

  Standard GZIP format container wrapping RFC 1951 DEFLATE payload with:
  - 10-byte standard header (Magic 0x1F 0x8B, CM 8, FLG, MTIME, XFL, OS)
  - Optional filename preservation (FNAME flag)
  - 8-byte trailer (CRC-32 checksum and uncompressed input size modulo 2^32)
  - 100% interoperable with GNU gzip, gunzip, zcat, and Python gzip module
!/

use zen.data.deflate as deflate_mod
use zen.crypto.crc32 as crc_mod
use zen.text.string as Str

function _to_byte_list(data) {
    when data == Nothing { <- [] }
    when data.kind == `String` {
        <- __builtin.string_to_bytes(data)
    }
    when data.kind == `List` or (data is List) {
        <- data
    }
    let b -> __builtin.string_to_bytes(data)
    when b.length > 0 { <- b }
    <- data
}

/!
  Compresses input data into RFC 1952 GZIP format.
  @param data String or byte list of data to compress.
  @param filename Optional original filename to record in the header.
  @param mtime Optional 32-bit Unix modification timestamp (default: 0).
  @param level Compression level (0..9, default: 6).
  @return List of bytes representing the complete .gz archive.
!/
export function compress(data, filename, mtime, level) {
    when filename == Nothing { filename -> `` }
    when mtime == Nothing { mtime -> 0 }
    when level == Nothing { level -> 6 }
    let uncompressed -> _to_byte_list(data)
    let isize -> uncompressed.length & 0xffffffff
    let crc -> crc_mod.crc32(uncompressed) & 0xffffffff

    let out -> []

    // 1. Magic bytes
    out.append(0x1f)
    out.append(0x8b)

    // 2. Compression Method (8 = DEFLATE)
    out.append(8)

    // 3. Flags: FNAME = 8 if filename provided
    let has_fname -> (filename != Nothing and filename != ``)
    let flg -> when has_fname { 8 } or { 0 }
    out.append(flg)

    // 4. MTIME (4 bytes little-endian)
    out.append(mtime & 255)
    out.append((mtime >> 8) & 255)
    out.append((mtime >> 16) & 255)
    out.append((mtime >> 24) & 255)

    // 5. Extra Flags (2 = maximum compression, 4 = fastest)
    let xfl -> when level >= 6 { 2 } or { 4 }
    out.append(xfl)

    // 6. Operating System (3 = Unix)
    out.append(3)

    // 7. Optional Filename (null-terminated ISO-8859-1 / ASCII)
    when has_fname {
        let fn_bytes -> __builtin.string_to_bytes(filename)
        let i -> 0
        let fn_len -> fn_bytes.length
        do while i < fn_len {
            out.append(fn_bytes[i] & 255)
            i -> i + 1
        }
        out.append(0) // Null terminator
    }

    // 8. Compressed DEFLATE payload
    let payload -> deflate_mod.deflate(uncompressed, level)
    let p_len -> payload.length
    let j -> 0
    do while j < p_len {
        out.append(payload[j] & 255)
        j -> j + 1
    }

    // 9. Trailer: CRC-32 (4 bytes little-endian)
    out.append(crc & 255)
    out.append((crc >> 8) & 255)
    out.append((crc >> 16) & 255)
    out.append((crc >> 24) & 255)

    // 10. Trailer: ISIZE (4 bytes little-endian)
    out.append(isize & 255)
    out.append((isize >> 8) & 255)
    out.append((isize >> 16) & 255)
    out.append((isize >> 24) & 255)

    <- out
}

/!
  Decompresses an RFC 1952 GZIP byte list or string.
  Validates GZIP magic, header flags, CRC-32 checksum, and ISIZE.
  @param gz_data GZIP-compressed byte list or string.
  @return List of uncompressed bytes, or raises error on corrupt archive.
!/
export function decompress(gz_data) {
    let bytes -> _to_byte_list(gz_data)
    let n -> bytes.length
    when n < 18 {
        // Minimum header (10) + trailer (8) = 18 bytes
        <- []
    }

    // Check Magic 0x1F 0x8B
    let id1 -> bytes[0] & 255
    let id2 -> bytes[1] & 255
    when id1 != 0x1f or id2 != 0x8b {
        <- [] // Invalid GZIP magic header
    }

    // Check Compression Method (8 = DEFLATE)
    let cm -> bytes[2] & 255
    when cm != 8 {
        <- [] // Unsupported compression method
    }

    let flg -> bytes[3] & 255
    let fextra -> (flg & 4) != 0
    let fname -> (flg & 8) != 0
    let fcomment -> (flg & 16) != 0
    let fhcrc -> (flg & 2) != 0

    let pos -> 10 // Start after base header

    // Skip FEXTRA if present
    when fextra {
        when pos + 2 > n { <- [] }
        let xlen -> (bytes[pos] & 255) | ((bytes[pos + 1] & 255) << 8)
        pos -> pos + 2 + xlen
    }

    // Skip FNAME if present
    when fname {
        do while pos < n and bytes[pos] != 0 {
            pos -> pos + 1
        }
        pos -> pos + 1 // skip null byte
    }

    // Skip FCOMMENT if present
    when fcomment {
        do while pos < n and bytes[pos] != 0 {
            pos -> pos + 1
        }
        pos -> pos + 1 // skip null byte
    }

    // Skip FHCRC if present
    when fhcrc {
        pos -> pos + 2
    }

    when pos >= n - 8 {
        <- [] // Corrupt or empty payload
    }

    // Payload is from pos to (n - 8)
    let payload_len -> (n - 8) - pos
    let payload -> bytes[pos:(n - 8)]

    // Decompress DEFLATE payload
    let decompressed -> deflate_mod.inflate(payload)

    // Validate Trailer: CRC-32 & ISIZE
    let t_crc -> (bytes[n - 8] & 255) |
                 ((bytes[n - 7] & 255) << 8) |
                 ((bytes[n - 6] & 255) << 16) |
                 ((bytes[n - 5] & 255) << 24)

    let t_isize -> (bytes[n - 4] & 255) |
                   ((bytes[n - 3] & 255) << 8) |
                   ((bytes[n - 2] & 255) << 16) |
                   ((bytes[n - 1] & 255) << 24)

    let actual_crc -> crc_mod.crc32(decompressed) & 0xffffffff
    let actual_isize -> decompressed.length & 0xffffffff

    when (actual_crc != (t_crc & 0xffffffff)) or (actual_isize != (t_isize & 0xffffffff)) {
        // CRC or size mismatch
        <- []
    }

    <- decompressed
}

/!
  Inspects a GZIP archive and returns metadata without decompressing the payload.
  @param gz_data GZIP byte list or string.
  @return Map containing header information:
          { valid, filename, mtime, os, xfl, crc32, isize, payload_bytes }
!/
export function inspect(gz_data) {
    let bytes -> _to_byte_list(gz_data)
    let n -> bytes.length
    when n < 18 {
        <- { `valid` -> false }
    }

    let id1 -> bytes[0] & 255
    let id2 -> bytes[1] & 255
    when id1 != 0x1f or id2 != 0x8b {
        <- { `valid` -> false }
    }

    let cm -> bytes[2] & 255
    let flg -> bytes[3] & 255
    let mtime -> (bytes[4] & 255) |
                 ((bytes[5] & 255) << 8) |
                 ((bytes[6] & 255) << 16) |
                 ((bytes[7] & 255) << 24)
    let xfl -> bytes[8] & 255
    let os -> bytes[9] & 255

    let fextra -> (flg & 4) != 0
    let fname -> (flg & 8) != 0
    let fcomment -> (flg & 16) != 0
    let fhcrc -> (flg & 2) != 0

    let pos -> 10
    when fextra {
        let xlen -> (bytes[pos] & 255) | ((bytes[pos + 1] & 255) << 8)
        pos -> pos + 2 + xlen
    }

    let parsed_filename -> Nothing
    when fname {
        let fn_bytes -> []
        do while pos < n and bytes[pos] != 0 {
            fn_bytes.append(bytes[pos])
            pos -> pos + 1
        }
        pos -> pos + 1
        parsed_filename -> __builtin.bytes_to_string(fn_bytes)
    }

    when fcomment {
        do while pos < n and bytes[pos] != 0 {
            pos -> pos + 1
        }
        pos -> pos + 1
    }

    when fhcrc {
        pos -> pos + 2
    }

    let t_crc -> (bytes[n - 8] & 255) |
                 ((bytes[n - 7] & 255) << 8) |
                 ((bytes[n - 6] & 255) << 16) |
                 ((bytes[n - 5] & 255) << 24)

    let t_isize -> (bytes[n - 4] & 255) |
                   ((bytes[n - 3] & 255) << 8) |
                   ((bytes[n - 2] & 255) << 16) |
                   ((bytes[n - 1] & 255) << 24)

    <- {
        `valid`         -> true,
        `cm`            -> cm,
        `filename`      -> parsed_filename,
        `mtime`         -> mtime,
        `xfl`           -> xfl,
        `os`            -> os,
        `crc32`         -> t_crc & 0xffffffff,
        `isize`         -> t_isize & 0xffffffff,
        `payload_bytes` -> (n - 8) - pos
    }
}

/!
  Compresses a UTF-8 string into GZIP format.
  @param text String to compress.
  @param filename Optional filename.
  @return List of bytes.
!/
export function compress_string(text, filename) {
    when filename == Nothing { filename -> `` }
    <- compress(text, filename, 0, 6)
}

/!
  Decompresses a GZIP byte list into a UTF-8 string.
  @param gz_data GZIP byte list or string.
  @return Decompressed UTF-8 string.
!/
export function decompress_to_string(gz_data) {
    let uncompressed_bytes -> decompress(gz_data)
    <- __builtin.bytes_to_string(uncompressed_bytes)
}
