/!
 JSON module.
 Provides functions for serializing and deserializing JSON data in pure Zenlang.
 !/

import zen.text.string as Str

/!
 Converts a Zenlang object to a JSON string.
 @param value The object to stringify.
 @return The JSON string representation.
 !/
function stringify(value) {
    when value is String {
        let res -> `"`
        let i -> 0
        do while i < value.length {
            let c -> value.at(i)
            when c == `"` { res -> res + `\\"` }
            or when c == `\\` { res -> res + `\\\\` }
            or when c == `\n` { res -> res + `\\n` }
            or when c == `\t` { res -> res + `\\t` }
            or when c == `\r` { res -> res + `\\r` }
            or { res -> res + c }
            i -> i + 1
        }
        <- res + `"`
    } or when value is Integer or value is Decimal {
        <- Str.to_string(value)
    } or when value is Boolean {
        when value { <- `true` }
        <- `false`
    } or when value is Nothing {
        <- `null`
    } or when value is List {
        let res -> `[`
        let first -> True
        do for item in value {
            when not first { res -> res + `,` }
            res -> res + stringify(item)
            first -> False
        }
        <- res + `]`
    } or when value is Map {
        let res -> `{`
        let first -> True
        let k_list -> __builtin_map.keys(value)
        do for k in k_list {
            when not first { res -> res + `,` }
            res -> res + stringify(Str.to_string(k)) + `:` + stringify(value[k])
            first -> False
        }
        <- res + `}`
    }
    <- `null`
}

function _make_indent(depth, spaces) {
    let res -> ``
    let total -> depth * spaces
    let i -> 0
    do while i < total {
        res -> res + ` `
        i -> i + 1
    }
    <- res
}

function _stringify_indent(value, depth, spaces) {
    when value is String {
        <- stringify(value)
    } or when value is Integer or value is Decimal {
        <- Str.to_string(value)
    } or when value is Boolean {
        when value { <- `true` }
        <- `false`
    } or when value is Nothing {
        <- `null`
    } or when value is List {
        when value.length == 0 {
            <- `[]`
        }
        let ind -> _make_indent(depth + 1, spaces)
        let outer_ind -> _make_indent(depth, spaces)
        let res -> `[\n`
        let first -> True
        do for item in value {
            when not first {
                res -> res + `,\n`
            }
            res -> res + ind + _stringify_indent(item, depth + 1, spaces)
            first -> False
        }
        <- res + `\n` + outer_ind + `]`
    } or when value is Map {
        let k_list -> __builtin_map.keys(value)
        when k_list.length == 0 {
            <- `{}`
        }
        let ind -> _make_indent(depth + 1, spaces)
        let outer_ind -> _make_indent(depth, spaces)
        let res -> `{\n`
        let first -> True
        do for k in k_list {
            when not first {
                res -> res + `,\n`
            }
            res -> res + ind + stringify(Str.to_string(k)) + `: ` + _stringify_indent(value[k], depth + 1, spaces)
            first -> False
        }
        <- res + `\n` + outer_ind + `}`
    }
    <- `null`
}

/!
  Converts a Zenlang object to a formatted, indented JSON string.
  @param value The object to stringify.
  @param indent_spaces Number of spaces per indentation level (default 2).
  @return The formatted JSON string representation.
!/
function stringify_pretty(value, indent_spaces) {
    let spaces -> indent_spaces
    when spaces == Nothing or spaces <= 0 {
        spaces -> 2
    }
    <- _stringify_indent(value, 0, spaces)
}

/!
 Internal JSON Parser.
 !/
class JsonParser {
    let _str
    let _pos

    function init(json_str) {
        self._str -> json_str
        self._pos -> 0
    }

    function skip_ws() {
        do while self._pos < self._str.length {
            let c -> self._str.at(self._pos)
            when c == ` ` or c == `\n` or c == `\t` or c == `\r` {
                self._pos -> self._pos + 1
            } or {
                break
            }
        }
    }

    function peek() {
        when self._pos < self._str.length {
            <- self._str.at(self._pos)
        }
        <- ``
    }

    function next() {
        let c -> self.peek()
        self._pos -> self._pos + 1
        <- c
    }

    function parse_value() {
        self.skip_ws()
        let c -> self.peek()
        
        when c == `{` { <- self.parse_object() }
        when c == `[` { <- self.parse_array() }
        when c == `"` { <- self.parse_string() }
        when c == `t` or c == `f` { <- self.parse_bool() }
        when c == `n` { <- self.parse_null() }
        
        <- self.parse_number()
    }

    function parse_object() {
        self.next() // skip {
        let obj -> {}
        self.skip_ws()
        
        when self.peek() == `}` {
            self.next()
            <- obj
        }

        do while True {
            self.skip_ws()
            let key -> self.parse_string()
            self.skip_ws()
            
            when self.next() != `:` { raise `ExpectedColon` }
            
            let val -> self.parse_value()
            obj[key] -> val
            
            self.skip_ws()
            let sep -> self.next()
            when sep == `}` { break }
            when sep != `,` { raise `ExpectedCommaOrBrace` }
        }
        <- obj
    }

    function parse_array() {
        self.next() // skip [
        let arr -> []
        self.skip_ws()
        
        when self.peek() == `]` {
            self.next()
            <- arr
        }

        do while True {
            let val -> self.parse_value()
            arr.append(val)
            
            self.skip_ws()
            let sep -> self.next()
            when sep == `]` { break }
            when sep != `,` { raise `ExpectedCommaOrBracket` }
        }
        <- arr
    }

    function parse_string() {
        self.next() // skip "
        let res -> ``
        do while True {
            let c -> self.next()
            when c == `"` { break }
            when c == `` { raise `UnterminatedString` }
            // Simple escape handle
            when c == `\\` {
                let esc -> self.next()
                when esc == `"` { res -> res + `"` }
                or when esc == `\\` { res -> res + `\\` }
                or when esc == `n` { res -> res + `\n` }
                or when esc == `t` { res -> res + `\t` }
                or when esc == `r` { res -> res + `\r` }
                or { res -> res + esc }
            } or {
                res -> res + c
            }
        }
        <- res
    }

    function parse_bool() {
        let c -> self.peek()
        when c == `t` {
            self._pos -> self._pos + 4
            <- True
        } or {
            self._pos -> self._pos + 5
            <- False
        }
    }

    function parse_null() {
        self._pos -> self._pos + 4
        <- Nothing
    }

    function parse_number() {
        let start -> self._pos
        do while self._pos < self._str.length {
            let c -> self.peek()
            // Very simple number detection
            when (c >= `0` and c <= `9`) or c == `.` or c == `-` {
                self._pos -> self._pos + 1
            } or {
                break
            }
        }
        let num_str -> self._str.substring(start, self._pos)
        // Convert to number using builtin or string trick
        // Here we can use a built-in for string-to-number if needed
        <- num_str.to_number()
    }
}

/!
 Parses a JSON string into Zenlang types.
 @param json_str The JSON string to parse.
 @return The parsed Zenlang object.
 !/
function parse(json_str) {
    let p -> JsonParser(json_str)
    <- p.parse_value()
}
