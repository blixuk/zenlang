/!
  zen.crypto.poly1305 - Poly1305 One-Time Authenticator (RFC 8439).
  High-speed message authentication code generating 16-byte authentication tags.
  Uses 5 limbs of 26-bit arithmetic modulo 2^130 - 5 with 64-bit integer headroom.
  Fully compatible with both the AST interpreter and native AOT compiler (-g).
!/

use zen.crypto.hex as Hex
use zen.text.string as Str

function _to_bytes(data) {
    when (data == Nothing) { <- [] }
    when (data.kind == `String`) {
        <- __builtin.string_to_bytes(data)
    }
    when (data.kind != Nothing) {
        <- data
    }
    let b -> __builtin.string_to_bytes(data)
    when (b.length > 0) { <- b }
    <- data
}

/!
  Computes Poly1305 authentication tag over message using 32-byte key.
  @param key 32-byte secret key (string or byte list).
  @param message Message to authenticate (string or byte list).
  @return 16-byte list containing the authentication tag.
!/
export function mac(key, message) {
    let k_bytes -> _to_bytes(key)
    let msg_bytes -> _to_bytes(message)

    when (k_bytes.length < 32) {
        raise `Poly1305 error: key must be at least 32 bytes`
    }

    // Clamp r (first 16 bytes)
    let r -> []
    let i -> 0
    do while i < 16 {
        r.append(k_bytes[i])
        i -> i + 1
    }
    r[3] -> r[3] & 15
    r[7] -> r[7] & 15
    r[11] -> r[11] & 15
    r[15] -> r[15] & 15
    r[4] -> r[4] & 252
    r[8] -> r[8] & 252
    r[12] -> r[12] & 252

    let t0 -> r[0] | (r[1] << 8) | (r[2] << 16) | (r[3] << 24)
    let t1 -> r[4] | (r[5] << 8) | (r[6] << 16) | (r[7] << 24)
    let t2 -> r[8] | (r[9] << 8) | (r[10] << 16) | (r[11] << 24)
    let t3 -> r[12] | (r[13] << 8) | (r[14] << 16) | (r[15] << 24)

    let r0 -> t0 & 0x3ffffff
    let r1 -> ((t0 >> 26) | (t1 << 6)) & 0x3ffffff
    let r2 -> ((t1 >> 20) | (t2 << 12)) & 0x3ffffff
    let r3 -> ((t2 >> 14) | (t3 << 18)) & 0x3ffffff
    let r4 -> (t3 >> 8) & 0x3ffffff

    let s1 -> r1 * 5
    let s2 -> r2 * 5
    let s3 -> r3 * 5
    let s4 -> r4 * 5

    let h0 -> 0
    let h1 -> 0
    let h2 -> 0
    let h3 -> 0
    let h4 -> 0

    let msg_len -> msg_bytes.length
    let idx -> 0

    do while idx < msg_len {
        let chunk_len -> 16
        when (idx + chunk_len > msg_len) {
            chunk_len -> msg_len - idx
        }

        // Pad block up to 17 bytes with 0x01 terminator
        let p -> []
        let ci -> 0
        do while ci < chunk_len {
            p.append(msg_bytes[idx + ci])
            ci -> ci + 1
        }
        p.append(1)
        do while p.length < 17 {
            p.append(0)
        }

        let mt0 -> p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24)
        let mt1 -> p[4] | (p[5] << 8) | (p[6] << 16) | (p[7] << 24)
        let mt2 -> p[8] | (p[9] << 8) | (p[10] << 16) | (p[11] << 24)
        let mt3 -> p[12] | (p[13] << 8) | (p[14] << 16) | (p[15] << 24)
        let mt4 -> p[16]

        let m0 -> mt0 & 0x3ffffff
        let m1 -> ((mt0 >> 26) | (mt1 << 6)) & 0x3ffffff
        let m2 -> ((mt1 >> 20) | (mt2 << 12)) & 0x3ffffff
        let m3 -> ((mt2 >> 14) | (mt3 << 18)) & 0x3ffffff
        let m4 -> ((mt3 >> 8) | (mt4 << 24)) & 0x3ffffff

        h0 -> h0 + m0
        h1 -> h1 + m1
        h2 -> h2 + m2
        h3 -> h3 + m3
        h4 -> h4 + m4

        let d0 -> (h0 * r0) + (h1 * s4) + (h2 * s3) + (h3 * s2) + (h4 * s1)
        let d1 -> (h0 * r1) + (h1 * r0) + (h2 * s4) + (h3 * s3) + (h4 * s2)
        let d2 -> (h0 * r2) + (h1 * r1) + (h2 * r0) + (h3 * s4) + (h4 * s3)
        let d3 -> (h0 * r3) + (h1 * r2) + (h2 * r1) + (h3 * r0) + (h4 * s4)
        let d4 -> (h0 * r4) + (h1 * r3) + (h2 * r2) + (h3 * r1) + (h4 * r0)

        let c -> d0 >> 26
        h0 -> d0 & 0x3ffffff
        d1 -> d1 + c

        c -> d1 >> 26
        h1 -> d1 & 0x3ffffff
        d2 -> d2 + c

        c -> d2 >> 26
        h2 -> d2 & 0x3ffffff
        d3 -> d3 + c

        c -> d3 >> 26
        h3 -> d3 & 0x3ffffff
        d4 -> d4 + c

        c -> d4 >> 26
        h4 -> d4 & 0x3ffffff
        h0 -> h0 + (c * 5)

        c -> h0 >> 26
        h0 -> h0 & 0x3ffffff
        h1 -> h1 + c

        idx -> idx + 16
    }

    // Final carry propagation
    let fc -> h1 >> 26
    h1 -> h1 & 0x3ffffff
    h2 -> h2 + fc

    fc -> h2 >> 26
    h2 -> h2 & 0x3ffffff
    h3 -> h3 + fc

    fc -> h3 >> 26
    h3 -> h3 & 0x3ffffff
    h4 -> h4 + fc

    fc -> h4 >> 26
    h4 -> h4 & 0x3ffffff
    h0 -> h0 + (fc * 5)

    fc -> h0 >> 26
    h0 -> h0 & 0x3ffffff
    h1 -> h1 + fc

    // Compute h - p (where p = 2^130 - 5)
    let g0 -> h0 + 5
    let gc -> g0 >> 26
    g0 -> g0 & 0x3ffffff

    let g1 -> h1 + gc
    gc -> g1 >> 26
    g1 -> g1 & 0x3ffffff

    let g2 -> h2 + gc
    gc -> g2 >> 26
    g2 -> g2 & 0x3ffffff

    let g3 -> h3 + gc
    gc -> g3 >> 26
    g3 -> g3 & 0x3ffffff

    let g4 -> h4 + gc - 0x4000000

    when (g4 >= 0) {
        h0 -> g0
        h1 -> g1
        h2 -> g2
        h3 -> g3
        h4 -> g4 & 0x3ffffff
    }

    // Repack limbs into four 32-bit words
    let w0 -> (h0 | (h1 << 26)) & 0xffffffff
    let w1 -> ((h1 >> 6) | (h2 << 20)) & 0xffffffff
    let w2 -> ((h2 >> 12) | (h3 << 14)) & 0xffffffff
    let w3 -> ((h3 >> 18) | (h4 << 8)) & 0xffffffff

    // Add s (bytes 16..31 of key)
    let s0 -> k_bytes[16] | (k_bytes[17] << 8) | (k_bytes[18] << 16) | (k_bytes[19] << 24)
    let s1_val -> k_bytes[20] | (k_bytes[21] << 8) | (k_bytes[22] << 16) | (k_bytes[23] << 24)
    let s2_val -> k_bytes[24] | (k_bytes[25] << 8) | (k_bytes[26] << 16) | (k_bytes[27] << 24)
    let s3_val -> k_bytes[28] | (k_bytes[29] << 8) | (k_bytes[30] << 16) | (k_bytes[31] << 24)

    let sum0 -> w0 + s0
    let f0 -> sum0 & 0xffffffff
    let carry -> sum0 >> 32

    let sum1 -> w1 + s1_val + carry
    let f1 -> sum1 & 0xffffffff
    carry -> sum1 >> 32

    let sum2 -> w2 + s2_val + carry
    let f2 -> sum2 & 0xffffffff
    carry -> sum2 >> 32

    let sum3 -> w3 + s3_val + carry
    let f3 -> sum3 & 0xffffffff

    // Emit 16 bytes little-endian
    let tag -> []
    tag.append(f0 & 255)
    tag.append((f0 >> 8) & 255)
    tag.append((f0 >> 16) & 255)
    tag.append((f0 >> 24) & 255)

    tag.append(f1 & 255)
    tag.append((f1 >> 8) & 255)
    tag.append((f1 >> 16) & 255)
    tag.append((f1 >> 24) & 255)

    tag.append(f2 & 255)
    tag.append((f2 >> 8) & 255)
    tag.append((f2 >> 16) & 255)
    tag.append((f2 >> 24) & 255)

    tag.append(f3 & 255)
    tag.append((f3 >> 8) & 255)
    tag.append((f3 >> 16) & 255)
    tag.append((f3 >> 24) & 255)

    <- tag
}

/!
  Computes Poly1305 MAC tag and returns a 32-character lowercase hex string.
!/
export function mac_hex(key, message) {
    let tag -> mac(key, message)
    <- Hex.encode(tag)
}

/!
  Verifies that a message matches an expected Poly1305 MAC tag in constant time.
  @param key 32-byte secret key.
  @param message Authenticated message.
  @param expected_tag Expected 16-byte tag (byte list or hex string).
  @return Boolean true if valid, false otherwise.
!/
export function verify(key, message, expected_tag) {
    let computed -> mac(key, message)
    let expected -> []
    when (expected_tag.kind == `String`) {
        expected -> Hex.decode_bytes(expected_tag)
    } or {
        expected -> expected_tag
    }

    when (computed.length != expected.length) { <- false }

    let diff -> 0
    let i -> 0
    let len -> computed.length
    do while i < len {
        diff -> diff | (computed[i] ^^ expected[i])
        i -> i + 1
    }
    <- diff == 0
}
