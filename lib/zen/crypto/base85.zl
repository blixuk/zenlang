/!
    zen.crypto.base85 - Ascii85 (Adobe) and ZeroMQ Z85 (RFC 1924) Encoding / Decoding.
    High-density binary-to-text encoding (4 bytes into 5 characters, 25% overhead).
    Pure Zenlang implementation compatible with both interpreter and native backend.
!/

use zen.text.string as Str

function _to_byte_list(data) {
    when data == Nothing { <- [] }
    when data.kind == `String` {
        <- __builtin.string_to_bytes(data)
    }
    when data.kind != Nothing {
        <- data
    }
    let b -> __builtin.string_to_bytes(data)
    when b.length > 0 { <- b }
    <- data
}

/!
    Encodes binary data or string into standard Ascii85 (Adobe) format.
    Features 'z' compression for four consecutive zero bytes.
    @param data String or byte list.
    @return Ascii85 encoded string.
!/
export function encode(data) {
    let bytes -> _to_byte_list(data)
    let length -> bytes.length
    when length == 0 { <- `` }

    let out -> ``
    let i -> 0

    do while i < length {
        let chunk_len -> length - i
        when chunk_len >= 4 {
            let b0 -> bytes[i]
            let b1 -> bytes[i + 1]
            let b2 -> bytes[i + 2]
            let b3 -> bytes[i + 3]

            when b0 < 0 { b0 -> b0 + 256 }
            when b1 < 0 { b1 -> b1 + 256 }
            when b2 < 0 { b2 -> b2 + 256 }
            when b3 < 0 { b3 -> b3 + 256 }

            let n -> ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xffffffff
            when n == 0 {
                out -> out + `z`
            } or {
                let c4 -> n % 85
                n -> (n - c4) / 85
                let c3 -> n % 85
                n -> (n - c3) / 85
                let c2 -> n % 85
                n -> (n - c2) / 85
                let c1 -> n % 85
                let c0 -> (n - c1) / 85

                let ch0 -> __builtin.bytes_to_string([c0 + 33])
                let ch1 -> __builtin.bytes_to_string([c1 + 33])
                let ch2 -> __builtin.bytes_to_string([c2 + 33])
                let ch3 -> __builtin.bytes_to_string([c3 + 33])
                let ch4 -> __builtin.bytes_to_string([c4 + 33])
                out -> out + ch0 + ch1 + ch2 + ch3 + ch4
            }
            i -> i + 4
        } or {
            let b0 -> bytes[i]
            let b1 -> when chunk_len > 1 { bytes[i + 1] } or { 0 }
            let b2 -> when chunk_len > 2 { bytes[i + 2] } or { 0 }
            let b3 -> 0

            when b0 < 0 { b0 -> b0 + 256 }
            when b1 < 0 { b1 -> b1 + 256 }
            when b2 < 0 { b2 -> b2 + 256 }

            let n -> ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xffffffff
            let c4 -> n % 85
            n -> (n - c4) / 85
            let c3 -> n % 85
            n -> (n - c3) / 85
            let c2 -> n % 85
            n -> (n - c2) / 85
            let c1 -> n % 85
            let c0 -> (n - c1) / 85

            let chars -> []
            chars.append(c0 + 33)
            chars.append(c1 + 33)
            chars.append(c2 + 33)
            chars.append(c3 + 33)
            chars.append(c4 + 33)

            let take -> chunk_len + 1
            let k -> 0
            do while k < take {
                out -> out + __builtin.bytes_to_string([chars[k]])
                k -> k + 1
            }
            i -> i + chunk_len
        }
    }

    <- out
}

/!
    Encodes binary data or string into Ascii85 wrapped in '<~' and '~>' delimiters.
    @param data String or byte list.
    @return Wrapped Ascii85 string.
!/
export function encode_wrapped(data) {
    <- `<~` + encode(data) + `~>`
}

/!
    Decodes an Ascii85 string into a list of byte integers (0-255).
    Handles optional '<~' and '~>' delimiters, ignores whitespace, and supports 'z' shorthand.
    @param str Ascii85 string.
    @return List of byte integers.
!/
export function decode_bytes(str) {
    let raw -> Str.trim(str)
    when Str.starts_with(raw, `<~`) and Str.ends_with(raw, `~>`) {
        raw -> Str.substring(raw, 2, Str.length(raw) - 2)
        raw -> Str.trim(raw)
    }

    let clean -> ``
    let raw_len -> Str.length(raw)
    let idx -> 0
    do while idx < raw_len {
        let ch -> Str.at(raw, idx)
        when ch != ` ` and ch != `\n` and ch != `\r` and ch != `\t` {
            clean -> clean + ch
        }
        idx -> idx + 1
    }

    let length -> Str.length(clean)
    when length == 0 { <- [] }

    let bytes -> []
    let i -> 0

    do while i < length {
        let c -> Str.at(clean, i)
        when c == `z` {
            bytes.append(0)
            bytes.append(0)
            bytes.append(0)
            bytes.append(0)
            i -> i + 1
        } or {
            let rem -> length - i
            let chunk_len -> when rem > 5 { 5 } or { rem }

            when chunk_len == 5 {
                let n -> 0
                let j -> 0
                do while j < 5 {
                    let ch -> Str.at(clean, i + j)
                    let code -> __builtin.string_to_bytes(ch)[0]
                    when code < 0 { code -> code + 256 }
                    let val -> code - 33
                    when val < 0 or val >= 85 {
                        raise `Ascii85 decode failed: Invalid character "` + ch + `"`
                    }
                    n -> ((n * 85) + val) & 0xffffffff
                    j -> j + 1
                }

                bytes.append((n >> 24) & 255)
                bytes.append((n >> 16) & 255)
                bytes.append((n >> 8) & 255)
                bytes.append(n & 255)
                i -> i + 5
            } or {
                // Partial block (2 to 4 characters)
                when chunk_len == 1 {
                    raise `Ascii85 decode failed: Truncated single character block`
                }

                let n -> 0
                let j -> 0
                do while j < chunk_len {
                    let ch -> Str.at(clean, i + j)
                    let code -> __builtin.string_to_bytes(ch)[0]
                    when code < 0 { code -> code + 256 }
                    let val -> code - 33
                    when val < 0 or val >= 85 {
                        raise `Ascii85 decode failed: Invalid character "` + ch + `"`
                    }
                    n -> ((n * 85) + val) & 0xffffffff
                    j -> j + 1
                }

                // Pad with value 84 ('u') for missing characters
                do while j < 5 {
                    n -> ((n * 85) + 84) & 0xffffffff
                    j -> j + 1
                }

                let take -> chunk_len - 1
                when take >= 1 { bytes.append((n >> 24) & 255) }
                when take >= 2 { bytes.append((n >> 16) & 255) }
                when take >= 3 { bytes.append((n >> 8) & 255) }

                i -> i + chunk_len
            }
        }
    }

    <- bytes
}

/!
    Decodes an Ascii85 string into the original text string.
    @param str Ascii85 string.
    @return Decoded string.
!/
export function decode(str) {
    let bytes -> decode_bytes(str)
    <- __builtin.bytes_to_string(bytes)
}

/!
    Encodes binary data or string into ZeroMQ Z85 format.
    Requires input length to be a multiple of 4 bytes (or pads with zeroes).
    @param data String or byte list.
    @return Z85 encoded string.
!/
export function encode_z85(data) {
    let bytes -> _to_byte_list(data)
    let length -> bytes.length
    when length == 0 { <- `` }

    let alpha -> `0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#`
    let out -> ``
    let i -> 0

    do while i < length {
        let b0 -> bytes[i]
        let b1 -> when i + 1 < length { bytes[i + 1] } or { 0 }
        let b2 -> when i + 2 < length { bytes[i + 2] } or { 0 }
        let b3 -> when i + 3 < length { bytes[i + 3] } or { 0 }

        when b0 < 0 { b0 -> b0 + 256 }
        when b1 < 0 { b1 -> b1 + 256 }
        when b2 < 0 { b2 -> b2 + 256 }
        when b3 < 0 { b3 -> b3 + 256 }

        let n -> ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xffffffff
        let c4 -> n % 85
        n -> (n - c4) / 85
        let c3 -> n % 85
        n -> (n - c3) / 85
        let c2 -> n % 85
        n -> (n - c2) / 85
        let c1 -> n % 85
        let c0 -> (n - c1) / 85

        out -> out + Str.at(alpha, c0) + Str.at(alpha, c1) + Str.at(alpha, c2) + Str.at(alpha, c3) + Str.at(alpha, c4)
        i -> i + 4
    }

    <- out
}

/!
    Decodes a ZeroMQ Z85 string into a list of byte integers (0-255).
    @param str Z85 string.
    @return List of byte integers.
!/
export function decode_z85_bytes(str) {
    let clean -> Str.trim(str)
    let length -> Str.length(clean)
    when length == 0 { <- [] }
    when (length % 5) != 0 {
        raise `Z85 decode failed: String length must be a multiple of 5`
    }

    let alpha -> `0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#`
    let bytes -> []
    let i -> 0

    do while i < length {
        let n -> 0
        let j -> 0
        do while j < 5 {
            let ch -> Str.at(clean, i + j)
            let val -> Str.index_of(alpha, ch)
            when val == -1 {
                raise `Z85 decode failed: Invalid character "` + ch + `"`
            }
            n -> ((n * 85) + val) & 0xffffffff
            j -> j + 1
        }

        bytes.append((n >> 24) & 255)
        bytes.append((n >> 16) & 255)
        bytes.append((n >> 8) & 255)
        bytes.append(n & 255)
        i -> i + 5
    }

    <- bytes
}

/!
    Decodes a ZeroMQ Z85 string into the original text string.
    @param str Z85 string.
    @return Decoded string.
!/
export function decode_z85(str) {
    let bytes -> decode_z85_bytes(str)
    <- __builtin.bytes_to_string(bytes)
}
