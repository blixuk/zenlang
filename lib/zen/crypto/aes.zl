/!
  zen.crypto.aes - Advanced Encryption Standard (AES-128 / FIPS 197).
  Pure Zenlang implementation of AES-128 (Rijndael) block cipher.
  Provides key expansion, block encrypt/decrypt, PKCS#7 padding, and CBC mode.
  Fully compatible with both the AST interpreter and native AOT compiler (-g).
!/

use zen.crypto.padding as Padding
use zen.crypto.hex as Hex
use zen.text.string as Str

function _to_bytes(data) {
    when (data == Nothing) { <- [] }
    when (data.kind == `String`) {
        <- __builtin.string_to_bytes(data)
    }
    when (data.kind != Nothing) {
        <- data
    }
    let b -> __builtin.string_to_bytes(data)
    when (b.length > 0) { <- b }
    <- data
}

function _get_sbox() {
    <- [
        0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
        0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
        0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
        0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
        0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
        0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
        0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
        0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
        0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
        0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
        0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
        0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
        0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
        0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
        0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
        0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
    ]
}

function _get_inv_sbox(sbox) {
    let inv -> []
    let i -> 0
    do while i < 256 {
        inv.append(0)
        i -> i + 1
    }
    i -> 0
    do while i < 256 {
        inv[sbox[i]] -> i
        i -> i + 1
    }
    <- inv
}

function _xtime(b) {
    let val -> (b << 1) & 0xff
    when (b & 0x80) != 0 {
        val -> val ^^ 0x1b
    }
    <- val
}

function _mul(a, b) {
    let p -> 0
    let aa -> a & 0xff
    let bb -> b & 0xff
    let i -> 0
    do while i < 8 {
        when (bb & 1) != 0 {
            p -> p ^^ aa
        }
        let hi -> aa & 0x80
        aa -> (aa << 1) & 0xff
        when hi != 0 {
            aa -> aa ^^ 0x1b
        }
        bb -> bb >> 1
        i -> i + 1
    }
    <- p
}

/!
  Expands a 16-byte key into 11 round keys (176 bytes) for AES-128.
  @param key 16-byte secret key (string or byte list).
  @return 176-byte round key list.
!/
export function expand_key(key) {
    let k_bytes -> _to_bytes(key)
    let sbox -> _get_sbox()
    let rcon -> [0, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]

    let w -> []
    let i -> 0
    do while i < 16 {
        when i < k_bytes.length {
            w.append(k_bytes[i])
        } or {
            w.append(0)
        }
        i -> i + 1
    }

    let word_idx -> 4
    do while word_idx < 44 {
        let prev_off -> (word_idx - 1) * 4
        let t0 -> w[prev_off]
        let t1 -> w[prev_off + 1]
        let t2 -> w[prev_off + 2]
        let t3 -> w[prev_off + 3]

        when (word_idx % 4) == 0 {
            // RotWord: t0, t1, t2, t3 -> t1, t2, t3, t0
            let tmp -> t0
            t0 -> sbox[t1] ^^ rcon[word_idx / 4]
            t1 -> sbox[t2]
            t2 -> sbox[t3]
            t3 -> sbox[tmp]
        }

        let base_off -> (word_idx - 4) * 4
        w.append(w[base_off] ^^ t0)
        w.append(w[base_off + 1] ^^ t1)
        w.append(w[base_off + 2] ^^ t2)
        w.append(w[base_off + 3] ^^ t3)

        word_idx -> word_idx + 1
    }

    <- w
}

/!
  Encrypts a single 16-byte block using AES-128.
  @param round_keys 176-byte expanded round keys.
  @param block 16-byte plaintext block.
  @return 16-byte encrypted block list.
!/
export function encrypt_block(round_keys, block) {
    let b_bytes -> _to_bytes(block)
    let sbox -> _get_sbox()

    let state -> []
    let i -> 0
    do while i < 16 {
        when i < b_bytes.length {
            state.append(b_bytes[i] ^^ round_keys[i])
        } or {
            state.append(round_keys[i])
        }
        i -> i + 1
    }

    // 9 Main Rounds
    let rnd -> 1
    do while rnd < 10 {
        // SubBytes
        i -> 0
        do while i < 16 {
            state[i] -> sbox[state[i]]
            i -> i + 1
        }

        // ShiftRows
        let s1 -> state[1]
        let s5 -> state[5]
        let s9 -> state[9]
        let s13 -> state[13]
        state[1] -> s5
        state[5] -> s9
        state[9] -> s13
        state[13] -> s1

        let s2 -> state[2]
        let s6 -> state[6]
        let s10 -> state[10]
        let s14 -> state[14]
        state[2] -> s10
        state[6] -> s14
        state[10] -> s2
        state[14] -> s6

        let s3 -> state[3]
        let s7 -> state[7]
        let s11 -> state[11]
        let s15 -> state[15]
        state[3] -> s15
        state[7] -> s3
        state[11] -> s7
        state[15] -> s11

        // MixColumns
        let c -> 0
        do while c < 4 {
            let col -> c * 4
            let a0 -> state[col]
            let a1 -> state[col + 1]
            let a2 -> state[col + 2]
            let a3 -> state[col + 3]

            let x0 -> _xtime(a0)
            let x1 -> _xtime(a1)
            let x2 -> _xtime(a2)
            let x3 -> _xtime(a3)

            state[col]     -> x0 ^^ (x1 ^^ a1) ^^ a2 ^^ a3
            state[col + 1] -> a0 ^^ x1 ^^ (x2 ^^ a2) ^^ a3
            state[col + 2] -> a0 ^^ a1 ^^ x2 ^^ (x3 ^^ a3)
            state[col + 3] -> (x0 ^^ a0) ^^ a1 ^^ a2 ^^ x3

            c -> c + 1
        }

        // AddRoundKey
        let rk_off -> rnd * 16
        i -> 0
        do while i < 16 {
            state[i] -> state[i] ^^ round_keys[rk_off + i]
            i -> i + 1
        }

        rnd -> rnd + 1
    }

    // Final Round (no MixColumns)
    i -> 0
    do while i < 16 {
        state[i] -> sbox[state[i]]
        i -> i + 1
    }

    let f1 -> state[1]
    let f5 -> state[5]
    let f9 -> state[9]
    let f13 -> state[13]
    state[1] -> f5
    state[5] -> f9
    state[9] -> f13
    state[13] -> f1

    let f2 -> state[2]
    let f6 -> state[6]
    let f10 -> state[10]
    let f14 -> state[14]
    state[2] -> f10
    state[6] -> f14
    state[10] -> f2
    state[14] -> f6

    let f3 -> state[3]
    let f7 -> state[7]
    let f11 -> state[11]
    let f15 -> state[15]
    state[3] -> f15
    state[7] -> f3
    state[11] -> f7
    state[15] -> f11

    i -> 0
    do while i < 16 {
        state[i] -> state[i] ^^ round_keys[160 + i]
        i -> i + 1
    }

    <- state
}

/!
  Decrypts a single 16-byte block using AES-128.
  @param round_keys 176-byte expanded round keys.
  @param block 16-byte ciphertext block.
  @return 16-byte decrypted block list.
!/
export function decrypt_block(round_keys, block) {
    let b_bytes -> _to_bytes(block)
    let sbox -> _get_sbox()
    let inv_sbox -> _get_inv_sbox(sbox)

    let state -> []
    let i -> 0
    do while i < 16 {
        when i < b_bytes.length {
            state.append(b_bytes[i] ^^ round_keys[160 + i])
        } or {
            state.append(round_keys[160 + i])
        }
        i -> i + 1
    }

    let rnd -> 9
    do while rnd > 0 {
        // InvShiftRows
        let s1 -> state[1]
        let s5 -> state[5]
        let s9 -> state[9]
        let s13 -> state[13]
        state[1] -> s13
        state[5] -> s1
        state[9] -> s5
        state[13] -> s9

        let s2 -> state[2]
        let s6 -> state[6]
        let s10 -> state[10]
        let s14 -> state[14]
        state[2] -> s10
        state[6] -> s14
        state[10] -> s2
        state[14] -> s6

        let s3 -> state[3]
        let s7 -> state[7]
        let s11 -> state[11]
        let s15 -> state[15]
        state[3] -> s7
        state[7] -> s11
        state[11] -> s15
        state[15] -> s3

        // InvSubBytes
        i -> 0
        do while i < 16 {
            state[i] -> inv_sbox[state[i]]
            i -> i + 1
        }

        // AddRoundKey
        let rk_off -> rnd * 16
        i -> 0
        do while i < 16 {
            state[i] -> state[i] ^^ round_keys[rk_off + i]
            i -> i + 1
        }

        // InvMixColumns
        let c -> 0
        do while c < 4 {
            let col -> c * 4
            let a0 -> state[col]
            let a1 -> state[col + 1]
            let a2 -> state[col + 2]
            let a3 -> state[col + 3]

            state[col]     -> _mul(a0, 14) ^^ _mul(a1, 11) ^^ _mul(a2, 13) ^^ _mul(a3, 9)
            state[col + 1] -> _mul(a0, 9)  ^^ _mul(a1, 14) ^^ _mul(a2, 11) ^^ _mul(a3, 13)
            state[col + 2] -> _mul(a0, 13) ^^ _mul(a1, 9)  ^^ _mul(a2, 14) ^^ _mul(a3, 11)
            state[col + 3] -> _mul(a0, 11) ^^ _mul(a1, 13) ^^ _mul(a2, 9)  ^^ _mul(a3, 14)

            c -> c + 1
        }

        rnd -> rnd - 1
    }

    // Final Round
    let f1 -> state[1]
    let f5 -> state[5]
    let f9 -> state[9]
    let f13 -> state[13]
    state[1] -> f13
    state[5] -> f1
    state[9] -> f5
    state[13] -> f9

    let f2 -> state[2]
    let f6 -> state[6]
    let f10 -> state[10]
    let f14 -> state[14]
    state[2] -> f10
    state[6] -> f14
    state[10] -> f2
    state[14] -> f6

    let f3 -> state[3]
    let f7 -> state[7]
    let f11 -> state[11]
    let f15 -> state[15]
    state[3] -> f7
    state[7] -> f11
    state[11] -> f15
    state[15] -> f3

    i -> 0
    do while i < 16 {
        state[i] -> inv_sbox[state[i]] ^^ round_keys[i]
        i -> i + 1
    }

    <- state
}

/!
  Encrypts data using AES-128 in CBC mode with PKCS#7 padding.
  @param key 16-byte key (string or byte list).
  @param iv 16-byte initialization vector (string or byte list).
  @param data Plaintext (string or byte list).
  @return List of encrypted ciphertext bytes.
!/
export function encrypt_cbc(key, iv, data) {
    let iv_bytes -> _to_bytes(iv)
    let iv16 -> []
    let i -> 0
    do while i < 16 {
        when i < iv_bytes.length {
            iv16.append(iv_bytes[i])
        } or {
            iv16.append(0)
        }
        i -> i + 1
    }

    let round_keys -> expand_key(key)
    let padded -> Padding.pad(data, 16)
    let ct -> []
    let prev -> iv16
    let offset -> 0
    let len -> padded.length

    do while offset < len {
        let block -> []
        i -> 0
        do while i < 16 {
            block.append(padded[offset + i] ^^ prev[i])
            i -> i + 1
        }

        let enc_block -> encrypt_block(round_keys, block)
        i -> 0
        do while i < 16 {
            ct.append(enc_block[i])
            i -> i + 1
        }
        prev -> enc_block
        offset -> offset + 16
    }

    <- ct
}

/!
  Decrypts AES-128 CBC ciphertext and removes PKCS#7 padding.
  @param key 16-byte key.
  @param iv 16-byte initialization vector.
  @param ciphertext Encrypted byte list or hex string.
  @return Decrypted byte list, or Nothing if padding is invalid.
!/
export function decrypt_cbc(key, iv, ciphertext) {
    let iv_bytes -> _to_bytes(iv)
    let iv16 -> []
    let i -> 0
    do while i < 16 {
        when i < iv_bytes.length {
            iv16.append(iv_bytes[i])
        } or {
            iv16.append(0)
        }
        i -> i + 1
    }

    let ct_bytes -> []
    when (ciphertext.kind == `String`) {
        ct_bytes -> Hex.decode_bytes(ciphertext)
    } or {
        ct_bytes -> ciphertext
    }

    when (ct_bytes.length == 0 or (ct_bytes.length % 16) != 0) {
        <- Nothing
    }

    let round_keys -> expand_key(key)
    let pt_padded -> []
    let prev -> iv16
    let offset -> 0
    let len -> ct_bytes.length

    do while offset < len {
        let block -> []
        i -> 0
        do while i < 16 {
            block.append(ct_bytes[offset + i])
            i -> i + 1
        }

        let dec_block -> decrypt_block(round_keys, block)
        i -> 0
        do while i < 16 {
            pt_padded.append(dec_block[i] ^^ prev[i])
            i -> i + 1
        }
        prev -> block
        offset -> offset + 16
    }

    <- Padding.unpad(pt_padded, 16)
}

/!
  Encrypts data using AES-128-CBC and returns a hexadecimal string.
!/
export function encrypt_hex(key, iv, data) {
    let ct_bytes -> encrypt_cbc(key, iv, data)
    <- Hex.encode(ct_bytes)
}

/!
  Decrypts hex-encoded AES-128-CBC ciphertext into original plaintext string.
!/
export function decrypt_hex(key, iv, hex_str) {
    let pt_bytes -> decrypt_cbc(key, iv, hex_str)
    when (pt_bytes == Nothing) { <- Nothing }
    <- __builtin.bytes_to_string(pt_bytes)
}
