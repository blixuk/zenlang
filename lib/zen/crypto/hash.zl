/!
    zen.crypto.hash - Unified Cryptographic & Non-Cryptographic Hashing Facade.
    Aggregates standard hash algorithm implementations across modular suites:
      - SHA-256, SHA-224 (zen.crypto.sha256)
      - SHA-512, SHA-384 (zen.crypto.sha512)
      - SHA-1 (zen.crypto.sha1)
      - MD5 (zen.crypto.md5)
      - FNV-1a 32-bit & 64-bit (zen.crypto.fnv)
    Fully compatible with both the AST interpreter and native AOT compiler (-g).
!/

use zen.crypto.sha256 as sha256_mod
use zen.crypto.sha512 as sha512_mod
use zen.crypto.sha1 as sha1_mod
use zen.crypto.md5 as md5_mod
use zen.crypto.fnv as fnv_mod

/!
    Computes SHA-256 digest of input string or byte list (FIPS 180-4).
    @return 64-character lowercase hex string.
!/
export function sha256(data) {
    <- sha256_mod.sha256(data)
}

/!
    Computes SHA-224 digest of input string or byte list (FIPS 180-4).
    @return 56-character lowercase hex string.
!/
export function sha224(data) {
    <- sha256_mod.sha224(data)
}

/!
    Computes SHA-512 digest of input string or byte list (FIPS 180-4).
    @return 128-character lowercase hex string.
!/
export function sha512(data) {
    <- sha512_mod.sha512(data)
}

/!
    Computes SHA-384 digest of input string or byte list (FIPS 180-4).
    @return 96-character lowercase hex string.
!/
export function sha384(data) {
    <- sha512_mod.sha384(data)
}

/!
    Computes SHA-1 digest of input string or byte list (FIPS 180-1 / RFC 3174).
    @return 40-character lowercase hex string.
!/
export function sha1(data) {
    <- sha1_mod.sha1(data)
}

/!
    Computes MD5 digest of input string or byte list (RFC 1321).
    @return 32-character lowercase hex string.
!/
export function md5(data) {
    <- md5_mod.md5(data)
}

/!
    Fast 32-bit FNV-1a non-cryptographic hash.
    @return 8-character lowercase hex string.
!/
export function fnv1a(data) {
    <- fnv_mod.fnv1a(data)
}

/!
    Fast 64-bit FNV-1a non-cryptographic hash.
    @return 16-character lowercase hex string.
!/
export function fnv1a64(data) {
    <- fnv_mod.fnv1a64(data)
}
