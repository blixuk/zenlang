/!
    Cryptographic Hashing Module.
    Pure Zenlang implementation of standard hash functions (SHA-256, FNV-1a).
    Compatible with both interpreter and native C backend.
!/

import zen.text.string as Str

function _to_byte_list(data) {
    when (data == Nothing) { <- [] }
    when (data.kind == `String`) {
        <- __builtin.string_to_bytes(data)
    }
    when (data.kind != Nothing) {
        <- data
    }
    let b -> __builtin.string_to_bytes(data)
    when (b.length > 0) { <- b }
    <- data
}

function _rotr(x, n) {
    let u -> x & 0xffffffff
    let right -> (u >> n) & 0xffffffff
    let left -> (u << (32 - n)) & 0xffffffff
    <- (right | left) & 0xffffffff
}

function _pad_hex_byte(b) {
    let digits -> `0123456789abcdef`
    let val -> 0 + b
    let hi -> (val >> 4) & 15
    let lo -> val & 15
    <- Str.at(digits, hi) + Str.at(digits, lo)
}

function _pad_hex32(num) {
    let n -> 0 + num
    let b3 -> (n >> 24) & 255
    let b2 -> (n >> 16) & 255
    let b1 -> (n >> 8) & 255
    let b0 -> n & 255
    <- _pad_hex_byte(b3) + _pad_hex_byte(b2) + _pad_hex_byte(b1) + _pad_hex_byte(b0)
}

/!
    Computes SHA-256 digest of input string or byte list.
    @return 64-character lowercase hex string.
!/
function sha256(data) {
    when (data == Nothing) { <- `e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855` }

    let bytes -> _to_byte_list(data)
    let orig_len -> bytes.length

    // Normalize byte array copy
    let padded -> []
    let i -> 0
    do while i < orig_len {
        let b -> bytes[i]
        when (b < 0) { b -> b + 256 }
        padded.append(b)
        i -> i + 1
    }

    // SHA-256 padding
    padded.append(128)
    do while ((padded.length % 64) != 56) {
        padded.append(0)
    }

    // Append 64-bit length in bits (big-endian)
    let bit_len -> orig_len * 8
    let b7 -> 0
    let b6 -> 0
    let b5 -> 0
    let b4 -> 0
    let b3 -> (bit_len >> 24) & 255
    let b2 -> (bit_len >> 16) & 255
    let b1 -> (bit_len >> 8) & 255
    let b0 -> bit_len & 255

    padded.append(b7)
    padded.append(b6)
    padded.append(b5)
    padded.append(b4)
    padded.append(b3)
    padded.append(b2)
    padded.append(b1)
    padded.append(b0)

    // Round constants
    let K -> [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]

    // Initial state in a list to prevent SMIR moves
    let state -> [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]

    let chunk_count -> padded.length / 64
    let chunk_idx -> 0

    do while chunk_idx < chunk_count {
        let offset -> chunk_idx * 64
        let w -> []

        let t -> 0
        do while t < 16 {
            let o -> offset + t * 4
            let word -> ((padded[o] << 24) | (padded[o + 1] << 16) | (padded[o + 2] << 8) | padded[o + 3]) & 0xffffffff
            w.append(word)
            t -> t + 1
        }

        do while t < 64 {
            let s0 -> (_rotr(w[t - 15], 7) ^^ _rotr(w[t - 15], 18) ^^ ((w[t - 15] >> 3) & 0xffffffff)) & 0xffffffff
            let s1 -> (_rotr(w[t - 2], 17) ^^ _rotr(w[t - 2], 19) ^^ ((w[t - 2] >> 10) & 0xffffffff)) & 0xffffffff
            let word -> (w[t - 16] + s0 + w[t - 7] + s1) & 0xffffffff
            w.append(word)
            t -> t + 1
        }

        let rv -> [
            state[0], state[1], state[2], state[3],
            state[4], state[5], state[6], state[7]
        ]

        t -> 0
        do while t < 64 {
            let s1 -> (_rotr(rv[4], 6) ^^ _rotr(rv[4], 11) ^^ _rotr(rv[4], 25)) & 0xffffffff
            let ch -> (rv[6] ^^ (rv[4] & (rv[5] ^^ rv[6]))) & 0xffffffff
            let temp1 -> (rv[7] + s1 + ch + K[t] + w[t]) & 0xffffffff
            let s0 -> (_rotr(rv[0], 2) ^^ _rotr(rv[0], 13) ^^ _rotr(rv[0], 22)) & 0xffffffff
            let maj -> ((rv[0] & rv[1]) ^^ (rv[2] & (rv[0] ^^ rv[1]))) & 0xffffffff
            let temp2 -> (s0 + maj) & 0xffffffff

            rv[7] -> rv[6]
            rv[6] -> rv[5]
            rv[5] -> rv[4]
            rv[4] -> (rv[3] + temp1) & 0xffffffff
            rv[3] -> rv[2]
            rv[2] -> rv[1]
            rv[1] -> rv[0]
            rv[0] -> (temp1 + temp2) & 0xffffffff

            t -> t + 1
        }

        state[0] -> (state[0] + rv[0]) & 0xffffffff
        state[1] -> (state[1] + rv[1]) & 0xffffffff
        state[2] -> (state[2] + rv[2]) & 0xffffffff
        state[3] -> (state[3] + rv[3]) & 0xffffffff
        state[4] -> (state[4] + rv[4]) & 0xffffffff
        state[5] -> (state[5] + rv[5]) & 0xffffffff
        state[6] -> (state[6] + rv[6]) & 0xffffffff
        state[7] -> (state[7] + rv[7]) & 0xffffffff

        chunk_idx -> chunk_idx + 1
    }

    <- _pad_hex32(state[0]) + _pad_hex32(state[1]) + _pad_hex32(state[2]) + _pad_hex32(state[3]) + _pad_hex32(state[4]) + _pad_hex32(state[5]) + _pad_hex32(state[6]) + _pad_hex32(state[7])
}

/!
    Fast 32-bit FNV-1a non-cryptographic hash.
    @return 8-character hex string.
!/
function fnv1a(data) {
    when (data == Nothing) { <- `811c9dc5` }

    let bytes -> _to_byte_list(data)
    let len -> bytes.length
    let hash_val -> 0x811c9dc5
    let prime -> 0x01000193

    let i -> 0
    do while i < len {
        let b -> bytes[i]
        when (b < 0) { b -> b + 256 }
        hash_val -> (hash_val ^^ b) & 0xffffffff
        hash_val -> (hash_val * prime) & 0xffffffff
        i -> i + 1
    }

    <- _pad_hex32(hash_val)
}
