/!
    zen.crypto.md5 - MD5 Hash Function (RFC 1321).
    Pure Zenlang implementation with zero C dependencies.
    Fully compatible with both the AST interpreter and native AOT compiler (-g).
!/

use zen.text.string as Str

function _to_byte_list(data) {
    when (data == Nothing) { <- [] }
    when (data.kind == `String`) {
        <- __builtin.string_to_bytes(data)
    }
    when (data.kind != Nothing) {
        <- data
    }
    let b -> __builtin.string_to_bytes(data)
    when (b.length > 0) { <- b }
    <- data
}

function _pad_hex_byte(b) {
    let digits -> `0123456789abcdef`
    let val -> 0 + b
    let hi -> (val >> 4) & 15
    let lo -> val & 15
    <- Str.at(digits, hi) + Str.at(digits, lo)
}

function _pad_hex32_le(num) {
    let n -> 0 + num
    let b0 -> n & 255
    let b1 -> (n >> 8) & 255
    let b2 -> (n >> 16) & 255
    let b3 -> (n >> 24) & 255
    <- _pad_hex_byte(b0) + _pad_hex_byte(b1) + _pad_hex_byte(b2) + _pad_hex_byte(b3)
}

function _rotl32(x, n) {
    let u -> x & 0xffffffff
    let left -> (u << n) & 0xffffffff
    let right -> (u >> (32 - n)) & 0xffffffff
    <- (left | right) & 0xffffffff
}

/!
    Computes MD5 digest of input string or byte list (RFC 1321).
    @return 32-character lowercase hex string.
!/
export function md5(data) {
    when (data == Nothing) { <- `d41d8cd98f00b204e9800998ecf8427e` }

    let bytes -> _to_byte_list(data)
    let orig_len -> bytes.length

    let padded -> []
    let idx -> 0
    do while idx < orig_len {
        let b -> bytes[idx]
        when (b < 0) { b -> b + 256 }
        padded.append(b)
        idx -> idx + 1
    }

    padded.append(128)
    do while ((padded.length % 64) != 56) {
        padded.append(0)
    }

    // Append 64-bit length in bits (little-endian)
    let bit_len -> orig_len * 8
    padded.append(bit_len & 255)
    padded.append((bit_len >> 8) & 255)
    padded.append((bit_len >> 16) & 255)
    padded.append((bit_len >> 24) & 255)
    padded.append(0)
    padded.append(0)
    padded.append(0)
    padded.append(0)

    let s -> [
        7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,
        5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,
        4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,
        6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21
    ]

    let K -> [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
        0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
        0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
        0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
        0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
        0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
        0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
        0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
        0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
    ]

    let a0 -> 0x67452301
    let b0 -> 0xefcdab89
    let c0 -> 0x98badcfe
    let d0 -> 0x10325476

    let chunk_count -> padded.length / 64
    let chunk_idx -> 0

    do while chunk_idx < chunk_count {
        let offset -> chunk_idx * 64
        let m -> []
        let j -> 0
        do while j < 16 {
            let o -> offset + (j * 4)
            let word -> (padded[o] | (padded[o + 1] << 8) | (padded[o + 2] << 16) | (padded[o + 3] << 24)) & 0xffffffff
            m.append(word)
            j -> j + 1
        }

        let a -> a0
        let b -> b0
        let c -> c0
        let d -> d0

        let i -> 0
        do while i < 64 {
            let f -> 0
            let g -> 0
            when i < 16 {
                f -> (b & c) | ((b ^^ 0xffffffff) & d)
                g -> i
            } or when i < 32 {
                f -> (d & b) | ((d ^^ 0xffffffff) & c)
                g -> ((5 * i) + 1) % 16
            } or when i < 48 {
                f -> b ^^ c ^^ d
                g -> ((3 * i) + 5) % 16
            } or {
                f -> c ^^ (b | (d ^^ 0xffffffff))
                g -> (7 * i) % 16
            }

            let temp -> d
            d -> c
            c -> b
            let sum -> (a + f + K[i] + m[g]) & 0xffffffff
            b -> (b + _rotl32(sum, s[i])) & 0xffffffff
            a -> temp

            i -> i + 1
        }

        a0 -> (a0 + a) & 0xffffffff
        b0 -> (b0 + b) & 0xffffffff
        c0 -> (c0 + c) & 0xffffffff
        d0 -> (d0 + d) & 0xffffffff

        chunk_idx -> chunk_idx + 1
    }

    <- _pad_hex32_le(a0) + _pad_hex32_le(b0) + _pad_hex32_le(c0) + _pad_hex32_le(d0)
}
