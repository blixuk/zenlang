/!
 Collection utilities module.
 Provides operations for dictionaries (maps) and sets.
 !/

/!
 Map utilities.
 !/
scope Map {
    /!
     Returns a list of all keys in the map.
     @param d The map.
     @return A list of keys.
     !/
    function keys(d) {
        <- __builtin_map.keys(d)
    }

    /!
     Returns a list of all values in the map.
     @param d The map.
     @return A list of values.
     !/
    function values(d) {
        <- __builtin_map.values(d)
    }

    /!
     Returns a list of { key, value } maps for each entry.
     @param d The map.
     @return A list of pair maps.
     !/
    function items(d) {
        <- __builtin_map.items(d)
    }

    /!
     Checks if a map has a specific key.
     @param d The map.
     @param k The key.
     @return True if found, False otherwise.
     !/
    function has(d, k) {
        <- __builtin_map.has(d, k)
    }
}

/!
 Set utilities.
 !/
scope Set {
    /!
     Creates a set from a list of elements.
     @param l The list.
     @return A new set.
     !/
    function from_list(l) {
        <- __builtin_set.from_list(l)
    }

    /!
     Converts a set back to a list.
     @param s The set.
     @return A list of elements.
     !/
    function to_list(s) {
        <- __builtin_set.to_list(s)
    }

    /!
     Adds an element to a set.
     @param s The set.
     @param v The value to add.
     !/
    function add(s, v) {
        __builtin_set.add(s, v)
    }

    /!
     Checks if a set contains a value.
     @param s The set.
     @param v The value.
     @return True if found, False otherwise.
     !/
    function has(s, v) {
        <- __builtin_set.has(s, v)
    }
}
/!
 Stack utility (LIFO).
 Uses a list as the underlying container.
 !/
class Stack {
    let items : List

    /!
     Initializes a new empty stack.
     !/
    function init() {
        self.items -> []
    }

    /!
     Pushes a value onto the stack.
     @param v The value.
     !/
    function push(v) {
        self.items.append(v)
    }

    /!
     Pops the top value from the stack.
     @return The popped value.
     !/
    function pop() {
        when self.items.length() == 0 { raise `StackUnderflow` }
        <- self.items.pop()
    }

    /!
     Returns the top value without removing it.
     @return The top value.
     !/
    function peek() {
        when self.items.length() == 0 { raise `StackUnderflow` }
        <- self.items.at(self.items.length() - 1)
    }

    /!
     Returns the number of items in the stack.
     !/
    function size() {
        <- self.items.length()
    }
}

/!
 Queue utility (FIFO).
 Uses a list as the underlying container.
 !/
class Queue {
    let items : List

    /!
     Initializes a new empty queue.
     !/
    function init() {
        self.items -> []
    }

    /!
     Adds an item to the back of the queue.
     @param v The value.
     !/
    function enqueue(v) {
        self.items.append(v)
    }

    /!
     Removes and returns the front item from the queue.
     @return The front value.
     !/
    function dequeue() {
        when self.items.length() == 0 { raise `QueueUnderflow` }
        <- self.items.remove_at(0)
    }

    /!
     Returns the front item without removing it.
     @return The front value.
     !/
    function peek() {
        when self.items.length() == 0 { raise `QueueUnderflow` }
        <- self.items.at(0)
    }

    /!
     Returns the number of items in the queue.
     !/
    function size() {
        <- self.items.length()
    }
}
