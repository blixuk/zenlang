/!
 Collection utilities module.
 Provides operations for dictionaries (maps) and sets.
 !/

/!
 Map utilities.
 !/
scope Map {
    /!
     Returns a list of all keys in the map.
     @param d The map.
     @return A list of keys.
     !/
    function keys(d) {
        <- __builtin_map.keys(d)
    }

    /!
     Returns a list of all values in the map.
     @param d The map.
     @return A list of values.
     !/
    function values(d) {
        <- __builtin_map.values(d)
    }

    /!
     Returns a list of { key, value } maps for each entry.
     @param d The map.
     @return A list of pair maps.
     !/
    function items(d) {
        <- __builtin_map.items(d)
    }

    /!
      Checks if a map has a specific key.
      @param d The map.
      @param k The key.
      @return True if found, False otherwise.
      !/
    function has(d, k) {
        <- k in d
    }

    /!
      Merges two maps together. Keys in m2 overwrite keys in m1.
      @param m1 First map.
      @param m2 Second map.
      @return New merged map.
      !/
    function merge(m1, m2) {
        let res -> {}
        do for k in keys(m1) {
            res[k] -> m1[k]
        }
        do for k in keys(m2) {
            res[k] -> m2[k]
        }
        <- res
    }

    /!
      Inverts keys and values of a map.
      @param m The map to invert.
      @return Inverted map.
      !/
    function invert(m) {
        let res -> {}
        do for k in keys(m) {
            res[m[k]] -> k
        }
        <- res
    }
}

/!
  Set utilities.
  !/
scope Set {
    /!
      Creates a set from a list of elements.
      @param l The list.
      @return A new set.
      !/
    function from_list(l) {
        <- __builtin_set.from_list(l)
    }

    /!
      Converts a set back to a list.
      @param s The set.
      @return A list of elements.
      !/
    function to_list(s) {
        <- __builtin_set.to_list(s)
    }

    /!
      Adds an element to a set.
      @param s The set.
      @param v The value to add.
      !/
    function add(s, v) {
        __builtin_set.add(s, v)
    }

    /!
      Checks if a set contains a value.
      @param s The set.
      @param v The value.
      @return True if found, False otherwise.
      !/
    function has(s, v) {
        <- v in s
    }

    /!
      Computes the union of two sets.
      @param s1 First set.
      @param s2 Second set.
      @return New set containing elements from both sets.
      !/
    function union(s1, s2) {
        let l1 -> to_list(s1)
        let l2 -> to_list(s2)
        let combined -> []
        do for x in l1 { combined.append(x) }
        do for x in l2 { combined.append(x) }
        <- from_list(combined)
    }

    /!
      Computes the intersection of two sets.
      @param s1 First set.
      @param s2 Second set.
      @return New set containing elements present in both sets.
      !/
    function intersection(s1, s2) {
        let l1 -> to_list(s1)
        let common -> []
        do for x in l1 {
            when has(s2, x) {
                common.append(x)
            }
        }
        <- from_list(common)
    }

    /!
      Computes the relative difference of two sets (s1 \ s2).
      @param s1 First set.
      @param s2 Second set.
      @return New set containing elements in s1 but not in s2.
      !/
    function difference(s1, s2) {
        let l1 -> to_list(s1)
        let diff -> []
        do for x in l1 {
            when not has(s2, x) {
                diff.append(x)
            }
        }
        <- from_list(diff)
    }
}
/!
 Stack utility (LIFO).
 Uses a list as the underlying container.
 !/
class Stack {
    let items : List

    /!
     Initializes a new empty stack.
     !/
    function init() {
        self.items -> []
    }

    /!
     Pushes a value onto the stack.
     @param v The value.
     !/
    function push(v) {
        self.items.append(v)
    }

    /!
     Pops the top value from the stack.
     @return The popped value.
     !/
    function pop() {
        when self.items.length() == 0 { raise `StackUnderflow` }
        <- self.items.pop()
    }

    /!
     Returns the top value without removing it.
     @return The top value.
     !/
    function peek() {
        when self.items.length() == 0 { raise `StackUnderflow` }
        <- self.items.at(self.items.length() - 1)
    }

    /!
     Returns the number of items in the stack.
     !/
    function size() {
        <- self.items.length()
    }
}

/!
 Queue utility (FIFO).
 Uses a list as the underlying container.
 !/
class Queue {
    let items : List

    /!
     Initializes a new empty queue.
     !/
    function init() {
        self.items -> []
    }

    /!
     Adds an item to the back of the queue.
     @param v The value.
     !/
    function enqueue(v) {
        self.items.append(v)
    }

    /!
     Removes and returns the front item from the queue.
     @return The front value.
     !/
    function dequeue() {
        when self.items.length() == 0 { raise `QueueUnderflow` }
        <- self.items.remove_at(0)
    }

    /!
     Returns the front item without removing it.
     @return The front value.
     !/
    function peek() {
        when self.items.length() == 0 { raise `QueueUnderflow` }
        <- self.items.at(0)
    }

    /!
     Returns the number of items in the queue.
     !/
    function size() {
        <- self.items.length()
    }
}
