/!
  List utility module.
  Provides functional operations, partitioning, and sequence utilities for lists.
!/

/!
  Applies a function to each element of a list and returns a new list of results.
  @param list The list to map.
  @param fn The function to apply (element -> result).
  @return A new list.
!/
export function map(list, fn) {
    let res -> []
    do for item in list {
        res.append(fn(item))
    }
    <- res
}

/!
  Filters a list based on a predicate function.
  @param list The list to filter.
  @param fn The predicate function (element -> boolean).
  @return A new list containing only elements that matched the predicate.
!/
export function filter(list, fn) {
    let res -> []
    do for item in list {
        when fn(item) {
            res.append(item)
        }
    }
    <- res
}

/!
  Reduces a list to a single value using an accumulator function.
  @param list The list to reduce.
  @param initial The initial accumulator value.
  @param fn The reducer function (accumulator, element -> new_accumulator).
  @return The final accumulator value.
!/
export function reduce(list, initial, fn) {
    let acc -> initial
    do for item in list {
        acc -> fn(acc, item)
    }
    <- acc
}

/!
  Executes a function for each element of a list.
  @param list The list.
  @param fn The function to execute (element -> void).
!/
export function each(list, fn) {
    do for item in list {
        fn(item)
    }
}

/!
  Finds the first element in a list that matches a predicate.
  @param list The list.
  @param fn The predicate function.
  @return The element, or Nothing if not found.
!/
export function find(list, fn) {
    do for item in list {
        when fn(item) {
            <- item
        }
    }
    <- Nothing
}

/!
  Checks if a list contains a specific value.
  Leverages the first-class `in` operator.
  @param list The list.
  @param val The value to search for.
  @return True if found, False otherwise.
!/
export function contains(list, val) {
    <- val in list
}

/!
  Reverses a list and returns a new list.
  @param list The list to reverse.
  @return A new reversed list.
!/
export function reverse(list) {
    let res -> []
    let n -> list.length
    let i -> n - 1
    do while i >= 0 {
        res.append(list[i])
        i -> i - 1
    }
    <- res
}

/!
  Deduplicates elements while preserving original insertion order.
  @param list The list to deduplicate.
  @return A new list containing only unique elements.
!/
export function unique(list) {
    let res -> []
    do for item in list {
        when not (item in res) {
            res.append(item)
        }
    }
    <- res
}

/!
  Flattens a list of lists one level deep.
  @param list The list to flatten.
  @return A flattened list.
!/
export function flatten(list) {
    let res -> []
    do for item in list {
        when item is List {
            do for sub in item {
                res.append(sub)
            }
        } or {
            res.append(item)
        }
    }
    <- res
}

/!
  Partitions a list into fixed-size chunks.
  @param list The list to partition.
  @param size The size of each chunk.
  @return A list of chunk lists.
!/
export function chunk(list, size) {
    when size <= 0 { <- [] }
    let res -> []
    let cur -> []
    do for item in list {
        cur.append(item)
        when cur.length == size {
            res.append(cur)
            cur -> []
        }
    }
    when cur.length > 0 {
        res.append(cur)
    }
    <- res
}

/!
  Returns the first n elements from the list.
  @param list The list.
  @param n Number of elements to take.
  @return List of taken elements.
!/
export function take(list, n) {
    when n <= 0 { <- [] }
    let res -> []
    let count -> 0
    do for item in list {
        when count < n {
            res.append(item)
            count -> count + 1
        }
    }
    <- res
}

/!
  Drops the first n elements and returns the rest.
  @param list The list.
  @param n Number of elements to drop.
  @return Remaining elements.
!/
export function drop(list, n) {
    let res -> []
    let count -> 0
    do for item in list {
        when count >= n {
            res.append(item)
        }
        count -> count + 1
    }
    <- res
}

/!
  Checks if at least one element satisfies the predicate.
  @param list The list.
  @param fn The predicate function.
  @return True if any element matches, False otherwise.
!/
export function any(list, fn) {
    do for item in list {
        when fn(item) {
            <- true
        }
    }
    <- false
}

/!
  Checks if all elements satisfy the predicate.
  @param list The list.
  @param fn The predicate function.
  @return True if all elements match, False otherwise.
!/
export function all(list, fn) {
    do for item in list {
        when not fn(item) {
            <- false
        }
    }
    <- true
}

function _merge_sorted(left, right, cmp_fn) {
    let result -> []
    let i -> 0
    let j -> 0
    let n_l -> left.length
    let n_r -> right.length

    do while i < n_l and j < n_r {
        let a -> left[i]
        let b -> right[j]
        let take_left -> False
        when (cmp_fn == Nothing) {
            take_left -> a <= b
        } or {
            take_left -> cmp_fn(a, b)
        }
        when (take_left) {
            result.append(a)
            i -> i + 1
        } or {
            result.append(b)
            j -> j + 1
        }
    }

    do while i < n_l {
        result.append(left[i])
        i -> i + 1
    }
    do while j < n_r {
        result.append(right[j])
        j -> j + 1
    }

    <- result
}

/!
  Sorts a list using an optional comparator function.
  Returns a new sorted list (does not mutate the original).
  @param list The list to sort.
  @param cmp_fn Optional comparator function (a, b -> boolean). Defaults to ascending (a <= b).
  @return A new sorted list.
!/
export function sort_by(list, cmp_fn) {
    when (list == Nothing) { <- [] }
    let n -> list.length
    when (n <= 1) {
        <- list
    }
    let mid -> Integer(n / 2)
    let left -> []
    let right -> []
    let idx -> 0
    do while idx < mid {
        left.append(list[idx])
        idx -> idx + 1
    }
    do while idx < n {
        right.append(list[idx])
        idx -> idx + 1
    }
    let s_left -> sort_by(left, cmp_fn)
    let s_right -> sort_by(right, cmp_fn)
    <- _merge_sorted(s_left, s_right, cmp_fn)
}

/!
  Sorts a list in ascending order.
  Returns a new sorted list (does not mutate the original).
  @param list The list to sort.
  @return A new sorted list.
!/
export function sort(list) {
    <- sort_by(list, Nothing)
}
