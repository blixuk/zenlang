/!
 Path manipulation module.
 Provides functions for interacting with Unix-style file paths.
 !/

import zen.string as Str

/!
 Joins two or more path components using the system separator (/).
 @param p1 The first path component.
 @param p2 The second path component.
 @return The joined path string.
 !/
function join(p1, p2) {
    when p1 == `` { <- p2 }
    when p2 == `` { <- p1 }

    let p1_ends -> Str.ends_with(p1, `/`)
    let p2_starts -> Str.starts_with(p2, `/`)

    when p1_ends and p2_starts {
        <- p1 + Str.substring(p2, 1, Str.length(p2))
    }
    when p1_ends or p2_starts {
        <- p1 + p2
    }
    <- p1 + `/` + p2
}

/!
 Returns the final component of a path.
 @param p The path string.
 @return The basename of the path.
 !/
function basename(p) {
    when p == `` { <- `.` }
    when p == `/` { <- `/` }
    
    let parts -> Str.split(p, `/`)
    let n -> Str.length(parts)
    
    // Handle trailing slash
    when parts[n-1] == `` {
        when n > 1 {
            <- parts[n-2]
        }
        <- `/`
    }
    
    <- parts[n-1]
}

/!
 Returns the parent directory of a path.
 @param p The path string.
 @return The directory name.
 !/
function dirname(p) {
    when p == `` or p == `.` { <- `.` }
    when p == `/` { <- `/` }
    
    let parts -> Str.split(p, `/`)
    let n -> Str.length(parts)
    
    // If it's just a filename with no slashes
    when n == 1 { <- `.` }
    
    // Handle trailing slash by ignoring last empty part
    let limit -> n - 1
    when parts[n-1] == `` {
        limit -> n - 2
    }
    
    when limit <= 0 {
        when Str.starts_with(p, `/`) { <- `/` }
        <- `.`
    }
    
    let res -> ``
    do for i in __builtin.range(0, limit) {
        when i > 0 {
            res -> res + `/`
        }
        res -> res + parts[i]
    }
    
    when res == `` and Str.starts_with(p, `/`) {
        <- `/`
    }
    
    <- res
}

/!
 Checks if a path is absolute (starts with /).
 @param p The path string.
 @return True if absolute, False otherwise.
 !/
function is_absolute(p) {
    <- Str.starts_with(p, `/`)
}

/!
 Returns the extension of the file (including the dot).
 @param p The path string.
 @return The extension, or an empty string if none.
 !/
function extname(p) {
    let base -> basename(p)
    let dot_idx -> Str.index_of(base, `.`)
    when dot_idx == -1 {
        <- ``
    }
    
    // Find LAST dot
    let last_dot -> dot_idx
    let search_from -> dot_idx + 1
    do while search_from < Str.length(base) {
        let next_dot -> Str.index_of(Str.substring(base, search_from, Str.length(base)), `.`)
        when next_dot == -1 {
            break
        }
        last_dot -> search_from + next_dot
        search_from -> last_dot + 1
    }
    
    <- Str.substring(base, last_dot, Str.length(base))
}
