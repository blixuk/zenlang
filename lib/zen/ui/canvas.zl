/!
 Terminal canvas — buffer of characters and colors.
 Dual-path: map-based API is the supported surface under interpret and `-g`.

 Canvas map keys:
   width, height, buffer, fg_buffer, bg_buffer
 !/

use zen.sys.term as term
use zen.text.string as Str

/!
 Create a blank canvas map: { width, height, buffer, fg_buffer, bg_buffer }.
 !/
function create(w, h) {
    let buffer -> []
    let fg_buffer -> []
    let bg_buffer -> []
    do for y in 0..-h {
        let row -> []
        let fg_row -> []
        let bg_row -> []
        do for x in 0..-w {
            row.append(` `)
            fg_row.append(`white`)
            bg_row.append(`black`)
        }
        buffer.append(row)
        fg_buffer.append(fg_row)
        bg_buffer.append(bg_row)
    }
    <- {
        `width` -> w,
        `height` -> h,
        `buffer` -> buffer,
        `fg_buffer` -> fg_buffer,
        `bg_buffer` -> bg_buffer
    }
}

/!
 Set a cell on a canvas map.
 !/
function set_cell(c, x, y, char, fg, bg) {
    let w -> c[`width`]
    let h -> c[`height`]
    when x >= 0 and x < w and y >= 0 and y < h {
        c[`buffer`][y][x] -> char
        when fg != Nothing {
            c[`fg_buffer`][y][x] -> fg
        }
        when bg != Nothing {
            c[`bg_buffer`][y][x] -> bg
        }
    }
}

/!
 Get character at (x, y), or empty string if OOB.
 !/
function get_cell(c, x, y) {
    let w -> c[`width`]
    let h -> c[`height`]
    when x >= 0 and x < w and y >= 0 and y < h {
        <- c[`buffer`][y][x]
    }
    <- ``
}

/!
  Reuse existing canvas `c` if width and height match (clearing in-place),
  or allocate a fresh canvas when null or dimensions change.
!/
function ensure(c, w, h) {
    when c != Nothing and c[`width`] == w and c[`height`] == h {
        clear(c, ` `, `white`, `black`)
        <- c
    }
    <- create(w, h)
}

/!
 Clear canvas map to a character (Default space).
!/
function clear(c, char, fg, bg) {
    let fill_char -> ` `
    when char != Nothing {
        fill_char -> char
    }
    let fill_fg -> `white`
    when fg != Nothing {
        fill_fg -> fg
    }
    let fill_bg -> `black`
    when bg != Nothing {
        fill_bg -> bg
    }
    let w -> c[`width`]
    let h -> c[`height`]
    let buf -> c[`buffer`]
    let fgb -> c[`fg_buffer`]
    let bgb -> c[`bg_buffer`]
    let y -> 0
    do while y < h {
        let row -> buf[y]
        let fgrow -> fgb[y]
        let bgrow -> bgb[y]
        let x -> 0
        do while x < w {
            row[x] -> fill_char
            fgrow[x] -> fill_fg
            bgrow[x] -> fill_bg
            x -> x + 1
        }
        y -> y + 1
    }
}

/!
 Draw axis-aligned rectangle outline from (x0,y0) with size width×height.
 Fast direct row buffer updates with boundary clipping.
!/
function draw_rect(c, x0, y0, width, height, char, fg, bg) {
    when width <= 0 or height <= 0 { <- Nothing }
    let w -> c[`width`]
    let h -> c[`height`]
    let x2 -> x0 + width - 1
    let y2 -> y0 + height - 1
    let buf -> c[`buffer`]
    let fgb -> c[`fg_buffer`]
    let bgb -> c[`bg_buffer`]

    // Top edge
    when y0 >= 0 and y0 < h {
        let row -> buf[y0]
        let fgrow -> fgb[y0]
        let bgrow -> bgb[y0]
        let x -> x0
        when x < 0 { x -> 0 }
        let end_x -> x2
        when end_x >= w { end_x -> w - 1 }
        do while x <= end_x {
            row[x] -> char
            when fg != Nothing { fgrow[x] -> fg }
            when bg != Nothing { bgrow[x] -> bg }
            x -> x + 1
        }
    }

    // Bottom edge
    when y2 != y0 and y2 >= 0 and y2 < h {
        let row -> buf[y2]
        let fgrow -> fgb[y2]
        let bgrow -> bgb[y2]
        let x -> x0
        when x < 0 { x -> 0 }
        let end_x -> x2
        when end_x >= w { end_x -> w - 1 }
        do while x <= end_x {
            row[x] -> char
            when fg != Nothing { fgrow[x] -> fg }
            when bg != Nothing { bgrow[x] -> bg }
            x -> x + 1
        }
    }

    // Left and right vertical edges
    let y -> y0 + 1
    when y < 0 { y -> 0 }
    let end_y -> y2 - 1
    when end_y >= h { end_y -> h - 1 }
    do while y <= end_y {
        let row -> buf[y]
        let fgrow -> fgb[y]
        let bgrow -> bgb[y]
        when x0 >= 0 and x0 < w {
            row[x0] -> char
            when fg != Nothing { fgrow[x0] -> fg }
            when bg != Nothing { bgrow[x0] -> bg }
        }
        when x2 != x0 and x2 >= 0 and x2 < w {
            row[x2] -> char
            when fg != Nothing { fgrow[x2] -> fg }
            when bg != Nothing { bgrow[x2] -> bg }
        }
        y -> y + 1
    }
}

/!
 Draw text starting at (x, y). Clips at canvas edge with direct row buffer updates.
!/
function draw_text(c, x, y, text, fg, bg) {
    let s -> Str.to_string(text)
    let n -> Str.length(s)
    let w -> c[`width`]
    let h -> c[`height`]
    when y < 0 or y >= h { <- Nothing }
    let row -> c[`buffer`][y]
    let fgrow -> c[`fg_buffer`][y]
    let bgrow -> c[`bg_buffer`][y]
    let i -> 0
    do while i < n {
        let px -> x + i
        when px >= 0 and px < w {
            row[px] -> Str.at(s, i)
            when fg != Nothing { fgrow[px] -> fg }
            when bg != Nothing { bgrow[px] -> bg }
        }
        i -> i + 1
    }
}

/!
 Fill a rectangle with a character (fast row updates with bounds clipping).
!/
function fill_rect(c, x0, y0, width, height, char, fg, bg) {
    when width <= 0 or height <= 0 { <- Nothing }
    let w -> c[`width`]
    let h -> c[`height`]
    let x1 -> x0 + width
    let y1 -> y0 + height
    when x0 < 0 { x0 -> 0 }
    when y0 < 0 { y0 -> 0 }
    when x1 > w { x1 -> w }
    when y1 > h { y1 -> h }
    when x0 >= x1 or y0 >= y1 { <- Nothing }

    let buf -> c[`buffer`]
    let fgb -> c[`fg_buffer`]
    let bgb -> c[`bg_buffer`]
    let y -> y0
    do while y < y1 {
        let row -> buf[y]
        let fgrow -> fgb[y]
        let bgrow -> bgb[y]
        let x -> x0
        do while x < x1 {
            row[x] -> char
            when fg != Nothing { fgrow[x] -> fg }
            when bg != Nothing { bgrow[x] -> bg }
            x -> x + 1
        }
        y -> y + 1
    }
}

/!
 Draw into a laid-out map node {x,y,w,h} (from zen.ui.layout map API).
 !/
function fill_node(c, node, char, fg, bg) {
    fill_rect(c, node[`x`], node[`y`], node[`w`], node[`h`], char, fg, bg)
}

/!
 Draw text at the top-left of a layout node.
 !/
function text_node(c, node, text, fg, bg) {
    draw_text(c, node[`x`], node[`y`], text, fg, bg)
}

/!
 Renders the canvas to the terminal.

 Native `-g`: C hot path `ZenTerm_paint_canvas` (no per-cell Zen calls,
 color only on change, one flush).

 Interpret: same algorithm in Python via `__builtin_term.paint_canvas`.
 !/
function render(c) {
    __builtin_term.paint_canvas(c)
}

/!
 Snapshot one row of characters as a string (for tests).
 !/
function row_string(c, y) {
    let w -> c[`width`]
    let h -> c[`height`]
    when y < 0 or y >= h { <- `` }
    let out -> ``
    let x -> 0
    do while x < w {
        out -> out + c[`buffer`][y][x]
        x -> x + 1
    }
    <- out
}
