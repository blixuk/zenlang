/!
  Package manager and dependency resolver for Zenlang projects.
  Manages external packages in deps/ (flat Cargo/Go model) and
  maintains reproducible dependency pins in zen.lock.
!/

import zen.tooling.manifest as manifest
import zen.io.file as file
import zen.io.path as path
import zen.io.io as io
import zen.sys.sys as sys
import zen.sys.process as process
import zen.text.string as Str

/!
  Adds a dependency to .zbuild.
  @param proj Project map.
  @param name Package name.
  @param source Git URL (git:https://...) or local path (path:../foo).
!/
export function add_dependency(proj, name, src_spec) {
    let manifest_map -> proj[`manifest`]
    let deps -> manifest_map[`dependencies`]
    when deps == Nothing {
        deps -> {}
    }
    deps[name] -> src_spec
    manifest_map[`dependencies`] -> deps

    let manifest_path -> path.join(proj[`root`], `.zbuild`)
    file.write(manifest_path, manifest.stringify_manifest(manifest_map))
    io.writeln(`[PKG] Added dependency '` + name + `' -> ` + src_spec + ` to .zbuild`)
    <- install_dependencies(proj)
}

/!
  Installs all dependencies declared in .zbuild into deps/ and updates zen.lock.
!/
export function install_dependencies(proj) {
    let root -> proj[`root`]
    let manifest_map -> proj[`manifest`]
    let deps -> manifest_map[`dependencies`]
    when deps == Nothing {
        deps -> {}
    }

    let deps_dir -> path.join(root, `deps`)
    file.make_dirs(deps_dir)

    let lock -> proj[`lock`]
    when lock == Nothing {
        lock -> { `version` -> `1.0`, `packages` -> {} }
    }
    let locked_pkgs -> lock[`packages`]
    when locked_pkgs == Nothing {
        locked_pkgs -> {}
    }

    let dep_names -> deps.keys()
    when dep_names.length == 0 {
        io.writeln(`[PKG] No external dependencies declared in .zbuild`)
        <- { `ok` -> true, `count` -> 0 }
    }

    io.writeln(`[PKG] Resolving ` + Str.to_string(dep_names.length) + ` dependencies for '` + manifest_map[`name`] + `'...`)

    let installed_count -> 0

    do for name in dep_names {
        let spec -> Str.to_string(deps[name])
        let pkg_dir -> path.join(deps_dir, name)
        let commit_sha -> `local`

        when Str.starts_with(spec, `git:`) or Str.starts_with(spec, `https://`) or Str.starts_with(spec, `git@`) {
            let git_url -> spec
            when Str.starts_with(git_url, `git:`) {
                git_url -> Str.substring(git_url, 4, Str.length(git_url))
            }
            when not file.exists(pkg_dir) {
                io.writeln(`[PKG] Cloning ` + name + ` from ` + git_url + `...`)
                process.shell(`git clone --depth 1 ` + process.shell_quote(git_url) + ` ` + process.shell_quote(pkg_dir) + ` 2>/dev/null`)
            } or {
                io.writeln(`[PKG] Updating ` + name + `...`)
                process.shell_in(pkg_dir, `git pull -q 2>/dev/null`)
            }

            // Extract commit SHA
            let r -> process.result_in(pkg_dir, `git rev-parse HEAD 2>/dev/null`)
            when r.code == 0 {
                commit_sha -> Str.trim(r.stdout)
            }
        } or when Str.starts_with(spec, `path:`) {
            let rel -> Str.substring(spec, 5, Str.length(spec))
            let src_dir -> path.join(root, rel)
            when file.exists(src_dir) {
                io.writeln(`[PKG] Linking local package ` + name + ` from ` + src_dir + `...`)
                file.remove_tree(pkg_dir)
                file.make_dirs(pkg_dir)
                let files -> file.find_files(src_dir, `.zl`)
                do for f in files {
                    let rel_f -> f.replace(src_dir + `/`, ``)
                    let dst_f -> path.join(pkg_dir, rel_f)
                    file.make_dirs(path.dir_name(dst_f))
                    file.copy(f, dst_f)
                }
            }
        }

        locked_pkgs[name] -> {
            `source` -> spec,
            `commit` -> commit_sha,
            `path` -> `deps/` + name
        }
        installed_count -> installed_count + 1
    }

    lock[`packages`] -> locked_pkgs
    let lock_path -> path.join(root, `zen.lock`)
    file.write(lock_path, manifest.stringify_lockfile(lock))
    io.writeln(`[PKG] Installed ` + Str.to_string(installed_count) + ` packages. Updated zen.lock`)

    <- {
        `ok` -> true,
        `count` -> installed_count,
        `packages` -> locked_pkgs
    }
}

/!
  Lists all configured and locked dependencies for a project.
!/
export function list_dependencies(proj) {
    let manifest_map -> proj[`manifest`]
    let deps -> manifest_map[`dependencies`]
    when deps == Nothing { deps -> {} }
    let lock -> proj[`lock`]
    let locked -> {}
    when lock != Nothing and lock.has(`packages`) {
        locked -> lock[`packages`]
    }

    io.writeln(`==============================================`)
    io.writeln(`  Dependencies for: ` + manifest_map[`name`])
    io.writeln(`==============================================`)

    let names -> deps.keys()
    when names.length == 0 {
        io.writeln(`No dependencies configured.`)
        io.writeln(`==============================================`)
        <- { `count` -> 0 }
    }

    do for name in names {
        let spec -> deps[name]
        let commit -> `unlocked`
        when locked.has(name) and locked[name].has(`commit`) {
            commit -> locked[name][`commit`]
            when Str.length(commit) > 8 {
                commit -> Str.substring(commit, 0, 8)
            }
        }
        io.writeln(`• ` + name + ` (` + commit + `) -> ` + Str.to_string(spec))
    }
    io.writeln(`==============================================`)
    <- { `count` -> names.length }
}

/!
  Removes a dependency from .zbuild and deletes its directory in deps/.
!/
export function remove_dependency(proj, name) {
    let manifest_map -> proj[`manifest`]
    let deps -> manifest_map[`dependencies`]
    when deps == Nothing or not deps.has(name) {
        io.writeln(`[PKG] Dependency '` + name + `' not found in .zbuild`)
        <- { `ok` -> false }
    }

    // Remove from manifest
    let new_deps -> {}
    do for k in deps.keys() {
        when k != name {
            new_deps[k] -> deps[k]
        }
    }
    manifest_map[`dependencies`] -> new_deps
    let manifest_path -> path.join(proj[`root`], `.zbuild`)
    file.write(manifest_path, manifest.stringify_manifest(manifest_map))

    // Remove from lockfile
    let lock -> proj[`lock`]
    when lock != Nothing and lock.has(`packages`) {
        let pkgs -> lock[`packages`]
        let new_pkgs -> {}
        do for k in pkgs.keys() {
            when k != name {
                new_pkgs[k] -> pkgs[k]
            }
        }
        lock[`packages`] -> new_pkgs
        let lock_path -> path.join(proj[`root`], `zen.lock`)
        file.write(lock_path, manifest.stringify_lockfile(lock))
    }

    // Delete folder in deps/
    let pkg_dir -> path.join(proj[`root`], `deps/` + name)
    when file.exists(pkg_dir) {
        file.remove_tree(pkg_dir)
    }

    io.writeln(`[PKG] Removed dependency '` + name + `' and cleaned deps/` + name)
    <- { `ok` -> true }
}

/!
  Visualizes dependencies as terminal tree or interactive HTML graph.
!/
export function graph_dependencies(proj, is_html, out_file) {
    import zen.tooling.graph as graph
    when is_html {
        <- graph.generate_html_graph(proj, out_file)
    }
    <- graph.render_terminal_tree(proj)
}
