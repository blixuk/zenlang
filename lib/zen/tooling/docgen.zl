/!
  Documentation generator module for Zenlang project tooling.
  Extracts doc comments from source files, generating
  Markdown API references and interactive HTML documentation.
!/

import zen.io.file as file
import zen.io.path as path
import zen.io.io as io
import zen.text.string as Str
import zen.text.zenmark as zm
import zen.text.html as html

/!
  Extracts documentation symbols and docblocks from a source file.
!/
export function extract_file_docs(file_path) {
    when not file.exists(file_path) {
        <- { `module` -> ``, `entries` -> [] }
    }
    let content -> file.read(file_path)
    let len -> Str.length(content)
    let i -> 0
    let entries -> []
    let current_class -> ``

    do while i < len {
        let start -> Str.index_of(Str.substring(content, i, len), `/!`)
        when start == -1 { break }
        let abs_start -> i + start

        let end -> Str.index_of(Str.substring(content, abs_start + 2, len), `!/`)
        when end == -1 { break }
        let abs_end -> abs_start + 2 + end

        let doc_text -> Str.substring(content, abs_start + 2, abs_end)
        let doc -> zm.parse(doc_text)

        // Peek ahead for associated declaration
        let next_pos -> abs_end + 2
        let chunk_len -> 200
        when next_pos + chunk_len > len {
            chunk_len -> len - next_pos
        }
        let next_chunk -> Str.trim(Str.substring(content, next_pos, next_pos + chunk_len))

        let sym_name -> ``
        let sym_type -> `Module`

        when Str.starts_with(next_chunk, `export function `) or Str.starts_with(next_chunk, `function `) {
            sym_type -> `Function`
            let fn_kw -> `function `
            let fn_idx -> Str.index_of(next_chunk, fn_kw)
            let p_idx -> Str.index_of(next_chunk, `(`)
            when fn_idx >= 0 and p_idx > fn_idx + 9 {
                sym_name -> Str.trim(Str.substring(next_chunk, fn_idx + 9, p_idx))
            }
        } or when Str.starts_with(next_chunk, `export class `) or Str.starts_with(next_chunk, `class `) {
            sym_type -> `Class`
            let cl_kw -> `class `
            let cl_idx -> Str.index_of(next_chunk, cl_kw)
            let b_idx -> Str.index_of(next_chunk, `{`)
            when cl_idx >= 0 and b_idx > cl_idx + 6 {
                sym_name -> Str.trim(Str.substring(next_chunk, cl_idx + 6, b_idx))
                current_class -> sym_name
            }
        } or when Str.starts_with(next_chunk, `export let `) or Str.starts_with(next_chunk, `let `) {
            sym_type -> `Constant`
            let let_kw -> `let `
            let let_idx -> Str.index_of(next_chunk, let_kw)
            let a_idx -> Str.index_of(next_chunk, `->`)
            when let_idx >= 0 and a_idx > let_idx + 4 {
                sym_name -> Str.trim(Str.substring(next_chunk, let_idx + 4, a_idx))
            }
        }

        when doc.summary != `` or sym_name != `` {
            entries.append({
                `name` -> sym_name,
                `type` -> sym_type,
                `class` -> current_class,
                `summary` -> doc.summary,
                `params` -> doc.params,
                `returns` -> doc.returns
            })
        }

        i -> abs_end + 2
    }

    let mod_name -> path.base_name(file_path).replace(`.zl`, ``)
    <- {
        `module` -> mod_name,
        `file` -> file_path,
        `entries` -> entries
    }
}

/!
  Generates Markdown and HTML documentation for a project.
!/
export function generate_docs(proj, out_format, out_dir) {
    let root -> proj[`root`]
    let manifest_map -> proj[`manifest`]
    let name -> manifest_map[`name`]
    let ver -> manifest_map[`version`]

    let docs_dir -> out_dir
    when docs_dir == Nothing or docs_dir == `` {
        docs_dir -> path.join(root, `docs`)
    }
    file.make_dirs(docs_dir)

    let src_dir -> path.join(root, `src`)
    let doc_items -> []
    when file.exists(src_dir) {
        let files -> file.find_files(src_dir, `.zl`)
        do for f in files {
            doc_items.append(extract_file_docs(f))
        }
    }

    // 1. Generate Zen Mark API.zm (and Markdown API.md)
    let zm_text -> `# ` + name + ` API Reference\n\n`
    zm_text -> zm_text + `> [!NOTE]\n`
    zm_text -> zm_text + `> Version \`` + ver + `\` — Generated with ZenDoc. View in terminal: \`zen view docs/API.zm\`\n\n`
    zm_text -> zm_text + `## Modules\n\n`

    do for item in doc_items {
        zm_text -> zm_text + `### Module: \`` + item[`module`] + `\`\n\n`
        do for e in item[`entries`] {
            let title -> e[`type`] + `: \`` + e[`name`] + `\``
            when e[`type`] == `Function` and e[`class`] != `` {
                title -> `Method: \`` + e[`class`] + `.` + e[`name`] + `\``
            }
            zm_text -> zm_text + `#### ` + title + `\n\n`
            when e[`summary`] != `` {
                zm_text -> zm_text + e[`summary`] + `\n\n`
            }
            when e[`params`] != Nothing and e[`params`].keys().length > 0 {
                zm_text -> zm_text + `**Parameters:**\n`
                do for p in e[`params`].keys() {
                    zm_text -> zm_text + `- \`` + p + `\`: ` + Str.to_string(e[`params`][p]) + `\n`
                }
                zm_text -> zm_text + `\n`
            }
            when e[`returns`] != Nothing and e[`returns`] != `` {
                zm_text -> zm_text + `**Returns:** \`` + Str.to_string(e[`returns`]) + `\`\n\n`
            }
            zm_text -> zm_text + `---\n\n`
        }
    }

    let zm_path -> path.join(docs_dir, `API.zm`)
    file.write(zm_path, zm_text)
    io.writeln(`[DOC] Generated Zen Mark reference: ` + zm_path)

    let md_path -> path.join(docs_dir, `API.md`)
    file.write(md_path, zm_text)

    // 2. Generate Interactive Dark-Mode HTML documentation
    let html_dir -> path.join(docs_dir, `html`)
    file.make_dirs(html_dir)

    let html_content -> `<!DOCTYPE html>\n<html lang="en">\n<head>\n`
    html_content -> html_content + `<meta charset="UTF-8">\n<meta name="viewport" content="width=device-width, initial-scale=1.0">\n`
    html_content -> html_content + `<title>` + name + ` API Documentation</title>\n`
    html_content -> html_content + `<style>\n`
    html_content -> html_content + `body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #e2e8f0; margin: 0; display: flex; height: 100vh; }\n`
    html_content -> html_content + `nav { width: 280px; background: #1e293b; padding: 24px 16px; border-right: 1px solid #334155; overflow-y: auto; }\n`
    html_content -> html_content + `main { flex: 1; padding: 40px 48px; overflow-y: auto; }\n`
    html_content -> html_content + `h1, h2, h3 { color: #f8fafc; }\n`
    html_content -> html_content + `.search-box { width: 100%; padding: 10px 12px; background: #0f172a; border: 1px solid #475569; border-radius: 6px; color: #fff; margin-bottom: 20px; box-sizing: border-box; }\n`
    html_content -> html_content + `.card { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 20px; margin-bottom: 20px; }\n`
    html_content -> html_content + `.badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; background: #3b82f6; color: #fff; margin-right: 8px; }\n`
    html_content -> html_content + `code { background: #334155; padding: 2px 6px; border-radius: 4px; font-family: monospace; color: #38bdf8; }\n`
    html_content -> html_content + `</style>\n</head>\n<body>\n`
    html_content -> html_content + `<nav>\n<h2>` + name + ` <span style="font-size:14px;color:#94a3b8;">v` + ver + `</span></h2>\n`
    html_content -> html_content + `<input type="text" class="search-box" id="search" placeholder="Search documentation..." onkeyup="filterDocs()">\n`
    html_content -> html_content + `<div id="nav-list">\n`

    do for item in doc_items {
        html_content -> html_content + `<div style="font-weight:600;margin-top:12px;color:#93c5fd;">` + item[`module`] + `</div>\n`
        do for e in item[`entries`] {
            when e[`name`] != `` {
                html_content -> html_content + `<div style="padding:4px 0;"><a href="#` + e[`name`] + `" style="color:#cbd5e1;text-decoration:none;">` + e[`name`] + `</a></div>\n`
            }
        }
    }
    html_content -> html_content + `</div>\n</nav>\n`

    html_content -> html_content + `<main id="content">\n`
    html_content -> html_content + `<h1>` + name + ` API Reference</h1>\n`
    html_content -> html_content + `<p style="color:#94a3b8;">` + manifest_map[`description`] + `</p>\n<hr style="border:0;border-top:1px solid #334155;margin:24px 0;">\n`

    do for item in doc_items {
        html_content -> html_content + `<h2>Module: ` + item[`module`] + `</h2>\n`
        do for e in item[`entries`] {
            html_content -> html_content + `<div class="card doc-entry" id="` + e[`name`] + `">\n`
            html_content -> html_content + `<div style="display:flex;align-items:center;margin-bottom:8px;">\n`
            html_content -> html_content + `<span class="badge">` + e[`type`] + `</span>\n`
            html_content -> html_content + `<h3 style="margin:0;">` + e[`name`] + `</h3>\n`
            html_content -> html_content + `</div>\n`
            when e[`summary`] != `` {
                html_content -> html_content + `<p>` + e[`summary`] + `</p>\n`
            }
            when e[`params`] != Nothing and e[`params`].keys().length > 0 {
                html_content -> html_content + `<h4>Parameters:</h4><ul>\n`
                do for p in e[`params`].keys() {
                    html_content -> html_content + `<li><code>` + p + `</code> — ` + Str.to_string(e[`params`][p]) + `</li>\n`
                }
                html_content -> html_content + `</ul>\n`
            }
            when e[`returns`] != Nothing and e[`returns`] != `` {
                html_content -> html_content + `<h4>Returns:</h4><p><code>` + Str.to_string(e[`returns`]) + `</code></p>\n`
            }
            html_content -> html_content + `</div>\n`
        }
    }

    html_content -> html_content + `</main>\n`
    html_content -> html_content + `<script>\n`
    html_content -> html_content + `function filterDocs() {\n`
    html_content -> html_content + `  var val = document.getElementById('search').value.toLowerCase();\n`
    html_content -> html_content + `  var entries = document.querySelectorAll('.doc-entry');\n`
    html_content -> html_content + `  entries.forEach(function(el) { el.style.display = el.innerText.toLowerCase().indexOf(val) > -1 ? 'block' : 'none'; });\n`
    html_content -> html_content + `}\n`
    html_content -> html_content + `</script>\n</body>\n</html>\n`

    let html_path -> path.join(html_dir, `index.html`)
    file.write(html_path, html_content)
    io.writeln(`[DOC] Generated interactive HTML documentation: ` + html_path)

    <- {
        `ok` -> true,
        `markdown` -> md_path,
        `html` -> html_path,
        `modules` -> doc_items.length
    }
}
