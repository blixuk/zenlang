/!
  Manifest module for Zenlang project tooling.
  Handles parsing and serialization of Zen Data (zen.pkg.zd)
  project manifests and dependency lockfiles (zen.lock.zd),
  with fallback support for legacy JSON/.zbuild.
!/

import zen.data.zendata as zd
import zen.data.json as json
import zen.text.string as Str
import zen.io.file as file

/!
  Strips line comments (//), block comments (/* ... */),
  and doc comments from source text.
!/
export function strip_comments(text) {
    when text == Nothing {
        <- ``
    }
    let n -> Str.length(text)
    let out -> ``
    let i -> 0
    let in_str -> false
    let str_char -> `"`

    do while i < n {
        let c -> Str.at(text, i)
        
        when in_str {
            out -> out + c
            when c == `\\` and i + 1 < n {
                i -> i + 1
                out -> out + Str.at(text, i)
            } or when c == str_char {
                in_str -> false
            }
            i -> i + 1
        } or {
            when c == `"` or c == `'` or c == `\`` {
                in_str -> true
                str_char -> c
                out -> out + c
                i -> i + 1
            } or when c == `/` and i + 1 < n {
                let next_c -> Str.at(text, i + 1)
                when next_c == `/` {
                    // Line comment: skip until newline
                    i -> i + 2
                    do while i < n and Str.at(text, i) != `\n` {
                        i -> i + 1
                    }
                } or when next_c == `*` {
                    // Block comment: skip until */
                    i -> i + 2
                    do while i + 1 < n and not (Str.at(text, i) == `*` and Str.at(text, i + 1) == `/`) {
                        i -> i + 1
                    }
                    i -> i + 2
                } or when next_c == `!` {
                    // Doc comment: skip until !/
                    i -> i + 2
                    do while i + 1 < n and not (Str.at(text, i) == `!` and Str.at(text, i + 1) == `/`) {
                        i -> i + 1
                    }
                    i -> i + 2
                } or {
                    out -> out + c
                    i -> i + 1
                }
            } or {
                out -> out + c
                i -> i + 1
            }
        }
    }
    <- out
}

/!
  Parses a zen.pkg.zd (or .zbuild) manifest string into a structured project map.
!/
export function parse_manifest(text) {
    when text == Nothing or Str.trim(text) == `` {
        <- default_manifest(`unnamed`)
    }
    // Try Zen Data parser first
    let manifest_map -> zd.parse(text)
    when manifest_map == Nothing or not (manifest_map is Map) or (not manifest_map.has(`name`) and not manifest_map.has(`version`) and not manifest_map.has(`type`) and not manifest_map.has(`dependencies`)) {
        let clean -> strip_comments(text)
        let j_map -> json.parse(clean)
        when j_map != Nothing and (j_map is Map) {
            manifest_map -> j_map
        }
    }
    when manifest_map == Nothing or not (manifest_map is Map) {
        <- default_manifest(`unnamed`)
    }

    let name -> `app`
    when manifest_map.has(`name`) and manifest_map[`name`] != Nothing {
        name -> Str.to_string(manifest_map[`name`])
    }

    let version -> `0.1.0`
    when manifest_map.has(`version`) and manifest_map[`version`] != Nothing {
        version -> Str.to_string(manifest_map[`version`])
    }

    let ptype -> `cli`
    when manifest_map.has(`type`) and manifest_map[`type`] != Nothing {
        ptype -> Str.to_string(manifest_map[`type`])
    }

    let entry -> `src/main.zl`
    when manifest_map.has(`entry`) and manifest_map[`entry`] != Nothing {
        entry -> Str.to_string(manifest_map[`entry`])
    } or when ptype == `lib` {
        entry -> `src/lib.zl`
    }

    let tgt_bin -> `build/` + name
    when manifest_map.has(`target`) and manifest_map[`target`] != Nothing {
        tgt_bin -> Str.to_string(manifest_map[`target`])
    }

    let description -> ``
    when manifest_map.has(`description`) and manifest_map[`description`] != Nothing {
        description -> Str.to_string(manifest_map[`description`])
    }

    let author -> ``
    when manifest_map.has(`author`) and manifest_map[`author`] != Nothing {
        author -> Str.to_string(manifest_map[`author`])
    }

    let license -> `MIT`
    when manifest_map.has(`license`) and manifest_map[`license`] != Nothing {
        license -> Str.to_string(manifest_map[`license`])
    }

    let dependencies -> {}
    when manifest_map.has(`dependencies`) and manifest_map[`dependencies`] != Nothing {
        dependencies -> manifest_map[`dependencies`]
    }

    let c_flags -> `-O2`
    when manifest_map.has(`c_flags`) and manifest_map[`c_flags`] != Nothing {
        c_flags -> Str.to_string(manifest_map[`c_flags`])
    }

    let include_dirs -> [`deps/`]
    when manifest_map.has(`include_dirs`) and manifest_map[`include_dirs`] != Nothing {
        include_dirs -> manifest_map[`include_dirs`]
    }

    let scripts -> {}
    when manifest_map.has(`scripts`) and manifest_map[`scripts`] != Nothing {
        scripts -> manifest_map[`scripts`]
    }

    <- {
        `name` -> name,
        `version` -> version,
        `type` -> ptype,
        `entry` -> entry,
        `target` -> tgt_bin,
        `description` -> description,
        `author` -> author,
        `license` -> license,
        `dependencies` -> dependencies,
        `c_flags` -> c_flags,
        `include_dirs` -> include_dirs,
        `scripts` -> scripts
    }
}

/!
  Creates a default manifest map.
!/
export function default_manifest(name) {
    let app_name -> name
    when app_name == Nothing or app_name == `` {
        app_name -> `app`
    }
    <- {
        `name` -> app_name,
        `version` -> `0.1.0`,
        `type` -> `cli`,
        `entry` -> `src/main.zl`,
        `target` -> `build/` + app_name,
        `description` -> `A Zenlang application`,
        `author` -> ``,
        `license` -> `MIT`,
        `dependencies` -> {},
        `c_flags` -> `-O2`,
        `include_dirs` -> [`deps/`],
        `scripts` -> {
            `test` -> `zen test`,
            `doc` -> `zen doc`
        }
    }
}

/!
  Serializes a manifest map into a formatted Zen Data (.zd) manifest string.
!/
export function stringify_manifest(m) {
    let out -> `// ==========================================================\n`
    out -> out + `// Zenlang Package Manifest (zen.pkg.zd)\n`
    out -> out + `// ==========================================================\n\n`
    out -> out + `Package {\n`
    out -> out + `    \`name\`         -> \`` + Str.to_string(m[`name`]) + `\`,\n`
    out -> out + `    \`version\`      -> \`` + Str.to_string(m[`version`]) + `\`,\n`
    out -> out + `    \`type\`         -> \`` + Str.to_string(m[`type`]) + `\`,\n`
    out -> out + `    \`entry\`        -> \`` + Str.to_string(m[`entry`]) + `\`,\n`
    out -> out + `    \`target\`       -> \`` + Str.to_string(m[`target`]) + `\`,\n`
    out -> out + `    \`description\`  -> \`` + Str.to_string(m[`description`]) + `\`,\n`
    when m.has(`author`) and m[`author`] != Nothing and Str.to_string(m[`author`]) != `` {
        out -> out + `    \`author\`       -> \`` + Str.to_string(m[`author`]) + `\`,\n`
    }
    out -> out + `    \`license\`      -> \`` + Str.to_string(m[`license`]) + `\`,\n`
    out -> out + `    \`c_flags\`      -> \`` + Str.to_string(m[`c_flags`]) + `\`,\n`
    
    // Dependencies
    let deps -> m[`dependencies`]
    when deps == Nothing or not (deps is Map) or deps.keys().length == 0 {
        out -> out + `    \`dependencies\` -> {},\n`
    } or {
        out -> out + `    \`dependencies\` -> {\n`
        do for k in deps.keys() {
            out -> out + `        \`` + Str.to_string(k) + `\` -> \`` + Str.to_string(deps[k]) + `\`,\n`
        }
        out -> out + `    },\n`
    }
    
    // Scripts
    let sc -> m[`scripts`]
    when sc == Nothing or not (sc is Map) or sc.keys().length == 0 {
        out -> out + `    \`scripts\`      -> {}\n`
    } or {
        out -> out + `    \`scripts\`      -> {\n`
        do for k in sc.keys() {
            out -> out + `        \`` + Str.to_string(k) + `\` -> \`` + Str.to_string(sc[k]) + `\`,\n`
        }
        out -> out + `    }\n`
    }
    
    out -> out + `}\n`
    <- out
}

/!
  Parses a zen.lock.zd (or zen.lock) lockfile string.
!/
export function parse_lockfile(text) {
    when text == Nothing or Str.trim(text) == `` {
        <- { `version` -> `1.0`, `packages` -> {} }
    }
    let lock -> zd.parse(text)
    when lock == Nothing or not (lock is Map) or (not lock.has(`packages`) and not lock.has(`version`)) {
        let clean -> strip_comments(text)
        let j_lock -> json.parse(clean)
        when j_lock != Nothing and (j_lock is Map) {
            lock -> j_lock
        }
    }
    when lock == Nothing or not (lock is Map) {
        <- { `version` -> `1.0`, `packages` -> {} }
    }
    when not lock.has(`packages`) {
        lock[`packages`] -> {}
    }
    when not lock.has(`version`) {
        lock[`version`] -> `1.0`
    }
    <- lock
}

/!
  Serializes a lockfile map into formatted Zen Data (.zd).
!/
export function stringify_lockfile(lock) {
    let out -> `// ==========================================================\n`
    out -> out + `// Zenlang Dependency Lockfile (zen.lock.zd)\n`
    out -> out + `// Auto-generated by zen pkg. Do not edit manually.\n`
    out -> out + `// ==========================================================\n\n`
    out -> out + `Lockfile {\n`
    out -> out + `    \`version\`  -> \`` + Str.to_string(lock[`version`]) + `\`,\n`
    let pkgs -> lock[`packages`]
    when pkgs == Nothing or not (pkgs is Map) or pkgs.keys().length == 0 {
        out -> out + `    \`packages\` -> {}\n`
    } or {
        out -> out + `    \`packages\` -> {\n`
        do for pname in pkgs.keys() {
            let pinfo -> pkgs[pname]
            out -> out + `        \`` + Str.to_string(pname) + `\` -> {\n`
            when pinfo is Map {
                do for ik in pinfo.keys() {
                    out -> out + `            \`` + Str.to_string(ik) + `\` -> \`` + Str.to_string(pinfo[ik]) + `\`,\n`
                }
            }
            out -> out + `        },\n`
        }
        out -> out + `    }\n`
    }
    out -> out + `}\n`
    <- out
}
