/!
 String manipulation module.
 Provides functions for string operations and conversions.
!/

/!
 Splits a string into a list of substrings based on a separator.
 @param s The string to split.
 @param sep The separator string.
 @return A list of substrings.
!/
function split(s, sep) {
    <- __builtin_string.split(s, sep)
}

/!
 Joins a list of strings into a single string using a separator.
 @param parts The list of strings to join.
 @param sep The separator string.
 @return The joined string.
!/
function join(parts, sep) {
    <- __builtin_string.join(parts, sep)
}

/!
 Trims whitespace from both ends of a string.
 @param s The string to trim.
 @return The trimmed string.
!/
function trim(s) {
    <- __builtin_string.trim(s)
}

/!
 Returns a substring of the given string.
 @param s The string.
 @param start The start index (inclusive).
 @param end The end index (exclusive).
 @return The substring.
!/
function substring(s, start, end) {
    <- __builtin_string.substring(s, start, end)
}

/!
 Checks if a string starts with the given prefix.
 @param s The string.
 @param prefix The prefix to check.
 @return True if it starts with prefix, False otherwise.
!/
function starts_with(s, prefix) {
    <- __builtin_string.starts_with(s, prefix)
}

/!
 Checks if a string ends with the given suffix.
 @param s The string.
 @param suffix The suffix to check.
 @return True if it ends with suffix, False otherwise.
!/
function ends_with(s, suffix) {
    <- __builtin_string.ends_with(s, suffix)
}

/!
 Checks if a string contains the given substring.
 @param s The string.
 @param sub The substring to check.
 @return True if it contains sub, False otherwise.
 !/
function contains(s, sub) {
    <- sub in s
}

/!
 Replaces occurrences of a substring with another substring.
 @param s The string.
 @param old The substring to replace.
 @param new The replacement substring.
 @return The resulting string.
!/
function replace(s, old, new) {
    <- __builtin_string.replace(s, old, new)
}

/!
 Returns the length of a string.
 @param s The string.
 @return The length of the string.
!/
function length(s) {
    <- __builtin_string.length(s)
}

/!
 Converts a string to lowercase.
 @param s The string.
 @return The lowercase string.
!/
function to_lower(s) {
    <- __builtin_string.to_lower(s)
}

/!
 Converts a string to uppercase.
 @param s The string.
 @return The uppercase string.
!/
function to_upper(s) {
    <- __builtin_string.to_upper(s)
}

/!
 Returns the index of the first occurrence of a substring.
 @param s The string.
 @param sub The substring to find.
 @return The index of the substring, or -1 if not found.
!/
function index_of(s, sub) {
    <- __builtin_string.index_of(s, sub)
}

/!
 Returns the character at the specified index.
 @param s The string.
 @param i The index.
 @return The character at index i.
!/
function at(s, i) {
    <- __builtin_string.at(s, i)
}

/!
 Returns the ASCII / byte code at the specified index, or -1 if out of bounds.
 @param s The string.
 @param i The index.
 @return The integer byte value.
!/
function byte_at(s, i) {
    <- __builtin_string.byte_at(s, i)
}

/!
 Converts a value to its string representation.
 @param x The value to convert.
 @return The string representation of x.
!/
function to_string(x) {
    <- __builtin_string.to_string(x)
}

/!
 Repeats a string n times.
 @param s The string to repeat.
 @param count Number of times to repeat.
 @return The repeated string.
!/
function repeat(s, count) {
    when count <= 0 { <- `` }
    let out -> ``
    let idx -> 0
    do while idx < count {
        out -> out + s
        idx -> 0 + idx + 1
    }
    <- out
}

/!
 Pads string on the left with pad_char to reach target length.
!/
function pad_left(s, target_len, pad_char) {
    let str_val -> to_string(s)
    let cur_len -> length(str_val)
    when cur_len >= target_len { <- str_val }
    let pad -> pad_char
    when pad == Nothing or length(pad) == 0 { pad -> ` ` }
    let needed -> target_len - cur_len
    <- repeat(pad, needed) + str_val
}

/!
 Pads string on the right with pad_char to reach target length.
!/
function pad_right(s, target_len, pad_char) {
    let str_val -> to_string(s)
    let cur_len -> length(str_val)
    when cur_len >= target_len { <- str_val }
    let pad -> pad_char
    when pad == Nothing or length(pad) == 0 { pad -> ` ` }
    let needed -> target_len - cur_len
    <- str_val + repeat(pad, needed)
}

function is_whitespace_char(c) {
    <- c == ` ` or c == `\t` or c == `\n` or c == `\r`
}

/!
  Returns a list of single-character strings.
  @param s The string.
  @return A list of characters.
!/
function chars(s) {
    let out -> []
    let n -> length(s)
    let i -> 0
    do while i < n {
        out.append(at(s, i))
        i -> i + 1
    }
    <- out
}

/!
  Strips leading whitespace from a string.
  @param s The string.
  @return String without leading whitespace.
!/
function trim_start(s) {
    let n -> length(s)
    let i -> 0
    do while i < n and is_whitespace_char(at(s, i)) {
        i -> i + 1
    }
    when i == 0 { <- s }
    when i >= n { <- `` }
    <- substring(s, i, n)
}

function trim_left(s) {
    <- trim_start(s)
}

/!
  Strips trailing whitespace from a string.
  @param s The string.
  @return String without trailing whitespace.
!/
function trim_end(s) {
    let n -> length(s)
    let i -> n - 1
    do while i >= 0 and is_whitespace_char(at(s, i)) {
        i -> i - 1
    }
    when i < 0 { <- `` }
    when i == n - 1 { <- s }
    <- substring(s, 0, i + 1)
}

function trim_right(s) {
    <- trim_end(s)
}

/!
  Checks if a string is empty (length == 0).
  @param s The string.
  @return True if empty, False otherwise.
!/
function is_empty(s) {
    <- s == `` or length(s) == 0
}

/!
  Checks if a string is blank (only whitespace).
  @param s The string.
  @return True if blank, False otherwise.
!/
function is_blank(s) {
    <- length(trim(s)) == 0
}

/!
  Returns the index of the last occurrence of a substring.
  @param s The string.
  @param sub The substring to find.
  @return The index or -1 if not found.
!/
function last_index_of(s, sub) {
    let n -> length(s)
    let sub_len -> length(sub)
    when sub_len == 0 { <- n }
    when sub_len > n { <- -1 }
    let i -> n - sub_len
    do while i >= 0 {
        when substring(s, i, i + sub_len) == sub {
            <- i
        }
        i -> i - 1
    }
    <- -1
}
