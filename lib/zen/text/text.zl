/!
 Semantic Text module.
 Provides structures for natural language processing:
 Word → Sentence → Paragraph → Chapter → Book.
 !/

import zen.text.string as Str

/!
 Represents a single word.
 !/
structure Word {
    text: String
}

/!
 Represents a sentence containing multiple words.
 !/
structure Sentence {
    text: String
}

/!
 Represents a paragraph containing multiple sentences.
 !/
structure Paragraph {
    text: String
}

/!
 Represents a chapter: a title plus an ordered list of paragraphs.
 !/
structure Chapter {
    title: String
    paragraphs: List
}

/!
 Represents a book: a title plus an ordered list of chapters.
 !/
structure Book {
    title: String
    chapters: List
}

scope Word {
    /!
     Checks if the word is entirely uppercase.
     @param w The Word structure.
     @return True if all runes are uppercase.
     !/
    function is_uppercase(w: Word) {
        let s -> w.text
        <- s == Str.to_upper(s)
    }

    /!
     Returns a capitalized version of the word.
     @param w The Word structure.
     @return A new Word with the first letter capitalized.
     !/
    function capitalize(w: Word) : Word {
        let s -> w.text
        when s.length == 0 { <- Word { text -> s } }
        
        let first -> Str.to_upper(s.at(0))
        let rest -> s.substring(1)
        <- Word { text -> first + rest }
    }
}

scope Sentence {
    /!
     Splits the sentence into a list of Words.
     @param s The Sentence structure.
     @return A list of Word structures.
     !/
    function to_words(s: Sentence) {
        let parts -> Str.split(s.text, ` `)
        let words -> []
        do for part in parts {
            words.append(Word { text -> part })
        }
        <- words
    }

    /!
     Counts the number of words in the sentence.
     @param s The Sentence structure.
     @return The number of words.
     !/
    function count_words(s: Sentence) {
        let words -> to_words(s)
        <- words.length
    }
}

scope Paragraph {
    /!
     Wraps the paragraph text to a maximum width.
     @param p The Paragraph structure.
     @param width The maximum line width.
     @return A new Paragraph with wrapped text.
     !/
    function wrap(p: Paragraph, width) : Paragraph {
        let text -> p.text
        let result -> ``
        let current_line -> ``
        
        let words -> Str.split(text, ` `)
        do for word in words {
            when current_line.length + word.length + 1 > width {
                result -> result + current_line + `\n`
                current_line -> word
            } or {
                when current_line.length == 0 {
                    current_line -> word
                } or {
                    current_line -> current_line + ` ` + word
                }
            }
        }
        result -> result + current_line
        <- Paragraph { text -> result }
    }
}

scope Chapter {
    /!
     Builds a chapter from a title and a list of Paragraph structures.
     @param title Chapter title.
     @param paragraphs List of Paragraphs.
     !/
    function from_paragraphs(title, paragraphs) : Chapter {
        <- Chapter { title -> title, paragraphs -> paragraphs }
    }

    /!
     Number of paragraphs in the chapter.
     !/
    function count_paragraphs(ch: Chapter) {
        <- ch.paragraphs.length
    }

    /!
     Returns a new chapter with an additional paragraph at the end.
     !/
    function append_paragraph(ch: Chapter, p: Paragraph) : Chapter {
        let paras -> []
        do for item in ch.paragraphs {
            paras.append(item)
        }
        paras.append(p)
        <- Chapter { title -> ch.title, paragraphs -> paras }
    }

    /!
     Joins title and paragraph bodies into a single string.
     Title is first line; paragraphs are separated by blank lines.
     !/
    function to_text(ch: Chapter) {
        let result -> ch.title
        do for p in ch.paragraphs {
            result -> result + `\n\n` + p.text
        }
        <- result
    }

    /!
     Wraps every paragraph in the chapter to the given width.
     (Inlines wrap logic so native `-g` does not depend on cross-scope static calls.)
     !/
    function wrap_all(ch: Chapter, width) : Chapter {
        let wrapped -> []
        do for p in ch.paragraphs {
            let text -> p.text
            let result -> ``
            let current_line -> ``
            let words -> Str.split(text, ` `)
            do for word in words {
                when current_line.length + word.length + 1 > width {
                    result -> result + current_line + `\n`
                    current_line -> word
                } or {
                    when current_line.length == 0 {
                        current_line -> word
                    } or {
                        current_line -> current_line + ` ` + word
                    }
                }
            }
            result -> result + current_line
            wrapped.append(Paragraph { text -> result })
        }
        <- Chapter { title -> ch.title, paragraphs -> wrapped }
    }
}

scope Book {
    /!
     Builds a book from a title and a list of Chapter structures.
     @param title Book title.
     @param chapters List of Chapters.
     !/
    function from_chapters(title, chapters) : Book {
        <- Book { title -> title, chapters -> chapters }
    }

    /!
     Number of chapters in the book.
     !/
    function count_chapters(b: Book) {
        <- b.chapters.length
    }

    /!
     Total paragraphs across all chapters.
     !/
    function count_paragraphs(b: Book) {
        let total -> 0
        do for ch in b.chapters {
            total -> total + ch.paragraphs.length
        }
        <- total
    }

    /!
     Returns a new book with an additional chapter at the end.
     !/
    function append_chapter(b: Book, ch: Chapter) : Book {
        let chapters -> []
        do for item in b.chapters {
            chapters.append(item)
        }
        chapters.append(ch)
        <- Book { title -> b.title, chapters -> chapters }
    }

    /!
     Joins book title and each chapter's text.
     Chapters are separated by a form-feed style blank block (`\n\n---\n\n`).
     !/
    function to_text(b: Book) {
        let result -> b.title
        do for ch in b.chapters {
            let chapter_text -> ch.title
            do for p in ch.paragraphs {
                chapter_text -> chapter_text + `\n\n` + p.text
            }
            result -> result + `\n\n---\n\n` + chapter_text
        }
        <- result
    }
}
