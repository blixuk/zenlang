/!
    Fuzzy String Matching and Levenshtein Distance.
    Provides edit distance calculations, fuzzy subsequence matching, and ranked search filtering.
!/

import zen.text.string as Str
import zen.math.math as Math

/!
    Computes Levenshtein edit distance between strings a and b.
!/
function levenshtein(a, b) {
    let s1 -> Str.to_string(a)
    let s2 -> Str.to_string(b)
    let len1 -> Str.length(s1)
    let len2 -> Str.length(s2)

    when (len1 == 0) { <- len2 }
    when (len2 == 0) { <- len1 }

    // dp row allocation
    let prev_row -> []
    let j -> 0
    do while j <= len2 {
        prev_row.append(j)
        j -> j + 1
    }

    let i -> 1
    do while i <= len1 {
        let ch1 -> Str.at(s1, i - 1)
        let curr_row -> [i]
        j -> 1
        do while j <= len2 {
            let ch2 -> Str.at(s2, j - 1)
            let cost -> when (ch1 == ch2) { 0 } or { 1 }
            let insertion -> curr_row[j - 1] + 1
            let deletion -> prev_row[j] + 1
            let substitution -> prev_row[j - 1] + cost

            let min_cost -> Math.min(insertion, Math.min(deletion, substitution))
            curr_row.append(min_cost)
            j -> j + 1
        }
        prev_row -> curr_row
        i -> i + 1
    }

    <- prev_row[len2]
}

/!
    Checks if characters in pattern appear sequentially in target_str (case-insensitive).
!/
function is_match(pattern, target_str) {
    let p_str -> Str.to_string(pattern)
    let t_str -> Str.to_string(target_str)
    let p -> Str.to_lower(p_str)
    let t -> Str.to_lower(t_str)
    let p_len -> Str.length(p)
    let t_len -> Str.length(t)

    when (p_len == 0) { <- True }
    when (p_len > t_len) { <- False }

    let p_idx -> 0
    let t_idx -> 0
    do while p_idx < p_len and t_idx < t_len {
        when (Str.at(p, p_idx) == Str.at(t, t_idx)) {
            p_idx -> p_idx + 1
        }
        t_idx -> t_idx + 1
    }

    let matched -> when (p_idx == p_len) { True } or { False }
    <- matched
}

function match(pattern, target_str) {
    <- is_match(pattern, target_str)
}

/!
    Calculates a fuzzy similarity score between 0.0 and 1.0.
    Considers sequential match, prefix bonus, and boundary hits.
!/
function score(pattern, target_str) {
    let p_str -> Str.to_string(pattern)
    let t_str -> Str.to_string(target_str)
    let p -> Str.to_lower(p_str)
    let t -> Str.to_lower(t_str)
    let p_len -> Str.length(p)
    let t_len -> Str.length(t)

    when (p_len == 0) { <- 1.0 }
    when (t_len == 0) { <- 0.0 }
    when (p == t) { <- 1.0 }

    let has_subsequence -> is_match(p, t)
    when (not has_subsequence) {
        // Fallback: ratio based on Levenshtein distance
        let dist -> levenshtein(p, t)
        let max_len -> Math.max(p_len, t_len)
        let sim -> 1.0 - ((0.0 + dist) / (0.0 + max_len))
        when (sim < 0.0) { <- 0.0 }
        <- sim * 0.5
    }

    // Base score for matching all characters in order
    let base_score -> (0.0 + p_len) / (0.0 + t_len)

    // Prefix bonus
    let bonus -> 0.0
    when (Str.starts_with(t, p)) {
        bonus -> 0.3
    } or when (Str.at(p, 0) == Str.at(t, 0)) {
        bonus -> 0.15
    }

    let final_score -> base_score * 0.7 + bonus
    when (final_score > 1.0) { final_score -> 1.0 }
    <- final_score
}

/!
    Filters and ranks a list of candidate strings against pattern.
    @param pattern Search query.
    @param candidates List of strings.
    @param limit Max items to return (0 for all matching).
    @return List of matching strings sorted by score descending.
!/
function filter(pattern, candidates, limit) {
    when (candidates == Nothing or candidates.length == 0) { <- [] }
    let count -> candidates.length

    let scored -> []
    let i -> 0
    do while i < count {
        let cand -> Str.to_string(candidates[i])
        let s -> score(pattern, cand)
        when (s > 0.0) {
            scored.append({ `cand` -> cand, `score` -> s })
        }
        i -> i + 1
    }

    // Simple bubble sort descending by score
    let n -> scored.length
    i -> 0
    do while i < n {
        let j -> 0
        do while j < n - i - 1 {
            let a -> scored[j]
            let b -> scored[j + 1]
            let a_score -> 0.0 + a[`score`]
            let b_score -> 0.0 + b[`score`]
            when (a_score < b_score) {
                scored[j] -> b
                scored[j + 1] -> a
            }
            j -> j + 1
        }
        i -> i + 1
    }

    let result -> []
    let max_items -> when (limit > 0 and limit < n) { limit } or { n }
    i -> 0
    do while i < max_items {
        result.append(scored[i][`cand`])
        i -> i + 1
    }
    <- result
}
