/!
 System interface module.
 Provides access to command line arguments, environment variables, and process control.
!/

/!
 Returns the command line arguments passed to the process.
 @return A list of strings representing the arguments.
!/
function get_args() {
    <- __builtin_sys.get_args()
}

/!
 Exits the current process with the specified exit code.
 @param code The exit code (0 for success).
!/
function exit(code) {
    <- __builtin_sys.exit(code)
}

/!
 Returns the value of an environment variable.
 @param key The name of the environment variable.
 @return The value of the environment variable as a string.
!/
function get_env(key) : String {
    <- __builtin_sys.get_env(key)
}

/!
 Returns the current working directory.
 @return The current working directory string.
 !/
function get_cwd() {
    <- __builtin_sys.get_cwd()
}

/!
 Returns the operating system platform name.
 @return The platform name string (e.g., 'linux', 'darwin', 'win32').
 !/
function platform() {
    <- __builtin_sys.platform()
}

/!
 Returns the Zenlang version string.
 @return The version string.
 !/
function version() {
    <- __builtin_sys.version()
}

/!
 Executes a shell command using the system shell.
 @param cmd The command to execute.
 @return The exit code of the command.
 !/
function exec(cmd) {
    <- __builtin_sys.exec(cmd)
}
