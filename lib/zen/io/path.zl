/!
  Path manipulation module for Zenlang.
  Provides Unix-style path manipulation, segment resolution, and normalization.
!/

import zen.text.string as Str

/!
  Joins two or more path components using the system separator (/).
  @param p1 The first path component.
  @param p2 The second path component.
  @return The joined path string.
!/
export function join(p1, p2) {
    when p1 == `` { <- p2 }
    when p2 == `` { <- p1 }

    let p1_ends -> Str.ends_with(p1, `/`)
    let p2_starts -> Str.starts_with(p2, `/`)

    when p1_ends and p2_starts {
        <- p1 + Str.substring(p2, 1, Str.length(p2))
    }
    when p1_ends or p2_starts {
        <- p1 + p2
    }
    <- p1 + `/` + p2
}

/!
  Returns the final component of a path.
  @param p The path string.
  @return The basename of the path.
!/
export function basename(p) {
    when p == `` { <- `.` }
    when p == `/` { <- `/` }

    let parts -> Str.split(p, `/`)
    let n -> parts.length

    // Handle trailing slash
    when parts[n - 1] == `` {
        when n > 1 {
            <- parts[n - 2]
        }
        <- `/`
    }

    <- parts[n - 1]
}

export function base_name(p) {
    <- basename(p)
}

/!
  Returns the parent directory of a path.
  @param p The path string.
  @return The directory name.
!/
export function dirname(p) {
    when p == `` or p == `.` { <- `.` }
    when p == `/` { <- `/` }

    let parts -> Str.split(p, `/`)
    let n -> parts.length

    // If ends in slash
    when parts[n - 1] == `` {
        n -> n - 1
    }

    when n <= 1 {
        when Str.starts_with(p, `/`) { <- `/` }
        <- `.`
    }

    let result -> parts[0]
    when result == `` {
        result -> `/` + parts[1]
        let i -> 2
        do while i < n - 1 {
            result -> result + `/` + parts[i]
            i -> i + 1
        }
        <- result
    }

    let i -> 1
    do while i < n - 1 {
        result -> result + `/` + parts[i]
        i -> i + 1
    }
    <- result
}

export function dir_name(p) {
    <- dirname(p)
}

/!
  Checks if a path is absolute (starts with /).
  @param p The path string.
  @return True if absolute, False otherwise.
!/
export function is_absolute(p) {
    <- Str.starts_with(p, `/`)
}

/!
  Checks if a path is relative (does not start with /).
  @param p The path string.
  @return True if relative, False otherwise.
!/
export function is_relative(p) {
    <- not is_absolute(p)
}

/!
  Returns the extension of a path (including the leading dot).
  @param p The path string.
  @return The extension, or empty string if none.
!/
export function extname(p) {
    when p == `` or p == `.` {
        <- ``
    }
    let base -> basename(p)
    let dot_idx -> Str.last_index_of(base, `.`)
    when dot_idx <= 0 {
        <- ``
    }
    <- Str.substring(base, dot_idx, Str.length(base))
}

export function extension(p) {
    <- extname(p)
}

export function ext(p) {
    <- extname(p)
}

/!
  Normalizes a path, resolving '.' and '..' segments.
  @param p The path string.
  @return The normalized path.
!/
export function normalize(p) {
    when p == `` { <- `.` }
    let is_abs -> is_absolute(p)
    let raw_parts -> Str.split(p, `/`)
    let stack -> []
    do for part in raw_parts {
        when part == `` or part == `.` {
            // skip empty segment or current directory
        } or when part == `..` {
            when stack.length > 0 and stack[stack.length - 1] != `..` {
                stack.pop()
            } or when not is_abs {
                stack.append(`..`)
            }
        } or {
            stack.append(part)
        }
    }
    let joined -> Str.join(stack, `/`)
    when is_abs {
        <- `/` + joined
    }
    when joined == `` {
        <- `.`
    }
    <- joined
}
