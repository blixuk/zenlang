/!
 Time and Duration utility module.
 Provides functions for time tracking, delays, and duration management.
 !/

/!
 Duration structure representing a length of time.
 Wraps a Decimal value representing seconds.
 !/
structure Duration {
    seconds: Decimal
}

/!
 Returns the current wallclock time in seconds since the Epoch.
 @return The current timestamp.
 !/
function now() {
    <- __builtin_time.now()
}

/!
 Returns the current wallclock time in seconds since the Epoch.
 Alias for now().
 @return The current timestamp.
 !/
function wallclock() {
    <- __builtin_time.wallclock()
}

/!
 Returns the current monotonic time in seconds.
 Useful for measuring elapsed time without being affected by system clock changes.
 @return The current monotonic timestamp.
 !/
function monotonic() {
    <- __builtin_time.monotonic()
}

/!
 Pauses the current execution for the specified duration.
 @param d The duration to sleep (can be a number of seconds or a Duration).
 !/
function sleep(d) {
    // Prefer numeric seconds. For a Duration value, pass `d.seconds`.
    // (Native `when d is Duration` field rebinding is not yet fully lowered.)
    __builtin_time.sleep(d)
}

/!
 Timer utility for measuring elapsed time.
 !/
class Timer {
    let _start_time
    let _running

    /!
     Initializes a new timer.
     !/
    function init() {
        self._start_time -> 0
        self._running -> False
    }

    /!
     Starts or restarts the timer.
     !/
    function start() {
        self._start_time -> __builtin_time.monotonic()
        self._running -> True
    }

    /!
     Returns the elapsed time since start() was called.
     @return The elapsed time in seconds (as a Decimal).
     !/
    function elapsed() {
        when self._running == False { <- 0 }
        <- __builtin_time.monotonic() - self._start_time
    }

    /!
     Returns the elapsed time in milliseconds.
     @return The elapsed time in ms.
     !/
    function elapsed_ms() {
        <- self.elapsed() * 1000
    }

    /!
     Stops the timer.
     !/
    function stop() {
        self._running -> False
    }
}
