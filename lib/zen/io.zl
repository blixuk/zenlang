/!
 Standard Input/Output module.
 Provides functions for terminal interaction and basic logging.
!/

// Export capabilities as objects for structured access
let out -> __builtin_output
let stdin -> __builtin_input


/!
 Writes a value to the standard output followed by a newline.
 @param value The value to write.
!/
function write(value) {
    out.write(value + `\n`)
}

/!
 Reads a line of input from the standard input.
 @param prompt The prompt to display to the user.
 @return The string read from input.
!/
function read(prompt) {
    <- __builtin_input.read(prompt)
}

/!
 Logs an informational message.
 @param value The message to log.
!/
function info(value) {
    __builtin_output.info(value)
}

/!
 Logs a warning message.
 @param value The message to log.
!/
function warn(value) {
    __builtin_output.warn(value)
}

/!
 Logs an error message.
 @param value The message to log.
!/
function error(value) {
    __builtin_output.error(value)
}

/!
 Logs a debug message.
 @param value The message to log.
!/
function debug(value) {
    __builtin_output.debug(value)
}
/!
  Reads the entire content of a file.
  @param path The path to the file.
  @return The content of the file as a string.
!/
function read_file(path) {
    <- __builtin_file.read(path)
}

/!
  Writes content to a file, overwriting its current content.
  @param path The path to the file.
  @param content The content to write.
!/
function write_file(path, content) {
    <- __builtin_file.write(path, content)
}

/!
  Checks if a file exists at the given path.
  @param path The path to check.
  @return True if it exists, False otherwise.
!/
function exists(path) {
    <- __builtin_file.exists(path)
}

function file_exists(path) {
    <- exists(path)
}

/!
  Lists contents of a directory.
  @param path The directory path.
  @return A list of strings containing the file and folder names.
!/
function list_dir(path) {
    <- __builtin_file.list_dir(path)
}
