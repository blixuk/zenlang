/!
  zen.graphics.qrcode - Pure Zenlang QR Code Generator and Decoder (ISO/IEC 18004).
  Provides complete 2D matrix symbology generation and decoding:
    - Data Encodings: Numeric, Alphanumeric, and 8-bit Byte modes.
    - Reed-Solomon Error Correction: GF(256) arithmetic, log/antilog tables,
      generator polynomials, syndrome calculation, Berlekamp-Massey, Chien search,
      and Forney error value recovery for standard levels L, M, Q, H.
    - Matrix Layout: Finder patterns, separators, timing tracks, alignment patterns
      (Versions 2-10), dark module, and BCH(15, 5) format info with 0x5412 masking.
    - 8 Standard Masks with ISO penalty evaluation (N1, N2, N3, N4).
    - Multi-Target Renderers: Unicode half-blocks (2-px/cell), ASCII, SVG, BMP.
    - Multi-Target Readers: Terminal art, ASCII, SVG, BMP image bytes, raw matrix.
  100% pure Zenlang with zero external C dependencies.
!/

use zen.text.string as Str

// ============================================================================
// 1. Galois Field GF(2^8) Arithmetic Subsystem (Primitive poly: 0x11D / 285)
// ============================================================================

function _build_gf() {
    let exp_tab -> []
    let log_tab -> []
    let i -> 0
    do while i < 512 {
        exp_tab.append(0)
        i -> i + 1
    }
    i -> 0
    do while i < 256 {
        log_tab.append(0)
        i -> i + 1
    }
    let x -> 1
    i -> 0
    do while i < 255 {
        exp_tab[i] -> x
        exp_tab[i + 255] -> x
        log_tab[x] -> i
        x -> x << 1
        when x >= 256 {
            x -> x ^^ 285
        }
        i -> i + 1
    }
    <- { `exp` -> exp_tab, `log` -> log_tab }
}

let _GF -> _build_gf()

function gf_exp(i) {
    <- _GF[`exp`][i]
}

function gf_log(x) {
    <- _GF[`log`][x]
}

function gf_mul(x, y) {
    when x == 0 or y == 0 {
        <- 0
    }
    let sum -> _GF[`log`][x] + _GF[`log`][y]
    <- _GF[`exp`][sum]
}

function gf_div(x, y) {
    when x == 0 {
        <- 0
    }
    when y == 0 {
        <- 0
    }
    let diff -> (_GF[`log`][x] + 255 - _GF[`log`][y]) % 255
    <- _GF[`exp`][diff]
}

function poly_mul(p, q) {
    let r -> []
    let r_len -> p.length + q.length - 1
    let i -> 0
    do while i < r_len {
        r.append(0)
        i -> i + 1
    }
    i -> 0
    do while i < p.length {
        let j -> 0
        do while j < q.length {
            r[i + j] -> r[i + j] ^^ gf_mul(p[i], q[j])
            j -> j + 1
        }
        i -> i + 1
    }
    <- r
}

function poly_eval(p, x) {
    let y -> 0
    for c in p {
        y -> gf_mul(y, x) ^^ c
    }
    <- y
}

function rs_generator_poly(k) {
    let g -> [1]
    let i -> 0
    do while i < k {
        g -> poly_mul(g, [1, gf_exp(i)])
        i -> i + 1
    }
    <- g
}

/!
  Computes Reed-Solomon error correction codewords for a message block.
!/
function rs_encode(msg, ec_count) {
    let g -> rs_generator_poly(ec_count)
    let out -> []
    for b in msg {
        out.append(b)
    }
    let i -> 0
    do while i < ec_count {
        out.append(0)
        i -> i + 1
    }
    i -> 0
    do while i < msg.length {
        let coef -> out[i]
        when coef != 0 {
            let j -> 0
            do while j < g.length {
                out[i + j] -> out[i + j] ^^ gf_mul(g[j], coef)
                j -> j + 1
            }
        }
        i -> i + 1
    }
    let rem -> []
    i -> msg.length
    do while i < out.length {
        rem.append(out[i])
        i -> i + 1
    }
    <- rem
}

/!
  Decodes a received block (data + EC) using Berlekamp-Massey, Chien search, and Forney.
  Returns { success: Bool, data: List[Int], errors: Int }.
!/
function rs_decode(rcvd, k_data, ec_count) {
    let i -> 0
    let j -> 0
    let syndromes -> []
    let syn_sum -> 0
    i -> 0
    do while i < ec_count {
        let s -> poly_eval(rcvd, gf_exp(i))
        syndromes.append(s)
        syn_sum -> syn_sum | s
        i -> i + 1
    }
    when syn_sum == 0 {
        let pure_data -> []
        i -> 0
        do while i < k_data {
            pure_data.append(rcvd[i])
            i -> i + 1
        }
        <- { `success` -> True, `data` -> pure_data, `errors` -> 0 }
    }

    // Berlekamp-Massey algorithm
    let c_poly -> [1]
    let b_poly -> [1]
    let l_deg -> 0
    let m -> 1
    let b_val -> 1
    let n -> 0
    do while n < ec_count {
        let d -> syndromes[n]
        j -> 1
        do while j <= l_deg {
            d -> d ^^ gf_mul(c_poly[j], syndromes[n - j])
            j -> j + 1
        }
        when d == 0 {
            m -> m + 1
        } or {
            let t_poly -> []
            for val in c_poly { t_poly.append(val) }
            let scale -> gf_div(d, b_val)
            let need_len -> b_poly.length + m
            do while c_poly.length < need_len {
                c_poly.append(0)
            }
            j -> 0
            do while j < b_poly.length {
                c_poly[j + m] -> c_poly[j + m] ^^ gf_mul(scale, b_poly[j])
                j -> j + 1
            }
            when 2 * l_deg <= n {
                l_deg -> n + 1 - l_deg
                b_poly -> t_poly
                b_val -> d
                m -> 1
            } or {
                m -> m + 1
            }
        }
        n -> n + 1
    }

    while c_poly.length > 1 and c_poly[c_poly.length - 1] == 0 {
        let trimmed -> []
        let ti -> 0
        do while ti < c_poly.length - 1 {
            trimmed.append(c_poly[ti])
            ti -> ti + 1
        }
        c_poly -> trimmed
    }

    let deg -> c_poly.length - 1
    when deg != l_deg {
        <- { `success` -> False, `data` -> [], `errors` -> -1 }
    }

    // Chien search for error positions
    let error_positions -> []
    let total_len -> rcvd.length
    i -> 0
    do while i < total_len {
        let x_inv -> gf_exp((255 - i) % 255)
        let val -> 0
        let p_pow -> 1
        j -> 0
        do while j < c_poly.length {
            val -> val ^^ gf_mul(c_poly[j], p_pow)
            p_pow -> gf_mul(p_pow, x_inv)
            j -> j + 1
        }
        when val == 0 {
            error_positions.append(total_len - 1 - i)
        }
        i -> i + 1
    }

    when error_positions.length != deg {
        <- { `success` -> False, `data` -> [], `errors` -> -1 }
    }

    // Forney algorithm for error values
    let s_poly -> []
    for s_val in syndromes { s_poly.append(s_val) }
    let sc_prod -> poly_mul(s_poly, c_poly)
    let omega -> []
    i -> 0
    do while i < ec_count and i < sc_prod.length {
        omega.append(sc_prod[i])
        i -> i + 1
    }

    let corrected -> []
    for c in rcvd { corrected.append(c) }

    for pos in error_positions {
        let l_idx -> total_len - 1 - pos
        let x_inv -> gf_exp((255 - l_idx) % 255)
        let x_loc -> gf_exp(l_idx % 255)

        let num -> 0
        let p_pow -> 1
        j -> 0
        do while j < omega.length {
            num -> num ^^ gf_mul(omega[j], p_pow)
            p_pow -> gf_mul(p_pow, x_inv)
            j -> j + 1
        }

        let denom -> 0
        p_pow -> 1
        j -> 1
        do while j < c_poly.length {
            when j % 2 == 1 {
                denom -> denom ^^ gf_mul(c_poly[j], p_pow)
            }
            p_pow -> gf_mul(p_pow, x_inv)
            j -> j + 1
        }

        when denom == 0 {
            <- { `success` -> False, `data` -> [], `errors` -> -1 }
        }

        let err_val -> gf_mul(x_loc, gf_div(num, denom))
        corrected[pos] -> corrected[pos] ^^ err_val
    }

    let result_data -> []
    i -> 0
    do while i < k_data {
        result_data.append(corrected[i])
        i -> i + 1
    }
    <- { `success` -> True, `data` -> result_data, `errors` -> error_positions.length }
}


// ============================================================================
// 2. ISO/IEC 18004 Version & Error Correction Tables (Versions 1 through 10)
// ============================================================================

/!
  Returns specification entry for a given version (1-10) and EC level (L, M, Q, H).
!/
function get_version_info(ver, ec) {
    let key -> String(ver) + `:` + ec

    when key == `1:L` { <- { `total` -> 26, `ec` -> 7, `b1` -> 1, `d1` -> 19, `b2` -> 0, `d2` -> 0, `data` -> 19 } }
    when key == `1:M` { <- { `total` -> 26, `ec` -> 10, `b1` -> 1, `d1` -> 16, `b2` -> 0, `d2` -> 0, `data` -> 16 } }
    when key == `1:Q` { <- { `total` -> 26, `ec` -> 13, `b1` -> 1, `d1` -> 13, `b2` -> 0, `d2` -> 0, `data` -> 13 } }
    when key == `1:H` { <- { `total` -> 26, `ec` -> 17, `b1` -> 1, `d1` -> 9, `b2` -> 0, `d2` -> 0, `data` -> 9 } }

    when key == `2:L` { <- { `total` -> 44, `ec` -> 10, `b1` -> 1, `d1` -> 34, `b2` -> 0, `d2` -> 0, `data` -> 34 } }
    when key == `2:M` { <- { `total` -> 44, `ec` -> 16, `b1` -> 1, `d1` -> 28, `b2` -> 0, `d2` -> 0, `data` -> 28 } }
    when key == `2:Q` { <- { `total` -> 44, `ec` -> 22, `b1` -> 1, `d1` -> 22, `b2` -> 0, `d2` -> 0, `data` -> 22 } }
    when key == `2:H` { <- { `total` -> 44, `ec` -> 28, `b1` -> 1, `d1` -> 16, `b2` -> 0, `d2` -> 0, `data` -> 16 } }

    when key == `3:L` { <- { `total` -> 70, `ec` -> 15, `b1` -> 1, `d1` -> 55, `b2` -> 0, `d2` -> 0, `data` -> 55 } }
    when key == `3:M` { <- { `total` -> 70, `ec` -> 26, `b1` -> 1, `d1` -> 44, `b2` -> 0, `d2` -> 0, `data` -> 44 } }
    when key == `3:Q` { <- { `total` -> 70, `ec` -> 18, `b1` -> 2, `d1` -> 17, `b2` -> 0, `d2` -> 0, `data` -> 34 } }
    when key == `3:H` { <- { `total` -> 70, `ec` -> 22, `b1` -> 2, `d1` -> 13, `b2` -> 0, `d2` -> 0, `data` -> 26 } }

    when key == `4:L` { <- { `total` -> 100, `ec` -> 20, `b1` -> 1, `d1` -> 80, `b2` -> 0, `d2` -> 0, `data` -> 80 } }
    when key == `4:M` { <- { `total` -> 100, `ec` -> 18, `b1` -> 2, `d1` -> 32, `b2` -> 0, `d2` -> 0, `data` -> 64 } }
    when key == `4:Q` { <- { `total` -> 100, `ec` -> 26, `b1` -> 2, `d1` -> 24, `b2` -> 0, `d2` -> 0, `data` -> 48 } }
    when key == `4:H` { <- { `total` -> 100, `ec` -> 16, `b1` -> 4, `d1` -> 9, `b2` -> 0, `d2` -> 0, `data` -> 36 } }

    when key == `5:L` { <- { `total` -> 134, `ec` -> 26, `b1` -> 1, `d1` -> 108, `b2` -> 0, `d2` -> 0, `data` -> 108 } }
    when key == `5:M` { <- { `total` -> 134, `ec` -> 24, `b1` -> 2, `d1` -> 43, `b2` -> 0, `d2` -> 0, `data` -> 86 } }
    when key == `5:Q` { <- { `total` -> 134, `ec` -> 18, `b1` -> 2, `d1` -> 15, `b2` -> 2, `d2` -> 16, `data` -> 62 } }
    when key == `5:H` { <- { `total` -> 134, `ec` -> 22, `b1` -> 2, `d1` -> 11, `b2` -> 2, `d2` -> 12, `data` -> 46 } }

    when key == `6:L` { <- { `total` -> 172, `ec` -> 18, `b1` -> 2, `d1` -> 68, `b2` -> 0, `d2` -> 0, `data` -> 136 } }
    when key == `6:M` { <- { `total` -> 172, `ec` -> 16, `b1` -> 4, `d1` -> 27, `b2` -> 0, `d2` -> 0, `data` -> 108 } }
    when key == `6:Q` { <- { `total` -> 172, `ec` -> 24, `b1` -> 4, `d1` -> 19, `b2` -> 0, `d2` -> 0, `data` -> 76 } }
    when key == `6:H` { <- { `total` -> 172, `ec` -> 28, `b1` -> 4, `d1` -> 15, `b2` -> 0, `d2` -> 0, `data` -> 60 } }

    when key == `7:L` { <- { `total` -> 196, `ec` -> 20, `b1` -> 2, `d1` -> 78, `b2` -> 0, `d2` -> 0, `data` -> 156 } }
    when key == `7:M` { <- { `total` -> 196, `ec` -> 18, `b1` -> 4, `d1` -> 31, `b2` -> 0, `d2` -> 0, `data` -> 124 } }
    when key == `7:Q` { <- { `total` -> 196, `ec` -> 18, `b1` -> 2, `d1` -> 14, `b2` -> 4, `d2` -> 15, `data` -> 88 } }
    when key == `7:H` { <- { `total` -> 196, `ec` -> 26, `b1` -> 4, `d1` -> 13, `b2` -> 1, `d2` -> 14, `data` -> 66 } }

    when key == `8:L` { <- { `total` -> 242, `ec` -> 24, `b1` -> 2, `d1` -> 97, `b2` -> 0, `d2` -> 0, `data` -> 194 } }
    when key == `8:M` { <- { `total` -> 242, `ec` -> 22, `b1` -> 2, `d1` -> 38, `b2` -> 2, `d2` -> 39, `data` -> 154 } }
    when key == `8:Q` { <- { `total` -> 242, `ec` -> 22, `b1` -> 4, `d1` -> 18, `b2` -> 2, `d2` -> 19, `data` -> 110 } }
    when key == `8:H` { <- { `total` -> 242, `ec` -> 26, `b1` -> 4, `d1` -> 14, `b2` -> 2, `d2` -> 15, `data` -> 86 } }

    when key == `9:L` { <- { `total` -> 292, `ec` -> 30, `b1` -> 2, `d1` -> 116, `b2` -> 0, `d2` -> 0, `data` -> 232 } }
    when key == `9:M` { <- { `total` -> 292, `ec` -> 22, `b1` -> 3, `d1` -> 36, `b2` -> 2, `d2` -> 37, `data` -> 182 } }
    when key == `9:Q` { <- { `total` -> 292, `ec` -> 20, `b1` -> 4, `d1` -> 16, `b2` -> 4, `d2` -> 17, `data` -> 132 } }
    when key == `9:H` { <- { `total` -> 292, `ec` -> 24, `b1` -> 4, `d1` -> 12, `b2` -> 4, `d2` -> 13, `data` -> 100 } }

    when key == `10:L` { <- { `total` -> 346, `ec` -> 18, `b1` -> 2, `d1` -> 68, `b2` -> 2, `d2` -> 69, `data` -> 274 } }
    when key == `10:M` { <- { `total` -> 346, `ec` -> 26, `b1` -> 4, `d1` -> 43, `b2` -> 1, `d2` -> 44, `data` -> 216 } }
    when key == `10:Q` { <- { `total` -> 346, `ec` -> 24, `b1` -> 6, `d1` -> 19, `b2` -> 2, `d2` -> 20, `data` -> 154 } }
    when key == `10:H` { <- { `total` -> 346, `ec` -> 28, `b1` -> 6, `d1` -> 15, `b2` -> 2, `d2` -> 16, `data` -> 122 } }

    <- { `total` -> 26, `ec` -> 10, `b1` -> 1, `d1` -> 16, `b2` -> 0, `d2` -> 0, `data` -> 16 }
}

/!
  Returns alignment pattern center coordinates for versions 1 through 10.
!/
function get_alignment_coords(ver) {
    when ver <= 1 { <- [] }
    when ver == 2 { <- [6, 18] }
    when ver == 3 { <- [6, 22] }
    when ver == 4 { <- [6, 26] }
    when ver == 5 { <- [6, 30] }
    when ver == 6 { <- [6, 34] }
    when ver == 7 { <- [6, 22, 38] }
    when ver == 8 { <- [6, 24, 42] }
    when ver == 9 { <- [6, 26, 46] }
    when ver == 10 { <- [6, 28, 50] }
    <- []
}


// ============================================================================
// 3. Data Encoders & Bit Buffer Manipulation
// ============================================================================

let ALPHANUMERIC_CHARS -> `0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:`

function _is_numeric(text) {
    let len -> Str.length(text)
    when len == 0 { <- False }
    let i -> 0
    do while i < len {
        let ch -> Str.at(text, i)
        when Str.index_of(`0123456789`, ch) < 0 {
            <- False
        }
        i -> i + 1
    }
    <- True
}

function _is_alphanumeric(text) {
    let len -> Str.length(text)
    when len == 0 { <- False }
    let i -> 0
    do while i < len {
        let ch -> Str.at(text, i)
        when Str.index_of(ALPHANUMERIC_CHARS, ch) < 0 {
            <- False
        }
        i -> i + 1
    }
    <- True
}

function detect_mode(text) {
    when _is_numeric(text) { <- `NUMERIC` }
    when _is_alphanumeric(text) { <- `ALPHANUMERIC` }
    <- `BYTE`
}

function _append_bits(bit_list, val, bit_count) {
    let k -> bit_count - 1
    do while k >= 0 {
        let bit -> (val >> k) & 1
        bit_list.append(bit)
        k -> k - 1
    }
}

function _select_version(text_len, mode, ec_level) {
    let v -> 1
    do while v <= 10 {
        let info -> get_version_info(v, ec_level)
        let max_data_bytes -> info[`data`]
        let max_bits -> max_data_bytes * 8

        let overhead -> 4
        when mode == `NUMERIC` {
            let cc_bits -> 10
            when v >= 10 { cc_bits -> 12 }
            overhead -> overhead + cc_bits
            let digits -> text_len
            let full_triplets -> (digits / 3) <: Integer
            let rem_digits -> digits % 3
            let data_bits -> full_triplets * 10
            when rem_digits == 1 { data_bits -> data_bits + 4 }
            when rem_digits == 2 { data_bits -> data_bits + 7 }
            when overhead + data_bits <= max_bits {
                <- v
            }
        } or when mode == `ALPHANUMERIC` {
            let cc_bits -> 9
            when v >= 10 { cc_bits -> 11 }
            overhead -> overhead + cc_bits
            let chars -> text_len
            let full_pairs -> (chars / 2) <: Integer
            let rem_chars -> chars % 2
            let data_bits -> full_pairs * 11
            when rem_chars == 1 { data_bits -> data_bits + 6 }
            when overhead + data_bits <= max_bits {
                <- v
            }
        } or {
            let cc_bits -> 8
            when v >= 10 { cc_bits -> 16 }
            overhead -> overhead + cc_bits
            let data_bits -> text_len * 8
            when overhead + data_bits <= max_bits {
                <- v
            }
        }
        v -> v + 1
    }
    <- 10
}

function _parse_dec(s) {
    let val -> 0
    let i -> 0
    let len -> Str.length(s)
    let digits -> `0123456789`
    do while i < len {
        let ch -> Str.at(s, i)
        let d -> Str.index_of(digits, ch)
        when d >= 0 {
            val -> val * 10 + d
        }
        i -> i + 1
    }
    <- val
}

/!
  Encodes string text into raw data codewords with padding for given version and EC level.
!/
function encode_data_codewords(text, ver, ec_level) {
    let mode -> detect_mode(text)
    let info -> get_version_info(ver, ec_level)
    let target_data_bytes -> info[`data`]
    let text_len -> Str.length(text)

    let bits -> []

    // 1. Mode indicator (4 bits)
    when mode == `NUMERIC` {
        _append_bits(bits, 1, 4)
        let cc_bits -> 10
        when ver >= 10 { cc_bits -> 12 }
        _append_bits(bits, text_len, cc_bits)

        let i -> 0
        do while i < text_len {
            when i + 3 <= text_len {
                let chunk -> Str.substring(text, i, i + 3)
                let num -> _parse_dec(chunk)
                _append_bits(bits, num, 10)
                i -> i + 3
            } or when i + 2 <= text_len {
                let chunk -> Str.substring(text, i, i + 2)
                let num -> _parse_dec(chunk)
                _append_bits(bits, num, 7)
                i -> i + 2
            } or {
                let chunk -> Str.substring(text, i, i + 1)
                let num -> _parse_dec(chunk)
                _append_bits(bits, num, 4)
                i -> i + 1
            }
        }
    } or when mode == `ALPHANUMERIC` {
        _append_bits(bits, 2, 4)
        let cc_bits -> 9
        when ver >= 10 { cc_bits -> 11 }
        _append_bits(bits, text_len, cc_bits)

        let i -> 0
        do while i < text_len {
            when i + 2 <= text_len {
                let c1 -> Str.index_of(ALPHANUMERIC_CHARS, Str.at(text, i))
                let c2 -> Str.index_of(ALPHANUMERIC_CHARS, Str.at(text, i + 1))
                let pair_val -> c1 * 45 + c2
                _append_bits(bits, pair_val, 11)
                i -> i + 2
            } or {
                let c1 -> Str.index_of(ALPHANUMERIC_CHARS, Str.at(text, i))
                _append_bits(bits, c1, 6)
                i -> i + 1
            }
        }
    } or {
        _append_bits(bits, 4, 4)
        let cc_bits -> 8
        when ver >= 10 { cc_bits -> 16 }
        _append_bits(bits, text_len, cc_bits)

        let bytes -> __builtin.string_to_bytes(text)
        for b in bytes {
            _append_bits(bits, b, 8)
        }
    }

    // 2. Terminator (up to 4 zeros)
    let max_bits -> target_data_bytes * 8
    let term_zeros -> max_bits - bits.length
    when term_zeros > 4 { term_zeros -> 4 }
    let k -> 0
    do while k < term_zeros {
        bits.append(0)
        k -> k + 1
    }

    // 3. Pad to byte boundary
    while (bits.length % 8) != 0 {
        bits.append(0)
    }

    let data_codewords -> []
    let bi -> 0
    do while bi < bits.length {
        let byte_val -> 0
        let bj -> 0
        do while bj < 8 {
            byte_val -> (byte_val << 1) | bits[bi + bj]
            bj -> bj + 1
        }
        data_codewords.append(byte_val)
        bi -> bi + 8
    }

    // 4. Pad with alternating 0xEC (236) and 0x11 (17)
    let pad_byte -> 236
    while data_codewords.length < target_data_bytes {
        data_codewords.append(pad_byte)
        when pad_byte == 236 {
            pad_byte -> 17
        } or {
            pad_byte -> 236
        }
    }

    <- data_codewords
}

/!
  Interleaves data codewords and error correction codewords according to block structure.
!/
function interleave_blocks(data_codewords, ver, ec_level) {
    let info -> get_version_info(ver, ec_level)
    let ec_count -> info[`ec`]
    let b1 -> info[`b1`]
    let d1 -> info[`d1`]
    let b2 -> info[`b2`]
    let d2 -> info[`d2`]

    let data_blocks -> []
    let ec_blocks -> []

    let offset -> 0
    let bi -> 0
    do while bi < b1 {
        let blk -> []
        let di -> 0
        do while di < d1 {
            blk.append(data_codewords[offset + di])
            di -> di + 1
        }
        data_blocks.append(blk)
        ec_blocks.append(rs_encode(blk, ec_count))
        offset -> offset + d1
        bi -> bi + 1
    }

    bi -> 0
    do while bi < b2 {
        let blk -> []
        let di -> 0
        do while di < d2 {
            blk.append(data_codewords[offset + di])
            di -> di + 1
        }
        data_blocks.append(blk)
        ec_blocks.append(rs_encode(blk, ec_count))
        offset -> offset + d2
        bi -> bi + 1
    }

    let total_blocks -> b1 + b2
    let max_data_len -> d1
    when d2 > max_data_len { max_data_len -> d2 }

    let interleaved -> []
    let col -> 0
    do while col < max_data_len {
        let b -> 0
        do while b < total_blocks {
            when col < data_blocks[b].length {
                interleaved.append(data_blocks[b][col])
            }
            b -> b + 1
        }
        col -> col + 1
    }

    col -> 0
    do while col < ec_count {
        let b -> 0
        do while b < total_blocks {
            interleaved.append(ec_blocks[b][col])
            b -> b + 1
        }
        col -> col + 1
    }

    <- interleaved
}


// ============================================================================
// 4. Matrix Construction & Layout (Function Patterns, Masking & Penalty)
// ============================================================================

function _create_grid(size) {
    let grid -> []
    let r -> 0
    do while r < size {
        let row -> []
        let c -> 0
        do while c < size {
            row.append(-1)
            c -> c + 1
        }
        grid.append(row)
        r -> r + 1
    }
    <- grid
}

function _place_finder(grid, top, left) {
    let r -> 0
    do while r < 7 {
        let c -> 0
        do while c < 7 {
            when r == 0 or r == 6 or c == 0 or c == 6 {
                grid[top + r][left + c] -> 1
            } or when r >= 2 and r <= 4 and c >= 2 and c <= 4 {
                grid[top + r][left + c] -> 1
            } or {
                grid[top + r][left + c] -> 0
            }
            c -> c + 1
        }
        r -> r + 1
    }
}

function _place_separators(grid, size) {
    let i -> 0
    do while i < 8 {
        when 7 < size and i < size { grid[7][i] -> 0 }
        when i < size and 7 < size { grid[i][7] -> 0 }
        i -> i + 1
    }
    i -> 0
    do while i < 8 {
        when 7 < size and (size - 8 + i) < size { grid[7][size - 8 + i] -> 0 }
        when i < size and (size - 8) >= 0 { grid[i][size - 8] -> 0 }
        i -> i + 1
    }
    i -> 0
    do while i < 8 {
        when (size - 8) >= 0 and i < size { grid[size - 8][i] -> 0 }
        when (size - 8 + i) < size and 7 < size { grid[size - 8 + i][7] -> 0 }
        i -> i + 1
    }
}

function _place_alignment(grid, center_r, center_c) {
    let r -> center_r - 2
    do while r <= center_r + 2 {
        let c -> center_c - 2
        do while c <= center_c + 2 {
            when r == center_r - 2 or r == center_r + 2 or c == center_c - 2 or c == center_c + 2 {
                grid[r][c] -> 1
            } or when r == center_r and c == center_c {
                grid[r][c] -> 1
            } or {
                grid[r][c] -> 0
            }
            c -> c + 1
        }
        r -> r + 1
    }
}

function _is_finder_zone(r, c, size) {
    when r < 9 and c < 9 { <- True }
    when r < 9 and c >= size - 9 { <- True }
    when r >= size - 9 and c < 9 { <- True }
    <- False
}

function _compute_bch_format(ec_level, mask_idx) {
    let ec_bits -> 0
    when ec_level == `L` { ec_bits -> 1 }
    when ec_level == `M` { ec_bits -> 0 }
    when ec_level == `Q` { ec_bits -> 3 }
    when ec_level == `H` { ec_bits -> 2 }

    let data -> (ec_bits << 3) | mask_idx
    let d -> data << 10
    let g -> 1335

    let k -> 14
    do while k >= 10 {
        when ((d >> k) & 1) != 0 {
            d -> d ^^ (g << (k - 10))
        }
        k -> k - 1
    }
    let rem -> d & 1023
    let format_val -> (data << 10) | rem
    <- format_val ^^ 21522
}

function _place_format_bits(grid, format_val, size) {
    let bit_idx -> 0
    let c -> 0
    do while c <= 8 {
        when c != 6 {
            let bit -> (format_val >> (14 - bit_idx)) & 1
            grid[8][c] -> bit
            bit_idx -> bit_idx + 1
        }
        c -> c + 1
    }
    let r -> 7
    do while r >= 0 {
        when r != 6 {
            let bit -> (format_val >> (14 - bit_idx)) & 1
            grid[r][8] -> bit
            bit_idx -> bit_idx + 1
        }
        r -> r - 1
    }

    bit_idx -> 0
    r -> size - 1
    do while r >= size - 7 {
        let bit -> (format_val >> bit_idx) & 1
        grid[r][8] -> bit
        bit_idx -> bit_idx + 1
        r -> r - 1
    }

    c -> size - 8
    do while c <= size - 1 {
        let bit -> (format_val >> bit_idx) & 1
        grid[8][c] -> bit
        bit_idx -> bit_idx + 1
        c -> c + 1
    }
}

function _mask_condition(idx, r, c) {
    when idx == 0 { <- (r + c) % 2 == 0 }
    when idx == 1 { <- r % 2 == 0 }
    when idx == 2 { <- c % 3 == 0 }
    when idx == 3 { <- (r + c) % 3 == 0 }
    when idx == 4 { <- (((r / 2) <: Integer) + ((c / 3) <: Integer)) % 2 == 0 }
    when idx == 5 { <- ((r * c) % 2) + ((r * c) % 3) == 0 }
    when idx == 6 { <- (((r * c) % 2) + ((r * c) % 3)) % 2 == 0 }
    when idx == 7 { <- (((r + c) % 2) + ((r * c) % 3)) % 2 == 0 }
    <- False
}

function _calculate_penalty(grid, size) {
    let penalty -> 0

    // N1: 5 or more consecutive modules of same color
    let r -> 0
    do while r < size {
        let run_val -> grid[r][0]
        let run_len -> 1
        let c -> 1
        do while c < size {
            when grid[r][c] == run_val {
                run_len -> run_len + 1
            } or {
                when run_len >= 5 {
                    penalty -> penalty + 3 + (run_len - 5)
                }
                run_val -> grid[r][c]
                run_len -> 1
            }
            c -> c + 1
        }
        when run_len >= 5 {
            penalty -> penalty + 3 + (run_len - 5)
        }
        r -> r + 1
    }

    let c -> 0
    do while c < size {
        let run_val -> grid[0][c]
        let run_len -> 1
        r -> 1
        do while r < size {
            when grid[r][c] == run_val {
                run_len -> run_len + 1
            } or {
                when run_len >= 5 {
                    penalty -> penalty + 3 + (run_len - 5)
                }
                run_val -> grid[r][c]
                run_len -> 1
            }
            r -> r + 1
        }
        when run_len >= 5 {
            penalty -> penalty + 3 + (run_len - 5)
        }
        c -> c + 1
    }

    // N2: 2x2 blocks of same color
    r -> 0
    do while r < size - 1 {
        c -> 0
        do while c < size - 1 {
            let v -> grid[r][c]
            when v == grid[r + 1][c] and v == grid[r][c + 1] and v == grid[r + 1][c + 1] {
                penalty -> penalty + 3
            }
            c -> c + 1
        }
        r -> r + 1
    }

    // N4: Black/white balance
    let dark_count -> 0
    r -> 0
    do while r < size {
        c -> 0
        do while c < size {
            when grid[r][c] == 1 {
                dark_count -> dark_count + 1
            }
            c -> c + 1
        }
        r -> r + 1
    }
    let total_modules -> size * size
    let pct -> ((dark_count * 100) / total_modules) <: Integer
    let dev -> pct - 50
    when dev < 0 { dev -> -dev }
    penalty -> penalty + ((dev / 5) <: Integer) * 10

    <- penalty
}

/!
  Builds the complete QR code matrix for a given version, EC level, and text payload.
  Returns { version, size, ec_level, mask, matrix }.
!/
function build_matrix(text, ver, ec_level) {
    let size -> 17 + 4 * ver
    let base_grid -> _create_grid(size)

    // 1. Place Finders
    _place_finder(base_grid, 0, 0)
    _place_finder(base_grid, 0, size - 7)
    _place_finder(base_grid, size - 7, 0)

    // 2. Place Separators
    _place_separators(base_grid, size)

    // 3. Place Timing Patterns
    let i -> 8
    do while i < size - 8 {
        let bit -> 1
        when i % 2 == 1 { bit -> 0 }
        base_grid[6][i] -> bit
        base_grid[i][6] -> bit
        i -> i + 1
    }

    // 4. Place Alignment Patterns (Versions 2+)
    let align_coords -> get_alignment_coords(ver)
    when align_coords.length > 0 {
        let ar -> 0
        do while ar < align_coords.length {
            let ac -> 0
            do while ac < align_coords.length {
                let cr -> align_coords[ar]
                let cc -> align_coords[ac]
                when _is_finder_zone(cr, cc, size) == False {
                    _place_alignment(base_grid, cr, cc)
                }
                ac -> ac + 1
            }
            ar -> ar + 1
        }
    }

    // 5. Dark Module
    base_grid[4 * ver + 9][8] -> 1

    // 6. Reserve Format info
    let c -> 0
    do while c <= 8 {
        when base_grid[8][c] == -1 { base_grid[8][c] -> 0 }
        c -> c + 1
    }
    let r -> 0
    do while r <= 8 {
        when base_grid[r][8] == -1 { base_grid[r][8] -> 0 }
        r -> r + 1
    }
    r -> size - 8
    do while r < size {
        when base_grid[r][8] == -1 { base_grid[r][8] -> 0 }
        r -> r + 1
    }
    c -> size - 8
    do while c < size {
        when base_grid[8][c] == -1 { base_grid[8][c] -> 0 }
        c -> c + 1
    }

    // 7. Get interleaved data + EC bits
    let data_bytes -> encode_data_codewords(text, ver, ec_level)
    let interleaved_bytes -> interleave_blocks(data_bytes, ver, ec_level)

    let all_bits -> []
    for b_val in interleaved_bytes {
        _append_bits(all_bits, b_val, 8)
    }

    // Remainder bits for versions 2-6 (7 bits)
    let rem_bits -> 0
    when ver >= 2 and ver <= 6 { rem_bits -> 7 }
    i -> 0
    do while i < rem_bits {
        all_bits.append(0)
        i -> i + 1
    }

    // 8. Place data bits in zig-zag
    let is_func -> []
    r -> 0
    do while r < size {
        let f_row -> []
        c -> 0
        do while c < size {
            f_row.append(base_grid[r][c] != -1)
            c -> c + 1
        }
        is_func.append(f_row)
        r -> r + 1
    }

    let unmasked_data -> []
    r -> 0
    do while r < size {
        let u_row -> []
        c -> 0
        do while c < size {
            u_row.append(0)
            c -> c + 1
        }
        unmasked_data.append(u_row)
        r -> r + 1
    }

    let bit_idx -> 0
    let col -> size - 1
    let dir_up -> True
    while col > 0 {
        when col == 6 { col -> 5 }
        let row_idx -> 0
        do while row_idx < size {
            let actual_r -> row_idx
            when dir_up {
                actual_r -> size - 1 - row_idx
            }

            let c_pair -> 0
            do while c_pair < 2 {
                let actual_c -> col - c_pair
                when is_func[actual_r][actual_c] == False {
                    let bit -> 0
                    when bit_idx < all_bits.length {
                        bit -> all_bits[bit_idx]
                        bit_idx -> bit_idx + 1
                    }
                    unmasked_data[actual_r][actual_c] -> bit
                }
                c_pair -> c_pair + 1
            }
            row_idx -> row_idx + 1
        }
        dir_up -> not dir_up
        col -> col - 2
    }

    // 9. Evaluate all 8 masks and pick lowest penalty
    let best_mask -> 0
    let best_penalty -> 999999999
    let best_matrix -> []

    let mask_idx -> 0
    do while mask_idx < 8 {
        let candidate -> []
        r -> 0
        do while r < size {
            let c_row -> []
            c -> 0
            do while c < size {
                when is_func[r][c] {
                    c_row.append(base_grid[r][c])
                } or {
                    let d_bit -> unmasked_data[r][c]
                    when _mask_condition(mask_idx, r, c) {
                        d_bit -> d_bit ^^ 1
                    }
                    c_row.append(d_bit)
                }
                c -> c + 1
            }
            candidate.append(c_row)
            r -> r + 1
        }

        let fmt_val -> _compute_bch_format(ec_level, mask_idx)
        _place_format_bits(candidate, fmt_val, size)

        let p -> _calculate_penalty(candidate, size)
        when p < best_penalty {
            best_penalty -> p
            best_mask -> mask_idx
            best_matrix -> candidate
        }
        mask_idx -> mask_idx + 1
    }

    let bool_matrix -> []
    r -> 0
    do while r < size {
        let b_row -> []
        c -> 0
        do while c < size {
            b_row.append(best_matrix[r][c] == 1)
            c -> c + 1
        }
        bool_matrix.append(b_row)
        r -> r + 1
    }

    <- {
        `version` -> ver,
        `size` -> size,
        `ec_level` -> ec_level,
        `mask` -> best_mask,
        `matrix` -> bool_matrix
    }
}

/!
  Public high-level encoder function.
  Automatically selects optimal version if not provided.
!/
export function encode(text, ec_level, ver) {
    when ec_level == Nothing {
        ec_level -> `M`
    }
    when ver == Nothing {
        let mode -> detect_mode(text)
        ver -> _select_version(Str.length(text), mode, ec_level)
    }
    <- build_matrix(text, ver, ec_level)
}


// ============================================================================
// 5. Multi-Target Renderers (Terminal Half-Blocks, Full-Blocks, SVG, BMP)
// ============================================================================

/!
  Renders QR code matrix to crisp Unicode half-blocks (2 pixels per character row).
!/
export function to_terminal(qr, margin) {
    when margin == Nothing { margin -> 2 }
    let matrix -> qr
    when type(qr) == `Map` { matrix -> qr[`matrix`] }

    let size -> matrix.length
    let total_w -> size + margin * 2
    let total_h -> size + margin * 2

    let out -> ``

    let y -> 0
    do while y < total_h {
        let row_str -> ``
        let x -> 0
        do while x < total_w {
            let top_dark -> False
            let bot_dark -> False

            let my_top -> y - margin
            let mx -> x - margin
            when my_top >= 0 and my_top < size and mx >= 0 and mx < size {
                top_dark -> matrix[my_top][mx]
            }

            let my_bot -> y + 1 - margin
            when my_bot >= 0 and my_bot < size and mx >= 0 and mx < size {
                bot_dark -> matrix[my_bot][mx]
            }

            when top_dark and bot_dark {
                row_str -> row_str + `█`
            } or when top_dark and (not bot_dark) {
                row_str -> row_str + `▀`
            } or when (not top_dark) and bot_dark {
                row_str -> row_str + `▄`
            } or {
                row_str -> row_str + ` `
            }
            x -> x + 1
        }
        out -> out + row_str + `\n`
        y -> y + 2
    }

    <- out
}

/!
  Renders QR code to double-width ASCII text blocks ("##" or "  ").
!/
export function to_ascii(qr, margin) {
    when margin == Nothing { margin -> 2 }
    let matrix -> qr
    when type(qr) == `Map` { matrix -> qr[`matrix`] }

    let size -> matrix.length
    let total_w -> size + margin * 2
    let total_h -> size + margin * 2

    let out -> ``
    let y -> 0
    do while y < total_h {
        let row_str -> ``
        let x -> 0
        do while x < total_w {
            let my -> y - margin
            let mx -> x - margin
            let dark -> False
            when my >= 0 and my < size and mx >= 0 and mx < size {
                dark -> matrix[my][mx]
            }
            when dark {
                row_str -> row_str + `##`
            } or {
                row_str -> row_str + `  `
            }
            x -> x + 1
        }
        out -> out + row_str + `\n`
        y -> y + 1
    }
    <- out
}

/!
  Renders QR code to scalable vector XML markup string (<svg>).
!/
export function to_svg(qr, module_size, margin) {
    when module_size == Nothing { module_size -> 8 }
    when margin == Nothing { margin -> 4 }
    let matrix -> qr
    when type(qr) == `Map` { matrix -> qr[`matrix`] }

    let size -> matrix.length
    let total_modules -> size + margin * 2
    let px_dim -> total_modules * module_size

    let svg -> `<svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="` + String(px_dim) + `" height="` + String(px_dim) + `" viewBox="0 0 ` + String(px_dim) + ` ` + String(px_dim) + `">\n`
    svg -> svg + `  <rect width="100%" height="100%" fill="#ffffff"/>\n`

    let r -> 0
    do while r < size {
        let c -> 0
        do while c < size {
            when matrix[r][c] {
                let rx -> (c + margin) * module_size
                let ry -> (r + margin) * module_size
                svg -> svg + `  <rect x="` + String(rx) + `" y="` + String(ry) + `" width="` + String(module_size) + `" height="` + String(module_size) + `" fill="#000000"/>\n`
            }
            c -> c + 1
        }
        r -> r + 1
    }
    svg -> svg + `</svg>\n`
    <- svg
}

function _bmp_u32(bytes, val) {
    bytes.append(val & 255)
    bytes.append((val >> 8) & 255)
    bytes.append((val >> 16) & 255)
    bytes.append((val >> 24) & 255)
}

function _bmp_u16(bytes, val) {
    bytes.append(val & 255)
    bytes.append((val >> 8) & 255)
}

/!
  Renders QR code to uncompressed 24-bit RGB BMP bytes.
!/
export function to_bmp(qr, scale, margin) {
    when scale == Nothing { scale -> 8 }
    when margin == Nothing { margin -> 4 }
    let matrix -> qr
    when type(qr) == `Map` { matrix -> qr[`matrix`] }

    let size -> matrix.length
    let total_modules -> size + margin * 2
    let dim -> total_modules * scale

    let row_size -> ((dim * 3 + 3) >> 2) << 2
    let pad -> row_size - (dim * 3)
    let image_size -> row_size * dim
    let file_size -> 54 + image_size

    let bytes -> []
    // 14-byte BMP Header
    bytes.append(66) // 'B'
    bytes.append(77) // 'M'
    _bmp_u32(bytes, file_size)
    _bmp_u16(bytes, 0)
    _bmp_u16(bytes, 0)
    _bmp_u32(bytes, 54)

    // 40-byte DIB Header (BITMAPINFOHEADER)
    _bmp_u32(bytes, 40)
    _bmp_u32(bytes, dim)
    _bmp_u32(bytes, dim) // positive height = bottom-up
    _bmp_u16(bytes, 1)
    _bmp_u16(bytes, 24)
    _bmp_u32(bytes, 0)
    _bmp_u32(bytes, image_size)
    _bmp_u32(bytes, 2835)
    _bmp_u32(bytes, 2835)
    _bmp_u32(bytes, 0)
    _bmp_u32(bytes, 0)

    // Pixel data: bottom-to-top
    let row_file -> 0
    do while row_file < dim {
        let y -> dim - 1 - row_file
        let module_y -> ((y / scale) <: Integer) - margin
        let x -> 0
        do while x < dim {
            let module_x -> ((x / scale) <: Integer) - margin
            let is_dark -> False
            when module_y >= 0 and module_y < size and module_x >= 0 and module_x < size {
                is_dark -> matrix[module_y][module_x]
            }
            when is_dark {
                bytes.append(0)
                bytes.append(0)
                bytes.append(0)
            } or {
                bytes.append(255)
                bytes.append(255)
                bytes.append(255)
            }
            x -> x + 1
        }
        let p -> 0
        do while p < pad {
            bytes.append(0)
            p -> p + 1
        }
        row_file -> row_file + 1
    }

    <- bytes
}

/!
  Convenience helper: encodes and prints directly to stdout in terminal half-blocks.
!/
export function print(text, ec_level) {
    let qr -> encode(text, ec_level, Nothing)
    let term -> to_terminal(qr, 2)
    stdout.write(term)
}


// ============================================================================
// 6. Multi-Target Readers & Decoders (Matrix, Terminal, ASCII, SVG, BMP)
// ============================================================================

function _decode_bch_format(raw_val) {
    let unmasked -> raw_val ^^ 21522
    let data -> unmasked >> 10
    let rem -> unmasked & 1023

    let d -> data << 10
    let g -> 1335
    let k -> 14
    do while k >= 10 {
        when ((d >> k) & 1) != 0 {
            d -> d ^^ (g << (k - 10))
        }
        k -> k - 1
    }
    when (d & 1023) == rem {
        let ec_bits -> (data >> 3) & 3
        let mask_idx -> data & 7
        let ec_str -> `M`
        when ec_bits == 1 { ec_str -> `L` }
        when ec_bits == 0 { ec_str -> `M` }
        when ec_bits == 3 { ec_str -> `Q` }
        when ec_bits == 2 { ec_str -> `H` }
        <- { `valid` -> True, `ec` -> ec_str, `mask` -> mask_idx }
    }

    // Try single bit-error correction
    let b1 -> 0
    do while b1 < 15 {
        let trial1 -> raw_val ^^ (1 << b1)
        let unmask1 -> trial1 ^^ 21522
        let data1 -> unmask1 >> 10
        let rem1 -> unmask1 & 1023
        let d1 -> data1 << 10
        let k1 -> 14
        do while k1 >= 10 {
            when ((d1 >> k1) & 1) != 0 {
                d1 -> d1 ^^ (g << (k1 - 10))
            }
            k1 -> k1 - 1
        }
        when (d1 & 1023) == rem1 {
            let ec_bits -> (data1 >> 3) & 3
            let mask_idx -> data1 & 7
            let ec_str -> `M`
            when ec_bits == 1 { ec_str -> `L` }
            when ec_bits == 0 { ec_str -> `M` }
            when ec_bits == 3 { ec_str -> `Q` }
            when ec_bits == 2 { ec_str -> `H` }
            <- { `valid` -> True, `ec` -> ec_str, `mask` -> mask_idx }
        }
        b1 -> b1 + 1
    }

    let ec_bits -> (data >> 3) & 3
    let mask_idx -> data & 7
    let ec_str -> `M`
    when ec_bits == 1 { ec_str -> `L` }
    when ec_bits == 0 { ec_str -> `M` }
    when ec_bits == 3 { ec_str -> `Q` }
    when ec_bits == 2 { ec_str -> `H` }
    <- { `valid` -> False, `ec` -> ec_str, `mask` -> mask_idx }
}

/!
  Decodes raw 2D boolean matrix into original text string.
!/
export function read_matrix(matrix) {
    let size -> matrix.length
    when size < 21 or ((size - 17) % 4) != 0 {
        <- Nothing
    }
    let ver -> ((size - 17) / 4) <: Integer

    // 1. Extract 15-bit format info around top-left finder
    let fmt_val -> 0
    let c -> 0
    do while c <= 8 {
        when c != 6 {
            let bit -> 0
            when matrix[8][c] { bit -> 1 }
            fmt_val -> (fmt_val << 1) | bit
        }
        c -> c + 1
    }
    let r -> 7
    do while r >= 0 {
        when r != 6 {
            let bit -> 0
            when matrix[r][8] { bit -> 1 }
            fmt_val -> (fmt_val << 1) | bit
        }
        r -> r - 1
    }

    let fmt_info -> _decode_bch_format(fmt_val)
    let ec_level -> fmt_info[`ec`]
    let mask_idx -> fmt_info[`mask`]

    // 2. Identify function modules to unmask data
    let base_grid -> _create_grid(size)
    _place_finder(base_grid, 0, 0)
    _place_finder(base_grid, 0, size - 7)
    _place_finder(base_grid, size - 7, 0)
    _place_separators(base_grid, size)

    let i -> 8
    do while i < size - 8 {
        base_grid[6][i] -> 1
        base_grid[i][6] -> 1
        i -> i + 1
    }

    let align_coords -> get_alignment_coords(ver)
    when align_coords.length > 0 {
        let ar -> 0
        do while ar < align_coords.length {
            let ac -> 0
            do while ac < align_coords.length {
                let cr -> align_coords[ar]
                let cc -> align_coords[ac]
                when _is_finder_zone(cr, cc, size) == False {
                    _place_alignment(base_grid, cr, cc)
                }
                ac -> ac + 1
            }
            ar -> ar + 1
        }
    }
    base_grid[4 * ver + 9][8] -> 1

    c -> 0
    do while c <= 8 {
        base_grid[8][c] -> 0
        c -> c + 1
    }
    r -> 0
    do while r <= 8 {
        base_grid[r][8] -> 0
        r -> r + 1
    }
    r -> size - 8
    do while r < size {
        base_grid[r][8] -> 0
        r -> r + 1
    }
    c -> size - 8
    do while c < size {
        base_grid[8][c] -> 0
        c -> c + 1
    }

    // 3. Zig-zag read unmasked data bits
    let data_bits -> []
    let col -> size - 1
    let dir_up -> True
    while col > 0 {
        when col == 6 { col -> 5 }
        let row_idx -> 0
        do while row_idx < size {
            let actual_r -> row_idx
            when dir_up { actual_r -> size - 1 - row_idx }

            let c_pair -> 0
            do while c_pair < 2 {
                let actual_c -> col - c_pair
                when base_grid[actual_r][actual_c] == -1 {
                    let bit -> 0
                    when matrix[actual_r][actual_c] { bit -> 1 }
                    when _mask_condition(mask_idx, actual_r, actual_c) {
                        bit -> bit ^^ 1
                    }
                    data_bits.append(bit)
                }
                c_pair -> c_pair + 1
            }
            row_idx -> row_idx + 1
        }
        dir_up -> not dir_up
        col -> col - 2
    }

    // Convert bits to byte codewords
    let codewords -> []
    let bi -> 0
    do while bi + 8 <= data_bits.length {
        let b_val -> 0
        let bj -> 0
        do while bj < 8 {
            b_val -> (b_val << 1) | data_bits[bi + bj]
            bj -> bj + 1
        }
        codewords.append(b_val)
        bi -> bi + 8
    }

    // 4. De-interleave and error-correct blocks
    let info -> get_version_info(ver, ec_level)
    let ec_count -> info[`ec`]
    let b1 -> info[`b1`]
    let d1 -> info[`d1`]
    let b2 -> info[`b2`]
    let d2 -> info[`d2`]
    let total_blocks -> b1 + b2

    let data_blocks -> []
    let ec_blocks -> []
    bi -> 0
    do while bi < total_blocks {
        data_blocks.append([])
        ec_blocks.append([])
        bi -> bi + 1
    }

    let max_d -> d1
    when d2 > max_d { max_d -> d2 }

    let cw_idx -> 0
    let col_idx -> 0
    do while col_idx < max_d {
        let b -> 0
        do while b < total_blocks {
            let target_len -> d1
            when b >= b1 { target_len -> d2 }
            when col_idx < target_len and cw_idx < codewords.length {
                data_blocks[b].append(codewords[cw_idx])
                cw_idx -> cw_idx + 1
            }
            b -> b + 1
        }
        col_idx -> col_idx + 1
    }

    col_idx -> 0
    do while col_idx < ec_count {
        let b -> 0
        do while b < total_blocks {
            when cw_idx < codewords.length {
                ec_blocks[b].append(codewords[cw_idx])
                cw_idx -> cw_idx + 1
            }
            b -> b + 1
        }
        col_idx -> col_idx + 1
    }

    let corrected_data -> []
    bi -> 0
    do while bi < total_blocks {
        let blk -> []
        for val in data_blocks[bi] { blk.append(val) }
        for val in ec_blocks[bi] { blk.append(val) }

        let target_len -> d1
        when bi >= b1 { target_len -> d2 }

        let dec_res -> rs_decode(blk, target_len, ec_count)
        when dec_res[`success`] == False {
            <- Nothing
        }
        for d_val in dec_res[`data`] {
            corrected_data.append(d_val)
        }
        bi -> bi + 1
    }

    // 5. Parse data stream
    let payload_bits -> []
    for b_val in corrected_data {
        _append_bits(payload_bits, b_val, 8)
    }

    let bit_pos -> 0
    let out_str -> ``

    while bit_pos + 4 <= payload_bits.length {
        let mode_val -> 0
        let k -> 0
        do while k < 4 {
            mode_val -> (mode_val << 1) | payload_bits[bit_pos + k]
            k -> k + 1
        }
        bit_pos -> bit_pos + 4

        when mode_val == 0 {
            <- out_str
        } or when mode_val == 1 {
            // NUMERIC
            let cc_len -> 10
            when ver >= 10 { cc_len -> 12 }
            when bit_pos + cc_len > payload_bits.length { <- out_str }
            let count -> 0
            k -> 0
            do while k < cc_len {
                count -> (count << 1) | payload_bits[bit_pos + k]
                k -> k + 1
            }
            bit_pos -> bit_pos + cc_len

            let processed -> 0
            while processed < count {
                let rem -> count - processed
                when rem >= 3 {
                    let num -> 0
                    k -> 0
                    do while k < 10 {
                        num -> (num << 1) | payload_bits[bit_pos + k]
                        k -> k + 1
                    }
                    bit_pos -> bit_pos + 10
                    let s -> String(num)
                    while Str.length(s) < 3 { s -> `0` + s }
                    out_str -> out_str + s
                    processed -> processed + 3
                } or when rem == 2 {
                    let num -> 0
                    k -> 0
                    do while k < 7 {
                        num -> (num << 1) | payload_bits[bit_pos + k]
                        k -> k + 1
                    }
                    bit_pos -> bit_pos + 7
                    let s -> String(num)
                    while Str.length(s) < 2 { s -> `0` + s }
                    out_str -> out_str + s
                    processed -> processed + 2
                } or {
                    let num -> 0
                    k -> 0
                    do while k < 4 {
                        num -> (num << 1) | payload_bits[bit_pos + k]
                        k -> k + 1
                    }
                    bit_pos -> bit_pos + 4
                    out_str -> out_str + String(num)
                    processed -> processed + 1
                }
            }
        } or when mode_val == 2 {
            // ALPHANUMERIC
            let cc_len -> 9
            when ver >= 10 { cc_len -> 11 }
            when bit_pos + cc_len > payload_bits.length { <- out_str }
            let count -> 0
            k -> 0
            do while k < cc_len {
                count -> (count << 1) | payload_bits[bit_pos + k]
                k -> k + 1
            }
            bit_pos -> bit_pos + cc_len

            let processed -> 0
            while processed < count {
                let rem -> count - processed
                when rem >= 2 {
                    let pair_val -> 0
                    k -> 0
                    do while k < 11 {
                        pair_val -> (pair_val << 1) | payload_bits[bit_pos + k]
                        k -> k + 1
                    }
                    bit_pos -> bit_pos + 11
                    let c1 -> (pair_val / 45) <: Integer
                    let c2 -> pair_val % 45
                    out_str -> out_str + Str.at(ALPHANUMERIC_CHARS, c1) + Str.at(ALPHANUMERIC_CHARS, c2)
                    processed -> processed + 2
                } or {
                    let c1 -> 0
                    k -> 0
                    do while k < 6 {
                        c1 -> (c1 << 1) | payload_bits[bit_pos + k]
                        k -> k + 1
                    }
                    bit_pos -> bit_pos + 6
                    out_str -> out_str + Str.at(ALPHANUMERIC_CHARS, c1)
                    processed -> processed + 1
                }
            }
        } or when mode_val == 4 {
            // BYTE mode
            let cc_len -> 8
            when ver >= 10 { cc_len -> 16 }
            when bit_pos + cc_len > payload_bits.length { <- out_str }
            let count -> 0
            k -> 0
            do while k < cc_len {
                count -> (count << 1) | payload_bits[bit_pos + k]
                k -> k + 1
            }
            bit_pos -> bit_pos + cc_len

            let char_bytes -> []
            let processed -> 0
            while processed < count and bit_pos + 8 <= payload_bits.length {
                let b_val -> 0
                k -> 0
                do while k < 8 {
                    b_val -> (b_val << 1) | payload_bits[bit_pos + k]
                    k -> k + 1
                }
                bit_pos -> bit_pos + 8
                char_bytes.append(b_val)
                processed -> processed + 1
            }
            out_str -> out_str + __builtin.bytes_to_string(char_bytes)
        } or {
            <- out_str
        }
    }

    <- out_str
}

/!
  Reads and decodes terminal string formatted with Unicode half-blocks (▀, ▄, █, space).
!/
export function read_terminal(text) {
    let raw_lines -> Str.split(text, `\n`)
    let lines -> []
    for l in raw_lines {
        let clean_l -> l
        when Str.ends_with(clean_l, `\r`) {
            clean_l -> Str.substring(clean_l, 0, Str.length(clean_l) - 1)
        }
        when Str.length(clean_l) > 0 {
            lines.append(clean_l)
        }
    }
    when lines.length == 0 { <- Nothing }

    let grid -> []
    for line in lines {
        let row_top -> []
        let row_bot -> []
        let len -> Str.length(line)
        let i -> 0
        while i < len {
            let rest -> Str.substring(line, i, len)
            when Str.starts_with(rest, `█`) {
                row_top.append(True)
                row_bot.append(True)
                i -> i + Str.length(`█`)
            } or when Str.starts_with(rest, `▀`) {
                row_top.append(True)
                row_bot.append(False)
                i -> i + Str.length(`▀`)
            } or when Str.starts_with(rest, `▄`) {
                row_top.append(False)
                row_bot.append(True)
                i -> i + Str.length(`▄`)
            } or {
                row_top.append(False)
                row_bot.append(False)
                i -> i + 1
            }
        }
        grid.append(row_top)
        grid.append(row_bot)
    }

    let min_r -> -1
    let min_c -> -1
    let max_r -> -1
    let max_c -> -1

    let r -> 0
    do while r < grid.length {
        let c -> 0
        do while c < grid[r].length {
            when grid[r][c] {
                when min_r < 0 or r < min_r { min_r -> r }
                when max_r < 0 or r > max_r { max_r -> r }
                when min_c < 0 or c < min_c { min_c -> c }
                when max_c < 0 or c > max_c { max_c -> c }
            }
            c -> c + 1
        }
        r -> r + 1
    }

    when min_r < 0 or min_c < 0 { <- Nothing }

    let crop_h -> max_r - min_r + 1
    let crop_w -> max_c - min_c + 1
    let dim -> crop_h
    when crop_w < dim { dim -> crop_w }

    let matrix -> []
    r -> 0
    do while r < dim {
        let m_row -> []
        let c -> 0
        do while c < dim {
            m_row.append(grid[min_r + r][min_c + c])
            c -> c + 1
        }
        matrix.append(m_row)
        r -> r + 1
    }

    <- read_matrix(matrix)
}

/!
  Reads and decodes ASCII string formatted with "##" or "  ".
!/
export function read_ascii(text) {
    let raw_lines -> Str.split(text, `\n`)
    let lines -> []
    for l in raw_lines {
        let clean_l -> l
        when Str.ends_with(clean_l, `\r`) {
            clean_l -> Str.substring(clean_l, 0, Str.length(clean_l) - 1)
        }
        when Str.length(clean_l) > 0 {
            lines.append(clean_l)
        }
    }
    when lines.length == 0 { <- Nothing }

    let grid -> []
    for line in lines {
        let row -> []
        let len -> Str.length(line)
        let i -> 0
        do while i < len {
            let ch -> Str.at(line, i)
            when ch == `#` or ch == `1` {
                row.append(True)
            } or {
                row.append(False)
            }
            when i + 1 < len and Str.at(line, i + 1) == ch {
                i -> i + 1
            }
            i -> i + 1
        }
        grid.append(row)
    }

    let min_r -> -1
    let min_c -> -1
    let max_r -> -1
    let max_c -> -1

    let r -> 0
    do while r < grid.length {
        let c -> 0
        do while c < grid[r].length {
            when grid[r][c] {
                when min_r < 0 or r < min_r { min_r -> r }
                when max_r < 0 or r > max_r { max_r -> r }
                when min_c < 0 or c < min_c { min_c -> c }
                when max_c < 0 or c > max_c { max_c -> c }
            }
            c -> c + 1
        }
        r -> r + 1
    }

    when min_r < 0 or min_c < 0 { <- Nothing }

    let crop_h -> max_r - min_r + 1
    let crop_w -> max_c - min_c + 1
    let dim -> crop_h
    when crop_w < dim { dim -> crop_w }

    let matrix -> []
    r -> 0
    do while r < dim {
        let m_row -> []
        let c -> 0
        do while c < dim {
            m_row.append(grid[min_r + r][min_c + c])
            c -> c + 1
        }
        matrix.append(m_row)
        r -> r + 1
    }

    <- read_matrix(matrix)
}

/!
  Reads and decodes SVG XML markup string containing <rect> modules.
!/
function _extract_attr(line, attr_name) {
    let prefix -> attr_name + `="`
    let idx -> Str.index_of(line, prefix)
    when idx < 0 { <- Nothing }
    let start_pos -> idx + Str.length(prefix)
    let rest -> Str.substring(line, start_pos, Str.length(line))
    let end_idx -> Str.index_of(rest, `"`)
    when end_idx < 0 { <- Nothing }
    let val_str -> Str.substring(rest, 0, end_idx)
    <- _parse_dec(val_str)
}

export function read_svg(svg_text) {
    let lines -> Str.split(svg_text, `\n`)
    let rects -> []

    for line in lines {
        when Str.index_of(line, `<rect`) >= 0 and (Str.index_of(line, `#000000`) >= 0 or Str.index_of(line, `black`) >= 0) {
            let x_val -> _extract_attr(line, `x`)
            let y_val -> _extract_attr(line, `y`)
            when x_val != Nothing and y_val != Nothing {
                rects.append({ `x` -> x_val, `y` -> y_val })
            }
        }
    }

    when rects.length == 0 { <- Nothing }

    let min_x -> rects[0][`x`]
    let max_x -> rects[0][`x`]
    let min_y -> rects[0][`y`]
    let max_y -> rects[0][`y`]

    for r in rects {
        when r[`x`] < min_x { min_x -> r[`x`] }
        when r[`x`] > max_x { max_x -> r[`x`] }
        when r[`y`] < min_y { min_y -> r[`y`] }
        when r[`y`] > max_y { max_y -> r[`y`] }
    }

    let diff_min -> 999999
    for r in rects {
        let dx -> r[`x`] - min_x
        when dx > 0 and dx < diff_min { diff_min -> dx }
        let dy -> r[`y`] - min_y
        when dy > 0 and dy < diff_min { diff_min -> dy }
    }
    let mod_size -> diff_min
    when mod_size <= 0 { mod_size -> 8 }

    let dim -> (((max_x - min_x) / mod_size) <: Integer) + 1

    let matrix -> []
    let r_idx -> 0
    do while r_idx < dim {
        let row -> []
        let c_idx -> 0
        do while c_idx < dim {
            row.append(False)
            c_idx -> c_idx + 1
        }
        matrix.append(row)
        r_idx -> r_idx + 1
    }

    for r in rects {
        let cx -> ((r[`x`] - min_x) / mod_size) <: Integer
        let cy -> ((r[`y`] - min_y) / mod_size) <: Integer
        when cx >= 0 and cx < dim and cy >= 0 and cy < dim {
            matrix[cy][cx] -> True
        }
    }

    <- read_matrix(matrix)
}

/!
  Reads and decodes standard 24-bit uncompressed BMP image bytes.
!/
export function read_bmp(bmp_bytes) {
    when bmp_bytes.length < 54 { <- Nothing }
    when bmp_bytes[0] != 0x42 or bmp_bytes[1] != 0x4D { <- Nothing }

    let width -> bmp_bytes[18] | (bmp_bytes[19] << 8) | (bmp_bytes[20] << 16) | (bmp_bytes[21] << 24)
    let height -> bmp_bytes[22] | (bmp_bytes[23] << 8) | (bmp_bytes[24] << 16) | (bmp_bytes[25] << 24)
    when width <= 0 or height <= 0 { <- Nothing }

    let data_offset -> bmp_bytes[10] | (bmp_bytes[11] << 8) | (bmp_bytes[12] << 16) | (bmp_bytes[13] << 24)
    let row_size -> ((width * 3 + 3) >> 2) << 2

    let pixels -> []
    let y -> 0
    do while y < height {
        let row -> []
        let x -> 0
        do while x < width {
            let p_idx -> data_offset + (height - 1 - y) * row_size + x * 3
            when p_idx + 2 < bmp_bytes.length {
                let b -> bmp_bytes[p_idx]
                let g -> bmp_bytes[p_idx + 1]
                let r -> bmp_bytes[p_idx + 2]
                let lum -> ((r * 299 + g * 587 + b * 114) / 1000) <: Integer
                row.append(lum < 128)
            } or {
                row.append(False)
            }
            x -> x + 1
        }
        pixels.append(row)
        y -> y + 1
    }

    let min_x -> -1
    let min_y -> -1
    let max_x -> -1
    let max_y -> -1

    y -> 0
    do while y < height {
        let x -> 0
        do while x < width {
            when pixels[y][x] {
                when min_x < 0 or x < min_x { min_x -> x }
                when max_x < 0 or x > max_x { max_x -> x }
                when min_y < 0 or y < min_y { min_y -> y }
                when max_y < 0 or y > max_y { max_y -> y }
            }
            x -> x + 1
        }
        y -> y + 1
    }

    when min_x < 0 or min_y < 0 { <- Nothing }

    let finder_run -> 0
    let fx -> min_x
    while fx <= max_x and pixels[min_y][fx] {
        finder_run -> finder_run + 1
        fx -> fx + 1
    }
    let mod_size -> ((finder_run + 3) / 7) <: Integer
    when mod_size <= 0 { mod_size -> 1 }

    let dim -> (((max_x - min_x + 1) + ((mod_size / 2) <: Integer)) / mod_size) <: Integer

    let matrix -> []
    let my -> 0
    do while my < dim {
        let m_row -> []
        let mx -> 0
        do while mx < dim {
            let px -> min_x + mx * mod_size + ((mod_size / 2) <: Integer)
            let py -> min_y + my * mod_size + ((mod_size / 2) <: Integer)
            let is_dark -> False
            when px >= 0 and px < width and py >= 0 and py < height {
                is_dark -> pixels[py][px]
            }
            m_row.append(is_dark)
            mx -> mx + 1
        }
        matrix.append(m_row)
        my -> my + 1
    }

    <- read_matrix(matrix)
}

/!
  Universal read auto-dispatcher:
  Accepts raw Matrix, Unicode/ASCII String, SVG markup, or BMP byte list.
!/
export function read(input_data) {
    when input_data == Nothing { <- Nothing }
    when type(input_data) == `List` {
        when input_data.length == 0 { <- Nothing }
        when type(input_data[0]) == `List` {
            <- read_matrix(input_data)
        }
        <- read_bmp(input_data)
    }
    when type(input_data) == `String` {
        when Str.index_of(input_data, `<svg`) >= 0 {
            <- read_svg(input_data)
        }
        when Str.index_of(input_data, `▀`) >= 0 or Str.index_of(input_data, `▄`) >= 0 or Str.index_of(input_data, `█`) >= 0 {
            <- read_terminal(input_data)
        }
        <- read_ascii(input_data)
    }
    <- Nothing
}
