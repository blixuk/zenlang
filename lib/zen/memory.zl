/!
 Memory management primitives.
 Provides interface for arena allocation and manual memory control.
!/

let __builtin -> __builtin_memory

/!
 Creates a new memory arena of the specified size.
 @param size The size of the arena in bytes.
 @return A handle to the created arena.
!/
function create_arena(size) {
    <- __builtin.create_arena(size)
}

/!
 Frees a memory arena and all its associated memory.
 @param arena The handle to the arena to free.
!/
function free_arena(arena) {
    __builtin.free_arena(arena)
}

/!
 Resets a memory arena, making its memory available for reuse without freeing it.
 @param arena The handle to the arena to reset.
!/
function reset_arena(arena) {
    __builtin.reset_arena(arena)
}

/!
 Pushes an arena onto the current allocation stack.
 All subsequent allocations will occur in this arena until popped.
 @param arena The handle to the arena to push.
!/
function push_arena(arena) {
    __builtin.push_arena(arena)
}

/!
 Pops the top arena from the allocation stack.
!/
function pop_arena() {
    __builtin.pop_arena()
}

/!
 Object-oriented wrapper for memory arenas.
!/
class Arena {
    let _handle

    /!
     Initializes the arena with a specified size.
     @param size The size of the arena.
    !/
    function init(size) {
        self._handle -> create_arena(size)
    }

    /!
     Frees the arena.
    !/
    function free() {
        free_arena(self._handle)
    }

    /!
     Resets the arena.
    !/
    function reset() {
        reset_arena(self._handle)
    }

    /!
     Pushes the arena onto the allocation stack.
    !/
    function push() {
        push_arena(self._handle)
    }

    /!
     Pops the arena from the allocation stack.
    !/
    function pop() {
        pop_arena()
    }
}

/!
 Context-based allocation region.
!/
function Region(size -> 1024) {
    <- create_arena(size)
}
