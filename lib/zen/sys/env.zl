/!
  Environment Variable Access Module for Zenlang.
  Provides typed getters, validation, and lifecycle operations backed by the ambient `env` map.
!/

import zen.text.string as Str

/!
  Gets an environment variable or returns the default value.
  @param name The name of the environment variable.
  @param default_val The fallback value if not found.
  @return The string value or default_val.
!/
export function get(name, default_val) {
    when name in env {
        <- env[name]
    }
    <- default_val
}

/!
  Checks if an environment variable exists.
  @param name The name of the environment variable.
  @return True if defined, False otherwise.
!/
export function has(name) {
    <- name in env
}

/!
  Requires an environment variable to exist.
  @param name The name of the environment variable.
  @return The string value.
!/
export function require(name) {
    when name in env {
        <- env[name]
    }
    raise `Environment variable '` + name + `' is required`
}

/!
  Gets an environment variable parsed as an Integer.
  @param name The name of the environment variable.
  @param default_val The fallback integer if not found.
  @return The integer value.
!/
export function get_int(name, default_val) {
    when name in env {
        let val -> env[name]
        when val != Nothing and val != `` {
            <- Integer(val)
        }
    }
    <- default_val
}

/!
  Gets an environment variable parsed as a Boolean.
  Truth values: `true`, `1`, `yes`. False values: `false`, `0`, `no`.
  @param name The name of the environment variable.
  @param default_val The fallback boolean if not found.
  @return The boolean value.
!/
export function get_bool(name, default_val) {
    when name in env {
        let val -> env[name]
        when val == `true` or val == `1` or val == `yes` {
            <- true
        }
        when val == `false` or val == `0` or val == `no` {
            <- false
        }
    }
    <- default_val
}

/!
  Gets an environment variable parsed as a Decimal.
  @param name The name of the environment variable.
  @param default_val The fallback decimal if not found.
  @return The decimal value.
!/
export function get_decimal(name, default_val) {
    when name in env {
        let val -> env[name]
        when val != Nothing and val != `` {
            <- Decimal(val)
        }
    }
    <- default_val
}

/!
  Sets an environment variable in both the ambient `env` map and the process environment.
  @param name The variable name.
  @param value The value to set.
!/
export function set(name, value) {
    let s -> Str.to_string(value)
    env[name] -> s
    __builtin_sys.set_env(name, s)
}

/!
  Unsets an environment variable.
  @param name The variable name.
!/
export function unset(name) {
    when name in env {
        env[name] -> Nothing
    }
    __builtin_sys.unset_env(name)
}

export function delete(name) {
    unset(name)
}

/!
  Lists all environment variable keys.
  @return A list of variable names.
!/
export function keys() {
    <- __builtin_map.keys(env)
}

/!
  Returns a snapshot map of all current environment variables.
  @return Map of environment key-value pairs.
!/
export function all() {
    let snapshot -> {}
    let ks -> __builtin_map.keys(env)
    do for k in ks {
        snapshot[k] -> env[k]
    }
    <- snapshot
}

export function to_map() {
    <- all()
}
