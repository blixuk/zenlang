/!
 Terminal UI utility module.
 Provides functions for terminal control, colors, and layout.
 !/

/!
 Clears the terminal screen and home the cursor.
 !/
function clear() {
    __builtin_term.clear()
}

/!
 Moves the cursor to the specified coordinates.
 @param x The column index (1-based).
 @param y The row index (1-based).
 !/
function move(x, y) {
    __builtin_term.move(x, y)
}

/!
 Sets the foreground and background colors of the terminal.
 @param fg The foreground color name (e.g. `green`).
 @param bg The background color name (e.g. `black`).
 !/
function color(fg, bg) {
    __builtin_term.color(fg, bg)
}

/!
 Resets all terminal attributes (colors, styles).
 !/
function reset() {
    __builtin_term.reset()
}

/!
 Returns the current terminal size.
 @return A record with `width` and `height`.
 !/
function get_size() {
    <- __builtin_term.get_size()
}

/!
 Executes a block of code within the alternate screen buffer.
 Ensures the terminal returns to the original state even if an error occurs.
 @param fn A closure to execute.
 !/
function alt_screen(fn) {
    __builtin_output.write(`\033[?1049h`) // Enter alt screen
    move(1, 1)
    
    // Use check or try-finally pattern if supported.
    // Since we don't have try-finally yet, we'll just run it.
    fn()
    
    __builtin_output.write(`\033[?1049l`) // Exit alt screen
}
