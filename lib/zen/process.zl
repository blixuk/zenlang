/!
 Process control module.
 Provides functions for running external commands and environment management.
 !/

/!
 Represents a system process.
 !/
class Process {
    let _instance
    let _cmd
    let _args

    /!
     Initializes a process with a command and arguments.
     !/
    function init(cmd, args) {
        self._cmd -> cmd
        self._args -> args
        self._instance -> nothing
    }

    /!
     Spawns the process.
     !/
    function start() {
        self._instance -> __builtin_process.spawn(self._cmd, self._args)
    }

    /!
     Waits for the process to complete and returns the exit code.
     !/
    function wait() {
        when self._instance == nothing { raise `ProcessNotStarted` }
        <- self._instance.wait()
    }

    /!
     Returns the standard output of the process.
     !/
    function stdout() {
        when self._instance == nothing { raise `ProcessNotStarted` }
        <- self._instance.get_stdout()
    }

    /!
     Returns the exit code of the process.
     !/
    function code() {
        when self._instance == nothing { raise `ProcessNotStarted` }
        <- self._instance.get_code()
    }

    /!
     Kills the process.
     !/
    function kill() {
        when self._instance == nothing { raise `ProcessNotStarted` }
        self._instance.kill()
    }
}

/!
 Executes a command with arguments and returns the standard output.
 @param command The command to run.
 @param arguments The list of arguments.
 @return The output of the command.
 !/
function run(command, arguments) {
    <- __builtin_process.run(command, arguments)
}

/!
 Returns the process ID of the current process.
 @return The PID.
 !/
function get_id() {
    <- __builtin_process.get_id()
}
