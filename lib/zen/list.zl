/!
 List utility module.
 Provides functional operations for lists.
 !/

/!
 Applies a function to each element of a list and returns a new list of results.
 @param list The list to map.
 @param fn The function to apply (element -> result).
 @return A new list.
 !/
function map(list, fn) {
    let res -> []
    do for item in list {
        res -> res + [fn(item)]
    }
    <- res
}

/!
 Filters a list based on a predicate function.
 @param list The list to filter.
 @param fn The predicate function (element -> boolean).
 @return A new list containing only elements that matched the predicate.
 !/
function filter(list, fn) {
    let res -> []
    do for item in list {
        when fn(item) {
            res -> res + [item]
        }
    }
    <- res
}

/!
 Reduces a list to a single value using an accumulator function.
 @param list The list to reduce.
 @param initial The initial accumulator value.
 @param fn The reducer function (accumulator, element -> new_accumulator).
 @return The final accumulator value.
 !/
function reduce(list, initial, fn) {
    let acc -> initial
    do for item in list {
        acc -> fn(acc, item)
    }
    <- acc
}

/!
 Executes a function for each element of a list.
 @param list The list.
 @param fn The function to execute (element -> void).
 !/
function each(list, fn) {
    do for item in list {
        fn(item)
    }
}

/!
 Finds the first element in a list that matches a predicate.
 @param list The list.
 @param fn The predicate function.
 @return The element, or nothing if not found.
 !/
function find(list, fn) {
    do for item in list {
        when fn(item) {
            <- item
        }
    }
    <- nothing
}

/!
 Checks if a list contains a specific value.
 @param list The list.
 @param val The value to search for.
 @return True if found, False otherwise.
 !/
function contains(list, val) {
    do for item in list {
        when item == val {
            <- true
        }
    }
    <- false
}
