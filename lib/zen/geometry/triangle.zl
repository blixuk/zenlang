import zen.geometry.point as point
import zen.math.math as math

/!
 Class representing a 2D triangle.
 !/
class Triangle {
    let p1: Point
    let p2: Point
    let p3: Point

    /!
     Initializes a new Triangle.
     @param p1 The first point.
     @param p2 The second point.
     @param p3 The third point.
     !/
    function init(p1, p2, p3) {
        self.p1 -> p1
        self.p2 -> p2
        self.p3 -> p3
    }

    /!
     Calculates the area of the triangle.
     !/
    function area() {
        <- math.abs(
            (self.p1.x * (self.p2.y - self.p3.y) +
             self.p2.x * (self.p3.y - self.p1.y) +
             self.p3.x * (self.p1.y - self.p2.y)) / 2
        )
    }
}
