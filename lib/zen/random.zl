/!
 Deterministic Randomness module.
 Provides seedable PRNGs and global randomness functions.
 !/

/!
 Initializes a new deterministic random number generator with a seed.
 @param s The seed value.
 @return An RNG object.
 !/
function seed(s) {
    <- __builtin_random.seed(s)
}

/!
 Returns a random integer between min and max (inclusive).
 @param min The minimum value.
 @param max The maximum value.
 @return A random integer.
 !/
function integer(min, max) {
    <- __builtin_random.integer(min, max)
}

/!
 Returns a random decimal between min and max.
 @param min The minimum value.
 @param max The maximum value.
 @return A random decimal.
 !/
function decimal(min, max) {
    <- __builtin_random.decimal(min, max)
}

/!
 Returns a random value in the specified range.
 If min and max are integers, returns an integer.
 Otherwise returns a decimal.
 @param min The minimum value.
 @param max The maximum value.
 @return A random value.
 !/
function range(min, max) {
    <- __builtin_random.range(min, max)
}
