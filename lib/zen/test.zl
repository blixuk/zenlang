import zen.io as IO
import zen.string as Str

/!
 Unit testing framework.
 Provides assertions and test management utilities.
 !/

/!
 Assets that two values are equal.
 @param actual The actual value.
 @param expected The expected value.
 @param message Optional message to display on failure.
 !/
function assert_equal(actual, expected, message) {
    let msg -> message
    when msg == nothing {
        msg -> `Assertion failed`
    }
    
    when actual != expected {
        IO.error(msg + `: expected ` + Str.to_string(expected) + ` but got ` + Str.to_string(actual))
        <- false
    }
    <- true
}

/!
 Assets that a value is true.
 @param value The value.
 @param message Optional message.
 !/
function assert_true(value, message) {
    <- assert_equal(value, true, message)
}

/!
 Assets that a value is false.
 @param value The value.
 @param message Optional message.
 !/
function assert_false(value, message) {
    <- assert_equal(value, false, message)
}

/!
 Runs a test function and captures its success/failure.
 @param name The name of the test.
 @param fn The test function.
 !/
function run_unit(name, fn) {
    IO.info(`Running test: ` + name)
    let success -> fn()
    when success {
        IO.info(`  [PASS] ` + name)
    } or {
        IO.error(`  [FAIL] ` + name)
    }
    <- success
}

/!
 Simple suite-like runner for multiple tests.
 @param name The name of the suite.
 @param tests A list of maps with 'name' and 'fn'.
 !/
function run_suite(name, tests) {
    IO.info(`--- Running Suite: ` + name + ` ---`)
    let passed -> 0
    let total -> __builtin_string.length(tests)
    
    do for t in tests {
        when run_unit(t[`name`], t[`fn`]) {
            passed -> passed + 1
        }
    }
    
    IO.info(`--- ` + name + `: ` + Str.to_string(passed) + `/` + Str.to_string(total) + ` passed ---`)
    <- passed == total
}
