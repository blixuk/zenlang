CC = gcc
PYTHON = python3
CFLAGS = -g -Wall -I runtime -I runtime/include
export ZEN_PATH = $(shell pwd):$(shell pwd)/src
BOOTSTRAP_DIR = bootstrap
SRC_DIR = src
BUILD_DIR = build
BIN_DIR = bin
RUNTIME_DIR = runtime

ZEN_SRC = $(SRC_DIR)/zen.zl
ZEN_DRIVER_C = $(BUILD_DIR)/zen.c
ZEN_EXE = $(BIN_DIR)/zen

STUBS_C = $(BUILD_DIR)/compiler_stubs.c
RUNTIME_C = $(RUNTIME_DIR)/main_wrapper.c \
               $(RUNTIME_DIR)/io/io_default.c \
               $(RUNTIME_DIR)/object/string.c \
               $(RUNTIME_DIR)/object/list.c \
               $(RUNTIME_DIR)/sys/sys_default.c \
               $(RUNTIME_DIR)/memory/allocator_default.c
# Self-host driver entry (provides zen_main called from host_main)
HOST_MAIN_C = $(BUILD_DIR)/host_main.c
# Components generated by bootstrap
COMPONENTS_C = $(BUILD_DIR)/Token.c $(BUILD_DIR)/Lexer.c $(BUILD_DIR)/AST.c $(BUILD_DIR)/Parser.c $(BUILD_DIR)/CTranspiler.c $(BUILD_DIR)/Resolver.c $(BUILD_DIR)/DependencyGraph.c
COMPONENTS_H = $(BUILD_DIR)/Token.h $(BUILD_DIR)/Lexer.h $(BUILD_DIR)/AST.h $(BUILD_DIR)/Parser.h $(BUILD_DIR)/CTranspiler.h $(BUILD_DIR)/Resolver.h $(BUILD_DIR)/DependencyGraph.h

all: $(ZEN_EXE)

$(BIN_DIR)/zen: $(ZEN_DRIVER_C) $(COMPONENTS_C) $(COMPONENTS_H) $(RUNTIME_C) $(HOST_MAIN_C)
	@mkdir -p $(BIN_DIR)
	$(CC) $(CFLAGS) -o $@ $(HOST_MAIN_C) $(ZEN_DRIVER_C) $(COMPONENTS_C) $(RUNTIME_C) -I $(BUILD_DIR) -I $(BUILD_DIR)/core -I $(BUILD_DIR)/collections -I $(BUILD_DIR)/io -I $(RUNTIME_DIR)/sys -I $(RUNTIME_DIR)/io -I $(RUNTIME_DIR)/object -I $(RUNTIME_DIR)/memory

$(ZEN_DRIVER_C): $(ZEN_SRC)
	@mkdir -p $(BUILD_DIR)
	cd $(BOOTSTRAP_DIR) && $(PYTHON) Zen.py ../$(ZEN_SRC) ../$(ZEN_SRC) ../$(ZEN_DRIVER_C)



$(BUILD_DIR)/Token.c: src/compiler/Token.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Token.zl $@

$(BUILD_DIR)/Lexer.c: src/compiler/Lexer.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Lexer.zl $@

$(BUILD_DIR)/AST.c: src/compiler/AST.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/AST.zl $@

$(BUILD_DIR)/Parser.c: src/compiler/Parser.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Parser.zl $@

$(BUILD_DIR)/CTranspiler.c: src/compiler/CTranspiler.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/CTranspiler.zl $@

$(BUILD_DIR)/Resolver.c: src/compiler/Module/Resolver.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Module/Resolver.zl $@

$(BUILD_DIR)/DependencyGraph.c: src/compiler/Module/DependencyGraph.zl $(ZEN_SRC)
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Module/DependencyGraph.zl $@

$(STUBS_C):
	@mkdir -p $(BUILD_DIR)
	@echo "Copying stubs..."
	cp src/stubs/*.h $(BUILD_DIR)/
	cp src/stubs/*.c $(BUILD_DIR)/

$(HOST_MAIN_C): src/compiler/host_main.c
	@mkdir -p $(BUILD_DIR)
	cp src/compiler/host_main.c $@

clean:
	rm -rf $(BUILD_DIR)/* $(BIN_DIR)/*

# --- Self-host build (uses the .zl sources transpiled by the self-host driver) ---
# This copies the full bootstrap runtime tree (like CCompile does) so the
# generated code from src/compiler/*.zl links against a matching runtime.
setup-runtime:
	@mkdir -p $(BUILD_DIR)
	@echo "Copying bootstrap runtime tree into build/ ..."
	@rm -rf $(BUILD_DIR)/core $(BUILD_DIR)/collections $(BUILD_DIR)/io $(BUILD_DIR)/memory $(BUILD_DIR)/concurrency $(BUILD_DIR)/bootstrap_runtime.*
	@cp -r bootstrap/Transpiler/runtime/* $(BUILD_DIR)/ || true

# Install a working bin/zen that drives the Python bootstrap (authoritative compiler).
# For the experimental self-host driver (src/zen.zl), use: make selfhost-driver
selfhost:
	@mkdir -p bin
	@printf '#!/bin/sh\n' > bin/zen
	@printf '# Zenlang CLI: Python bootstrap (authoritative)\n' >> bin/zen
	@printf 'SCRIPT_DIR=$$(CDPATH= cd -- "$$(dirname -- "$$0")" && pwd)\n' >> bin/zen
	@printf 'ROOT=$$(CDPATH= cd -- "$$SCRIPT_DIR/.." && pwd)\n' >> bin/zen
	@printf 'exec python3 "$$ROOT/bootstrap/Zen.py" "$$@"\n' >> bin/zen
	@chmod +x bin/zen
	@ls -l bin/zen
	@echo "Usage: ./bin/zen file.zl            # interpret"
	@echo "       ./bin/zen -g file.zl         # transpile to C, compile, run"
	@echo "       ./bin/zen --test file.zl     # run test_* functions"
	@echo "       ./bin/zen --check file.zl    # typecheck only"

# Experimental: bin/zen invokes src/zen.zl as the driver (partial self-host).
selfhost-driver:
	@mkdir -p bin
	@printf '#!/bin/sh\n' > bin/zen
	@printf '# Experimental self-host driver: src/zen.zl via bootstrap\n' >> bin/zen
	@printf 'SCRIPT_DIR=$$(CDPATH= cd -- "$$(dirname -- "$$0")" && pwd)\n' >> bin/zen
	@printf 'ROOT=$$(CDPATH= cd -- "$$SCRIPT_DIR/.." && pwd)\n' >> bin/zen
	@printf 'exec python3 "$$ROOT/bootstrap/Zen.py" "$$ROOT/src/zen.zl" "$$@"\n' >> bin/zen
	@chmod +x bin/zen
	@ls -l bin/zen
	@echo "Usage: ./bin/zen file.zl [out.c]   # experimental self-host path"

# Language core: interpret only
test-core:
	bash scripts/run_core_tests.sh

# Language core: interpret vs native (-g) parity
test-parity:
	bash scripts/run_core_parity.sh

# Standard library (interpreter only)
test-lib:
	bash tests/lib/run_all.sh

# Small native stdlib smoke (subset that already transpiles)
test-lib-native:
	bash scripts/run_lib_smoke_native.sh

# Default developer test entry (core + parity + lib + native lib smoke)
test: test-core test-parity test-lib test-lib-native

# Try to build native bin/zen from the self-host generated C pieces.
selfhost-regen: clean setup-runtime
	python3 bootstrap/Zen.py src/zen.zl src/zen.zl $(BUILD_DIR)/zen.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Token.zl $(BUILD_DIR)/Token.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Lexer.zl $(BUILD_DIR)/Lexer.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/AST.zl $(BUILD_DIR)/AST.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Parser.zl $(BUILD_DIR)/Parser.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/CTranspiler.zl $(BUILD_DIR)/CTranspiler.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Module/Resolver.zl $(BUILD_DIR)/Resolver.c
	python3 bootstrap/Zen.py src/zen.zl src/compiler/Module/DependencyGraph.zl $(BUILD_DIR)/DependencyGraph.c
	$(MAKE) $(ZEN_EXE)

.PHONY: all clean setup-runtime selfhost selfhost-driver selfhost-regen test test-core test-parity test-lib test-lib-native
