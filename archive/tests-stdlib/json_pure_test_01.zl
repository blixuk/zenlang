import zen.io.io as IO
import zen.data.json as JSON
import zen.text.string as Str

function test_json() {
    IO.info(`--- Testing Pure Zenlang JSON ---`)
    
    let data -> {
        `name` -> `Zen`,
        `version` -> 0.1,
        `active` -> True,
        `features` -> [`fast`, `simple`, 42],
        `meta` -> { `os` -> `unix`, `null_val` -> Nothing }
    }
    
    let s -> JSON.stringify(data)
    IO.info(`  Stringified: ` + s)
    
    let parsed -> JSON.parse(s)
    IO.info(`  Parsed successfully.`)
    
    // In JSON parsing, numbers are often decimal, so we check carefully
    when parsed[`name`] == `Zen` and parsed[`active`] == True {
        IO.info(`  Basic fields check: PASSED`)
    } or {
        IO.error(`  Basic fields check: FAILED`)
    }
    
    when parsed[`features`][0] == `fast` and parsed[`features`][2] == 42 {
        IO.info(`  Nested list check: PASSED`)
    } or {
        IO.error(`  Nested list check: FAILED`)
    }

    when parsed[`meta`][`os`] == `unix` and parsed[`meta`][`null_val`] == Nothing {
        IO.info(`  Nested map check: PASSED`)
    } or {
        IO.error(`  Nested map check: FAILED`)
    }
}

function zen_entry() {
    test_json()
}
