import zen.io.io as IO
import zen.collections as Coll
import zen.text.string as Str

function test_stack() {
    IO.info(`--- Testing Stack (Class) ---`)
    let s -> Coll.Stack()
    s.push(1)
    s.push(2)
    s.push(3)
    
    IO.info(`  Peek: ` + Str.to_string(s.peek()))
    IO.info(`  Pop: ` + Str.to_string(s.pop()))
    IO.info(`  Pop: ` + Str.to_string(s.pop()))
    s.push(4)
    IO.info(`  Pop: ` + Str.to_string(s.pop()))
    IO.info(`  Pop: ` + Str.to_string(s.pop()))
}

function test_queue() {
    IO.info(`--- Testing Queue (Class) ---`)
    let q -> Coll.Queue()
    q.enqueue(1)
    q.enqueue(2)
    q.enqueue(3)
    
    IO.info(`  Peek: ` + Str.to_string(q.peek()))
    IO.info(`  Dequeue: ` + Str.to_string(q.dequeue()))
    IO.info(`  Dequeue: ` + Str.to_string(q.dequeue()))
    q.enqueue(4)
    IO.info(`  Dequeue: ` + Str.to_string(q.dequeue()))
    IO.info(`  Dequeue: ` + Str.to_string(q.dequeue()))
}

function zen_entry() {
    test_stack()
    test_queue()
}
