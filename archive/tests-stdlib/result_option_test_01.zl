import zen.io.io
import zen.core

function test_option(opt) {
    io.write(`Testing Option: `)
    when opt {
        is Option.Something(v) {
            io.write(`Some(`)
            io.write(v)
            io.write(`)\n`)
        }
        is Option.Nothing {
            io.write(`Nothing\n`)
        }
        or {
            io.write(`Not an option\n`)
        }
    }
}

function test_result(res) {
    io.write(`Testing Result: `)
    when res {
        is Result.Ok(v) {
            io.write(`Ok(`)
            io.write(v)
            io.write(`)\n`)
        }
        is Result.Error(m) {
            io.write(`Error: `)
            io.write(m)
            io.write(`\n`)
        }
        or {
            io.write(`Not a result\n`)
        }
    }
}

function main() {
    let s -> Option.Something(100)
    let n -> Option.Nothing
    
    test_option(s)
    test_option(n)
    test_option(`hello`)
    
    let r1 -> Result.Ok(`Success`)
    let r2 -> Result.Error(`Failed`)
    
    test_result(r1)
    test_result(r2)
    
    io.write(`is_something(s): `)
    io.write(core.is_something(s))
    io.write(`\n`)
    
    io.write(`unwrap(s): `)
    io.write(core.unwrap(s))
    io.write(`\n`)
    
    io.write(`is_ok(r1): `)
    io.write(core.is_ok(r1))
    io.write(`\n`)
}
