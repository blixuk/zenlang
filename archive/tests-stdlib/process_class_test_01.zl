import zen.io.io as IO
import zen.sys.process as Proc
import zen.text.string as Str

function test_process_class() {
    IO.info(`--- Testing Process Class ---`)
    
    // Test 'ls -la' or similar
    let p -> Proc.Process(`ls`, [`-la`])
    IO.info(`  Process initialized.`)
    
    p.start()
    IO.info(`  Process started.`)
    
    let code -> p.wait()
    IO.info(`  Process finished with code: ` + Str.to_string(code))
    
    let output -> p.stdout()
    IO.info(`  Output length: ` + Str.to_string(output.length()))
    
    when output.length() > 0 {
        IO.info(`  Process output received successfully.`)
    }
}

function zen_entry() {
    test_process_class()
}
