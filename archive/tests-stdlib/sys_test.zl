from zen.io import write
import zen.sys.sys as sys
import zen.text.string as s

let args -> sys.get_args()
write(`Arguments count: ` + s.length(args))

// Usually first arg is the script path
when s.length(args) > 0 {
    write(`Script path: ` + args[0])
}

