
function fib(n) {
    when n <= 1 {
        <- n
    }
    <- fib(n - 1) + fib(n - 2)
}

function loop_accumulate(limit) {
    let sum -> 0
    let i -> 0
    do while i < limit {
        sum -> sum + (i % 10)
        i -> i + 1
    }
    <- sum
}

function collections_workload(count) {
    let items -> []
    let i -> 0
    do while i < count {
        items.append(i * 2)
        i -> i + 1
    }
    let map_data -> {
        `first` -> items[0],
        `mid` -> items[500],
        `last` -> items[count - 1]
    }
    <- map_data[`mid`]
}

function main() {
    let f -> fib(15)
    let l -> loop_accumulate(10000)
    let c -> collections_workload(1000)
    <- 0
}
