/!
 Selfhost driver entry — Standalone pure Zen host (no Python).
 Commands: compile | build | bundle | run | vm | interpret | check | deps | plugin | todo | lint | help
 !/

import compiler.Driver as Driver
import compiler.Plugin as Plugin
import zen.io.io as io
import zen.sys.sys as Sys

function main() {
    Plugin.register_plugin(Plugin.make_todo_tracker_plugin())
    Plugin.register_plugin(Plugin.make_linter_plugin())
    let args -> Sys.get_args()
    let r -> Driver.run_args(args)
    when r == Nothing {
        <- 0
    }
    let msg -> r[`message`]
    when msg != Nothing and msg != `` {
        io.writeln(msg)
    }
    let code -> r[`code`]
    when code == Nothing {
        <- 0
    }
    // Pass through integer program/CLI codes.
    <- code
}
