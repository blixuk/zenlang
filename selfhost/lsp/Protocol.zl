/!
  Language Server Protocol (LSP) — Protocol & Framing.
  Implements JSON-RPC 2.0 framing over standard I/O for Zenlang LSP.
!/

import zen.concurrency as conc
import zen.data.json as json
import zen.io.io as io
import zen.text.string as Str

/!
  Parses Content-Length integer from header line.
  e.g. "Content-Length: 123" -> 123
!/
export function parse_content_length(line) {
    let prefix -> `content-length:`
    let lower -> Str.trim(line)
    when lower.length < prefix.length {
        <- -1
    }
    let sub -> lower.substring(0, prefix.length)
    when sub != `Content-Length:` and sub != `content-length:` and sub != `CONTENT-LENGTH:` {
        <- -1
    }
    let rest -> Str.trim(lower.substring(prefix.length, lower.length))
    let n -> 0
    let i -> 0
    do while i < rest.length {
        let c -> rest.at(i)
        when c >= `0` and c <= `9` {
            let digit -> 0
            when c == `1` { digit -> 1 }
            when c == `2` { digit -> 2 }
            when c == `3` { digit -> 3 }
            when c == `4` { digit -> 4 }
            when c == `5` { digit -> 5 }
            when c == `6` { digit -> 6 }
            when c == `7` { digit -> 7 }
            when c == `8` { digit -> 8 }
            when c == `9` { digit -> 9 }
            n -> n * 10 + digit
        }
        i -> i + 1
    }
    <- n
}

/!
  Reads a single JSON-RPC message from standard input.
  Returns map payload, or Nothing on EOF/error.
!/
export function read_rpc_message() {
    let content_len -> -1
    do while true {
        let line -> io.read_line()
        when line == Nothing {
            <- Nothing
        }
        let trimmed -> Str.trim(line)
        when trimmed == `` {
            // End of headers
            break
        }
        let cl -> parse_content_length(trimmed)
        when cl >= 0 {
            content_len -> cl
        }
    }
    when content_len < 0 {
        <- Nothing
    }
    let body -> io.read_exact(content_len)
    when body == Nothing or body == `` {
        <- Nothing
    }
    let msg -> json.parse(body)
    <- msg
}

/!
  Reads JSON-RPC messages from stdin without blocking the fiber pool.
  Uses non-blocking kernel event reactor (poll_fd) with timeout.
!/
export function read_message_async() {
    // 1. Wait for stdin (fd 0) to be readable (POLLIN = 1)
    // Timeout of 0.5s allows graceful shutdown checks
    let ready -> conc.poll_fd(0, 1, 0.5)
    when ready <= 0 {
        <- Nothing
    }

    // 2. Read headers until empty line
    let content_len -> -1
    do while true {
        let line -> io.read_line()
        when line == Nothing {
            <- Nothing
        }
        let trimmed -> Str.trim(line)
        when trimmed == `` {
            break
        }
        let cl -> parse_content_length(trimmed)
        when cl >= 0 {
            content_len -> cl
        }
    }

    when content_len < 0 {
        <- Nothing
    }

    // 3. Read exact payload bytes
    let body -> io.read_exact(content_len)
    when body == Nothing or body == `` {
        <- Nothing
    }

    let msg -> json.parse(body)
    <- msg
}

/!
  Sends a JSON-RPC message to standard output with Content-Length header.
!/
export function send_rpc_message(msg) {
    let body -> json.stringify(msg)
    let len -> body.length
    let header -> `Content-Length: ` + Str.to_string(len) + `\r\n\r\n`
    io.write_raw(header + body)
    io.flush()
}

/!
  Ergonomic alias for send_rpc_message.
!/
export function write_message(msg_map) {
    send_rpc_message(msg_map)
}

/!
  Sends a JSON-RPC response.
!/
export function send_response(id, result) {
    let resp -> {
        `jsonrpc` -> `2.0`,
        `id` -> id,
        `result` -> result
    }
    send_rpc_message(resp)
}

/!
  Sends a JSON-RPC error response.
!/
export function send_error(id, code, message) {
    let resp -> {
        `jsonrpc` -> `2.0`,
        `id` -> id,
        `error` -> {
            `code` -> code,
            `message` -> message
        }
    }
    send_rpc_message(resp)
}

/!
  Sends a JSON-RPC notification.
!/
export function send_notification(method, params) {
    let notif -> {
        `jsonrpc` -> `2.0`,
        `method` -> method,
        `params` -> params
    }
    send_rpc_message(notif)
}
