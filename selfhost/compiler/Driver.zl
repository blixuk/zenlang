/!
 Stage 6: selfhost driver pipeline.
 parse (Stage 2) → optional check (Stage 4) → codegen (Stage 5).
 Dual-path free functions; no legacy CTranspiler class path.
 !/

import compiler.Parser as Parser
import compiler.AST as AST
import compiler.TypeChecker as Checker
import compiler.Codegen as Codegen
import compiler.CLink as CLink
import compiler.Interpreter as Interp
import compiler.Bytecode as Bytecode
import compiler.Extensions as Extensions
import compiler.Daemon as Daemon
import compiler.Plugin as Plugin
import compiler.Module.GraphBuilder as GraphBuilder
import compiler.Module.DependencyGraph as Graph
import compiler.Module.Resolver as Resolver
import zen.io.io as io
import zen.text.string as Str
import zen.io.path as Path
import zen.time.time as Time
import zen.sys.sys as Sys

function fs_read(path) {
    <- __builtin_file.read(path)
}

function fs_write(path, content) {
    <- __builtin_file.write(path, content)
}

function fs_is_file(path) {
    <- __builtin_file.is_file(path)
}

function fs_is_dir(path) {
    <- __builtin_file.is_dir(path)
}

function fs_list_dir(path) {
    <- __builtin_file.list_dir(path)
}

function fs_remove(path) {
    when fs_is_file(path) {
        <- __builtin_file.remove(path)
    }
    <- false
}

function parse_file_cached(path) {
    let p -> GraphBuilder.parse_cached(path)
    when p != Nothing {
        <- p
    }
    let src -> fs_read(path)
    <- Parser.parse_source(src)
}


/!
 Compile source text through the selfhost pipeline.
 @param src Zen source string
 @param do_check when true, run TypeChecker and fail on errors
 @return map: ok, c_code, errors, program
 !/
function compile_string(src, do_check) {
    let prog -> Parser.parse_source(src)
    when AST.prog_err(prog) != Nothing {
        let pe -> []
        pe.append(`parse: ` + Str.to_string(AST.prog_err(prog)))
        <- {
            `ok` -> false,
            `c_code` -> ``,
            `errors` -> pe,
            `program` -> prog
        }
    }

    let errors -> []
    when do_check == true {
        let cr -> Checker.check_program(prog)
        when cr[`ok`] != true {
            let errs -> cr[`errors`]
            let n -> errs.length
            let i -> 0
            // copy by index (for-in consumes under -g)
            errors -> copy_errors(errs, 0, n, [])
            <- {
                `ok` -> false,
                `c_code` -> ``,
                `errors` -> errors,
                `program` -> prog
            }
        }
    }

    let c_code -> Codegen.transpile_program(prog, true, `zen_module_init`)
    // Real codegen failure prefixes with `/* parse error` — do not scan the whole
    // unit (merged sources embed the words "parse error" as string data).
    when c_code == Nothing or c_code == `` or Str.starts_with(c_code, `/* parse error`) {
        let pe -> []
        pe.append(`codegen: empty or parse error output`)
        <- {
            `ok` -> false,
            `c_code` -> c_code,
            `errors` -> pe,
            `program` -> prog
        }
    }

    <- {
        `ok` -> true,
        `c_code` -> c_code,
        `errors` -> errors,
        `program` -> prog
    }
}

function copy_errors(errs, i, n, acc) {
    when i >= n {
        <- acc
    }
    acc.append(errs[i])
    <- copy_errors(errs, i + 1, n, acc)
}

/!
 True when free functions in this file should be Prefix_name namespaced.
 Compiler + stdlib yes; test fixtures no (bare cross-file free-fn merge).
 !/
function should_namespace_path(path) {
    when path == Nothing {
        <- false
    }
    let p -> Str.to_string(path)
    when Str.contains(p, `lib/zen/`) or Str.contains(p, `/lib/zen/`) {
        <- true
    }
    when Str.contains(p, `selfhost/compiler`) or Str.contains(p, `selfhost/Module`) {
        <- true
    }
    when Str.contains(p, `/compiler/`) {
        <- true
    }
    when Str.contains(p, `selfhost/lsp`) {
        <- true
    }
    <- false
}

/!
 Module prefix for multi-file free-function names (avoids Str.join vs Path.join).
 Matches import aliases: Path, Str, Ty, AST, …
 !/
function module_fn_prefix(path) {
    when path == Nothing or path == `` {
        <- ``
    }
    when Str.ends_with(path, `/string.zl`) or Str.ends_with(path, `text/string.zl`) {
        <- `Str`
    }
    when Str.ends_with(path, `/path.zl`) or Str.ends_with(path, `io/path.zl`) {
        <- `Path`
    }
    when Str.ends_with(path, `/io.zl`) or Str.ends_with(path, `io/io.zl`) {
        <- `IO`
    }
    when Str.ends_with(path, `/sys.zl`) or Str.ends_with(path, `sys/sys.zl`) {
        <- `Sys`
    }
    when Str.ends_with(path, `/AST.zl`) {
        <- `AST`
    }
    when Str.ends_with(path, `/Types.zl`) {
        <- `Ty`
    }
    when Str.ends_with(path, `/TypeChecker.zl`) {
        <- `Checker`
    }
    when Str.ends_with(path, `/Parser.zl`) {
        <- `Parser`
    }
    when Str.ends_with(path, `/Lexer.zl`) {
        <- `Lexer`
    }
    when Str.ends_with(path, `/Codegen.zl`) {
        <- `Codegen`
    }
    when Str.ends_with(path, `/Driver.zl`) {
        <- `Driver`
    }
    when Str.ends_with(path, `/Resolver.zl`) {
        <- `Resolver`
    }
    when Str.ends_with(path, `/DependencyGraph.zl`) {
        <- `Graph`
    }
    when Str.ends_with(path, `/GraphBuilder.zl`) {
        <- `GraphBuilder`
    }
    when Str.ends_with(path, `/Interpreter.zl`) {
        <- `Interp`
    }
    when Str.ends_with(path, `/CLink.zl`) {
        <- `CLink`
    }
    when Str.ends_with(path, `/process.zl`) or Str.ends_with(path, `sys/process.zl`) {
        <- `Proc`
    }
    when Str.ends_with(path, `/json.zl`) or Str.ends_with(path, `data/json.zl`) {
        <- `json`
    }
    when Str.ends_with(path, `/Protocol.zl`) {
        <- `Protocol`
    }
    when Str.ends_with(path, `/Server.zl`) or Str.contains(path, `/lsp/Server`) {
        <- `LspServer`
    }
    when Str.ends_with(path, `/ui/color.zl`) or Str.ends_with(path, `ui/color.zl`) {
        <- `ui_color`
    }
    when Str.ends_with(path, `/file.zl`) or Str.ends_with(path, `io/file.zl`) {
        <- `File`
    }
    // Default: basename without .zl
    <- file_stem(path)
}

/!
 Last path component without .zl (pure string; no Path.join).
 !/
function file_stem(path) {
    let s -> Str.to_string(path)
    let n -> Str.length(s)
    when n == 0 {
        <- ``
    }
    // strip trailing slash without rebind loops (-g safe recursion)
    when Str.ends_with(s, `/`) and n > 1 {
        <- file_stem(Str.substring(s, 0, n - 1))
    }
    <- file_stem_from(s, n - 1)
}

function file_stem_from(s, i) {
    when i < 0 {
        <- strip_zl(s)
    }
    when Str.at(s, i) == `/` {
        <- strip_zl(Str.substring(s, i + 1, Str.length(s)))
    }
    <- file_stem_from(s, i - 1)
}

function strip_zl(base) {
    when Str.ends_with(base, `.zl`) {
        let bl -> Str.length(base)
        when bl > 3 {
            <- Str.substring(base, 0, bl - 3)
        }
    }
    <- base
}

/!
 True if `name` is in list `names` (index walk; dual-path safe).
 !/
function names_has(names, name) {
    when names == Nothing {
        <- false
    }
    let n -> names.length
    let i -> 0
    do while i < n {
        when names[i] == name {
            <- true
        }
        i -> i + 1
    }
    <- false
}

/!
 Collect bare free-function names from a file's statements (excluding main).
 !/
function collect_local_fn_names(stmts, i, n, acc) {
    when i >= n {
        <- acc
    }
    let s -> stmts[i]
    let k -> AST.ast_kind(s)
    when k == AST.K_FUNCTION {
        let fname -> Str.to_string(AST.fn_name(s))
        when fname != `main` and fname != `` {
            acc.append(fname)
        }
    }
    when k == AST.K_LET {
        let vname -> Str.to_string(AST.let_name(s))
        when vname != `` {
            acc.append(vname)
        }
    }
    when k == AST.K_STRUCTURE {
        let sname -> Str.to_string(AST.struct_name(s))
        when sname != `` {
            acc.append(sname)
        }
    }
    when k == AST.K_CLASS {
        let cname -> Str.to_string(AST.class_name(s))
        when cname != `` {
            acc.append(cname)
        }
    }
    when k == AST.K_ENUMERATOR {
        let ename -> Str.to_string(AST.enum_name(s))
        when ename != `` and ename != `Option` and ename != `Result` and ename != `Ordering` {
            acc.append(ename)
        }
    }
    when k == AST.K_SCOPE {
        let scname -> Str.to_string(AST.scope_name(s))
        when scname != `` {
            acc.append(scname)
        }
        let sc_body -> AST.scope_body(s)
        let sc_stmts -> []
        when sc_body != Nothing {
            when AST.ast_kind(sc_body) == AST.K_BLOCK {
                sc_stmts -> AST.block_stmts(sc_body)
            } or {
                sc_stmts -> sc_body
            }
        }
        when sc_stmts != Nothing {
            let si -> 0
            let sn -> sc_stmts.length
            do while si < sn {
                let sm -> sc_stmts[si]
                when sm != Nothing and AST.ast_kind(sm) == AST.K_FUNCTION {
                    let sfname -> Str.to_string(AST.fn_name(sm))
                    when sfname != `` {
                        acc.append(scname + `_` + sfname)
                    }
                }
                si -> si + 1
            }
        }
    }
    <- collect_local_fn_names(stmts, i + 1, n, acc)
}

/!
 Rewrite bare free-fn calls inside a node to Prefix_name for same-file linkage.
 Only touch known AST kinds (never probe missing map keys).
 !/
function collect_declared_let_names_node(node, acc) {
    when node == Nothing { <- acc }
    let k -> AST.ast_kind(node)
    when k == AST.K_LET {
        let vname -> Str.to_string(AST.let_name(node))
        when vname != `` {
            acc.append(vname)
        }
    }
    when k == AST.K_BLOCK {
        let stmts -> AST.block_stmts(node)
        when stmts != Nothing and (stmts is List) {
            let i -> 0
            let n -> stmts.length
            do while i < n {
                collect_declared_let_names_node(stmts[i], acc)
                i -> i + 1
            }
        }
    }
    when k == AST.K_WHEN {
        let cases -> AST.when_cases(node)
        when cases != Nothing and (cases is List) {
            let i -> 0
            let n -> cases.length
            do while i < n {
                let c -> cases[i]
                when c != Nothing {
                    collect_declared_let_names_node(AST.case_body(c), acc)
                }
                i -> i + 1
            }
        }
    }
    when k == AST.K_WHILE {
        collect_declared_let_names_node(AST.while_body(node), acc)
    }
    when k == AST.K_DO_WHILE {
        collect_declared_let_names_node(AST.do_while_body(node), acc)
    }
    when k == AST.K_FOR {
        let vname -> Str.to_string(AST.for_var(node))
        when vname != `` {
            acc.append(vname)
        }
        collect_declared_let_names_node(AST.for_body(node), acc)
    }
    <- acc
}

function filter_names_excluding_params(names, params, body) {
    when names == Nothing or names.length == 0 {
        <- names
    }
    let pmap -> {}
    when params != Nothing {
        let pi -> 0
        let pn -> params.length
        do while pi < pn {
            let p -> params[pi]
            when p != Nothing {
                pmap[Str.to_string(AST.param_name(p))] -> true
            }
            pi -> pi + 1
        }
    }
    when body != Nothing {
        let declared -> collect_declared_let_names_node(body, [])
        let di -> 0
        let dn -> declared.length
        do while di < dn {
            pmap[declared[di]] -> true
            di -> di + 1
        }
    }
    let res -> []
    let ni -> 0
    let nn -> names.length
    do while ni < nn {
        let nm -> names[ni]
        when not pmap.has(nm) {
            res.append(nm)
        }
        ni -> ni + 1
    }
    <- res
}

function rewrite_calls_node(node, local_names, prefix) {
    when node == Nothing or prefix == `` {
        <- node
    }
    let k -> AST.ast_kind(node)
    when k == AST.K_VARIABLE {
        let nm -> Str.to_string(AST.var_name(node))
        when names_has(local_names, nm) {
            AST.set_var_name(node, prefix + `_` + nm)
        }
        <- node
    }
    when k == AST.K_CALL {
        let callee -> AST.call_callee(node)
        when callee != Nothing {
            let ck -> AST.ast_kind(callee)
            when ck == AST.K_VARIABLE {
                let nm -> Str.to_string(AST.var_name(callee))
                when names_has(local_names, nm) {
                    AST.set_var_name(callee, prefix + `_` + nm)
                }
            } or {
                rewrite_calls_node(callee, local_names, prefix)
            }
        }
        rewrite_calls_list(AST.call_args(node), local_names, prefix)
        <- node
    }
    when k == AST.K_FUNCTION {
        let fn_names -> filter_names_excluding_params(local_names, AST.fn_params(node), AST.fn_body(node))
        rewrite_calls_node(AST.fn_body(node), fn_names, prefix)
        <- node
    }
    when k == AST.K_FUNC_EXPR {
        let fn_names -> filter_names_excluding_params(local_names, AST.func_expr_params(node), AST.func_expr_body(node))
        rewrite_calls_node(AST.func_expr_body(node), fn_names, prefix)
        <- node
    }
    when k == AST.K_BLOCK {
        rewrite_calls_list(AST.block_stmts(node), local_names, prefix)
        <- node
    }
    when k == AST.K_LET {
        rewrite_calls_node(AST.let_val(node), local_names, prefix)
        <- node
    }
    when k == AST.K_EXPR_STMT or k == AST.K_ASSERT {
        rewrite_calls_node(AST.expr_stmt_expr(node), local_names, prefix)
        <- node
    }
    when k == AST.K_RETURN {
        rewrite_calls_node(AST.ret_val(node), local_names, prefix)
        <- node
    }
    when k == AST.K_WHEN {
        rewrite_calls_list(AST.when_cases(node), local_names, prefix)
        <- node
    }
    when k == AST.K_CASE {
        rewrite_calls_node(AST.case_cond(node), local_names, prefix)
        rewrite_calls_node(AST.case_body(node), local_names, prefix)
        <- node
    }
    when k == AST.K_CHECK_STMT {
        rewrite_calls_node(AST.check_stmt_expr(node), local_names, prefix)
        rewrite_calls_list(AST.check_stmt_cases(node), local_names, prefix)
        rewrite_calls_node(AST.check_stmt_or_block(node), local_names, prefix)
        rewrite_calls_node(AST.check_stmt_raise(node), local_names, prefix)
        <- node
    }
    when k == AST.K_CHECK {
        rewrite_calls_node(AST.check_expr_expr(node), local_names, prefix)
        <- node
    }
    when k == AST.K_WHILE or k == AST.K_DO_WHILE {
        rewrite_calls_node(AST.while_cond(node), local_names, prefix)
        rewrite_calls_node(AST.while_body(node), local_names, prefix)
        <- node
    }
    when k == AST.K_FOR {
        rewrite_calls_node(AST.for_iter(node), local_names, prefix)
        rewrite_calls_node(AST.for_body(node), local_names, prefix)
        <- node
    }
    when k == AST.K_BINARY or k == AST.K_LOGICAL {
        rewrite_calls_node(AST.bin_left(node), local_names, prefix)
        rewrite_calls_node(AST.bin_right(node), local_names, prefix)
        <- node
    }
    when k == AST.K_UNARY {
        rewrite_calls_node(AST.un_right(node), local_names, prefix)
        <- node
    }
    when k == AST.K_GROUPING {
        rewrite_calls_node(AST.grp_expr(node), local_names, prefix)
        <- node
    }
    when k == AST.K_ASSIGN {
        let aname -> Str.to_string(AST.assign_name(node))
        when names_has(local_names, aname) {
            AST.set_assign_name(node, prefix + `_` + aname)
        }
        rewrite_calls_node(AST.assign_val(node), local_names, prefix)
        <- node
    }
    when k == AST.K_INDEX_ASSIGN {
        rewrite_calls_node(AST.idx_assign_obj(node), local_names, prefix)
        rewrite_calls_node(AST.idx_assign_expr(node), local_names, prefix)
        rewrite_calls_node(AST.idx_assign_val(node), local_names, prefix)
        <- node
    }
    when k == AST.K_SET {
        rewrite_calls_node(AST.set_obj(node), local_names, prefix)
        rewrite_calls_node(AST.set_val(node), local_names, prefix)
        <- node
    }
    when k == AST.K_GET {
        rewrite_calls_node(AST.get_obj(node), local_names, prefix)
        <- node
    }
    when k == AST.K_INDEX {
        rewrite_calls_node(AST.idx_obj(node), local_names, prefix)
        rewrite_calls_node(AST.idx_expr(node), local_names, prefix)
        <- node
    }
    when k == AST.K_LIST {
        rewrite_calls_list(AST.list_elems(node), local_names, prefix)
        <- node
    }
    when k == AST.K_MAP {
        rewrite_calls_list(AST.map_entries(node), local_names, prefix)
        <- node
    }
    when k == AST.K_STRUCT_INIT {
        rewrite_calls_list(AST.struct_init_fields(node), local_names, prefix)
        <- node
    }
    when k == AST.K_STRUCT_FIELD {
        rewrite_calls_node(AST.struct_field_val(node), local_names, prefix)
        <- node
    }
    when k == AST.K_DEFER {
        rewrite_calls_node(AST.defer_body(node), local_names, prefix)
        <- node
    }
    when k == AST.K_RAISE {
        rewrite_calls_node(AST.raise_expr(node), local_names, prefix)
        <- node
    }
    when k == AST.K_SCOPE {
        rewrite_calls_node(AST.scope_body(node), local_names, prefix)
        <- node
    }
    when k == AST.K_CLASS {
        rewrite_calls_list(AST.class_methods(node), local_names, prefix)
        rewrite_calls_list(AST.class_members(node), local_names, prefix)
        <- node
    }
    when k == AST.K_WITH {
        rewrite_calls_node(AST.with_expr(node), local_names, prefix)
        rewrite_calls_node(AST.with_body(node), local_names, prefix)
        <- node
    }
    when k == AST.K_VARIABLE {
        let nm -> Str.to_string(AST.var_name(node))
        when names_has(local_names, nm) {
            AST.set_var_name(node, prefix + `_` + nm)
        }
        <- node
    }
    <- node
}

function rewrite_calls_list(lst, local_names, prefix) {
    when lst == Nothing {
        <- Nothing
    }
    let n -> lst.length
    let i -> 0
    do while i < n {
        rewrite_calls_node(lst[i], local_names, prefix)
        i -> i + 1
    }
    <- Nothing
}

/!
 Map import aliases in this file to the merge prefix of the imported module.
 Skip TokenType from-imports (GetExpression TokenType.X must stay).
 !/
function collect_import_alias_pairs(stmts, i, n, acc) {
    when i >= n {
        <- acc
    }
    let s -> stmts[i]
    let k -> AST.ast_kind(s)
    when k == AST.K_FROM_IMPORT {
        let path -> Str.to_string(AST.from_import_mod(s))
        let names -> AST.from_import_names(s)
        when import_should_rewrite(path) and names != Nothing {
            let pfx -> prefix_for_import_path(path)
            when pfx != `` {
                let ni -> 0
                let nn -> names.length
                do while ni < nn {
                    let nm -> Str.to_string(names[ni])
                    when nm != `` and nm != `TokenType` {
                        acc.append({`a` -> nm, `p` -> pfx + `_` + nm, `from_import` -> true})
                    }
                    ni -> ni + 1
                }
            }
        }
    }
    when k == AST.K_IMPORT {
        let path -> Str.to_string(AST.import_path(s))
        let alias -> AST.import_alias(s)
        when alias == Nothing or alias == `` {
            alias -> import_path_stem(path)
        }
        let als -> Str.to_string(alias)
        when import_should_rewrite(path) and als != `TokenType` {
            let pfx -> prefix_for_import_path(path)
            when pfx != `` {
                acc.append({`a` -> als, `p` -> pfx, `from_import` -> false})
            }
        }
    }
    <- collect_import_alias_pairs(stmts, i + 1, n, acc)
}

function import_path_stem(path) {
    let s -> Str.to_string(path)
    let n -> Str.length(s)
    <- import_path_stem_from(s, n - 1, n)
}

function import_path_stem_from(s, i, n) {
    when i < 0 {
        <- s
    }
    when Str.at(s, i) == `.` or Str.at(s, i) == `/` {
        <- Str.substring(s, i + 1, n)
    }
    <- import_path_stem_from(s, i - 1, n)
}

function import_should_rewrite(path) {
    let s -> Str.to_string(path)
    when Str.contains(s, `compiler.`) or Str.contains(s, `zen.`) or
         Str.contains(s, `selfhost.`) or Str.contains(s, `lib/zen`) {
        <- true
    }
    <- false
}

function prefix_for_import_path(path) {
    let s -> Str.to_string(path)
    when Str.ends_with(s, `ui.color`) or Str.ends_with(s, `ui/color`) or Str.ends_with(s, `ui.color.zl`) or Str.ends_with(s, `ui/color.zl`) {
        <- `ui_color`
    }
    <- module_fn_prefix(`/` + import_path_stem(s) + `.zl`)
}

function alias_prefix_at(pairs, name, i, n) {
    when pairs == Nothing or i >= n {
        <- Nothing
    }
    let p -> pairs[i]
    when p[`a`] == name {
        <- p[`p`]
    }
    <- alias_prefix_at(pairs, name, i + 1, n)
}

function from_alias_prefix_at(pairs, name, i, n) {
    when pairs == Nothing or i >= n {
        <- Nothing
    }
    let p -> pairs[i]
    when p[`a`] == name and p[`from_import`] == true {
        <- p[`p`]
    }
    <- from_alias_prefix_at(pairs, name, i + 1, n)
}

function rewrite_alias_calls_node(node, pairs) {
    when node == Nothing or pairs == Nothing {
        <- node
    }
    let pn -> pairs.length
    when pn == 0 {
        <- node
    }
    let k -> AST.ast_kind(node)
    when k == AST.K_GET {
        let obj -> AST.get_obj(node)
        when obj != Nothing {
            let okind -> AST.ast_kind(obj)
            when okind == AST.K_VARIABLE {
                let nm -> Str.to_string(AST.var_name(obj))
                let pfx -> alias_prefix_at(pairs, nm, 0, pn)
                when pfx != Nothing and pfx != `` {
                    let field_name -> Str.to_string(AST.get_name(node))
                    let merged_name -> pfx + `_` + field_name
                    AST.set_ast_kind(node, AST.K_VARIABLE)
                    AST.set_var_name(node, merged_name)
                    <- node
                }
            } or when okind == AST.K_GET {
                let inner_obj -> AST.get_obj(obj)
                when inner_obj != Nothing and AST.ast_kind(inner_obj) == AST.K_VARIABLE {
                    let nm -> Str.to_string(AST.var_name(inner_obj))
                    let pfx -> alias_prefix_at(pairs, nm, 0, pn)
                    when pfx != Nothing and pfx != `` {
                        let mid_name -> Str.to_string(AST.get_name(obj))
                        let field_name -> Str.to_string(AST.get_name(node))
                        let full_name -> pfx + `_` + mid_name + `_` + field_name
                        AST.set_ast_kind(node, AST.K_VARIABLE)
                        AST.set_var_name(node, full_name)
                        <- node
                    } or {
                        rewrite_alias_calls_node(obj, pairs)
                    }
                } or {
                    rewrite_alias_calls_node(obj, pairs)
                }
            } or {
                rewrite_alias_calls_node(obj, pairs)
            }
        }
        <- node
    }
    when k == AST.K_CALL {
        rewrite_alias_calls_node(AST.call_callee(node), pairs)
        rewrite_alias_calls_list(AST.call_args(node), pairs)
        <- node
    }
    when k == AST.K_FUNCTION {
        rewrite_alias_calls_node(AST.fn_body(node), pairs)
        <- node
    }
    when k == AST.K_BLOCK {
        rewrite_alias_calls_list(AST.block_stmts(node), pairs)
        <- node
    }
    when k == AST.K_LET {
        rewrite_alias_calls_node(AST.let_val(node), pairs)
        <- node
    }
    when k == AST.K_ASSIGN {
        let aname -> Str.to_string(AST.assign_name(node))
        let pfx -> from_alias_prefix_at(pairs, aname, 0, pn)
        when pfx != Nothing and pfx != `` {
            AST.set_assign_name(node, pfx)
        }
        rewrite_alias_calls_node(AST.assign_val(node), pairs)
        <- node
    }
    when k == AST.K_SET {
        rewrite_alias_calls_node(AST.set_obj(node), pairs)
        rewrite_alias_calls_node(AST.set_val(node), pairs)
        <- node
    }
    when k == AST.K_LIST {
        rewrite_alias_calls_list(AST.list_elems(node), pairs)
        <- node
    }
    when k == AST.K_MAP {
        rewrite_alias_calls_list(AST.map_entries(node), pairs)
        <- node
    }
    when k == AST.K_RETURN {
        rewrite_alias_calls_node(AST.ret_val(node), pairs)
        <- node
    }
    when k == AST.K_EXPR_STMT or k == AST.K_ASSERT {
        rewrite_alias_calls_node(AST.expr_stmt_expr(node), pairs)
        <- node
    }
    when k == AST.K_CHECK_STMT {
        rewrite_alias_calls_node(AST.check_stmt_expr(node), pairs)
        rewrite_alias_calls_list(AST.check_stmt_cases(node), pairs)
        rewrite_alias_calls_node(AST.check_stmt_or_block(node), pairs)
        rewrite_alias_calls_node(AST.check_stmt_raise(node), pairs)
        <- node
    }
    when k == AST.K_CHECK {
        rewrite_alias_calls_node(AST.check_expr_expr(node), pairs)
        <- node
    }
    when k == AST.K_WHEN {
        rewrite_alias_calls_list(AST.when_cases(node), pairs)
        <- node
    }
    when k == AST.K_CASE {
        rewrite_alias_calls_node(AST.case_cond(node), pairs)
        rewrite_alias_calls_node(AST.case_body(node), pairs)
        <- node
    }
    when k == AST.K_WHILE or k == AST.K_DO_WHILE {
        rewrite_alias_calls_node(AST.while_cond(node), pairs)
        rewrite_alias_calls_node(AST.while_body(node), pairs)
        <- node
    }
    when k == AST.K_FOR {
        rewrite_alias_calls_node(AST.for_iter(node), pairs)
        rewrite_alias_calls_node(AST.for_body(node), pairs)
        <- node
    }
    when k == AST.K_BINARY or k == AST.K_LOGICAL {
        rewrite_alias_calls_node(AST.bin_left(node), pairs)
        rewrite_alias_calls_node(AST.bin_right(node), pairs)
        <- node
    }
    when k == AST.K_UNARY {
        rewrite_alias_calls_node(AST.un_right(node), pairs)
        <- node
    }
    when k == AST.K_GROUPING {
        rewrite_alias_calls_node(AST.grp_expr(node), pairs)
        <- node
    }
    when k == AST.K_RAISE {
        rewrite_alias_calls_node(AST.raise_expr(node), pairs)
        <- node
    }
    when k == AST.K_INDEX_ASSIGN {
        rewrite_alias_calls_node(AST.idx_assign_obj(node), pairs)
        rewrite_alias_calls_node(AST.idx_assign_expr(node), pairs)
        rewrite_alias_calls_node(AST.idx_assign_val(node), pairs)
        <- node
    }
    when k == AST.K_INDEX {
        rewrite_alias_calls_node(AST.idx_obj(node), pairs)
        rewrite_alias_calls_node(AST.idx_expr(node), pairs)
        <- node
    }
    when k == AST.K_CLASS {
        rewrite_alias_calls_list(AST.class_methods(node), pairs)
        rewrite_alias_calls_list(AST.class_members(node), pairs)
        <- node
    }
    when k == AST.K_WITH {
        rewrite_alias_calls_node(AST.with_expr(node), pairs)
        rewrite_alias_calls_node(AST.with_body(node), pairs)
        <- node
    }
    when k == AST.K_STRUCT_INIT {
        let sname -> Str.to_string(AST.struct_init_name(node))
        when Str.contains(sname, `.`) {
            let parts -> Str.split(sname, `.`)
            when parts.length >= 2 {
                let pfx -> alias_prefix_at(pairs, Str.to_string(parts[0]), 0, pn)
                when pfx != Nothing and pfx != `` {
                    let full_sname -> pfx + `_` + Str.to_string(parts[1])
                    AST.set_struct_init_name(node, full_sname)
                }
            }
        }
        rewrite_alias_calls_list(AST.struct_init_fields(node), pairs)
        <- node
    }
    when k == AST.K_VARIABLE {
        let nm -> Str.to_string(AST.var_name(node))
        let pfx -> from_alias_prefix_at(pairs, nm, 0, pn)
        when pfx != Nothing and pfx != `` {
            AST.set_var_name(node, pfx)
        }
        <- node
    }
    <- node
}

function rewrite_alias_calls_list(lst, pairs) {
    when lst == Nothing {
        <- Nothing
    }
    let n -> lst.length
    let i -> 0
    do while i < n {
        rewrite_alias_calls_node(lst[i], pairs)
        i -> i + 1
    }
    <- Nothing
}

/!
 Append statements from one dependency file into `acc`.
/!
  Prepare a single module file's statements into an isolated StmtChunk:
  - Strip imports; drop non-entry `main`
  - Namespace free functions as Prefix_name (all deps, not only stdlib)
  - Rewrite same-file bare calls to Prefix_name
  Returns a StmtChunk or Nothing if no statements remain.
 !/
function prepare_file_chunk(stmts, path, entry_path) {
    when stmts == Nothing {
        <- Nothing
    }
    let is_entry -> path == entry_path
    // Namespace compiler + stdlib only. Fixtures keep bare free-fn names (multi_lib_val).
    let prefix -> ``
    when is_entry == false and should_namespace_path(path) {
        prefix -> module_fn_prefix(path)
    }
    let n -> stmts.length
    let alias_pairs -> collect_import_alias_pairs(stmts, 0, n, [])
    let local_names -> []
    when prefix != `` {
        local_names -> collect_local_fn_names(stmts, 0, n, [])
    }
    let file_stmts -> []
    let i -> 0
    do while i < n {
        let s -> stmts[i]
        let k -> AST.ast_kind(s)
        let skip -> false
        when k == AST.K_IMPORT or k == AST.K_FROM_IMPORT {
            skip -> true
        }
        when k == AST.K_FUNCTION {
            let fname -> Str.to_string(AST.fn_name(s))
            when fname == `main` and is_entry == false {
                skip -> true
            }
            when skip == false {
                rewrite_alias_calls_node(s, alias_pairs)
            }
            when skip == false and prefix != `` and fname != `main` {
                let fn_names -> filter_names_excluding_params(local_names, AST.fn_params(s), AST.fn_body(s))
                rewrite_calls_node(AST.fn_body(s), fn_names, prefix)
                AST.set_fn_name(s, prefix + `_` + fname)
            }
        }
        when skip == false and k != AST.K_FUNCTION {
            rewrite_alias_calls_node(s, alias_pairs)
            when prefix != `` {
                rewrite_calls_node(s, local_names, prefix)
                when k == AST.K_LET {
                    let vname -> Str.to_string(AST.let_name(s))
                    when vname != `` {
                        AST.set_let_name(s, prefix + `_` + vname)
                    }
                }
                when k == AST.K_STRUCTURE {
                    let sname -> Str.to_string(AST.struct_name(s))
                    when sname != `` {
                        AST.set_struct_name(s, prefix + `_` + sname)
                    }
                }
                when k == AST.K_CLASS {
                    let cname -> Str.to_string(AST.class_name(s))
                    when cname != `` {
                        AST.set_class_name(s, prefix + `_` + cname)
                    }
                }
                when k == AST.K_ENUMERATOR {
                    let ename -> Str.to_string(AST.enum_name(s))
                    when ename != `` and ename != `Option` and ename != `Result` and ename != `Ordering` {
                        AST.set_enum_name(s, prefix + `_` + ename)
                    }
                }
            }
            when k == AST.K_SCOPE {
                let scname -> Str.to_string(AST.scope_name(s))
                let sc_body -> AST.scope_body(s)
                let sc_stmts -> []
                when sc_body != Nothing {
                    when AST.ast_kind(sc_body) == AST.K_BLOCK {
                        sc_stmts -> AST.block_stmts(sc_body)
                    } or {
                        sc_stmts -> sc_body
                    }
                }
                when sc_stmts != Nothing {
                    let scope_fn_names -> []
                    let si0 -> 0
                    let sn0 -> sc_stmts.length
                    do while si0 < sn0 {
                        let sm0 -> sc_stmts[si0]
                        when sm0 != Nothing and AST.ast_kind(sm0) == AST.K_FUNCTION {
                            let sfn0 -> Str.to_string(AST.fn_name(sm0))
                            when sfn0 != `` {
                                scope_fn_names.append(sfn0)
                            }
                        }
                        si0 -> si0 + 1
                    }
                    let si -> 0
                    let sn -> sc_stmts.length
                    do while si < sn {
                        let sm -> sc_stmts[si]
                        when sm != Nothing and AST.ast_kind(sm) == AST.K_FUNCTION {
                            let sfname -> Str.to_string(AST.fn_name(sm))
                            when sfname != `` {
                                let scoped_name -> scname + `_` + sfname
                                AST.set_fn_name(sm, scoped_name)
                                let scoped_fn_names -> filter_names_excluding_params(scope_fn_names, AST.fn_params(sm), AST.fn_body(sm))
                                rewrite_calls_node(AST.fn_body(sm), scoped_fn_names, scname)
                                rewrite_alias_calls_node(sm, alias_pairs)
                                when prefix != `` {
                                    let local_fn_names -> filter_names_excluding_params(local_names, AST.fn_params(sm), AST.fn_body(sm))
                                    rewrite_calls_node(AST.fn_body(sm), local_fn_names, prefix)
                                    AST.set_fn_name(sm, prefix + `_` + scoped_name)
                                }
                                file_stmts.append(sm)
                            }
                        }
                        si -> si + 1
                    }
                }
            }
        }
        when skip == false {
            file_stmts.append(s)
        }
        i -> i + 1
    }
    when file_stmts.length == 0 {
        <- Nothing
    }
    <- AST.stmt_chunk(file_stmts, Nothing)
}

function append_file_stmts(acc, stmts, path, entry_path, seen_names) {
    let chunk -> prepare_file_chunk(stmts, path, entry_path)
    when chunk == Nothing {
        <- acc
    }
    let chunk_stmts -> AST.stmt_chunk_stmts(chunk)
    let n -> chunk_stmts.length
    let i -> 0
    do while i < n {
        acc -> drv_list_push(acc, chunk_stmts[i])
        i -> i + 1
    }
    <- acc
}

function drv_list_push(lst, node) {
    when lst == Nothing {
        lst -> []
    }
    let grown -> lst.append(node)
    when grown != Nothing {
        <- grown
    }
    <- lst
}

/!
  Parse files in dependency order and merge into one Program using O(1) StmtChunk linking.
  Eliminates large array reallocations and copies across module boundaries.
 !/
function merge_program_files(order, entry_path) {
    let chunks -> []
    let n -> order.length
    let i -> 0
    let last_err -> Nothing
    do while i < n {
        let path -> order[i]
        when fs_is_file(path) {
            let prog -> parse_file_cached(path)
            when AST.prog_err(prog) != Nothing {
                last_err -> `parse ` + path + `: ` + Str.to_string(AST.prog_err(prog))
            } or {
                let chunk -> prepare_file_chunk(AST.prog_stmts(prog), path, entry_path)
                when chunk != Nothing {
                    chunks.append(chunk)
                }
            }
        }
        i -> i + 1
    }
    when last_err != Nothing {
        <- AST.program_error(last_err)
    }
    let cn -> chunks.length
    when cn == 0 {
        <- AST.program([])
    }
    let ci -> 0
    do while ci < cn - 1 {
        AST.set_stmt_chunk_next(chunks[ci], chunks[ci + 1])
        ci -> ci + 1
    }
    <- AST.program(chunks[0])
}

function prof_on() {
    let v -> Sys.get_env(`ZEN_PROFILE`)
    when v == `1` {
        <- true
    }
    <- false
}

function prof_log(on, label, t0) {
    when on != true {
        <- Nothing
    }
    let ms -> (Time.monotonic() - t0) * 1000
    io.writeln(`profile ` + label + ` ` + Str.to_string(ms) + ` ms`)
    <- Nothing
}

function prof_arena_log(on, label) {
    when on != true {
        <- Nothing
    }
    let stats -> __builtin_memory.arena_stats(Nothing)
    when stats != Nothing and type(stats) == `Map` and stats.has(`allocated`) {
        let alloc -> stats[`allocated`]
        let cap -> stats[`capacity`]
        let ch -> stats[`chunks`]
        io.writeln(`profile arena ` + label + ` allocated: ` + Str.to_string(alloc) + ` B, capacity: ` + Str.to_string(cap) + ` B, chunks: ` + Str.to_string(ch))
    }
    <- Nothing
}

function compute_content_sig(s) {
    when s == Nothing {
        <- `0_0`
    }
    let slen -> Str.length(s)
    let h -> 2166136261
    let i -> 0
    let step -> 1
    when slen > 65536 {
        step -> slen / 32768
    }
    do while i < slen {
        let b -> Str.byte_at(s, i)
        h -> (h * 31 + b + i) % 2147483647
        i -> i + step
    }
    <- Str.to_string(slen) + `_` + Str.to_string(h)
}

/!
 Compile entry .zl with multi-file dependency merge (Stage 5.x / 7.x).
 Search roots: entry dir, ., lib, selfhost (+ Resolver always adds tests/self_hosting).
 Default: one merged C translation unit.
 ZEN_PROFILE=1 prints stage ms (graph / merge / check / codegen / total).
 !/
function compile_file(source_path, output_path, do_check) {
    when not fs_is_file(source_path) {
        let pe -> []
        pe.append(`file not found: ` + source_path)
        <- {
            `ok` -> false,
            `c_code` -> ``,
            `errors` -> pe,
            `program` -> Nothing
        }
    }

    let want -> prof_on()
    let t_all -> Time.monotonic()
    let base -> Path.dirname(source_path)
    let t_graph -> Time.monotonic()
    let order -> ensure_compile_order(source_path, base)
    prof_log(want, `graph`, t_graph)

    let t_merge -> Time.monotonic()
    let prog -> merge_program_files(order, source_path)
    prof_log(want, `merge`, t_merge)
    when AST.prog_err(prog) != Nothing {
        let pe -> []
        pe.append(Str.to_string(AST.prog_err(prog)))
        <- {
            `ok` -> false,
            `c_code` -> ``,
            `errors` -> pe,
            `program` -> prog
        }
    }

    let pstmts -> AST.prog_stmts(prog)
    when pstmts == Nothing or pstmts.length == 0 {
        let pe -> []
        pe.append(`source file '` + source_path + `' contains no statements or declarations.\n` +
                  `A minimum compilable Zenlang program requires at least one statement or an entry function:\n\n` +
                  `  function main() {\n` +
                  `      writeln(\`Hello, Zen!\`)\n` +
                  `  }`)
        <- {
            `ok` -> false,
            `c_code` -> ``,
            `errors` -> pe,
            `program` -> prog
        }
    }

    let errors -> []
    when do_check == true {
        let t_check -> Time.monotonic()
        let cr -> Checker.check_program(prog)
        prof_log(want, `check`, t_check)
        when cr[`ok`] != true {
            let errs -> cr[`errors`]
            errors -> copy_errors(errs, 0, errs.length, [])
            <- {
                `ok` -> false,
                `c_code` -> ``,
                `errors` -> errors,
                `program` -> prog
            }
        }
    }

    when output_path != Nothing and output_path != `` {
        let t_cg -> Time.monotonic()
        let marker -> Codegen.transpile_program_to_file(prog, output_path)
        prof_log(want, `codegen`, t_cg)
        prof_log(want, `total`, t_all)
        prof_arena_log(want, `summary`)
        when marker != `ok` {
            let pe -> []
            pe.append(`codegen: empty or parse error output`)
            <- {
                `ok` -> false,
                `c_code` -> marker,
                `errors` -> pe,
                `program` -> prog
            }
        }
        <- {
            `ok` -> true,
            `c_code` -> `__streamed__`,
            `errors` -> errors,
            `program` -> prog,
            `files` -> order
        }
    }

    let t_cg2 -> Time.monotonic()
    let c_code -> Codegen.transpile_program(prog, true, `zen_module_init`)
    prof_log(want, `codegen`, t_cg2)
    prof_log(want, `total`, t_all)
    prof_arena_log(want, `summary`)
    when c_code == Nothing or c_code == `` or Str.starts_with(c_code, `/* parse error`) {
        let pe -> []
        pe.append(`codegen: empty or parse error output`)
        <- {
            `ok` -> false,
            `c_code` -> c_code,
            `errors` -> pe,
            `program` -> prog
        }
    }

    <- {
        `ok` -> true,
        `c_code` -> c_code,
        `errors` -> errors,
        `program` -> prog,
        `files` -> order
    }
}

/!
 Parse one dependency path into a namespaced unit Program (imports stripped).
 Same rewrite rules as merge, but one file only.
 !/
function prepare_unit(path, entry_path) {
    when not fs_is_file(path) {
        <- {
            `ok` -> false,
            `program` -> Nothing,
            `error` -> `file not found: ` + path,
            `stem` -> file_stem(path),
            `path` -> path
        }
    }
    let prog -> parse_file_cached(path)
    when AST.prog_err(prog) != Nothing {
        <- {
            `ok` -> false,
            `program` -> prog,
            `error` -> `parse ` + path + `: ` + Str.to_string(AST.prog_err(prog)),
            `stem` -> file_stem(path),
            `path` -> path
        }
    }
    let chunk -> prepare_file_chunk(AST.prog_stmts(prog), path, entry_path)
    <- {
        `ok` -> true,
        `program` -> AST.program(chunk),
        `error` -> Nothing,
        `stem` -> file_stem(path),
        `path` -> path,
        `is_entry` -> path == entry_path
    }
}

/!
 Sanitize stem for C identifiers (init / file base).
 !/
function c_safe_stem(stem, idx) {
    when stem == Nothing or stem == `` {
        <- `u` + Str.to_string(idx)
    }
    let s -> Str.to_string(stem)
    when s == `` or s == `Nothing` or s == `None` {
        <- `u` + Str.to_string(idx)
    }
    // Prefer stem as-is when already a simple ident (fixtures, modules).
    <- s
}

/!
 Unique non-static init name for multi-unit: zen_mod_init_<stem>
 !/
function unit_init_name(stem, idx) {
    <- `zen_mod_init_` + c_safe_stem(stem, idx)
}

/!
 Join proto blocks; skip empties. Dual-path safe recursion.
 !/
function join_proto_blocks(blocks, i, n, acc) {
    when i >= n {
        <- acc
    }
    let b -> blocks[i]
    when b == Nothing or b == `` {
        <- join_proto_blocks(blocks, i + 1, n, acc)
    }
    let s -> Str.to_string(b)
    when s == `` {
        <- join_proto_blocks(blocks, i + 1, n, acc)
    }
    when acc == `` {
        <- join_proto_blocks(blocks, i + 1, n, s)
    }
    <- join_proto_blocks(blocks, i + 1, n, acc + `\n` + s)
}

/!
 Emit one C file per module + host main. Writes under out_dir.
 Returns { ok, c_files, init_names, errors, files, out_dir }.
 Single-unit merge remains compile_file Default.
 !/
function compile_file_multi(source_path, out_dir, do_check, incremental) {
    when not fs_is_file(source_path) {
        let pe -> []
        pe.append(`file not found: ` + source_path)
        <- {
            `ok` -> false,
            `c_files` -> [],
            `errors` -> pe,
            `out_dir` -> out_dir
        }
    }

    let base -> Path.dirname(source_path)
    let order -> ensure_compile_order(source_path, base)

    let merged -> merge_program_files(order, source_path)
    when AST.prog_err(merged) != Nothing {
        let pe -> []
        pe.append(Str.to_string(AST.prog_err(merged)))
        <- {
            `ok` -> false,
            `c_files` -> [],
            `errors` -> pe,
            `out_dir` -> out_dir
        }
    }
    let pstmts -> AST.prog_stmts(merged)
    when pstmts == Nothing or pstmts.length == 0 {
        let pe -> []
        pe.append(`source file '` + source_path + `' contains no statements or declarations.\n` +
                  `A minimum compilable Zenlang program requires at least one statement or an entry function:\n\n` +
                  `  function main() {\n` +
                  `      writeln(\`Hello, Zen!\`)\n` +
                  `  }`)
        <- {
            `ok` -> false,
            `c_files` -> [],
            `errors` -> pe,
            `out_dir` -> out_dir
        }
    }

    // Optional typecheck still uses merged program (one graph).
    when do_check == true {
        let cr -> Checker.check_program(merged)
        when cr[`ok`] != true {
            let errs -> cr[`errors`]
            let errors -> copy_errors(errs, 0, errs.length, [])
            <- {
                `ok` -> false,
                `c_files` -> [],
                `errors` -> errors,
                `out_dir` -> out_dir
            }
        }
    }

    let dir -> out_dir
    when dir == Nothing or dir == `` {
        dir -> `output/multi_c`
    }
    // Best-effort create out dir (ignore failure; write will fail loudly).
    __builtin_file.mkdir_p(dir)

    let n -> order.length
    let units -> prepare_units(order, source_path, 0, n, [])
    when units[`ok`] != true {
        let pe -> []
        pe.append(Str.to_string(units[`error`]))
        <- {
            `ok` -> false,
            `c_files` -> [],
            `errors` -> pe,
            `out_dir` -> dir
        }
    }
    let ulist -> units[`list`]
    let un -> ulist.length

    // Shared protos + extern module globals (AST.K_* across TUs)
    let gblocks -> collect_unit_globals(ulist, 0, un, [])
    let pblocks -> collect_unit_protos(ulist, 0, un, [])
    let gshared -> join_proto_blocks(gblocks, 0, gblocks.length, ``)
    let pshared -> join_proto_blocks(pblocks, 0, pblocks.length, ``)
    let shared -> gshared
    when pshared != `` {
        when shared == `` {
            shared -> pshared
        } or {
            shared -> shared + `\n` + pshared
        }
    }

    let c_files -> []
    let init_names -> []
    let cache_file -> Path.join(dir, `.cache.zd`)
    let cache_map -> {}
    when incremental == true and fs_is_file(cache_file) {
        let c_lines -> Str.split(fs_read(cache_file), `\n`)
        let li -> 0
        do while li < c_lines.length {
            let l -> Str.trim(c_lines[li])
            let sep -> Str.index_of(l, `=`)
            when sep > 0 {
                let ck -> Str.substring(l, 0, sep)
                let cv -> Str.substring(l, sep + 1, Str.length(l))
                cache_map[ck] -> cv
            }
            li -> li + 1
        }
    }

    let shared_sig -> compute_content_sig(shared)
    let shared_changed -> false
    when incremental == true {
        when not cache_map.has(`__shared__`) or cache_map[`__shared__`] != shared_sig {
            shared_changed -> true
        }
    }

    let new_cache_lines -> []
    new_cache_lines.append(`__shared__=` + shared_sig)
    let cached_units -> 0
    let compiled_units -> 0
    let wi -> 0
    do while wi < un {
        let u -> ulist[wi]
        let stem -> c_safe_stem(u[`stem`], wi)
        let iname -> unit_init_name(stem, wi)
        init_names.append(iname)
        // No host main in module TUs — host file owns main.
        let cpath -> Path.join(dir, stem + `.c`)
        let objpath -> Path.join(dir, stem + `.o`)
        let upath -> u[`path`]
        let u_content -> fs_read(upath)
        let u_sig -> compute_content_sig(u_content)
        new_cache_lines.append(upath + `=` + u_sig)

        let skip_codegen -> false
        when incremental == true and not shared_changed and fs_is_file(cpath) {
            when cache_map.has(upath) and cache_map[upath] == u_sig {
                skip_codegen -> true
            }
        }

        when not skip_codegen {
            fs_remove(objpath)
            let code -> Codegen.transpile_unit_ex_to_file(u[`program`], false, iname, shared, cpath)
            when code != `ok` {
                let pe -> []
                pe.append(`codegen multi: bad unit ` + Str.to_string(upath))
                <- {
                    `ok` -> false,
                    `c_files` -> c_files,
                    `errors` -> pe,
                    `out_dir` -> dir
                }
            }
            compiled_units -> compiled_units + 1
        } or {
            cached_units -> cached_units + 1
        }
        c_files.append(cpath)
        wi -> wi + 1
    }

    when incremental == true {
        fs_write(cache_file, Str.join(new_cache_lines, `\n`))
    }

    let host -> Codegen.emit_multi_host_main(init_names)
    let host_path -> Path.join(dir, `zen_host_main.c`)
    let host_obj -> Path.join(dir, `zen_host_main.o`)
    fs_remove(host_obj)
    fs_write(host_path, host)
    c_files.append(host_path)

    let want -> prof_on()
    prof_arena_log(want, `multi`)

    <- {
        `ok` -> true,
        `c_files` -> c_files,
        `init_names` -> init_names,
        `errors` -> [],
        `files` -> order,
        `out_dir` -> dir,
        `c_code` -> host,
        `cached_units` -> cached_units,
        `compiled_units` -> compiled_units
    }
}

/!
 Prepare all units; fail fast on first error.
 !/
function prepare_units(order, entry_path, i, n, acc) {
    when i >= n {
        <- {
            `ok` -> true,
            `list` -> acc,
            `error` -> Nothing
        }
    }
    let path -> order[i]
    let u -> prepare_unit(path, entry_path)
    when u[`ok`] != true {
        <- {
            `ok` -> false,
            `list` -> acc,
            `error` -> u[`error`]
        }
    }
    acc.append(u)
    <- prepare_units(order, entry_path, i + 1, n, acc)
}

function collect_unit_protos(ulist, i, n, acc) {
    when i >= n {
        <- acc
    }
    let u -> ulist[i]
    let block -> Codegen.proto_block_for_program(u[`program`])
    when block != Nothing and block != `` {
        acc.append(block)
    }
    <- collect_unit_protos(ulist, i + 1, n, acc)
}

function collect_unit_globals(ulist, i, n, acc) {
    when i >= n {
        <- acc
    }
    let u -> ulist[i]
    let block -> Codegen.global_extern_block_for_program(u[`program`])
    when block != Nothing and block != `` {
        acc.append(block)
    }
    <- collect_unit_globals(ulist, i + 1, n, acc)
}

/!
 dep_order + guarantee non-empty list containing at least entry_path.
 Avoid rebinding order in caller (native when-branch rebind is sticky-broken).
 !/
function ensure_compile_order(source_path, base) {
    let src -> fs_read(source_path)
    when not GraphBuilder.source_may_import(src) {
        let single -> []
        single.append(source_path)
        <- single
    }
    let order -> dep_order(source_path, base, `.`, `lib`, `selfhost`)
    when order == Nothing or order.length == 0 {
        let single2 -> []
        single2.append(source_path)
        <- single2
    }
    <- order
}

/!
 Typecheck only (no C emit).
 !/
function check_string_file(src, filename) {
    <- Checker.check_source_file(src, filename)
}

function check_string(src) {
    <- check_string_file(src, `<source>`)
}

/!
 Build dependency order for an entry file (Stage 3).
 roots: up to four search roots.
 !/
function dep_order(entry_path, r0, r1, r2, r3) {
    let g -> GraphBuilder.build_from_file_roots(entry_path, r0, r1, r2, r3)
    <- Graph.get_compilation_order(g)
}

/!
 True when s is a CLI subcommand or bare .zl entry (not a program path).
 !/
function is_cli_token(s) {
    when s == `help` or s == `-h` or s == `--help` {
        <- true
    }
    when s == `daemon` or s == `check` or s == `deps` or s == `compile` or s == `build` or s == `bundle` or s == `package` or s == `plugin` or s == `todo` or s == `lint` or s == `run` or s == `interpret` or s == `eval` or s == `vm` or s == `test` or s == `--test` or s == `lsp` {
        <- true
    }
    when s == `-g` or s == `--generate` {
        <- true
    }
    when Str.ends_with(s, `.zl`) or Str.ends_with(s, `.zbc`) {
        <- true
    }
    <- false
}

/!
 Skip argv[0] when it is the script/binary path (not a command).
 Interpret: a0 = selfhost/zen.zl; native: a0 = .../zen-selfhost or zen_program.
 Tests may pass bare [`help`] with no program name.
 !/
function cli_cmd_index(args, n) {
    when n <= 0 {
        <- 0
    }
    let a0 -> Str.to_string(args[0])
    when is_cli_token(a0) {
        // Bare .zl as first token is the compile target, not the driver script.
        // Only skip .zl when it is clearly the host script name (contains selfhost/zen or ends with /zen.zl).
        when Str.ends_with(a0, `.zl`) {
            when Str.contains(a0, `selfhost/zen`) or Str.ends_with(a0, `/zen.zl`) or a0 == `zen.zl` {
                <- 1
            }
            <- 0
        }
        <- 0
    }
    // Binary path or unknown argv0 — skip
    <- 1
}

/!
 Finish compile CLI after source path is known (no rebind of src under -g).
 Supports --multi → compile_file_multi (out = directory).
 !/
function compile_cli(src_path, args, opt_start, n) {
    let arena -> __builtin_memory.create_arena(32 * 1024 * 1024)
    __builtin_memory.push_arena(arena)
    let opts -> parse_compile_opts(args, opt_start, n, `out.c`, false, false, false)
    let out_path -> opts[`out`]
    let do_check -> opts[`check`]
    let multi -> opts[`multi`]
    let incremental -> opts[`incremental`]
    let ok_flag -> false
    let extra -> ``
    let err_msg -> ``
    when multi == true {
        let multi_res -> compile_cli_multi(src_path, out_path, do_check, incremental)
        let m_code -> multi_res[`code`]
        let m_msg -> Str.to_string(multi_res[`message`])
        __builtin_memory.pop_arena()
        __builtin_memory.free_arena(arena)
        <- {
            `code` -> m_code,
            `message` -> m_msg
        }
    } or {
        let r -> compile_file(src_path, out_path, do_check)
        when r[`ok`] == true {
            ok_flag -> true
            when r[`c_code`] != `__streamed__` and r[`c_code`] != Nothing {
                extra -> ` (` + Str.to_string(Str.length(r[`c_code`])) + ` bytes)`
            }
        } or {
            ok_flag -> false
            err_msg -> `compile failed:\n` + join_errs(r[`errors`])
        }
    }
    __builtin_memory.pop_arena()
    __builtin_memory.free_arena(arena)
    when ok_flag == true {
        <- {
            `code` -> 0,
            `message` -> `wrote ` + out_path + extra
        }
    }
    <- {
        `code` -> 1,
        `message` -> err_msg
    }
}

function compile_cli_multi(src_path, out_path, do_check, incremental) {
    let dir -> out_path
    // If user passed out.c, use sibling dir out_multi (or strip .c).
    when dir == Nothing or dir == `` or dir == `out.c` {
        dir -> `output/multi_c`
    }
    when Str.ends_with(dir, `.c`) {
        // Treat foo.c as directory "foo_multi" under same parent, or just drop extension
        let bl -> Str.length(dir)
        when bl > 2 {
            dir -> Str.substring(dir, 0, bl - 2)
        }
    }
    let r -> compile_file_multi(src_path, dir, do_check, incremental)
    when r[`ok`] == true {
        let nfiles -> 0
        when r[`c_files`] != Nothing {
            nfiles -> r[`c_files`].length
        }
        let inc_note -> ``
        when incremental == true {
            inc_note -> ` [incremental cache]`
        }
        <- {
            `code` -> 0,
            `message` -> `multi-unit wrote ` + Str.to_string(nfiles) + ` files under ` + dir + inc_note
        }
    }
    <- {
        `code` -> 1,
        `message` -> `multi compile failed:\n` + join_errs(r[`errors`])
    }
}

/!
 CLI-style dispatch on an args list (args[0] may be script/binary name).
 Supports:
   compile <in.zl> [out.c] [--typecheck|-t]
   check <in.zl>
   deps <in.zl>
   help
 Returns exit map: { code: Integer, message: String }
 !/
function run_args(args) {
    Plugin.set_tool_runner(vm_cli)
    let n -> 0
    when args != Nothing {
        n -> args.length
    }
    let i0 -> cli_cmd_index(args, n)
    when i0 >= n {
        // Bare zen invocation: if running in an interactive terminal, launch REPL
        when __builtin_term.is_tty() == true {
            let repl_tool -> Plugin.find_tool_path(`zenrepl`)
            when repl_tool != Nothing {
                <- vm_cli(repl_tool)
            }
        }
        <- {
            `code` -> 0,
            `message` -> usage_text()
        }
    }
    let cmd -> Str.to_string(args[i0])

    when cmd == `daemon` {
        let sub -> `start`
        when i0 + 1 < n {
            sub -> Str.to_string(args[i0 + 1])
        }
        when sub == `start` {
            let sock -> `/tmp/zen_compiler.sock`
            when i0 + 2 < n {
                sock -> Str.to_string(args[i0 + 2])
            }
            let code -> Daemon.start_daemon(sock, [])
            <- {`code` -> code, `message` -> ``}
        }
        when sub == `stop` or sub == `status` or sub == `clear` or sub == `ping` {
            let sock -> `/tmp/zen_compiler.sock`
            let resp -> Daemon.try_proxy_request(sock, sub, [])
            when resp == Nothing {
                <- {`code` -> 1, `message` -> `zen daemon is not running`}
            }
            <- resp
        }
        <- {`code` -> 1, `message` -> `unknown daemon subcommand: ` + sub}
    }

    // Transparent proxying to background compiler daemon
    when Sys.get_env(`ZEN_NO_DAEMON`) == Nothing and Sys.get_env(`ZEN_DAEMON_WORKER`) == Nothing {
        when cmd == `compile` or cmd == `build` or cmd == `check` {
            let proxy_args -> []
            let pi -> i0 + 1
            do while pi < n {
                proxy_args.append(args[pi])
                pi -> pi + 1
            }
            let proxy_resp -> Daemon.try_proxy_request(`/tmp/zen_compiler.sock`, cmd, proxy_args)
            when proxy_resp != Nothing {
                <- proxy_resp
            }
        }
    }

    <- run_args_local(args, i0, n, cmd)
}

export function run_args_local(args, i0, n, cmd) {
    when cmd == `help` or cmd == `-h` or cmd == `--help` {
        when i0 + 1 < n {
            let target_sub -> Str.to_string(args[i0 + 1])
            let sub_help -> command_help(target_sub)
            when sub_help != Nothing {
                <- {`code` -> 0, `message` -> sub_help}
            }
        }
        <- {
            `code` -> 0,
            `message` -> usage_text()
        }
    }

    when cmd == `info` or cmd == `version` or cmd == `--version` or cmd == `-v` {
        <- Extensions.compiler_info()
    }

    // Check if subcommand was called with --help or -h (e.g. zen build --help)
    when i0 + 1 < n {
        let flag_help -> Str.to_string(args[i0 + 1])
        when flag_help == `--help` or flag_help == `-h` {
            let specific_help -> command_help(cmd)
            when specific_help != Nothing {
                <- {`code` -> 0, `message` -> specific_help}
            }
        }
    }

    when cmd == `completion` {
        let sh -> `bash`
        when i0 + 1 < n {
            sh -> Str.to_string(args[i0 + 1])
        }
        when sh == `bash` {
            <- Extensions.bash_completion_script()
        }
        <- {`code` -> 1, `message` -> `unknown shell: ` + sh + ` (supported: bash)`}
    }

    when cmd == `disasm` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `disasm: missing file (.zbc or .zl)\n\nUsage: zen disasm <file>`}
        }
        let t_file -> Str.to_string(args[i0 + 1])
        <- Extensions.disasm_file(t_file)
    }

    when cmd == `ast` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `ast: missing file (.zl)\n\nUsage: zen ast <file.zl>`}
        }
        let t_file -> Str.to_string(args[i0 + 1])
        <- Extensions.ast_file(t_file)
    }

    when cmd == `check` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `check: missing file`}
        }
        let path -> Str.to_string(args[i0 + 1])
        when not fs_is_file(path) {
            <- {`code` -> 1, `message` -> `check: not found ` + path}
        }
        let src -> fs_read(path)
        let r -> check_string_file(src, path)
        when r[`ok`] == true {
            <- {`code` -> 0, `message` -> `check ok: ` + path}
        }
        let msg -> `check failed:\n` + join_errs(r[`errors`])
        <- {`code` -> 1, `message` -> msg}
    }

    when cmd == `deps` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `deps: missing file`}
        }
        let path -> Str.to_string(args[i0 + 1])
        let base -> Path.dirname(path)
        let order -> dep_order(path, base, `.`, `lib`, `selfhost`)
        let on -> order.length
        let msg -> `deps (` + Str.to_string(on) + `):\n` + join_paths(order, 0, on, ``)
        <- {`code` -> 0, `message` -> msg}
    }

    when cmd == `compile` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `compile: missing file\n\nSee 'zen compile --help' for options.`}
        }
        let src_path -> Str.to_string(args[i0 + 1])
        <- compile_cli(src_path, args, i0 + 2, n)
    }

    when cmd == `build` {
        let is_proj_build -> false
        when i0 + 1 >= n {
            is_proj_build -> true
        } or when Str.starts_with(Str.to_string(args[i0 + 1]), `-`) {
            is_proj_build -> true
        }
        when is_proj_build {
            when fs_is_file(`zen.pkg.zd`) or fs_is_file(`.zbuild`) {
                let pm_tool -> Plugin.find_tool_path(`zenpm`)
                when pm_tool != Nothing {
                    <- vm_cli(pm_tool)
                }
            }
            when i0 + 1 >= n {
                <- {`code` -> 1, `message` -> `build: no project manifest (zen.pkg.zd) found and no input file specified.\n\nRun 'zen new <name>' to create a project, or 'zen build <file.zl>' to compile a file.`}
            }
        }
        let src_path -> Str.to_string(args[i0 + 1])
        <- build_cli(src_path, args, i0 + 2, n)
    }

    when cmd == `run` or cmd == `-g` or cmd == `--generate` {
        let is_proj_run -> false
        when i0 + 1 >= n {
            is_proj_run -> true
        } or when Str.starts_with(Str.to_string(args[i0 + 1]), `-`) {
            is_proj_run -> true
        }
        when is_proj_run {
            when fs_is_file(`zen.pkg.zd`) or fs_is_file(`.zbuild`) {
                let pm_tool -> Plugin.find_tool_path(`zenpm`)
                when pm_tool != Nothing {
                    <- vm_cli(pm_tool)
                }
            }
            when i0 + 1 >= n {
                <- {`code` -> 1, `message` -> `run: no project manifest (zen.pkg.zd) found and no input file specified.\n\nRun 'zen run <file.zl>' or 'zen init' to initialize a project.`}
            }
        }
        let src_path -> Str.to_string(args[i0 + 1])
        <- run_cli(src_path, args, i0 + 2, n)
    }

    when cmd == `interpret` or cmd == `eval` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `interpret: missing file`}
        }
        let src_path -> Str.to_string(args[i0 + 1])
        <- interpret_cli(src_path)
    }

    when cmd == `vm` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `vm: missing file`}
        }
        let src_path -> Str.to_string(args[i0 + 1])
        <- vm_cli(src_path)
    }

    when cmd == `test` or cmd == `--test` {
        let is_proj_test -> false
        when i0 + 1 >= n {
            is_proj_test -> true
        } or when Str.starts_with(Str.to_string(args[i0 + 1]), `-`) {
            is_proj_test -> true
        } or when not fs_is_file(Str.to_string(args[i0 + 1])) and not Str.ends_with(Str.to_string(args[i0 + 1]), `.zl`) {
            is_proj_test -> true
        }
        when is_proj_test {
            when fs_is_file(`zen.pkg.zd`) or fs_is_dir(`tests`) {
                let pm_tool -> Plugin.find_tool_path(`zenpm`)
                when pm_tool != Nothing {
                    <- vm_cli(pm_tool)
                }
            }
            when i0 + 1 >= n {
                <- {`code` -> 1, `message` -> `test: no tests/ directory or zen.pkg.zd found and no test file specified.\n\nUsage: zen test [file.zl]`}
            }
        }
        let src_path -> Str.to_string(args[i0 + 1])
        <- test_cli(src_path)
    }

    when cmd == `lsp` {
        // LSP is a separate entry (tools/zenlsp.zl) so zen-selfhost
        // does not link Protocol/json into every compile/interpret.
        <- {
            `code` -> 1,
            `message` -> `lsp is not linked into zen-selfhost. Use: python3 bootstrap/Zen.py tools/zenlsp.zl\n  hybrid: ./bin/zen lsp`
        }
    }

    when Plugin.has_command(cmd) {
        <- Plugin.dispatch_command(cmd, args)
    }

    when cmd == `plugin` {
        let sub -> `list`
        when i0 + 1 < n {
            sub -> Str.to_string(args[i0 + 1])
        }
        when sub == `list` {
            let plist -> Plugin.get_registered_plugins()
            let pn -> plist.length
            let pmsg -> Extensions.style_bold(`Registered plugins (` + Str.to_string(pn) + `):\n`)
            let pi -> 0
            do while pi < pn {
                let pl -> plist[pi]
                pmsg -> pmsg + `  - ` + Extensions.style_cyan(Str.to_string(pl[`name`])) + ` (v` + Str.to_string(pl[`version`]) + `): ` + Str.to_string(pl[`description`]) + `\n`
                pi -> pi + 1
            }
            <- {`code` -> 0, `message` -> pmsg}
        }
        when sub == `run` {
            when i0 + 2 >= n {
                <- {`code` -> 1, `message` -> `plugin run: missing script path`}
            }
            let pscript -> Str.to_string(args[i0 + 2])
            <- Plugin.run_plugin_script(pscript, [])
        }
        <- {`code` -> 1, `message` -> `unknown plugin subcommand: ` + sub + ` (supported: list, run)`}
    }

    when cmd == `bundle` or cmd == `package` {
        when i0 + 1 >= n {
            <- {`code` -> 1, `message` -> `bundle: missing file\n\nUsage: zen bundle <file.zl> [-o out.zbc]`}
        }
        let src_path -> Str.to_string(args[i0 + 1])
        let out_path -> Bytecode.get_cache_path(src_path)
        when i0 + 2 < n {
            let flag -> Str.to_string(args[i0 + 2])
            when (flag == `-o` or flag == `--out` or flag == `--output`) and i0 + 3 < n {
                out_path -> Str.to_string(args[i0 + 3])
            } or when Str.starts_with(flag, `--output=`) {
                out_path -> Str.substring(flag, 9, Str.length(flag))
            } or {
                out_path -> flag
            }
        }
        let base -> Path.dirname(src_path)
        let order -> ensure_compile_order(src_path, base)
        let prog -> merge_program_files(order, src_path)
        when prog == Nothing or AST.prog_err(prog) != Nothing {
            let err -> AST.prog_err(prog)
            when err == Nothing { err -> `parse error` }
            <- {`code` -> 1, `message` -> `bundle failed: ` + Str.to_string(err)}
        }
        let b_res -> Bytecode.compile_program(prog)
        when b_res[`ok`] != true {
            <- {`code` -> 1, `message` -> `bundle failed: bytecode compilation error`}
        }
        let chunk -> b_res[`chunk`]
        let src_content -> fs_read(src_path)
        Bytecode.write_bytecode_file(chunk, out_path, Str.length(src_content))
        <- {`code` -> 0, `message` -> `bundled bytecode: ` + out_path}
    }

    when Str.ends_with(cmd, `.zbc`) or Bytecode.is_bytecode_file(cmd) {
        let v -> __builtin_vm.run_file(cmd)
        when v == Nothing or v == 0 {
            <- {`code` -> 0, `message` -> ``}
        }
        when v == 1 {
            <- {`code` -> 1, `message` -> ``}
        }
        let s -> Str.to_string(v)
        when s == `0` {
            <- {`code` -> 0, `message` -> ``}
        }
        <- {`code` -> 0, `message` -> s}
    }

    when Str.ends_with(cmd, `.zl`) {
        // Run bare script on the fly via fast Bytecode VM with automated .zbc caching
        <- vm_cli(cmd)
    }

    let sug -> Extensions.get_command_suggestion(cmd)
    let err_msg -> `error: unknown command '` + cmd + `'\n`
    when sug != Nothing {
        err_msg -> err_msg + `\n  Did you mean '` + Extensions.style_cyan(sug) + `'?\n`
    }
    err_msg -> err_msg + `\nSee 'zen --help' for available commands.`
    <- {
        `code` -> 1,
        `message` -> err_msg
    }
}

export function vm_cli(src_path) {
    when not fs_is_file(src_path) {
        <- {`code` -> 1, `message` -> `vm: not found ` + src_path}
    }
    when Str.ends_with(src_path, `.zbc`) or Bytecode.is_bytecode_file(src_path) {
        let v -> __builtin_vm.run_file(src_path)
        when v == Nothing or v == 0 {
            <- {`code` -> 0, `message` -> ``}
        }
        when v == 1 {
            <- {`code` -> 1, `message` -> ``}
        }
        let s -> Str.to_string(v)
        when s == `0` {
            <- {`code` -> 0, `message` -> ``}
        }
        when type(v) == `Integer` or type(v) == `Int` {
            <- {`code` -> v, `message` -> ``}
        }
        <- {`code` -> 0, `message` -> s}
    }
    let base -> Path.dirname(src_path)
    let order -> ensure_compile_order(src_path, base)
    let prog -> merge_program_files(order, src_path)
    when prog == Nothing or AST.prog_err(prog) != Nothing {
        let err -> AST.prog_err(prog)
        when err == Nothing {
            err -> `parse error`
        }
        <- {`code` -> 1, `message` -> `vm: ` + Str.to_string(err)}
    }
    let b_res -> Bytecode.compile_program(prog)
    when b_res[`ok`] != true {
        let errs -> b_res[`errors`]
        let msg -> `bytecode compilation failed`
        when errs != Nothing and errs.length > 0 {
            msg -> Str.to_string(errs[0])
        }
        <- {`code` -> 1, `message` -> `vm: ` + msg}
    }
    let chunk -> b_res[`chunk`]
    let globals -> Bytecode.create_vm_prelude()
    let v -> Bytecode.eval_chunk(chunk, globals)
    when v == Nothing or v == 0 {
        <- {`code` -> 0, `message` -> ``}
    }
    when v == 1 {
        <- {`code` -> 1, `message` -> ``}
    }
    let s -> Str.to_string(v)
    when s == `0` {
        <- {`code` -> 0, `message` -> ``}
    }
    when type(v) == `Integer` or type(v) == `Int` {
        <- {`code` -> v, `message` -> ``}
    }
    <- {`code` -> 0, `message` -> s}
}

/!
 Script interpret: accelerated by Bytecode VM (Phase 3),
 falling back to AST interpreter for complex multi-module imports.
 !/
function interpret_cli(src_path) {
    when not fs_is_file(src_path) {
        <- {`code` -> 1, `message` -> `interpret: not found ` + src_path}
    }
    let r -> Interp.interpret_file(src_path)
    when r[`ok`] != true {
        let err -> r[`error`]
        when err == Nothing {
            err -> `interpret failed`
        }
        <- {`code` -> 1, `message` -> Str.to_string(err)}
    }
    let v -> r[`value`]
    when v == Nothing {
        <- {`code` -> 0, `message` -> ``}
    }
    when v == 0 {
        <- {`code` -> 0, `message` -> ``}
    }
    when v == 1 {
        <- {`code` -> 1, `message` -> ``}
    }
    let s -> Str.to_string(v)
    when s == `0` {
        <- {`code` -> 0, `message` -> ``}
    }
    <- {`code` -> 0, `message` -> s}
}

/!
 Discover test_* functions in src_path and run them under Interpreter,
 or execute main() if no test_* functions exist (e.g. test suites using zen.test).
 !/
function test_single_file(src_path) {
    when not fs_is_file(src_path) {
        <- {`code` -> 1, `message` -> `test: not found ` + src_path}
    }
    let res -> Interp.interpret_file_env(src_path)
    when res[`ok`] != true {
        let err -> res[`error`]
        when err == Nothing {
            err -> `test setup failed`
        }
        <- {`code` -> 1, `message` -> Str.to_string(err)}
    }
    let env -> res[`env`]
    let prog -> res[`program`]
    let test_fns -> collect_test_fn_names(AST.flatten_stmts(AST.prog_stmts(prog)))
    let count -> test_fns.length
    when count == 0 {
        // No explicit test_* functions; run main() if present (e.g. test_*.zl test suites)
        let main_res -> Interp.call_named_fn(env, `main`, Nothing)
        when main_res[`ok`] != true {
            let err -> main_res[`error`]
            when err == Nothing {
                err -> `test run failed`
            }
            <- {`code` -> 1, `message` -> Str.to_string(err)}
        }
        let v -> main_res[`value`]
        when v == false {
            <- {`code` -> 1, `message` -> `test suite failed`}
        }
        when v == 1 {
            <- {`code` -> 1, `message` -> `test suite failed with code 1`}
        }
        <- {`code` -> 0, `message` -> ``}
    }

    // Run discovered test_* functions
    io.writeln(`--- Running tests in ` + src_path + ` ---`)
    let passed -> run_test_fn_list(env, test_fns, 0, count, 0)
    io.writeln(`--- ` + src_path + `: ` + Str.to_string(passed) + `/` + Str.to_string(count) + ` tests passed ---`)
    when passed == count {
        <- {`code` -> 0, `message` -> ``}
    }
    <- {`code` -> 1, `message` -> `some tests failed in ` + src_path}
}

function test_cli(src_path) {
    when fs_is_dir(src_path) {
        let entries -> fs_list_dir(src_path)
        when entries == Nothing {
            <- {`code` -> 1, `message` -> `test: cannot list directory ` + src_path}
        }
        let total_files -> 0
        let total_passed -> 0
        let total_failed -> 0
        let i -> 0
        let n -> entries.length
        do while i < n {
            let ent -> entries[i]
            let ent_name -> Str.to_string(ent)
            when Str.starts_with(ent_name, `test_`) and Str.ends_with(ent_name, `.zl`) {
                let full_path -> Path.join(src_path, ent_name)
                total_files -> total_files + 1
                let res -> test_single_file(full_path)
                when res[`code`] == 0 {
                    total_passed -> total_passed + 1
                } or {
                    total_failed -> total_failed + 1
                }
            }
            i -> i + 1
        }
        when total_files == 0 {
            <- {`code` -> 0, `message` -> `test: no test_*.zl files found in ` + src_path}
        }
        io.writeln(`=== Summary: ` + Str.to_string(total_passed) + `/` + Str.to_string(total_files) + ` test files passed ===`)
        when total_failed == 0 {
            <- {`code` -> 0, `message` -> ``}
        }
        <- {`code` -> 1, `message` -> Str.to_string(total_failed) + ` test file(s) failed in ` + src_path}
    }
    <- test_single_file(src_path)
}

function collect_test_fn_names(stmts) {
    let acc -> []
    when stmts == Nothing {
        <- acc
    }
    let n -> stmts.length
    let i -> 0
    do while i < n {
        let s -> stmts[i]
        when s != Nothing and (AST.is_function(s) or AST.ast_kind(s) == 21) {
            let name -> Str.to_string(AST.fn_name(s))
            when Str.starts_with(name, `test_`) {
                acc.append(name)
            }
        }
        i -> i + 1
    }
    <- acc
}

function run_test_fn_list(env, test_fns, i, n, passed) {
    when i >= n {
        <- passed
    }
    let name -> test_fns[i]
    io.write(`  [TEST] ` + name + `... `)
    let res -> Interp.call_named_fn(env, name, Nothing)
    when res[`ok`] != true {
        let err -> res[`error`]
        when err == Nothing {
            err -> `error`
        }
        io.writeln(`FAIL: ` + Str.to_string(err))
        <- run_test_fn_list(env, test_fns, i + 1, n, passed)
    }
    let v -> res[`value`]
    when v == false {
        io.writeln(`FAIL: returned false`)
        <- run_test_fn_list(env, test_fns, i + 1, n, passed)
    }
    io.writeln(`PASS`)
    <- run_test_fn_list(env, test_fns, i + 1, n, passed + 1)
}

/!
 Zen → C → gcc → binary (no run).
 build <file.zl> [exe] [--typecheck|-t] [--workdir dir]
 !/
function build_cli(src_path, args, opt_start, n) {
    let opts -> parse_build_opts(args, opt_start, n, `output/build/selfhost_native/zen_program`, `output/build/selfhost_native`, false, false, false)
    let r -> Nothing
    when opts[`multi`] == true or opts[`incremental`] == true {
        r -> build_file_multi(src_path, opts[`workdir`], opts[`exe`], opts[`check`], opts[`incremental`])
    } or {
        r -> build_file(src_path, opts[`workdir`], opts[`exe`], opts[`check`])
    }
    when r[`ok`] == true {
        let msg -> `built ` + r[`exe`]
        when opts[`incremental`] == true {
            msg -> msg + ` (cached: ` + Str.to_string(r[`cached_units`]) + `, compiled: ` + Str.to_string(r[`compiled_units`]) + `)`
        }
        <- {
            `code` -> 0,
            `message` -> msg
        }
    }
    <- {
        `code` -> 1,
        `message` -> `build failed:\n` + Str.to_string(r[`message`])
    }
}

/!
 Zen → C → gcc → run (bootstrap -g equivalent for selfhost).
 run|-g <file.zl> [--typecheck|-t] [--workdir dir] [--] [prog args...]
 !/
function run_cli(src_path, args, opt_start, n) {
    let opts -> parse_run_opts(args, opt_start, n, `output/build/selfhost_native`, false, [])
    let r -> build_file(src_path, opts[`workdir`], Path.join(opts[`workdir`], `zen_program`), opts[`check`])
    when r[`ok`] != true {
        <- {
            `code` -> 1,
            `message` -> `run: build failed:\n` + Str.to_string(r[`message`])
        }
    }
    let exe -> r[`exe`]
    let prog_args -> opts[`prog_args`]
    let exit_c -> CLink.run_exe(exe, prog_args)
    when exit_c == 0 {
        <- {
            `code` -> 0,
            `message` -> `ran ` + exe + ` (exit 0)`
        }
    }
    <- {
        `code` -> exit_c,
        `message` -> `ran ` + exe + ` (exit ` + Str.to_string(exit_c) + `)`
    }
}

/!
 Full pipeline: compile_file → CLink.build_c_code.
 !/
function build_file(source_path, workdir, exe_path, do_check) {
    when not fs_is_file(source_path) {
        <- {
            `ok` -> false,
            `message` -> `file not found: ` + source_path,
            `exe` -> ``
        }
    }
    let c_path -> Path.join(workdir, `out.c`)
    // Ensure workdir exists before compile write
    __builtin_file.mkdir_p(workdir)
    let cr -> compile_file(source_path, c_path, do_check)
    when cr[`ok`] != true {
        <- {
            `ok` -> false,
            `message` -> join_errs(cr[`errors`]),
            `exe` -> ``
        }
    }
    let lr -> CLink.build_c_code(cr[`c_code`], workdir, exe_path)
    when lr[`ok`] != true {
        <- {
            `ok` -> false,
            `message` -> lr[`message`],
            `exe` -> ``
        }
    }
    <- {
        `ok` -> true,
        `message` -> lr[`message`],
        `exe` -> lr[`exe`],
        `workdir` -> workdir
    }
}

/!
 Multi-unit incremental pipeline: compile_file_multi → CLink.build_multi_units.
 !/
function build_file_multi(source_path, workdir, exe_path, do_check, incremental) {
    when not fs_is_file(source_path) {
        <- {
            `ok` -> false,
            `message` -> `file not found: ` + source_path,
            `exe` -> ``
        }
    }
    when workdir == Nothing or workdir == `` {
        workdir -> `output/multi_c`
    }
    __builtin_file.mkdir_p(workdir)
    let cr -> compile_file_multi(source_path, workdir, do_check, incremental)
    when cr[`ok`] != true {
        <- {
            `ok` -> false,
            `message` -> join_errs(cr[`errors`]),
            `exe` -> ``
        }
    }
    let lr -> CLink.build_multi_units(cr[`c_files`], workdir, exe_path, incremental)
    when lr[`ok`] != true {
        <- {
            `ok` -> false,
            `message` -> lr[`message`],
            `exe` -> ``
        }
    }
    <- {
        `ok` -> true,
        `message` -> lr[`message`],
        `exe` -> lr[`exe`],
        `cached_units` -> cr[`cached_units`],
        `compiled_units` -> cr[`compiled_units`],
        `workdir` -> workdir
    }
}

function parse_build_opts(args, k, n, exe_path, workdir, do_check, multi, incremental) {
    when k >= n {
        <- {
            `exe` -> exe_path,
            `workdir` -> workdir,
            `check` -> do_check,
            `multi` -> multi,
            `incremental` -> incremental
        }
    }
    let a -> Str.to_string(args[k])
    when a == `--typecheck` or a == `-t` {
        <- parse_build_opts(args, k + 1, n, exe_path, workdir, true, multi, incremental)
    }
    when a == `--multi` or a == `-m` {
        <- parse_build_opts(args, k + 1, n, exe_path, workdir, do_check, true, incremental)
    }
    when a == `--incremental` or a == `-i` {
        <- parse_build_opts(args, k + 1, n, exe_path, workdir, do_check, true, true)
    }
    when a == `-o` or a == `--output` or a == `--out` {
        when k + 1 < n {
            <- parse_build_opts(args, k + 2, n, Str.to_string(args[k + 1]), workdir, do_check, multi, incremental)
        }
    }
    when Str.starts_with(a, `--output=`) {
        let val -> Str.substring(a, 9, Str.length(a))
        <- parse_build_opts(args, k + 1, n, val, workdir, do_check, multi, incremental)
    }
    when a == `--workdir` {
        when k + 1 >= n {
            <- parse_build_opts(args, k + 1, n, exe_path, workdir, do_check, multi, incremental)
        }
        <- parse_build_opts(args, k + 2, n, exe_path, Str.to_string(args[k + 1]), do_check, multi, incremental)
    }
    when not Str.starts_with(a, `-`) {
        // bare path = exe output
        <- parse_build_opts(args, k + 1, n, a, workdir, do_check, multi, incremental)
    }
    <- parse_build_opts(args, k + 1, n, exe_path, workdir, do_check, multi, incremental)
}

function parse_run_opts(args, k, n, workdir, do_check, prog_args) {
    when k >= n {
        <- {
            `workdir` -> workdir,
            `check` -> do_check,
            `prog_args` -> prog_args
        }
    }
    let a -> Str.to_string(args[k])
    when a == `--typecheck` or a == `-t` {
        <- parse_run_opts(args, k + 1, n, workdir, true, prog_args)
    }
    when a == `--workdir` {
        when k + 1 >= n {
            <- parse_run_opts(args, k + 1, n, workdir, do_check, prog_args)
        }
        <- parse_run_opts(args, k + 2, n, Str.to_string(args[k + 1]), do_check, prog_args)
    }
    when a == `--` {
        // rest are program args
        let rest -> []
        let j -> k + 1
        do while j < n {
            rest.append(args[j])
            j -> j + 1
        }
        <- {
            `workdir` -> workdir,
            `check` -> do_check,
            `prog_args` -> rest
        }
    }
    when Str.starts_with(a, `-`) {
        <- parse_run_opts(args, k + 1, n, workdir, do_check, prog_args)
    }
    // positional after file: treat as program args (no out.c for run)
    prog_args.append(a)
    <- parse_run_opts(args, k + 1, n, workdir, do_check, prog_args)
}

/!
 Parse compile CLI options from args[k..n) into { out, check, multi }.
 !/
function parse_compile_opts(args, k, n, out_path, do_check, multi, incremental) {
    when k >= n {
        <- {
            `out` -> out_path,
            `check` -> do_check,
            `multi` -> multi,
            `incremental` -> incremental
        }
    }
    let a -> Str.to_string(args[k])
    when a == `--typecheck` or a == `-t` {
        <- parse_compile_opts(args, k + 1, n, out_path, true, multi, incremental)
    }
    when a == `--multi` or a == `-m` {
        <- parse_compile_opts(args, k + 1, n, out_path, do_check, true, incremental)
    }
    when a == `--incremental` or a == `-i` {
        <- parse_compile_opts(args, k + 1, n, out_path, do_check, true, true)
    }
    when a == `-o` or a == `--output` or a == `--out` {
        when k + 1 < n {
            <- parse_compile_opts(args, k + 2, n, Str.to_string(args[k + 1]), do_check, multi, incremental)
        }
    }
    when Str.starts_with(a, `--output=`) {
        let val -> Str.substring(a, 9, Str.length(a))
        <- parse_compile_opts(args, k + 1, n, val, do_check, multi, incremental)
    }
    when not Str.starts_with(a, `-`) {
        <- parse_compile_opts(args, k + 1, n, a, do_check, multi, incremental)
    }
    <- parse_compile_opts(args, k + 1, n, out_path, do_check, multi, incremental)
}

function command_help(cmd) {
    when cmd == `build` {
        let h -> Extensions.style_bold(`zen build`) + ` — Compile and link Zen source into a standalone native binary\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen build <file.zl> [OPTIONS]\n\n`
        h -> h + Extensions.style_bold(`OPTIONS:\n`)
        h -> h + `  ` + Extensions.style_cyan(`-o, --output <path>`) + `    Output binary executable path\n`
        h -> h + `  ` + Extensions.style_cyan(`-O, --opt <0..3|s>`) + `    Optimization level (default: 2)\n`
        h -> h + `  ` + Extensions.style_cyan(`-m, --multi`) + `           Compile modules into separate C translation units\n`
        h -> h + `  ` + Extensions.style_cyan(`-i, --incremental`) + `     Only compile modified modules with cache\n`
        h -> h + `  ` + Extensions.style_cyan(`--static`) + `              Link fully static native binary\n`
        h -> h + `  ` + Extensions.style_cyan(`--shared`) + `              Compile shared library (.so)\n`
        h -> h + `  ` + Extensions.style_cyan(`-t, --typecheck`) + `       Run type checker before code generation\n`
        h -> h + `  ` + Extensions.style_cyan(`-h, --help`) + `            Display this help message\n\n`
        h -> h + Extensions.style_bold(`EXAMPLES:\n`)
        h -> h + `  zen build src/main.zl -o bin/app\n`
        h -> h + `  zen build src/main.zl --incremental\n`
        h -> h + `  zen build server.zl -O 3 --typecheck\n`
        <- h
    }
    when cmd == `bundle` or cmd == `package` {
        let h -> Extensions.style_bold(`zen bundle`) + ` — Package Zen source into a standalone bytecode binary (.zbc)\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen bundle <file.zl> [OPTIONS]\n\n`
        h -> h + Extensions.style_bold(`OPTIONS:\n`)
        h -> h + `  ` + Extensions.style_cyan(`-o, --output <path>`) + `    Output .zbc file path (default: __zcache__/<stem>.zbc)\n`
        h -> h + `  ` + Extensions.style_cyan(`-h, --help`) + `            Display this help message\n\n`
        h -> h + Extensions.style_bold(`EXAMPLES:\n`)
        h -> h + `  zen bundle scripts/task.zl -o dist/task.zbc\n`
        h -> h + `  zen dist/task.zbc                  ` + Extensions.style_dim(`# run without source code`) + `\n`
        <- h
    }
    when cmd == `run` {
        let h -> Extensions.style_bold(`zen run`) + ` — Execute a Zen script or packaged bytecode (.zbc)\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen run <file.zl|file.zbc> [OPTIONS] [-- SCRIPT_ARGS...]\n\n`
        h -> h + Extensions.style_bold(`OPTIONS:\n`)
        h -> h + `  ` + Extensions.style_cyan(`-t, --typecheck`) + `       Enforce type checking\n`
        h -> h + `  ` + Extensions.style_cyan(`-h, --help`) + `            Display this help message\n\n`
        h -> h + Extensions.style_bold(`EXAMPLES:\n`)
        h -> h + `  zen run app.zl\n`
        h -> h + `  zen run app.zbc -- --port 8080\n`
        <- h
    }
    when cmd == `compile` {
        let h -> Extensions.style_bold(`zen compile`) + ` — Transpile Zen source code to C\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen compile <file.zl> [OPTIONS] [out.c]\n\n`
        h -> h + Extensions.style_bold(`OPTIONS:\n`)
        h -> h + `  ` + Extensions.style_cyan(`-o, --output <path>`) + `    Output C file or directory\n`
        h -> h + `  ` + Extensions.style_cyan(`-m, --multi`) + `           Emit separate C translation units\n`
        h -> h + `  ` + Extensions.style_cyan(`-i, --incremental`) + `     Skip regenerating unchanged .c unit files\n`
        h -> h + `  ` + Extensions.style_cyan(`-t, --typecheck`) + `       Run type checker before code generation\n`
        h -> h + `  ` + Extensions.style_cyan(`-h, --help`) + `            Display this help message\n\n`
        <- h
    }
    when cmd == `check` {
        let h -> Extensions.style_bold(`zen check`) + ` — Typecheck and validate Zen source without compiling\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen check <file.zl>\n`
        <- h
    }
    when cmd == `disasm` {
        let h -> Extensions.style_bold(`zen disasm`) + ` — Disassemble and inspect bytecode instructions & constants\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen disasm <file.zbc|file.zl>\n`
        <- h
    }
    when cmd == `ast` {
        let h -> Extensions.style_bold(`zen ast`) + ` — Pretty-print parsed Abstract Syntax Tree hierarchy\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen ast <file.zl>\n`
        <- h
    }
    when cmd == `info` {
        let h -> Extensions.style_bold(`zen info`) + ` — Print compiler version and environment diagnostics\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen info\n`
        <- h
    }
    when cmd == `completion` {
        let h -> Extensions.style_bold(`zen completion`) + ` — Generate shell tab-completion script\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen completion [bash]\n\n`
        h -> h + Extensions.style_bold(`INSTALLATION:\n`)
        h -> h + `  source <(zen completion bash)      ` + Extensions.style_dim(`# add to ~/.bashrc`) + `\n`
        <- h
    }
    when cmd == `plugin` {
        let h -> Extensions.style_bold(`zen plugin`) + ` — Manage compiler plugins and run extension scripts\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`)
        h -> h + `  zen plugin list                    ` + Extensions.style_dim(`# list registered plugins`) + `\n`
        h -> h + `  zen plugin run <script.zl>         ` + Extensions.style_dim(`# execute a dynamic plugin script`) + `\n`
        <- h
    }
    when cmd == `test` {
        let h -> Extensions.style_bold(`zen test`) + ` — Discover and execute test suites natively\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen test <file.zl>\n`
        <- h
    }
    when cmd == `new` {
        let h -> Extensions.style_bold(`zen new`) + ` — Create a new Zenlang project scaffold\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen new <name> [--template <cli|tui|lib|service>]\n\n`
        h -> h + Extensions.style_bold(`TEMPLATES:\n`)
        h -> h + `  ` + Extensions.style_cyan(`cli`) + `       Command-line interface application (default)\n`
        h -> h + `  ` + Extensions.style_cyan(`tui`) + `       Terminal UI application with canvas & mouse\n`
        h -> h + `  ` + Extensions.style_cyan(`lib`) + `       Reusable Zenlang package/library\n`
        h -> h + `  ` + Extensions.style_cyan(`service`) + `   Networked HTTP/TCP backend service\n`
        <- h
    }
    when cmd == `init` {
        let h -> Extensions.style_bold(`zen init`) + ` — Initialize a project manifest (zen.pkg.zd) in existing directory\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen init [directory] [--template <type>]\n`
        <- h
    }
    when cmd == `pkg` {
        let h -> Extensions.style_bold(`zen pkg`) + ` — Manage project dependencies and lockfile\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`)
        h -> h + `  zen pkg list                       ` + Extensions.style_dim(`# list declared & resolved dependencies`) + `\n`
        h -> h + `  zen pkg install                    ` + Extensions.style_dim(`# resolve and fetch dependencies into deps/`) + `\n`
        h -> h + `  zen pkg add <name> <git_or_path>   ` + Extensions.style_dim(`# add dependency to zen.pkg.zd`) + `\n`
        h -> h + `  zen pkg remove <name>              ` + Extensions.style_dim(`# remove dependency from zen.pkg.zd`) + `\n`
        h -> h + `  zen pkg graph [--html]             ` + Extensions.style_dim(`# visualize dependency tree`) + `\n`
        <- h
    }
    when cmd == `repl` {
        let h -> Extensions.style_bold(`zen repl`) + ` — Start interactive Zenlang Read-Eval-Print-Loop\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen repl\n`
        <- h
    }
    when cmd == `fmt` {
        let h -> Extensions.style_bold(`zen fmt`) + ` — Format Zenlang source files to canonical style\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`)
        h -> h + `  zen fmt <file.zl...>               ` + Extensions.style_dim(`# format and print to stdout`) + `\n`
        h -> h + `  zen fmt -w <file.zl...>            ` + Extensions.style_dim(`# format files in-place`) + `\n`
        h -> h + `  zen fmt --check <file.zl...>       ` + Extensions.style_dim(`# check formatting without writing`) + `\n`
        <- h
    }
    when cmd == `clean` {
        let h -> Extensions.style_bold(`zen clean`) + ` — Remove project build artifacts and intermediate files\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen clean\n`
        <- h
    }
    when cmd == `doc` or cmd == `explain` {
        let h -> Extensions.style_bold(`zen doc`) + ` — Built-in terminal man pages & symbol documentation\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`)
        h -> h + `  zen doc <symbol|keyword>            Query manual page for keyword, operator, or type\n`
        h -> h + `  zen doc --topics                    List all available language documentation topics\n`
        h -> h + `  zen doc [--html|--markdown] [dir]   Generate project API documentation\n`
        h -> h + `  zen explain <symbol|topic>          Alias for zen doc <query>\n\n`
        h -> h + Extensions.style_bold(`EXAMPLES:\n`)
        h -> h + `  zen doc when\n`
        h -> h + `  zen doc ->\n`
        h -> h + `  zen doc List\n`
        h -> h + `  zen explain ??\n`
        h -> h + `  zen doc --topics\n`
        <- h
    }
    when cmd == `dash` or cmd == `dashboard` {
        let h -> Extensions.style_bold(`zen dash`) + ` — Launch interactive terminal developer dashboard\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`) + `  zen dash\n`
        <- h
    }
    when cmd == `daemon` {
        let h -> Extensions.style_bold(`zen daemon`) + ` — Manage background resident compiler service\n\n`
        h -> h + Extensions.style_bold(`USAGE:\n`)
        h -> h + `  zen daemon start [socket_path]\n`
        h -> h + `  zen daemon stop\n`
        h -> h + `  zen daemon status\n`
        h -> h + `  zen daemon clear\n`
        <- h
    }
    <- Nothing
}

function usage_text() {
    let u -> Extensions.style_bold(`Zenlang Standalone Self-Hosted Compiler (v1.0.0-beta.1)`) + `\n`
    u -> u + Extensions.style_dim(`Modern visual data-flow language with three-layer execution (AOT C + Bytecode VM)\n\n`)
    
    u -> u + Extensions.style_bold(`USAGE:\n`)
    u -> u + `  ` + Extensions.style_cyan(`zen`) + `                                    ` + Extensions.style_dim(`# Start interactive REPL`) + `\n`
    u -> u + `  ` + Extensions.style_cyan(`zen`) + ` [COMMAND] [OPTIONS] [ARGS...]\n`
    u -> u + `  ` + Extensions.style_cyan(`zen`) + ` ` + Extensions.style_green(`<file.zl>`) + ` [ARGS...]            ` + Extensions.style_dim(`# Run script via Bytecode VM`) + `\n`
    u -> u + `  ` + Extensions.style_cyan(`zen`) + ` ` + Extensions.style_green(`<file.zbc>`) + ` [ARGS...]           ` + Extensions.style_dim(`# Run packaged bytecode directly`) + `\n\n`
    
    u -> u + Extensions.style_bold(`PROJECT WORKFLOWS:\n`)
    u -> u + `  ` + Extensions.style_cyan(`new`) + `       <name> [--template <t>] Create new project scaffold (cli, tui, lib, service)\n`
    u -> u + `  ` + Extensions.style_cyan(`init`) + `      [dir] [--template <t>]  Initialize zen.pkg.zd in current/specified directory\n`
    u -> u + `  ` + Extensions.style_cyan(`build`) + `     [file] [--release|-g]   Compile project or file into native executable\n`
    u -> u + `  ` + Extensions.style_cyan(`run`) + `       [file] [args] [--watch] Run project entrypoint or script\n`
    u -> u + `  ` + Extensions.style_cyan(`test`) + `      [file|filter]           Run test suites in tests/ or single test file\n`
    u -> u + `  ` + Extensions.style_cyan(`clean`) + `                             Remove build artifacts and intermediate files\n`
    u -> u + `  ` + Extensions.style_cyan(`pkg`) + `       <add|rm|ls|install>     Manage project dependencies and lockfile\n\n`

    u -> u + Extensions.style_bold(`DEVELOPER TOOLING:\n`)
    u -> u + `  ` + Extensions.style_cyan(`repl`) + `                              Start interactive Zenlang REPL\n`
    u -> u + `  ` + Extensions.style_cyan(`fmt`) + `       <files...> [-w|--check] Format source files to canonical style\n`
    u -> u + `  ` + Extensions.style_cyan(`doc`) + `       [symbol|options]        Query symbol man page or generate project docs\n`
    u -> u + `  ` + Extensions.style_cyan(`explain`) + `   <topic|symbol>          Explain keyword, operator, type, or concept\n`
    u -> u + `  ` + Extensions.style_cyan(`dash`) + `                              Launch interactive terminal developer dashboard\n`
    u -> u + `  ` + Extensions.style_cyan(`watch`) + `     [command]               Watch source files and auto-rebuild on change\n`
    u -> u + `  ` + Extensions.style_cyan(`bench`) + `     [filter]                Run benchmark suites in benches/\n`
    u -> u + `  ` + Extensions.style_cyan(`bundle`) + `    <file> [-o out.zbc]     Package script into standalone .zbc binary\n`
    u -> u + `  ` + Extensions.style_cyan(`check`) + `     <file>                  Typecheck and validate source without compiling\n\n`

    u -> u + Extensions.style_bold(`COMPILER & LOW-LEVEL:\n`)
    u -> u + `  ` + Extensions.style_cyan(`compile`) + `   <file> [out.c]          Transpile Zen source to native C source\n`
    u -> u + `  ` + Extensions.style_cyan(`deps`) + `      <file>                  Compute module dependency order and graph\n`
    u -> u + `  ` + Extensions.style_cyan(`disasm`) + `    <file.zbc|file.zl>      Disassemble bytecode opcodes & constants\n`
    u -> u + `  ` + Extensions.style_cyan(`ast`) + `       <file.zl>               Print formatted Abstract Syntax Tree\n`
    u -> u + `  ` + Extensions.style_cyan(`info`) + `                              Display compiler diagnostics & environment\n`
    u -> u + `  ` + Extensions.style_cyan(`daemon`) + `    <start|stop|status>     Manage resident compiler service\n`
    u -> u + `  ` + Extensions.style_cyan(`completion`) + ` [bash]                 Generate shell tab-completion script\n\n`

    u -> u + Extensions.style_bold(`EXTENSIONS & QUALITY:\n`)
    u -> u + `  ` + Extensions.style_cyan(`plugin`) + `    <list|run <script>>     Manage plugins or run extension script\n`
    u -> u + `  ` + Extensions.style_cyan(`todo`) + `                              Scan codebase for TODO/FIXME annotations\n`
    u -> u + `  ` + Extensions.style_cyan(`lint`) + `                              Run Zenlang style and convention linter\n\n`

    u -> u + Extensions.style_bold(`GLOBAL FLAGS:\n`)
    u -> u + `  ` + Extensions.style_cyan(`-o, --output <path>`) + `             Specify output binary, bytecode, or C file\n`
    u -> u + `  ` + Extensions.style_cyan(`-O, --opt <0..3|s>`) + `              Set optimization level (default: 2)\n`
    u -> u + `  ` + Extensions.style_cyan(`-m, --multi`) + `                    Emit separate C translation units\n`
    u -> u + `  ` + Extensions.style_cyan(`-i, --incremental`) + `              Only compile modified modules with cache\n`
    u -> u + `  ` + Extensions.style_cyan(`--static`) + `                       Link fully static native binary\n`
    u -> u + `  ` + Extensions.style_cyan(`-t, --typecheck`) + `                Enforce strict type checking\n`
    u -> u + `  ` + Extensions.style_cyan(`-q, --quiet`) + `                    Suppress banner and non-error diagnostics\n`
    u -> u + `  ` + Extensions.style_cyan(`-v, --version`) + `                  Show compiler version\n`
    u -> u + `  ` + Extensions.style_cyan(`-h, --help`) + `                     Show help (use 'zen <cmd> --help' for details)\n`
    <- u
}

function join_errs(errs) {
    when errs == Nothing {
        <- ``
    }
    let n -> errs.length
    <- join_errs_rec(errs, 0, n, ``)
}

function join_errs_rec(errs, i, n, acc) {
    when i >= n {
        <- acc
    }
    let e -> Str.to_string(errs[i])
    let next -> acc + e + `\n`
    <- join_errs_rec(errs, i + 1, n, next)
}

function join_paths(order, i, n, acc) {
    when i >= n {
        <- acc
    }
    let raw -> order[i]
    when raw == Nothing or raw == `` {
        <- join_paths(order, i + 1, n, acc)
    }
    let p -> Str.to_string(raw)
    when p == `Nothing` or p == `None` or p == `` {
        <- join_paths(order, i + 1, n, acc)
    }
    let next -> acc + p + `\n`
    <- join_paths(order, i + 1, n, next)
}
