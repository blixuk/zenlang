/!
 Stage 3 Layer: Zenlang Bytecode Architecture & VM.
 Compiles AST positional structs into compact bytecode chunks.
 Runs either via C VM (zen_vm.c in runtime/) or in-memory evaluator.
 !/

import compiler.AST as AST
import zen.text.string as Str

// --- Opcode Constants ---
function op_nop() { <- 0 }
function op_const() { <- 1 }
function op_nothing() { <- 2 }
function op_default() { <- 3 }
function op_true() { <- 4 }
function op_false() { <- 5 }

function op_pop() { <- 16 }
function op_dup() { <- 17 }
function op_swap() { <- 18 }

function op_load_local() { <- 32 }
function op_store_local() { <- 33 }
function op_load_global() { <- 34 }
function op_store_global() { <- 35 }

function op_add() { <- 48 }
function op_sub() { <- 49 }
function op_mul() { <- 50 }
function op_div() { <- 51 }
function op_mod() { <- 52 }
function op_neg() { <- 53 }
function op_not() { <- 54 }
function op_bit_not() { <- 55 }
function op_bit_and() { <- 56 }
function op_bit_or() { <- 57 }
function op_bit_xor() { <- 58 }
function op_shl() { <- 59 }
function op_shr() { <- 60 }

function op_eq() { <- 64 }
function op_neq() { <- 65 }
function op_lt() { <- 66 }
function op_lte() { <- 67 }
function op_gt() { <- 68 }
function op_gte() { <- 69 }

function op_make_list() { <- 80 }
function op_make_map() { <- 81 }
function op_get_index() { <- 82 }
function op_set_index_op() { <- 83 }
function op_get_prop() { <- 84 }
function op_set_prop_op() { <- 85 }

function op_jump() { <- 96 }
function op_jump_if_false() { <- 97 }
function op_jump_if_true() { <- 98 }
function op_pop_jump_if_false() { <- 99 }

function op_call() { <- 112 }
function op_return() { <- 113 }
function op_halt() { <- 255 }

function set_index(obj, key, val) {
    when obj is List {
        let kidx -> parse_int_str(key)
        when kidx < 0 {
            kidx -> kidx + obj.length
        }
        when kidx >= 0 and kidx < obj.length {
            obj[kidx] -> val
        }
        <- val
    }
    obj[key] -> val
    <- val
}

function vm_slice(obj, s, e, stp) {
    let step_val -> 1
    when stp != Nothing {
        when (stp is Integer) { step_val -> 0 + stp } or { step_val -> parse_int_str(stp) }
    }
    when step_val == 0 {
        when (obj is String) { <- `` }
        <- []
    }
    when (obj is String) {
        let len -> Str.length(obj)
        let s_idx -> 0
        let e_idx -> 0 + len
        when step_val > 0 {
            when s != Nothing {
                when (s is Integer) { s_idx -> 0 + s } or { s_idx -> parse_int_str(s) }
                when s_idx < 0 { s_idx -> s_idx + len }
                when s_idx < 0 { s_idx -> 0 }
                when s_idx > len { s_idx -> 0 + len }
            }
            when e != Nothing {
                when (e is Integer) { e_idx -> 0 + e } or { e_idx -> parse_int_str(e) }
                when e_idx < 0 { e_idx -> e_idx + len }
                when e_idx < 0 { e_idx -> 0 }
                when e_idx > len { e_idx -> 0 + len }
            }
            let res -> ``
            let cur -> 0 + s_idx
            do while cur < e_idx {
                res -> res + Str.at(obj, cur)
                cur -> cur + step_val
            }
            <- res
        } or {
            s_idx -> len - 1
            e_idx -> -1
            when s != Nothing {
                when (s is Integer) { s_idx -> 0 + s } or { s_idx -> parse_int_str(s) }
                when s_idx < 0 { s_idx -> s_idx + len }
                when s_idx >= len { s_idx -> len - 1 }
                when s_idx < -1 { s_idx -> -1 }
            }
            when e != Nothing {
                when (e is Integer) { e_idx -> 0 + e } or { e_idx -> parse_int_str(e) }
                when e_idx < 0 { e_idx -> e_idx + len }
                when e_idx >= len { e_idx -> len - 1 }
                when e_idx < -1 { e_idx -> -1 }
            }
            let res -> ``
            let cur -> 0 + s_idx
            do while cur > e_idx {
                res -> res + Str.at(obj, cur)
                cur -> cur + step_val
            }
            <- res
        }
    }
    when (obj is List) {
        let len -> obj.length
        let s_idx -> 0
        let e_idx -> 0 + len
        when step_val > 0 {
            when s != Nothing {
                when (s is Integer) { s_idx -> 0 + s } or { s_idx -> parse_int_str(s) }
                when s_idx < 0 { s_idx -> s_idx + len }
                when s_idx < 0 { s_idx -> 0 }
                when s_idx > len { s_idx -> 0 + len }
            }
            when e != Nothing {
                when (e is Integer) { e_idx -> 0 + e } or { e_idx -> parse_int_str(e) }
                when e_idx < 0 { e_idx -> e_idx + len }
                when e_idx < 0 { e_idx -> 0 }
                when e_idx > len { e_idx -> 0 + len }
            }
            let res -> []
            let cur -> 0 + s_idx
            do while cur < e_idx {
                res.append(obj[cur])
                cur -> cur + step_val
            }
            <- res
        } or {
            s_idx -> len - 1
            e_idx -> -1
            when s != Nothing {
                when (s is Integer) { s_idx -> 0 + s } or { s_idx -> parse_int_str(s) }
                when s_idx < 0 { s_idx -> s_idx + len }
                when s_idx >= len { s_idx -> len - 1 }
                when s_idx < -1 { s_idx -> -1 }
            }
            when e != Nothing {
                when (e is Integer) { e_idx -> 0 + e } or { e_idx -> parse_int_str(e) }
                when e_idx < 0 { e_idx -> e_idx + len }
                when e_idx >= len { e_idx -> len - 1 }
                when e_idx < -1 { e_idx -> -1 }
            }
            let res -> []
            let cur -> 0 + s_idx
            do while cur > e_idx {
                res.append(obj[cur])
                cur -> cur + step_val
            }
            <- res
        }
    }
    <- Nothing
}

function vm_list_append(l, item) {
    let arr -> []
    arr -> l
    arr.append(item)
    <- arr
}
function vm_list_pop(l) {
    let arr -> []
    arr -> l
    <- arr.pop()
}
function vm_map_has(m, key) {
    let map_obj -> {}
    map_obj -> m
    when map_obj == Nothing { <- false }
    <- map_obj[key] != Nothing
}
function vm_map_keys(m) {
    let map_obj -> {}
    map_obj -> m
    <- map_obj.keys()
}
function vm_map_values(m) {
    let map_obj -> {}
    map_obj -> m
    <- map_obj.values()
}

// --- Chunk Constructor & Helpers ---

function strip_underscores(s) {
    let s_str -> Str.to_string(s)
    when Str.index_of(s_str, `_`) == -1 {
        <- s_str
    }
    let n -> Str.length(s_str)
    let res -> ``
    let i -> 0
    do while i < n {
        let ch -> Str.at(s_str, i)
        when ch != `_` {
            res -> res + ch
        }
        i -> i + 1
    }
    <- res
}

function looks_int_str(s) {
    let s_str -> Str.to_string(s)
    let n -> Str.length(s_str)
    when n == 0 {
        <- false
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `x` or Str.at(s_str, 1) == `X`) {
        let hex_digits -> `0123456789abcdefABCDEF`
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` and Str.index_of(hex_digits, ch) == -1 {
                <- false
            }
            i -> i + 1
        }
        <- true
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `b` or Str.at(s_str, 1) == `B`) {
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` and ch != `0` and ch != `1` {
                <- false
            }
            i -> i + 1
        }
        <- true
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `o` or Str.at(s_str, 1) == `O`) {
        let oct_digits -> `01234567`
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` and Str.index_of(oct_digits, ch) == -1 {
                <- false
            }
            i -> i + 1
        }
        <- true
    }
    let digits -> `0123456789`
    let i -> 0
    when Str.at(s_str, 0) == `-` {
        when n == 1 {
            <- false
        }
        i -> 1
    }
    do while i < n {
        let ch -> Str.at(s_str, i)
        when ch != `_` and Str.index_of(digits, ch) == -1 {
            <- false
        }
        i -> i + 1
    }
    <- true
}

function parse_int_str(s) {
    when s == Nothing {
        <- 0
    }
    when s is Integer {
        <- s
    }
    let s_str -> Str.to_string(s)
    let n -> Str.length(s_str)
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `x` or Str.at(s_str, 1) == `X`) {
        let hex_digits -> `0123456789abcdef`
        let hex_lower -> Str.to_lower(s_str)
        let acc -> 0
        let i -> 2
        do while i < n {
            let ch -> Str.at(hex_lower, i)
            when ch != `_` {
                let d -> Str.index_of(hex_digits, ch)
                when d != -1 {
                    acc -> (acc * 16) + d
                }
            }
            i -> i + 1
        }
        <- acc
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `b` or Str.at(s_str, 1) == `B`) {
        let acc -> 0
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch == `1` {
                acc -> (acc * 2) + 1
            } or when ch == `0` {
                acc -> acc * 2
            }
            i -> i + 1
        }
        <- acc
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `o` or Str.at(s_str, 1) == `O`) {
        let oct_digits -> `01234567`
        let acc -> 0
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` {
                let d -> Str.index_of(oct_digits, ch)
                when d != -1 {
                    acc -> (acc * 8) + d
                }
            }
            i -> i + 1
        }
        <- acc
    }
    let dot -> Str.index_of(s_str, `.`)
    when dot != -1 {
        s_str -> Str.substring(s_str, 0, dot)
        n -> Str.length(s_str)
    }
    when n == 0 {
        <- 0
    }
    let i -> 0
    let neg -> false
    when Str.at(s_str, 0) == `-` {
        neg -> true
        i -> 1
    }
    let acc -> 0
    let digits -> `0123456789`
    do while i < n {
        let ch -> Str.at(s_str, i)
        when ch != `_` {
            let d -> Str.index_of(digits, ch)
            when d != -1 {
                acc -> acc * 10 + d
            }
        }
        i -> i + 1
    }
    when neg {
        <- 0 - acc
    }
    <- acc
}

function int_to_u8(n) {
    when n is Integer {
        let v -> n % 256
        when v < 0 { <- v + 256 }
        <- v
    }
    let v -> parse_int_str(n) % 256
    when v < 0 { <- v + 256 }
    <- v
}

function make_chunk(name) {
    <- {
        `code` -> [],
        `constants` -> [],
        `lines` -> [],
        `num_locals` -> 0,
        `name` -> name
    }
}

function emit_byte(ctx, byte, line) {
    let c -> ctx[`chunk`]
    let b -> int_to_u8(byte)
    c[`code`].append(b)
    c[`lines`].append(line)
}

function emit_u16(ctx, val, line) {
    let u -> 0
    when (val is Integer) {
        u -> val
    } or {
        u -> parse_int_str(val)
    }
    let lo -> u % 256
    let hi -> (u - lo) / 256
    emit_byte(ctx, hi, line)
    emit_byte(ctx, lo, line)
}

function emit_i16(ctx, val, line) {
    let u -> val
    when u < 0 {
        u -> 65536 + u
    }
    emit_u16(ctx, u, line)
}

function add_constant(ctx, val) {
    let c -> ctx[`chunk`]
    let consts -> c[`constants`]
    let n -> consts.length
    let i -> 0
    do while i < n {
        when consts[i] == val {
            <- i
        }
        i -> i + 1
    }
    consts.append(val)
    <- n
}

function emit_constant(ctx, val, line) {
    let idx -> add_constant(ctx, val)
    emit_byte(ctx, 1, line) // OP_CONST
    emit_u16(ctx, idx, line)
}

function emit_jump(ctx, op, line) {
    emit_byte(ctx, op, line)
    let c -> ctx[`chunk`]
    let offset -> c[`code`].length
    emit_i16(ctx, 0, line)
    <- offset
}

function patch_jump(ctx, offset) {
    let c -> ctx[`chunk`]
    let code -> c[`code`]
    let jump -> code.length - (offset + 2)
    let u -> 0
    when (jump is Integer) {
        u -> jump
    } or {
        u -> parse_int_str(jump)
    }
    when u < 0 {
        u -> 65536 + u
    }
    let lo -> u % 256
    let hi -> (u - lo) / 256
    code[offset] -> int_to_u8(hi)
    code[offset + 1] -> int_to_u8(lo)
}

function patch_jump_target(ctx, offset, target_ip) {
    let c -> ctx[`chunk`]
    let code -> c[`code`]
    let jump -> target_ip - (offset + 2)
    let u -> 0
    when (jump is Integer) {
        u -> jump
    } or {
        u -> parse_int_str(jump)
    }
    when u < 0 {
        u -> 65536 + u
    }
    let lo -> u % 256
    let hi -> (u - lo) / 256
    code[offset] -> int_to_u8(hi)
    code[offset + 1] -> int_to_u8(lo)
}

// --- Scope & Locals ---

function make_compiler(name) {
    <- {
        `chunk` -> make_chunk(name),
        `locals` -> [],
        `captures` -> [],
        `parent` -> Nothing,
        `scope_depth` -> 0,
        `max_locals` -> 0,
        `functions` -> {},
        `variables` -> {},
        `errors` -> [],
        `breaks` -> [],
        `continues` -> []
    }
}

function make_compiler_child(name, parent_ctx) {
    <- {
        `chunk` -> make_chunk(name),
        `locals` -> [],
        `captures` -> [],
        `parent` -> parent_ctx,
        `scope_depth` -> 0,
        `max_locals` -> 0,
        `functions` -> {},
        `variables` -> parent_ctx[`variables`],
        `errors` -> [],
        `breaks` -> [],
        `continues` -> []
    }
}

function enter_scope(ctx) {
    ctx[`scope_depth`] -> ctx[`scope_depth`] + 1
}

function exit_scope(ctx, line) {
    ctx[`scope_depth`] -> ctx[`scope_depth`] - 1
    let locals -> ctx[`locals`]
    let cur_depth -> ctx[`scope_depth`]
    do while locals.length > 0 {
        let last -> locals[locals.length - 1]
        when last[`depth`] > cur_depth {
            locals.pop()
        } or {
            break
        }
    }
}

function resolve_local(ctx, name) {
    let locals -> ctx[`locals`]
    let s_name -> Str.to_string(name)
    let i -> locals.length - 1
    do while i >= 0 {
        let loc -> locals[i]
        when Str.to_string(loc[`name`]) == s_name {
            <- loc[`slot`]
        }
        i -> i - 1
    }
    <- -1
}

function resolve_or_capture_local(ctx, name) {
    let slot -> resolve_local(ctx, name)
    when slot >= 0 {
        <- { `type` -> `local`, `index` -> slot }
    }
    when ctx[`parent`] != Nothing {
        let p_slot -> resolve_local(ctx[`parent`], name)
        when p_slot >= 0 {
            let caps -> ctx[`captures`]
            let ci -> 0
            let s_name -> Str.to_string(name)
            do while ci < caps.length {
                when Str.to_string(caps[ci][`name`]) == s_name {
                    <- { `type` -> `capture`, `index` -> ci }
                }
                ci -> ci + 1
            }
            let new_idx -> caps.length
            caps.append({ `name` -> s_name, `parent_slot` -> p_slot })
            <- { `type` -> `capture`, `index` -> new_idx }
        }
    }
    <- Nothing
}

function declare_local(ctx, name) {
    let locals -> ctx[`locals`]
    let slot -> locals.length
    let s_name -> Str.to_string(name)
    locals.append({
        `name` -> s_name,
        `depth` -> ctx[`scope_depth`],
        `slot` -> slot
    })
    when locals.length > ctx[`max_locals`] {
        ctx[`max_locals`] -> locals.length
    }
    <- slot
}

// --- AST Bytecode Compilation ---

export function compile_program(prog) {
    let ctx -> make_compiler(`<main>`)
    let stmts -> AST.flatten_stmts(AST.prog_stmts(prog))
    let n -> stmts.length
    let has_main -> false
    let main_takes_args -> false
    let i -> 0
    do while i < n {
        let s -> stmts[i]
        when s != Nothing and (AST.is_function(s) or s[0] == 21) and Str.to_string(AST.fn_name(s)) == `main` {
            has_main -> true
            let params -> AST.fn_params(s)
            when params != Nothing and params.length > 0 {
                main_takes_args -> true
            }
        }
        compile_statement(ctx, stmts[i])
        i -> i + 1
    }
    when has_main == true {
        let m_idx -> add_constant(ctx, `main`)
        emit_byte(ctx, 34, 0) // OP_LOAD_GLOBAL
        emit_u16(ctx, m_idx, 0)
        when main_takes_args == true {
            let a_idx -> add_constant(ctx, `args`)
            emit_byte(ctx, 34, 0) // OP_LOAD_GLOBAL args
            emit_u16(ctx, a_idx, 0)
            emit_byte(ctx, 112, 0) // OP_CALL
            emit_u16(ctx, 1, 0)   // 1 arg
        } or {
            emit_byte(ctx, 112, 0) // OP_CALL
            emit_u16(ctx, 0, 0)   // 0 args
        }
    } or {
        emit_byte(ctx, 2, 0)  // OP_NOTHING
    }
    emit_byte(ctx, 113, 0) // OP_RETURN
    let ch -> ctx[`chunk`]
    ch[`num_locals`] -> ctx[`max_locals`]
    <- {
        `ok` -> ctx[`errors`].length == 0,
        `chunk` -> ch,
        `errors` -> ctx[`errors`]
    }
}

function is_default_literal(expr) {
    when expr == Nothing { <- false }
    when expr == Default { <- true }
    when not (expr is List) or expr.length < 4 { <- false }
    let k -> expr[0]
    when k == 2 { // K_LITERAL
        let v -> expr[3]
        when v == Default { <- true }
        let tk -> ``
        when expr.length > 4 and expr[4] != Nothing { tk -> expr[4] }
        let tks -> Str.to_string(tk)
        when tk == 20 or tks == `20` or tks == `DEFAULT` { <- true }
        let vs -> Str.to_string(v)
        when vs == `Default` or vs == `default` { <- true }
    }
    when k == 4 or k == 30 { // K_VARIABLE or K_IDENTIFIER
        let vs -> Str.to_string(expr[3])
        when vs == `Default` or vs == `default` { <- true }
    }
    <- false
}

function emit_zero_of_type(ctx, type_ann, line) {
    let n -> ``
    when type_ann != Nothing and (type_ann is List) and type_ann.length > 3 {
        n -> Str.to_string(type_ann[3])
    } or {
        n -> Str.to_string(type_ann)
    }
    when n == `Integer` or n == `Int` or n == `int` {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 3, line)  // ZEN_INTEGER
    } or when n == `Decimal` or n == `Float` {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 4, line)  // ZEN_DECIMAL
    } or when n == `Boolean` or n == `Bool` {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 2, line)  // ZEN_BOOLEAN
    } or when n == `String` or n == `Str` or n == `Rune` or n == `Char` {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 5, line)  // ZEN_STRING
    } or when n == `List` {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 6, line)  // ZEN_LIST
    } or when n == `Map` {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 7, line)  // ZEN_MAP
    } or {
        emit_byte(ctx, 3, line) // OP_DEFAULT
        emit_u16(ctx, 1, line)  // ZEN_DEFAULT
    }
}

function compile_statement(ctx, stmt) {
    let kind -> stmt[0]
    let line -> stmt[1]

    when kind == 19 { // K_LET
        let name -> stmt[3]
        when name != Nothing and (name is List) and name.length > 3 and name[0] == 45 { // K_TYPE_ANN
            name -> name[3]
        }
        name -> Str.to_string(name)
        let init -> stmt[4]
        let type_ann -> Nothing
        when stmt.length > 5 {
            type_ann -> stmt[5]
        }
        when init != Nothing {
            when is_default_literal(init) and type_ann != Nothing {
                emit_zero_of_type(ctx, type_ann, line)
            } or {
                compile_expression(ctx, init)
            }
        } or {
            emit_byte(ctx, 2, line) // OP_NOTHING
        }
        when ctx[`scope_depth`] == 0 {
            when ctx[`variables`] != Nothing {
                ctx[`variables`][name] -> true
            }
            let name_idx -> add_constant(ctx, name)
            emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
            emit_u16(ctx, name_idx, line)
        } or {
            let slot -> declare_local(ctx, name)
            emit_byte(ctx, 33, line) // OP_STORE_LOCAL
            emit_u16(ctx, slot, line)
        }
        <- Nothing
    }

    when kind == 9 { // K_ASSIGN
        let tgt -> stmt[3]
        when (tgt != Nothing) and (tgt is List) and tgt.length > 3 and tgt[0] == 45 { // K_TYPE_ANN
            tgt -> tgt[3]
        }
        when (tgt != Nothing) and (tgt is List) and tgt.length > 3 and (tgt[0] == 4 or tgt[0] == 30) { // K_VARIABLE or K_IDENTIFIER
            tgt -> tgt[3]
        }
        when (tgt != Nothing) and (tgt is List) and tgt.length > 4 and (tgt[0] == 8 or tgt[0] == 5) { // K_INDEX: obj[key] -> val
            compile_expression(ctx, tgt[3]) // obj
            compile_expression(ctx, tgt[4]) // key
            compile_expression(ctx, stmt[4])   // val
            emit_byte(ctx, 83, line)           // OP_SET_INDEX
            emit_byte(ctx, 16, line)           // OP_POP
            <- Nothing
        }
        when (tgt != Nothing) and (tgt is List) and tgt.length > 4 and tgt[0] == 6 { // K_GET: obj.prop -> val
            compile_expression(ctx, tgt[3]) // obj
            let prop_name -> Str.to_string(tgt[4])
            let name_idx -> add_constant(ctx, prop_name)
            emit_byte(ctx, 1, line)            // OP_CONST
            emit_u16(ctx, name_idx, line)
            compile_expression(ctx, stmt[4])   // val
            emit_byte(ctx, 83, line)           // OP_SET_INDEX
            emit_byte(ctx, 16, line)           // OP_POP
            <- Nothing
        }
        let name -> Str.to_string(tgt)
        let val -> stmt[4]
        compile_expression(ctx, val)
        let resolved -> resolve_or_capture_local(ctx, name)
        when resolved != Nothing {
            when resolved[`type`] == `local` {
                emit_byte(ctx, 33, line) // OP_STORE_LOCAL
                emit_u16(ctx, resolved[`index`], line)
            } or when resolved[`type`] == `capture` {
                emit_byte(ctx, 39, line) // OP_STORE_CAPTURE
                emit_u16(ctx, resolved[`index`], line)
            }
        } or {
            let name_idx -> add_constant(ctx, name)
            emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
            emit_u16(ctx, name_idx, line)
        }
        <- Nothing
    }

    when kind == 44 { // K_INDEX_ASSIGN: obj[key] -> val
        compile_expression(ctx, stmt[3]) // obj
        compile_expression(ctx, stmt[4]) // key
        compile_expression(ctx, stmt[5]) // val
        emit_byte(ctx, 83, line)         // OP_SET_INDEX
        emit_byte(ctx, 16, line)         // OP_POP
        <- Nothing
    }

    when kind == 22 { // K_RETURN
        let val -> stmt[3]
        when val != Nothing {
            compile_expression(ctx, val)
        } or {
            emit_byte(ctx, 2, line) // OP_NOTHING
        }
        emit_byte(ctx, 113, line) // OP_RETURN
        <- Nothing
    }

    when kind == 18 { // K_EXPR_STMT
        let inner -> stmt[3]
        when inner != Nothing and (inner is List) and inner.length > 3 and (inner[0] == 2 or inner[0] == 4) { // K_LITERAL or K_VARIABLE
            let lval -> inner[3]
            when lval == `break` and ctx[`breaks`] != Nothing {
                let bj -> emit_jump(ctx, 96, line) // OP_JUMP
                ctx[`breaks`].append(bj)
                <- Nothing
            }
            when lval == `continue` and ctx[`continues`] != Nothing {
                let cj -> emit_jump(ctx, 96, line) // OP_JUMP
                ctx[`continues`].append(cj)
                <- Nothing
            }
        }
        compile_expression(ctx, stmt[3])
        emit_byte(ctx, 16, line) // OP_POP
        <- Nothing
    }

    when kind == 23 { // K_WHEN
        let cases -> stmt[3]
        let cn -> cases.length
        let ci -> 0
        let end_jumps -> []

        do while ci < cn {
            let c -> cases[ci]
            let cond -> c[3]
            let body -> c[4]
            
            let is_pat -> cond != Nothing and (cond is List) and cond.length > 4 and cond[0] == 38 and
                          cond[4] != Nothing and (cond[4] is List) and cond[4].length > 3 and
                          (cond[4][0] == 11 or cond[4][0] == 12 or cond[4][0] == 13 or cond[4][0] == 5)
            when is_pat {
                let val_expr -> cond[3]
                let pat_expr -> cond[4]
                enter_scope(ctx)
                compile_expression(ctx, val_expr)
                let val_slot -> declare_local(ctx, `__pat_subj_` + Str.to_string(line))
                emit_byte(ctx, 33, line) // OP_STORE_LOCAL
                emit_u16(ctx, val_slot, line)
                compile_pattern_case(ctx, val_slot, pat_expr, body, Nothing, end_jumps, line)
                exit_scope(ctx, line)
            } or when cond == Nothing or cond == `else` {
                // Else fallback branch
                enter_scope(ctx)
                compile_block(ctx, body)
                exit_scope(ctx, line)
            } or {
                compile_expression(ctx, cond)
                let jump_false -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
                enter_scope(ctx)
                compile_block(ctx, body)
                exit_scope(ctx, line)
                
                when ci < cn - 1 {
                    let j_end -> emit_jump(ctx, 96, line) // OP_JUMP
                    end_jumps.append(j_end)
                }
                patch_jump(ctx, jump_false)
            }
            ci -> ci + 1
        }

        let ji -> 0
        let jn -> end_jumps.length
        do while ji < jn {
            patch_jump(ctx, end_jumps[ji])
            ji -> ji + 1
        }
        <- Nothing
    }

    when kind == 24 { // K_CHECK_STMT
        let expr_node -> stmt[3]
        let cases -> stmt[4]
        let or_block -> stmt[5]
        let raise_expr -> stmt[6]
        
        enter_scope(ctx)
        compile_expression(ctx, expr_node)
        let val_slot -> declare_local(ctx, `__check_subj_` + Str.to_string(line))
        emit_byte(ctx, 33, line) // OP_STORE_LOCAL
        emit_u16(ctx, val_slot, line)
        
        let end_jumps -> []
        let ci -> 0
        let cn -> 0
        when cases != Nothing { cn -> cases.length }
        do while ci < cn {
            let c -> cases[ci]
            let pat -> c[3]
            let body -> c[4]
            let guard -> Nothing
            when c.length > 5 { guard -> c[5] }
            compile_pattern_case(ctx, val_slot, pat, body, guard, end_jumps, line)
            ci -> ci + 1
        }
        
        when cn == 0 and (or_block != Nothing or raise_expr != Nothing) {
            emit_byte(ctx, 32, line) // OP_LOAD_LOCAL val_slot
            emit_u16(ctx, val_slot, line)
            let err_idx -> add_constant(ctx, `Error`)
            emit_byte(ctx, 85, line) // OP_IS_TYPE Error
            emit_u16(ctx, err_idx, line)
            let j_not_err -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
            when or_block != Nothing {
                compile_block(ctx, or_block)
            }
            when raise_expr != Nothing {
                compile_expression(ctx, raise_expr)
                emit_byte(ctx, 94, line) // OP_RAISE
            }
            patch_jump(ctx, j_not_err)
        } or when or_block != Nothing or raise_expr != Nothing {
            when or_block != Nothing {
                compile_block(ctx, or_block)
            }
            when raise_expr != Nothing {
                compile_expression(ctx, raise_expr)
                emit_byte(ctx, 94, line) // OP_RAISE
            }
        }
        
        let ji -> 0
        let jn -> end_jumps.length
        do while ji < jn {
            patch_jump(ctx, end_jumps[ji])
            ji -> ji + 1
        }
        exit_scope(ctx, line)
        <- Nothing
    }

    when kind == 25 { // K_WHILE (while cond { body } or do while cond { body })
        let loop_start -> ctx[`chunk`][`code`].length
        let cond -> stmt[3]
        let body -> stmt[4]
        
        let old_breaks -> ctx[`breaks`]
        let old_conts -> ctx[`continues`]
        let my_breaks -> []
        let my_conts -> []
        ctx[`breaks`] -> my_breaks
        ctx[`continues`] -> my_conts

        compile_expression(ctx, cond)
        let exit_jump -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
        enter_scope(ctx)
        compile_block(ctx, body)
        exit_scope(ctx, line)
        
        let ci -> 0
        do while ci < my_conts.length {
            patch_jump_target(ctx, my_conts[ci], loop_start)
            ci -> ci + 1
        }

        // Loop back
        emit_byte(ctx, 96, line) // OP_JUMP
        let back_jump -> loop_start - (ctx[`chunk`][`code`].length + 2)
        emit_i16(ctx, back_jump, line)
        patch_jump(ctx, exit_jump)

        let bi -> 0
        do while bi < my_breaks.length {
            patch_jump(ctx, my_breaks[bi])
            bi -> bi + 1
        }
        ctx[`breaks`] -> old_breaks
        ctx[`continues`] -> old_conts
        <- Nothing
    }

    when kind == 26 { // K_DO_WHILE
        let body -> stmt[3]
        let cond -> stmt[4]
        let test_first -> true
        when stmt.length > 5 and stmt[5] != Nothing {
            test_first -> stmt[5]
        }
        
        when test_first == true {
            let loop_start -> ctx[`chunk`][`code`].length
            let old_breaks -> ctx[`breaks`]
            let old_conts -> ctx[`continues`]
            let my_breaks -> []
            let my_conts -> []
            ctx[`breaks`] -> my_breaks
            ctx[`continues`] -> my_conts

            compile_expression(ctx, cond)
            let exit_jump -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE

            enter_scope(ctx)
            compile_block(ctx, body)
            exit_scope(ctx, line)

            let cont_target -> ctx[`chunk`][`code`].length
            let ci -> 0
            do while ci < my_conts.length {
                patch_jump_target(ctx, my_conts[ci], cont_target)
                ci -> ci + 1
            }

            emit_byte(ctx, 96, line) // OP_JUMP
            let back_jump -> loop_start - (ctx[`chunk`][`code`].length + 2)
            emit_i16(ctx, back_jump, line)
            patch_jump(ctx, exit_jump)

            let bi -> 0
            do while bi < my_breaks.length {
                patch_jump(ctx, my_breaks[bi])
                bi -> bi + 1
            }
            ctx[`breaks`] -> old_breaks
            ctx[`continues`] -> old_conts
            <- Nothing
        } or {
            let loop_start -> ctx[`chunk`][`code`].length
            let old_breaks -> ctx[`breaks`]
            let old_conts -> ctx[`continues`]
            let my_breaks -> []
            let my_conts -> []
            ctx[`breaks`] -> my_breaks
            ctx[`continues`] -> my_conts

            enter_scope(ctx)
            compile_block(ctx, body)
            exit_scope(ctx, line)

            let cont_target -> ctx[`chunk`][`code`].length
            let ci -> 0
            do while ci < my_conts.length {
                patch_jump_target(ctx, my_conts[ci], cont_target)
                ci -> ci + 1
            }

            compile_expression(ctx, cond)
            // If cond is true, loop back to loop_start
            emit_byte(ctx, 100, line) // OP_POP_JUMP_IF_TRUE
            let back_jump -> loop_start - (ctx[`chunk`][`code`].length + 2)
            emit_i16(ctx, back_jump, line)

            let bi -> 0
            do while bi < my_breaks.length {
                patch_jump(ctx, my_breaks[bi])
                bi -> bi + 1
            }
            ctx[`breaks`] -> old_breaks
            ctx[`continues`] -> old_conts
            <- Nothing
        }
    }

    when kind == 28 { // K_ASSERT (! cond)
        let cond -> stmt[3]
        compile_expression(ctx, cond)
        let pass_jump -> emit_jump(ctx, 100, line) // OP_POP_JUMP_IF_TRUE
        // Assert failed: halt with error
        emit_byte(ctx, 255, line) // OP_HALT
        patch_jump(ctx, pass_jump)
        <- Nothing
    }

    when kind == 31 { // K_CASE (is pattern arm)
        let cond -> stmt[3]
        let body -> stmt[4]
        when cond == Nothing or cond == `else` {
            enter_scope(ctx)
            compile_block(ctx, body)
            exit_scope(ctx, line)
        } or {
            compile_expression(ctx, cond)
            let skip_jump -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
            enter_scope(ctx)
            compile_block(ctx, body)
            exit_scope(ctx, line)
            patch_jump(ctx, skip_jump)
        }
        <- Nothing
    }

    when kind == 27 { // K_FOR (do for item in collection { body })
        let raw_var -> stmt[3]
        let var_name -> ``
        when raw_var != Nothing and (raw_var is List) and raw_var.length > 3 {
            var_name -> Str.to_string(raw_var[3])
        } or when raw_var != Nothing {
            var_name -> Str.to_string(raw_var)
        }
        let iter_expr -> stmt[4]
        let body -> stmt[5]
        
        let old_breaks -> ctx[`breaks`]
        let old_conts -> ctx[`continues`]
        let my_breaks -> []
        let my_conts -> []
        ctx[`breaks`] -> my_breaks
        ctx[`continues`] -> my_conts

        // Evaluate collection expression and store in hidden local
        compile_expression(ctx, iter_expr)
        enter_scope(ctx)
        let iter_slot -> declare_local(ctx, `__iter_obj_` + Str.to_string(line))
        emit_byte(ctx, 33, line) // OP_STORE_LOCAL
        emit_u16(ctx, iter_slot, line)
        
        // Declare hidden index counter = 0
        let zero_idx -> add_constant(ctx, 0)
        emit_byte(ctx, 1, line) // OP_CONST
        emit_u16(ctx, zero_idx, line)
        let idx_slot -> declare_local(ctx, `__iter_idx_` + Str.to_string(line))
        emit_byte(ctx, 33, line) // OP_STORE_LOCAL
        emit_u16(ctx, idx_slot, line)
        
        let loop_start -> ctx[`chunk`][`code`].length
        
        // Condition: idx < iter_obj.length
        emit_byte(ctx, 32, line) // OP_LOAD_LOCAL idx
        emit_u16(ctx, idx_slot, line)
        emit_byte(ctx, 32, line) // OP_LOAD_LOCAL iter_obj
        emit_u16(ctx, iter_slot, line)
        let len_prop_idx -> add_constant(ctx, `length`)
        emit_byte(ctx, 84, line) // OP_GET_PROP .length
        emit_u16(ctx, len_prop_idx, line)
        emit_byte(ctx, 66, line) // OP_LT
        
        let exit_jump -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
        
        // Loop Body: var_name = iter_obj[idx]
        enter_scope(ctx)
        emit_byte(ctx, 32, line) // OP_LOAD_LOCAL iter_obj
        emit_u16(ctx, iter_slot, line)
        emit_byte(ctx, 32, line) // OP_LOAD_LOCAL idx
        emit_u16(ctx, idx_slot, line)
        emit_byte(ctx, 82, line) // OP_GET_INDEX
        let var_slot -> declare_local(ctx, var_name)
        emit_byte(ctx, 33, line) // OP_STORE_LOCAL
        emit_u16(ctx, var_slot, line)
        
        compile_block(ctx, body)
        exit_scope(ctx, line)
        
        let cont_target -> ctx[`chunk`][`code`].length
        let ci -> 0
        do while ci < my_conts.length {
            patch_jump_target(ctx, my_conts[ci], cont_target)
            ci -> ci + 1
        }

        // Increment idx: idx = idx + 1
        emit_byte(ctx, 32, line) // OP_LOAD_LOCAL idx
        emit_u16(ctx, idx_slot, line)
        let one_idx -> add_constant(ctx, 1)
        emit_byte(ctx, 1, line) // OP_CONST
        emit_u16(ctx, one_idx, line)
        emit_byte(ctx, 48, line) // OP_ADD
        emit_byte(ctx, 33, line) // OP_STORE_LOCAL idx
        emit_u16(ctx, idx_slot, line)
        
        // Loop back
        emit_byte(ctx, 96, line) // OP_JUMP
        let back_jump -> loop_start - (ctx[`chunk`][`code`].length + 2)
        emit_i16(ctx, back_jump, line)
        patch_jump(ctx, exit_jump)

        let bi -> 0
        do while bi < my_breaks.length {
            patch_jump(ctx, my_breaks[bi])
            bi -> bi + 1
        }
        ctx[`breaks`] -> old_breaks
        ctx[`continues`] -> old_conts
        exit_scope(ctx, line)
        <- Nothing
    }

    when kind == 21 { // K_FUNCTION
        let fn_name -> stmt[3]
        let fn_params -> stmt[4]
        let fn_body -> stmt[5]
        
        let fn_ctx -> make_compiler(fn_name)
        enter_scope(fn_ctx)
        
        // Bind parameters as locals
        let pi -> 0
        let pn -> fn_params.length
        do while pi < pn {
            let p -> fn_params[pi]
            when p != Nothing and p.length > 3 and p[0] == 30 { // K_PARAM
                declare_local(fn_ctx, p[3])
            } or {
                declare_local(fn_ctx, p)
            }
            pi -> pi + 1
        }
        
        compile_block(fn_ctx, fn_body)
        emit_byte(fn_ctx, 2, line) // OP_NOTHING
        emit_byte(fn_ctx, 113, line) // OP_RETURN
        
        let fn_chunk -> fn_ctx[`chunk`]
        fn_chunk[`num_locals`] -> fn_ctx[`max_locals`]
        
        // Store compiled function chunk in constants and global
        let const_idx -> add_constant(ctx, fn_chunk)
        emit_byte(ctx, 1, line) // OP_CONST
        emit_u16(ctx, const_idx, line)
        let gname_idx -> add_constant(ctx, fn_name)
        emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
        emit_u16(ctx, gname_idx, line)
        <- Nothing
    }

    when kind == 32 { // K_STRUCTURE
        let s_name -> stmt[3]
        let s_members -> stmt[4]
        
        let fn_ctx -> make_compiler(s_name)
        enter_scope(fn_ctx)
        
        // Members become constructor parameters
        let mi -> 0
        let mn -> 0
        when s_members != Nothing {
            mn -> s_members.length
        }
        let entries -> []
        entries.append([14, line, 0, [2, line, 0, `__type__`], [2, line, 0, s_name]])
        
        do while mi < mn {
            let m -> s_members[mi]
            let mname -> ``
            when m != Nothing and m.length > 3 {
                mname -> Str.to_string(m[3])
            } or when m != Nothing {
                mname -> Str.to_string(m)
            }
            when mname != `` {
                declare_local(fn_ctx, mname)
                entries.append([14, line, 0, [2, line, 0, mname], [4, line, 0, mname]])
            }
            mi -> mi + 1
        }
        
        let map_node -> [12, line, 0, entries] // K_MAP
        compile_expression(fn_ctx, map_node)
        emit_byte(fn_ctx, 113, line) // OP_RETURN
        
        let fn_chunk -> fn_ctx[`chunk`]
        fn_chunk[`num_locals`] -> fn_ctx[`max_locals`]
        
        let const_idx -> add_constant(ctx, fn_chunk)
        emit_byte(ctx, 1, line) // OP_CONST
        emit_u16(ctx, const_idx, line)
        let gname_idx -> add_constant(ctx, s_name)
        emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
        emit_u16(ctx, gname_idx, line)
        <- Nothing
    }

    when kind == 35 { // K_ENUMERATOR
        let e_name -> Str.to_string(stmt[3])
        let e_members -> stmt[4]
        let entries -> []
        let mi -> 0
        let mn -> 0
        when e_members != Nothing {
            mn -> e_members.length
        }
        do while mi < mn {
            let m -> e_members[mi]
            let m_name -> ``
            let m_val -> Nothing
            when m != Nothing and m.length > 3 {
                m_name -> Str.to_string(m[3])
                when m.length > 4 and m[4] != Nothing {
                    m_val -> m[4]
                } or {
                    m_val -> [12, line, 0, [
                        [14, line, 0, [2, line, 0, `enum_name`], [2, line, 0, e_name]],
                        [14, line, 0, [2, line, 0, `variant_name`], [2, line, 0, m_name]],
                        [14, line, 0, [2, line, 0, `data`], [11, line, 0, []]],
                        [14, line, 0, [2, line, 0, `__type__`], [2, line, 0, e_name]]
                    ]]
                }
            } or when m != Nothing {
                m_name -> Str.to_string(m)
                m_val -> [12, line, 0, [
                    [14, line, 0, [2, line, 0, `enum_name`], [2, line, 0, e_name]],
                    [14, line, 0, [2, line, 0, `variant_name`], [2, line, 0, m_name]],
                    [14, line, 0, [2, line, 0, `data`], [11, line, 0, []]],
                    [14, line, 0, [2, line, 0, `__type__`], [2, line, 0, e_name]]
                ]]
            }
            when m_name != `` {
                entries.append([14, line, 0, [2, line, 0, m_name], m_val])
                // Direct global for enum member: e_name + "_" + m_name
                compile_expression(ctx, m_val)
                let direct_idx -> add_constant(ctx, e_name + `_` + m_name)
                emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
                emit_u16(ctx, direct_idx, line)
            }
            mi -> mi + 1
        }
        let map_node -> [12, line, 0, entries] // K_MAP
        compile_expression(ctx, map_node)
        let gname_idx -> add_constant(ctx, e_name)
        emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
        emit_u16(ctx, gname_idx, line)
        <- Nothing
    }

    when kind == 7 { // K_SET (obj.name -> val)
        compile_expression(ctx, stmt)
        emit_byte(ctx, 16, line) // OP_POP
        <- Nothing
    }

    when kind == 34 { // K_CLASS (class Name { members, methods })
        let c_name -> Str.to_string(stmt[3])
        let c_base -> stmt[4]
        let c_members -> stmt[5]
        let c_methods -> stmt[6]

        // 1. Compile each method with `self` as the first parameter
        let mi -> 0
        let mn -> 0
        when c_methods != Nothing {
            mn -> c_methods.length
        }
        let init_method -> Nothing
        do while mi < mn {
            let m -> c_methods[mi]
            let m_name -> Str.to_string(m[3])
            let m_params -> m[4]
            let m_body -> m[5]

            // Prepend 'self' parameter
            let full_params -> [[30, line, 0, `self`]]
            let pi -> 0
            let pn -> 0
            when m_params != Nothing {
                pn -> m_params.length
            }
            do while pi < pn {
                full_params.append(m_params[pi])
                pi -> pi + 1
            }

            let full_fn_name -> c_name + `_` + m_name
            let m_ctx -> make_compiler(full_fn_name)
            enter_scope(m_ctx)

            let ppi -> 0
            let ppn -> full_params.length
            do while ppi < ppn {
                let p -> full_params[ppi]
                when p != Nothing and (p is List) and p.length > 3 and p[0] == 30 {
                    declare_local(m_ctx, p[3])
                } or {
                    declare_local(m_ctx, p)
                }
                ppi -> ppi + 1
            }

            compile_block(m_ctx, m_body)
            emit_byte(m_ctx, 2, line) // OP_NOTHING
            emit_byte(m_ctx, 113, line) // OP_RETURN

            let m_chunk -> m_ctx[`chunk`]
            m_chunk[`num_locals`] -> m_ctx[`max_locals`]

            let m_const_idx -> add_constant(ctx, m_chunk)
            emit_byte(ctx, 1, line) // OP_CONST
            emit_u16(ctx, m_const_idx, line)
            let m_gname_idx -> add_constant(ctx, full_fn_name)
            emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
            emit_u16(ctx, m_gname_idx, line)

            when m_name == `init` {
                init_method -> m
            }
            mi -> mi + 1
        }

        // 2. Compile Constructor function for ClassName
        let ctor_params -> []
        when init_method != Nothing and init_method[4] != Nothing {
            ctor_params -> init_method[4]
        }
        let ctor_ctx -> make_compiler(c_name)
        enter_scope(ctor_ctx)

        let cpi -> 0
        let cpn -> ctor_params.length
        do while cpi < cpn {
            let cp -> ctor_params[cpi]
            when cp != Nothing and (cp is List) and cp.length > 3 and cp[0] == 30 {
                declare_local(ctor_ctx, cp[3])
            } or {
                declare_local(ctor_ctx, cp)
            }
            cpi -> cpi + 1
        }

        // Build self = { __type__ -> c_name, ...member fields }
        let entries -> []
        entries.append([14, line, 0, [2, line, 0, `__type__`], [2, line, 0, c_name]])
        let memi -> 0
        let memn -> 0
        when c_members != Nothing {
            memn -> c_members.length
        }
        do while memi < memn {
            let mem -> c_members[memi]
            let memname -> ``
            when mem != Nothing and (mem is List) and mem.length > 3 {
                memname -> Str.to_string(mem[3])
            } or when mem != Nothing {
                memname -> Str.to_string(mem)
            }
            when memname != `` {
                entries.append([14, line, 0, [2, line, 0, memname], [2, line, 0, Nothing]])
            }
            memi -> memi + 1
        }

        let self_map -> [12, line, 0, entries] // K_MAP
        compile_expression(ctor_ctx, self_map)
        let self_slot -> declare_local(ctor_ctx, `self`)
        emit_byte(ctor_ctx, 33, line) // OP_STORE_LOCAL self
        emit_u16(ctor_ctx, self_slot, line)

        // If init exists, call ClassName_init(self, args)
        when init_method != Nothing {
            let init_gidx -> add_constant(ctor_ctx, c_name + `_init`)
            emit_byte(ctor_ctx, 34, line) // OP_LOAD_GLOBAL
            emit_u16(ctor_ctx, init_gidx, line)
            emit_byte(ctor_ctx, 32, line) // OP_LOAD_LOCAL self
            emit_u16(ctor_ctx, self_slot, line)
            let ipi -> 0
            do while ipi < cpn {
                let iparam -> ctor_params[ipi]
                let ipname -> ``
                when iparam != Nothing and (iparam is List) and iparam.length > 3 and iparam[0] == 30 {
                    ipname -> Str.to_string(iparam[3])
                } or {
                    ipname -> Str.to_string(iparam)
                }
                let resolved -> resolve_or_capture_local(ctor_ctx, ipname)
                when resolved != Nothing {
                    emit_byte(ctor_ctx, 32, line) // OP_LOAD_LOCAL
                    emit_u16(ctor_ctx, resolved[`index`], line)
                }
                ipi -> ipi + 1
            }
            emit_byte(ctor_ctx, 112, line) // OP_CALL (argc = 1 + cpn)
            emit_u16(ctor_ctx, 1 + cpn, line)
            emit_byte(ctor_ctx, 16, line) // OP_POP
        }

        // Return self
        emit_byte(ctor_ctx, 32, line) // OP_LOAD_LOCAL self
        emit_u16(ctor_ctx, self_slot, line)
        emit_byte(ctor_ctx, 113, line) // OP_RETURN

        let ctor_chunk -> ctor_ctx[`chunk`]
        ctor_chunk[`num_locals`] -> ctor_ctx[`max_locals`]

        let ctor_const_idx -> add_constant(ctx, ctor_chunk)
        emit_byte(ctx, 1, line) // OP_CONST
        emit_u16(ctx, ctor_const_idx, line)
        let ctor_gname_idx -> add_constant(ctx, c_name)
        emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
        emit_u16(ctx, ctor_gname_idx, line)
        <- Nothing
    }

    when kind == 16 { // K_RAISE
        let rexpr -> stmt[3]
        let err_fn_idx -> add_constant(ctx, `__builtin_error`)
        emit_byte(ctx, 34, line) // OP_LOAD_GLOBAL __builtin_error
        emit_u16(ctx, err_fn_idx, line)
        when rexpr != Nothing {
            compile_expression(ctx, rexpr)
        } or {
            emit_byte(ctx, 2, line) // OP_NOTHING
        }
        emit_byte(ctx, 112, line) // OP_CALL (1 arg)
        emit_u16(ctx, 1, line)
        emit_byte(ctx, 113, line) // OP_RETURN
        <- Nothing
    }

    <- Nothing
}

function compile_block(ctx, node_or_stmts) {
    when node_or_stmts == Nothing {
        <- Nothing
    }
    when node_or_stmts.length > 3 and node_or_stmts[0] == 20 { // K_BLOCK
        let stmts -> node_or_stmts[3]
        let n -> stmts.length
        let i -> 0
        do while i < n {
            compile_statement(ctx, stmts[i])
            i -> i + 1
        }
        <- Nothing
    }
    when node_or_stmts.length > 0 and (node_or_stmts[0] is List) { // List of statements
        let n -> node_or_stmts.length
        let i -> 0
        do while i < n {
            compile_statement(ctx, node_or_stmts[i])
            i -> i + 1
        }
        <- Nothing
    }
    when node_or_stmts.length > 0 and (node_or_stmts[0] is Integer) { // Single statement node
        compile_statement(ctx, node_or_stmts)
        <- Nothing
    }
    <- Nothing
}

function compile_block_expr(ctx, node_or_stmts) {
    when node_or_stmts == Nothing {
        emit_byte(ctx, 2, ctx[`line`])
        <- Nothing
    }
    let stmts -> node_or_stmts
    when (node_or_stmts is List) and node_or_stmts.length > 3 and node_or_stmts[0] == 20 { // K_BLOCK
        stmts -> node_or_stmts[3]
    }
    when stmts != Nothing and (stmts is List) and stmts.length > 0 {
        let first -> stmts[0]
        when first is List {
            let n -> stmts.length
            let i -> 0
            do while i < n {
                let s -> stmts[i]
                when i == n - 1 {
                    when s != Nothing and (s is List) and s.length > 3 and s[0] == 18 {
                        compile_expression(ctx, s[3])
                    } or when s != Nothing and (s is List) and s.length > 3 and s[0] == 22 {
                        compile_expression(ctx, s[3])
                    } or when s != Nothing and (s is List) and s.length > 0 and s[0] != 18 and s[0] != 19 and s[0] != 22 and s[0] != 23 and s[0] != 24 and s[0] != 25 and s[0] != 26 and s[0] != 27 and s[0] != 28 and s[0] != 34 and s[0] != 35 and s[0] != 36 {
                        compile_expression(ctx, s)
                    } or {
                        compile_statement(ctx, s)
                    }
                } or {
                    compile_statement(ctx, s)
                }
                i -> i + 1
            }
            <- Nothing
        } or when first is Integer {
            when stmts[0] == 18 or stmts[0] == 22 {
                compile_expression(ctx, stmts[3])
            } or when stmts[0] != 19 and stmts[0] != 23 and stmts[0] != 24 and stmts[0] != 25 and stmts[0] != 26 and stmts[0] != 27 and stmts[0] != 28 and stmts[0] != 34 and stmts[0] != 35 and stmts[0] != 36 {
                compile_expression(ctx, stmts)
            } or {
                compile_statement(ctx, stmts)
            }
            <- Nothing
        }
    }
    emit_byte(ctx, 2, ctx[`line`])
    <- Nothing
}

function compile_pattern_case(ctx, val_slot, pat, body, guard, end_jumps, line) {
    when pat == Nothing {
        enter_scope(ctx)
        compile_block(ctx, body)
        exit_scope(ctx, line)
        <- Nothing
    }
    let pk -> pat[0]
    
    when pk == 11 { // K_LIST: [first, ...rest] or [a, b, c] or [1, _, 3]
        enter_scope(ctx)
        let elems -> pat[3]
        let has_rest -> false
        let fixed_n -> 0
        when elems != Nothing {
            fixed_n -> elems.length
            when fixed_n > 0 and elems[fixed_n - 1] != Nothing and (elems[fixed_n - 1] is List) and elems[fixed_n - 1].length > 3 and elems[fixed_n - 1][0] == 17 { // K_REST
                has_rest -> true
                fixed_n -> fixed_n - 1
            }
        }
        
        // 1. Check val is List
        emit_byte(ctx, 32, line) // OP_LOAD_LOCAL val_slot
        emit_u16(ctx, val_slot, line)
        let t_idx -> add_constant(ctx, `List`)
        emit_byte(ctx, 85, line) // OP_IS_TYPE
        emit_u16(ctx, t_idx, line)
        let j_fail1 -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
        
        // 2. Check length
        emit_byte(ctx, 32, line)
        emit_u16(ctx, val_slot, line)
        let len_idx -> add_constant(ctx, `length`)
        emit_byte(ctx, 84, line) // OP_GET_PROP .length
        emit_u16(ctx, len_idx, line)
        emit_constant(ctx, fixed_n, line)
        when has_rest {
            emit_byte(ctx, 69, line) // OP_GTE
        } or {
            emit_byte(ctx, 64, line) // OP_EQ
        }
        let j_fail2 -> emit_jump(ctx, 99, line)
        
        // 3. Check fixed literal/constant elements
        let j_lit_fails -> []
        let ei -> 0
        do while ei < fixed_n {
            let el -> elems[ei]
            when el != Nothing and (el is List) and el.length > 3 and el[0] == 2 { // K_LITERAL
                emit_byte(ctx, 32, line)
                emit_u16(ctx, val_slot, line)
                emit_constant(ctx, ei, line)
                emit_byte(ctx, 82, line) // OP_GET_INDEX
                compile_expression(ctx, el)
                emit_byte(ctx, 64, line) // OP_EQ
                let j_lf -> emit_jump(ctx, 99, line)
                j_lit_fails.append(j_lf)
            }
            ei -> ei + 1
        }
        
        // 4. Bind variables
        ei -> 0
        do while ei < fixed_n {
            let el -> elems[ei]
            when el != Nothing and (el is List) and el.length > 3 and el[0] == 4 { // K_VARIABLE
                let vname -> Str.to_string(el[3])
                when vname != `_` {
                    emit_byte(ctx, 32, line)
                    emit_u16(ctx, val_slot, line)
                    emit_constant(ctx, ei, line)
                    emit_byte(ctx, 82, line) // OP_GET_INDEX
                    let bslot -> declare_local(ctx, vname)
                    emit_byte(ctx, 33, line) // OP_STORE_LOCAL
                    emit_u16(ctx, bslot, line)
                }
            }
            ei -> ei + 1
        }
        when has_rest {
            let rest_node -> elems[elems.length - 1]
            let rname -> Str.to_string(rest_node[3])
            when rname != `_` {
                emit_constant(ctx, fixed_n, line)
                emit_byte(ctx, 32, line)
                emit_u16(ctx, val_slot, line)
                emit_byte(ctx, 49, line) // OP_SUB (fixed_n - list drops start)
                let rslot -> declare_local(ctx, rname)
                emit_byte(ctx, 33, line)
                emit_u16(ctx, rslot, line)
            }
        }
        
        // 5. Guard check
        let j_guard -> -1
        when guard != Nothing {
            compile_expression(ctx, guard)
            j_guard -> emit_jump(ctx, 99, line)
        }
        
        // 6. Body & jump to end
        compile_block(ctx, body)
        let j_end -> emit_jump(ctx, 96, line)
        end_jumps.append(j_end)
        
        // 7. Patch failure jumps
        patch_jump(ctx, j_fail1)
        patch_jump(ctx, j_fail2)
        let li -> 0
        do while li < j_lit_fails.length {
            patch_jump(ctx, j_lit_fails[li])
            li -> li + 1
        }
        when j_guard >= 0 {
            patch_jump(ctx, j_guard)
        }
        exit_scope(ctx, line)
        <- Nothing
    }
    
    when pk == 13 or pk == 12 { // K_STRUCT_INIT or K_MAP: Point { x, y } or { `name` -> n }
        enter_scope(ctx)
        let fields -> Nothing
        let struct_name -> ``
        when pk == 13 {
            struct_name -> Str.to_string(pat[3])
            when pat.length > 4 { fields -> pat[4] }
        } or when pk == 12 {
            when pat.length > 3 { fields -> pat[3] }
        }
        
        // Check val is Map
        emit_byte(ctx, 32, line)
        emit_u16(ctx, val_slot, line)
        let t_idx -> add_constant(ctx, `Map`)
        emit_byte(ctx, 85, line) // OP_IS_TYPE
        emit_u16(ctx, t_idx, line)
        let j_fail1 -> emit_jump(ctx, 99, line)
        
        // If struct_name present, check val is struct_name
        let j_fail_type -> -1
        when struct_name != `` {
            emit_byte(ctx, 32, line)
            emit_u16(ctx, val_slot, line)
            let s_idx -> add_constant(ctx, struct_name)
            emit_byte(ctx, 85, line) // OP_IS_TYPE struct_name
            emit_u16(ctx, s_idx, line)
            j_fail_type -> emit_jump(ctx, 99, line)
        }
        
        // Bind fields
        when fields != Nothing {
            let fi -> 0
            do while fi < fields.length {
                let f -> fields[fi]
                when f != Nothing and (f is List) and f.length > 3 {
                    let raw_key -> ``
                    when f[3] != Nothing and (f[3] is List) and f[3].length > 3 and f[3][0] == 2 { // K_LITERAL
                        raw_key -> Str.to_string(f[3][3])
                    } or {
                        raw_key -> Str.to_string(f[3])
                    }
                    let bind_name -> ``
                    when f.length > 4 and f[4] != Nothing and (f[4] is List) and f[4].length > 3 and f[4][0] == 4 {
                        bind_name -> Str.to_string(f[4][3])
                    } or {
                        bind_name -> Str.to_string(raw_key)
                    }
                    when bind_name != `_` {
                        emit_byte(ctx, 32, line)
                        emit_u16(ctx, val_slot, line)
                        let k_idx -> add_constant(ctx, Str.to_string(raw_key))
                        emit_byte(ctx, 1, line)
                        emit_u16(ctx, k_idx, line)
                        emit_byte(ctx, 82, line) // OP_GET_INDEX
                        let bslot -> declare_local(ctx, bind_name)
                        emit_byte(ctx, 33, line)
                        emit_u16(ctx, bslot, line)
                    }
                }
                fi -> fi + 1
            }
        }
        
        let j_guard -> -1
        when guard != Nothing {
            compile_expression(ctx, guard)
            j_guard -> emit_jump(ctx, 99, line)
        }
        
        compile_block(ctx, body)
        let j_end -> emit_jump(ctx, 96, line)
        end_jumps.append(j_end)
        
        patch_jump(ctx, j_fail1)
        when j_fail_type >= 0 {
            patch_jump(ctx, j_fail_type)
        }
        when j_guard >= 0 {
            patch_jump(ctx, j_guard)
        }
        exit_scope(ctx, line)
        <- Nothing
    }
    
    when pk == 5 { // K_CALL: Result.Ok(v) or Option.Some(x)
        enter_scope(ctx)
        let callee -> pat[3]
        let args -> pat[4]
        let variant_name -> ``
        let enum_name -> ``
        when callee != Nothing and (callee is List) and callee.length > 4 and callee[0] == 6 { // K_GET
            when callee[3] != Nothing and (callee[3] is List) and callee[3].length > 3 and callee[3][0] == 4 {
                enum_name -> Str.to_string(callee[3][3])
            }
            variant_name -> Str.to_string(callee[4])
        } or when callee != Nothing and (callee is List) and callee.length > 3 and callee[0] == 4 { // K_VARIABLE
            variant_name -> Str.to_string(callee[3])
        }
        
        // Check type is Variant / Enum
        emit_byte(ctx, 32, line)
        emit_u16(ctx, val_slot, line)
        let is_ok -> add_constant(ctx, `Variant`)
        emit_byte(ctx, 85, line) // OP_IS_TYPE Variant
        emit_u16(ctx, is_ok, line)
        let j_fail1 -> emit_jump(ctx, 99, line)
        
        // Check variant_name if present
        let j_fail_var -> -1
        when variant_name != `` {
            emit_byte(ctx, 32, line)
            emit_u16(ctx, val_slot, line)
            let v_idx -> add_constant(ctx, variant_name)
            emit_byte(ctx, 85, line) // OP_IS_TYPE variant_name
            emit_u16(ctx, v_idx, line)
            j_fail_var -> emit_jump(ctx, 99, line)
        }
        
        // Bind args from variant data / list
        when args != Nothing {
            let ai -> 0
            do while ai < args.length {
                let a -> args[ai]
                when a != Nothing and (a is List) and a.length > 3 and a[0] == 4 {
                    let aname -> Str.to_string(a[3])
                    when aname != `_` {
                        emit_byte(ctx, 32, line)
                        emit_u16(ctx, val_slot, line)
                        let data_prop -> add_constant(ctx, `data`)
                        emit_byte(ctx, 84, line) // OP_GET_PROP .data
                        emit_u16(ctx, data_prop, line)
                        emit_constant(ctx, ai, line)
                        emit_byte(ctx, 82, line) // OP_GET_INDEX
                        let aslot -> declare_local(ctx, aname)
                        emit_byte(ctx, 33, line)
                        emit_u16(ctx, aslot, line)
                    }
                }
                ai -> ai + 1
            }
        }
        
        let j_guard -> -1
        when guard != Nothing {
            compile_expression(ctx, guard)
            j_guard -> emit_jump(ctx, 99, line)
        }
        
        compile_block(ctx, body)
        let j_end -> emit_jump(ctx, 96, line)
        end_jumps.append(j_end)
        
        patch_jump(ctx, j_fail1)
        when j_fail_var >= 0 {
            patch_jump(ctx, j_fail_var)
        }
        when j_guard >= 0 {
            patch_jump(ctx, j_guard)
        }
        exit_scope(ctx, line)
        <- Nothing
    }
    
    when pk == 4 { // K_VARIABLE: case n when n < 10
        enter_scope(ctx)
        let vname -> Str.to_string(pat[3])
        when vname != `_` {
            emit_byte(ctx, 32, line)
            emit_u16(ctx, val_slot, line)
            let vslot -> declare_local(ctx, vname)
            emit_byte(ctx, 33, line)
            emit_u16(ctx, vslot, line)
        }
        
        let j_guard -> -1
        when guard != Nothing {
            compile_expression(ctx, guard)
            j_guard -> emit_jump(ctx, 99, line)
        }
        
        compile_block(ctx, body)
        let j_end -> emit_jump(ctx, 96, line)
        end_jumps.append(j_end)
        
        when j_guard >= 0 {
            patch_jump(ctx, j_guard)
        }
        exit_scope(ctx, line)
        <- Nothing
    }
    
    // Fallback literal / expression equality match
    enter_scope(ctx)
    emit_byte(ctx, 32, line)
    emit_u16(ctx, val_slot, line)
    compile_expression(ctx, pat)
    emit_byte(ctx, 64, line) // OP_EQ
    let j_fail1 -> emit_jump(ctx, 99, line)
    
    let j_guard -> -1
    when guard != Nothing {
        compile_expression(ctx, guard)
        j_guard -> emit_jump(ctx, 99, line)
    }
    
    compile_block(ctx, body)
    let j_end -> emit_jump(ctx, 96, line)
    end_jumps.append(j_end)
    
    patch_jump(ctx, j_fail1)
    when j_guard >= 0 {
        patch_jump(ctx, j_guard)
    }
    exit_scope(ctx, line)
    <- Nothing
}

function compile_expression(ctx, expr) {
    when expr == Nothing {
        emit_byte(ctx, 2, 0) // OP_NOTHING
        <- Nothing
    }
    let kind -> expr[0]
    let line -> expr[1]

    when kind == 2 { // K_LITERAL
        let val -> expr[3]
        let tok_kind -> ``
        when expr.length > 4 and expr[4] != Nothing { tok_kind -> expr[4] }
        let tok_kind_str -> Str.to_string(tok_kind)
        when tok_kind == 19 or tok_kind_str == `19` or tok_kind_str == `NOTHING` or val == Nothing {
            emit_byte(ctx, 2, line) // OP_NOTHING
        } or when tok_kind == 20 or tok_kind_str == `20` or tok_kind_str == `DEFAULT` {
            emit_byte(ctx, 3, line) // OP_DEFAULT
            emit_u16(ctx, 1, line)  // ZEN_DEFAULT
        } or when tok_kind == 26 or tok_kind_str == `26` or tok_kind_str == `BOOLEAN` or (val is Boolean) {
            when val == true or val == `true` or val == `True` {
                emit_byte(ctx, 4, line) // OP_TRUE
            } or {
                emit_byte(ctx, 5, line) // OP_FALSE
            }
        } or when tok_kind == 22 or tok_kind_str == `22` or tok_kind_str == `INTEGER` or tok_kind_str == `Int` or (val is Integer) {
            when val is Integer {
                emit_constant(ctx, val, line)
            } or when looks_int_str(val) {
                emit_constant(ctx, parse_int_str(val), line)
            } or {
                emit_constant(ctx, val, line)
            }
        } or when tok_kind == 23 or tok_kind_str == `23` or tok_kind_str == `DECIMAL` or tok_kind_str == `Float` or (val is Decimal) {
            when val is Decimal {
                emit_constant(ctx, val, line)
            } or {
                let num_str -> strip_underscores(Str.to_string(val))
                emit_constant(ctx, num_str.to_number(), line)
            }
        } or {
            emit_constant(ctx, val, line)
        }
        <- Nothing
    }

    when kind == 4 { // K_VARIABLE
        let name -> expr[3]
        when name != Nothing and (name is List) and name.length > 3 and name[0] == 45 { // K_TYPE_ANN
            name -> name[3]
        }
        name -> Str.to_string(name)
        when name == `Nothing` or name == `nothing` {
            emit_byte(ctx, 2, line) // OP_NOTHING
        } or when name == `Default` or name == `default` {
            emit_byte(ctx, 3, line) // OP_DEFAULT
            emit_u16(ctx, 1, line)  // ZEN_DEFAULT
        } or when name == `True` or name == `true` {
            emit_byte(ctx, 4, line) // OP_TRUE
        } or when name == `False` or name == `false` {
            emit_byte(ctx, 5, line) // OP_FALSE
        } or {
            let resolved -> resolve_or_capture_local(ctx, name)
            when resolved != Nothing {
                when resolved[`type`] == `local` {
                    emit_byte(ctx, 32, line) // OP_LOAD_LOCAL
                    emit_u16(ctx, resolved[`index`], line)
                } or when resolved[`type`] == `capture` {
                    emit_byte(ctx, 38, line) // OP_LOAD_CAPTURE
                    emit_u16(ctx, resolved[`index`], line)
                }
            } or {
                let name_idx -> add_constant(ctx, name)
                emit_byte(ctx, 34, line) // OP_LOAD_GLOBAL
                emit_u16(ctx, name_idx, line)
            }
        }
        <- Nothing
    }

    when kind == 0 or kind == 10 { // K_BINARY or K_LOGICAL
        let left -> expr[3]
        let op -> expr[4]
        let right -> expr[5]
        
        when op == `and` {
            compile_expression(ctx, left)
            let end_jump -> emit_jump(ctx, 97, line) // OP_JUMP_IF_FALSE
            emit_byte(ctx, 16, line) // OP_POP
            compile_expression(ctx, right)
            patch_jump(ctx, end_jump)
            <- Nothing
        }
        
        when op == `or` {
            compile_expression(ctx, left)
            let end_jump -> emit_jump(ctx, 98, line) // OP_JUMP_IF_TRUE
            emit_byte(ctx, 16, line) // OP_POP
            compile_expression(ctx, right)
            patch_jump(ctx, end_jump)
            <- Nothing
        }
        
        compile_expression(ctx, left)
        compile_expression(ctx, right)
        
        when op == `+` { emit_byte(ctx, 48, line) }      // OP_ADD
        or when op == `-` { emit_byte(ctx, 49, line) } // OP_SUB
        or when op == `*` { emit_byte(ctx, 50, line) } // OP_MUL
        or when op == `/` { emit_byte(ctx, 51, line) } // OP_DIV
        or when op == `%` { emit_byte(ctx, 52, line) } // OP_MOD
        or when op == `**` { emit_byte(ctx, 61, line) } // OP_POW
        or when op == `&` or op == `&&` { emit_byte(ctx, 56, line) } // OP_BIT_AND
        or when op == `|` or op == `||` { emit_byte(ctx, 57, line) } // OP_BIT_OR
        or when op == `^` or op == `^^` { emit_byte(ctx, 58, line) } // OP_BIT_XOR
        or when op == `<<` { emit_byte(ctx, 59, line) } // OP_SHL
        or when op == `>>` { emit_byte(ctx, 60, line) } // OP_SHR
        or when op == `==` { emit_byte(ctx, 64, line) } // OP_EQ
        or when op == `!=` { emit_byte(ctx, 65, line) } // OP_NEQ
        or when op == `<` { emit_byte(ctx, 66, line) }  // OP_LT
        or when op == `<=` { emit_byte(ctx, 67, line) } // OP_LTE
        or when op == `>` { emit_byte(ctx, 68, line) }  // OP_GT
        or when op == `>=` { emit_byte(ctx, 69, line) } // OP_GTE
        or when op == `..` { emit_byte(ctx, 94, line) } // OP_RANGE_BETWEEN
        or when op == `..-` { emit_byte(ctx, 88, line) } // OP_RANGE_EXCL
        or when op == `...` { emit_byte(ctx, 89, line) } // OP_RANGE_INCL
        or when op == `..+` { emit_byte(ctx, 93, line) } // OP_RANGE_INCL_END
        or when op == `++` { emit_byte(ctx, 90, line) } // OP_CONCAT_APPEND
        or when op == `--` { emit_byte(ctx, 91, line) } // OP_DROP
        or when op == `in` { emit_byte(ctx, 95, line) } // OP_IN
        or when op == `??` { emit_byte(ctx, 101, line) } // OP_COALESCE
        <- Nothing
    }

    when kind == 5 { // K_CALL
        let callee -> expr[3]
        let args -> expr[4]
        when callee != Nothing and (callee[0] == 4 or callee[0] == 2) { // K_VARIABLE or K_LITERAL
            let cname -> Str.to_string(callee[3])
            when is_type_name_str(cname) {
                when args != Nothing and args.length >= 1 {
                    compile_expression(ctx, args[0])
                } or {
                    emit_byte(ctx, 2, line) // OP_NOTHING
                }
                let const_idx -> add_constant(ctx, cname)
                emit_byte(ctx, 86, line) // OP_CAST
                emit_u16(ctx, const_idx, line)
                <- Nothing
            }
        }
        when callee != Nothing and callee[0] == 6 { // K_GET
            let obj -> callee[3]
            let mname -> Str.to_string(callee[4])
            when obj != Nothing and obj[0] == 4 { // K_VARIABLE
                let oname -> Str.to_string(obj[3])
                let is_local_var -> resolve_local(ctx, oname) >= 0
                when is_local_var == false and ctx[`parent`] != Nothing {
                    is_local_var -> resolve_or_capture_local(ctx, oname) != Nothing
                }
                let is_top_var -> false
                when ctx[`variables`] != Nothing and ctx[`variables`][oname] == true {
                    is_top_var -> true
                }
                when is_local_var == false and is_top_var == false and
                     oname != `__builtin_set` and oname != `__builtin_map` and
                     oname != `__builtin_list` and oname != `__builtin_math` and
                     oname != `__builtin_io` and oname != `__builtin_file` and
                     oname != `__builtin_term` and oname != `__builtin_sys` and
                     oname != `__builtin_time` and oname != `__builtin_string` and
                     oname != `__builtin_process` and oname != `__builtin_regex` and
                     oname != `__builtin_net` and
                     oname != `__builtin_output` and oname != `__builtin_input` and
                     oname != `__builtin_reflect` and oname != `__builtin` {
                    let direct_name -> oname + `_` + mname
                    let name_idx -> add_constant(ctx, direct_name)
                    emit_byte(ctx, 34, line) // OP_LOAD_GLOBAL
                    emit_u16(ctx, name_idx, line)
                    
                    let an -> 0
                    when args != Nothing {
                        an -> args.length
                        let ai -> 0
                        do while ai < an {
                            compile_expression(ctx, args[ai])
                            ai -> ai + 1
                        }
                    }
                    emit_byte(ctx, 112, line) // OP_CALL
                    emit_u16(ctx, an, line)
                    <- Nothing
                }
            }
        }
        
        compile_expression(ctx, callee)
        let an -> args.length
        let ai -> 0
        do while ai < an {
            compile_expression(ctx, args[ai])
            ai -> ai + 1
        }
        emit_byte(ctx, 112, line) // OP_CALL
        emit_u16(ctx, an, line)
        <- Nothing
    }

    when kind == 1 { // K_UNARY (op, right)
        let op_name -> Str.to_string(expr[3])
        let right_expr -> expr[4]
        compile_expression(ctx, right_expr)
        when op_name == `not` or op_name == `!` {
            emit_byte(ctx, 54, line) // OP_NOT
        } or when op_name == `~` {
            emit_byte(ctx, 55, line) // OP_BIT_NOT
        } or when op_name == `-` {
            emit_byte(ctx, 53, line) // OP_NEG
        } or when op_name == `+` {
            // No-op
        } or {
            emit_byte(ctx, 54, line)
        }
        <- Nothing
    }

    when kind == 10 { // K_LOGICAL (left, op, right)
        let op_name -> Str.to_string(expr[4])
        when op_name == `and` {
            compile_expression(ctx, expr[3])
            let skip_jump -> emit_jump(ctx, 97, line) // OP_JUMP_IF_FALSE
            emit_byte(ctx, 4, line)                   // OP_POP
            compile_expression(ctx, expr[5])
            patch_jump(ctx, skip_jump)
            <- Nothing
        }
        when op_name == `or` {
            compile_expression(ctx, expr[3])
            let skip_jump -> emit_jump(ctx, 98, line) // OP_JUMP_IF_TRUE
            emit_byte(ctx, 4, line)                   // OP_POP
            compile_expression(ctx, expr[5])
            patch_jump(ctx, skip_jump)
            <- Nothing
        }
        when op_name == `xor` {
            compile_expression(ctx, expr[3])
            compile_expression(ctx, expr[5])
            emit_byte(ctx, 65, line) // OP_NEQ
            <- Nothing
        }
        <- Nothing
    }

    when kind == 11 { // K_LIST
        let items -> expr[3]
        let in_len -> items.length
        let ii -> 0
        do while ii < in_len {
            compile_expression(ctx, items[ii])
            ii -> ii + 1
        }
        emit_byte(ctx, 80, line) // OP_MAKE_LIST
        emit_u16(ctx, in_len, line)
        <- Nothing
    }

    when kind == 12 { // K_MAP
        let entries -> expr[3]
        let en -> entries.length
        let ei -> 0
        do while ei < en {
            let entry -> entries[ei]
            let knode -> entry[3]
            when knode != Nothing and (knode is List) and knode.length > 0 {
                compile_expression(ctx, knode)
            } or {
                emit_constant(ctx, Str.to_string(knode), line)
            }
            compile_expression(ctx, entry[4])
            ei -> ei + 1
        }
        emit_byte(ctx, 81, line) // OP_MAKE_MAP
        emit_u16(ctx, en, line)
        <- Nothing
    }

    when kind == 13 { // K_STRUCT_INIT (Point { x -> 10, y -> 20 } or Point { x, y })
        let sname -> Str.to_string(expr[3])
        let fields -> expr[4]
        let fn -> 0
        when fields != Nothing { fn -> fields.length }
        
        // Push '__type__' -> sname
        emit_constant(ctx, `__type__`, line)
        emit_constant(ctx, sname, line)
        
        let fi -> 0
        do while fi < fn {
            let f -> fields[fi]
            let kname -> Str.to_string(f[3])
            let fval -> f[4]
            emit_constant(ctx, kname, line)
            when fval == Nothing {
                compile_expression(ctx, [4, line, 0, kname]) // K_VARIABLE shorthand
            } or {
                compile_expression(ctx, fval)
            }
            fi -> fi + 1
        }
        emit_byte(ctx, 81, line) // OP_MAKE_MAP
        emit_u16(ctx, fn + 1, line)
        <- Nothing
    }

    when kind == 9 { // K_ASSIGN
        let tgt -> expr[3]
        when (tgt != Nothing) and (tgt is List) and tgt.length > 3 and tgt[0] == 45 { // K_TYPE_ANN
            tgt -> tgt[3]
        }
        when (tgt != Nothing) and (tgt is List) and tgt.length > 3 and (tgt[0] == 4 or tgt[0] == 30) { // K_VARIABLE or K_IDENTIFIER
            tgt -> tgt[3]
        }
        when (tgt != Nothing) and (tgt is List) and tgt.length > 4 and (tgt[0] == 8 or tgt[0] == 5) { // K_INDEX: obj[key] -> val
            compile_expression(ctx, tgt[3]) // obj
            compile_expression(ctx, tgt[4]) // key
            compile_expression(ctx, expr[4])   // val
            emit_byte(ctx, 83, line)           // OP_SET_INDEX
            <- Nothing
        }
        when (tgt != Nothing) and (tgt is List) and tgt.length > 4 and tgt[0] == 6 { // K_GET: obj.prop -> val
            compile_expression(ctx, tgt[3]) // obj
            let prop_name -> Str.to_string(tgt[4])
            let name_idx -> add_constant(ctx, prop_name)
            emit_byte(ctx, 1, line)            // OP_CONST
            emit_u16(ctx, name_idx, line)
            compile_expression(ctx, expr[4])   // val
            emit_byte(ctx, 83, line)           // OP_SET_INDEX
            <- Nothing
        }
        let name -> Str.to_string(tgt)
        let val -> expr[4]
        compile_expression(ctx, val)
        let resolved -> resolve_or_capture_local(ctx, name)
        when resolved != Nothing {
            when resolved[`type`] == `local` {
                emit_byte(ctx, 33, line) // OP_STORE_LOCAL
                emit_u16(ctx, resolved[`index`], line)
                emit_byte(ctx, 32, line) // OP_LOAD_LOCAL
                emit_u16(ctx, resolved[`index`], line)
            } or when resolved[`type`] == `capture` {
                emit_byte(ctx, 39, line) // OP_STORE_CAPTURE
                emit_u16(ctx, resolved[`index`], line)
                emit_byte(ctx, 38, line) // OP_LOAD_CAPTURE
                emit_u16(ctx, resolved[`index`], line)
            }
        } or {
            let name_idx -> add_constant(ctx, name)
            emit_byte(ctx, 35, line) // OP_STORE_GLOBAL
            emit_u16(ctx, name_idx, line)
            emit_byte(ctx, 34, line) // OP_LOAD_GLOBAL
            emit_u16(ctx, name_idx, line)
        }
        <- Nothing
    }

    when kind == 7 { // K_SET (obj.name -> val)
        compile_expression(ctx, expr[3]) // obj
        let prop_name -> Str.to_string(expr[4])
        let name_idx -> add_constant(ctx, prop_name)
        emit_byte(ctx, 1, line) // OP_CONST
        emit_u16(ctx, name_idx, line)
        compile_expression(ctx, expr[5]) // val
        emit_byte(ctx, 83, line) // OP_SET_INDEX
        <- Nothing
    }

    when kind == 44 { // K_INDEX_ASSIGN
        compile_expression(ctx, expr[3])
        compile_expression(ctx, expr[4])
        compile_expression(ctx, expr[5])
        emit_byte(ctx, 83, line) // OP_SET_INDEX
        <- Nothing
    }

    when kind == 8 { // K_INDEX
        compile_expression(ctx, expr[3])
        compile_expression(ctx, expr[4])
        emit_byte(ctx, 82, line) // OP_GET_INDEX
        <- Nothing
    }

    when kind == 48 { // K_SLICE
        compile_expression(ctx, expr[3])
        let s -> expr[4]
        when s != Nothing { compile_expression(ctx, s) } or { emit_byte(ctx, 2, line) }
        let e -> expr[5]
        when e != Nothing { compile_expression(ctx, e) } or { emit_byte(ctx, 2, line) }
        let stp -> expr[6]
        when stp != Nothing { compile_expression(ctx, stp) } or { emit_byte(ctx, 2, line) }
        emit_byte(ctx, 102, line) // OP_SLICE
        <- Nothing
    }

    when kind == 6 { // K_GET
        compile_expression(ctx, expr[3])
        let prop_name -> expr[4]
        let name_idx -> add_constant(ctx, prop_name)
        emit_byte(ctx, 84, line) // OP_GET_PROP
        emit_u16(ctx, name_idx, line)
        <- Nothing
    }

    when kind == 3 { // K_GROUPING
        compile_expression(ctx, expr[3])
        <- Nothing
    }

    when kind == 47 { // K_CAST (<: syntax)
        let val_expr -> expr[3]
        let target_type -> Str.to_string(expr[4])
        compile_expression(ctx, val_expr)
        let const_idx -> add_constant(ctx, target_type)
        emit_byte(ctx, 86, line) // OP_CAST
        emit_u16(ctx, const_idx, line)
        <- Nothing
    }

    when kind == 15 { // K_CHECK (check expr)
        compile_expression(ctx, expr[3])
        emit_byte(ctx, 92, line) // OP_CHECK_UNWRAP
        <- Nothing
    }

    when kind == 38 { // K_IS (val is Pattern / Type)
        let val_node -> expr[3]
        let pat_node -> expr[4]
        compile_expression(ctx, val_node)
        when pat_node != Nothing and pat_node.length > 3 and is_type_name_str(Str.to_string(pat_node[3])) {
            let type_name -> Str.to_string(pat_node[3])
            let type_idx -> add_constant(ctx, type_name)
            emit_byte(ctx, 85, line) // OP_IS_TYPE
            emit_u16(ctx, type_idx, line)
            <- Nothing
        } or {
            compile_expression(ctx, pat_node)
            emit_byte(ctx, 64, line) // OP_EQ
            <- Nothing
        }
    }

    when kind == 16 { // K_RAISE
        let rexpr -> expr[3]
        let err_fn_idx -> add_constant(ctx, `__builtin_error`)
        emit_byte(ctx, 34, line) // OP_LOAD_GLOBAL __builtin_error
        emit_u16(ctx, err_fn_idx, line)
        when rexpr != Nothing {
            compile_expression(ctx, rexpr)
        } or {
            emit_byte(ctx, 2, line) // OP_NOTHING
        }
        emit_byte(ctx, 112, line) // OP_CALL (1 arg)
        emit_u16(ctx, 1, line)
        emit_byte(ctx, 113, line) // OP_RETURN
        <- Nothing
    }

    when kind == 23 { // K_WHEN expression
        let cases -> expr[3]
        let cn -> cases.length
        let ci -> 0
        let end_jumps -> []

        do while ci < cn {
            let c -> cases[ci]
            let cond -> c[3]
            let body -> c[4]
            
            when cond == Nothing or cond == `else` or (cond is String and cond == `else`) or (cond is List and cond.length > 3 and cond[0] == 2 and cond[3] == `else`) {
                enter_scope(ctx)
                compile_block_expr(ctx, body)
                exit_scope(ctx, line)
            } or {
                compile_expression(ctx, cond)
                let jump_false -> emit_jump(ctx, 99, line) // OP_POP_JUMP_IF_FALSE
                enter_scope(ctx)
                compile_block_expr(ctx, body)
                exit_scope(ctx, line)
                
                when ci < cn - 1 {
                    let j_end -> emit_jump(ctx, 96, line) // OP_JUMP
                    end_jumps.append(j_end)
                }
                patch_jump(ctx, jump_false)
            }
            ci -> ci + 1
        }

        let ji -> 0
        let jn -> end_jumps.length
        do while ji < jn {
            patch_jump(ctx, end_jumps[ji])
            ji -> ji + 1
        }
        <- Nothing
    }

    when kind == 20 { // K_BLOCK (block expression { ... expr })
        let stmts -> expr[3]
        enter_scope(ctx)
        let si -> 0
        let sn -> 0
        when stmts != Nothing { sn -> stmts.length }
        do while si < sn {
            let s -> stmts[si]
            when si == sn - 1 and s != Nothing and s[0] == 18 { // Last statement is K_EXPR_STMT: evaluate without pop
                compile_expression(ctx, s[3])
            } or {
                compile_statement(ctx, s)
            }
            si -> si + 1
        }
        exit_scope(ctx, line)
        <- Nothing
    }

    when kind == 21 or kind == 37 { // K_FUNCTION or K_FUNC_EXPR (lambda / closure)
        let fn_name -> ``
        let fn_params -> []
        let fn_body -> Nothing
        when kind == 21 {
            fn_name -> expr[3]
            fn_params -> expr[4]
            fn_body -> expr[5]
        } or {
            fn_name -> `anon_fn_` + Str.to_string(line)
            fn_params -> expr[3]
            fn_body -> expr[4]
        }
        when fn_name == Nothing or fn_name == `` {
            fn_name -> `anon_fn_` + Str.to_string(line)
        }
        
        let fn_ctx -> make_compiler_child(fn_name, ctx)
        enter_scope(fn_ctx)
        
        // Bind parameters as locals
        let pi -> 0
        let pn -> 0
        when fn_params != Nothing { pn -> fn_params.length }
        do while pi < pn {
            let p -> fn_params[pi]
            when p != Nothing and p.length > 3 and p[0] == 30 { // K_PARAM
                declare_local(fn_ctx, p[3])
            } or {
                declare_local(fn_ctx, p)
            }
            pi -> pi + 1
        }
        
        compile_block(fn_ctx, fn_body)
        emit_byte(fn_ctx, 2, line) // OP_NOTHING
        emit_byte(fn_ctx, 113, line) // OP_RETURN
        
        let fn_chunk -> fn_ctx[`chunk`]
        fn_chunk[`num_locals`] -> fn_ctx[`max_locals`]
        
        let const_idx -> add_constant(ctx, fn_chunk)
        let caps -> fn_ctx[`captures`]
        when caps.length > 0 {
            let ci -> 0
            do while ci < caps.length {
                emit_byte(ctx, 32, line) // OP_LOAD_LOCAL parent slot
                emit_u16(ctx, caps[ci][`parent_slot`], line)
                ci -> ci + 1
            }
            emit_byte(ctx, 87, line) // OP_MAKE_CLOSURE
            emit_u16(ctx, const_idx, line)
            emit_u16(ctx, caps.length, line)
        } or {
            emit_byte(ctx, 1, line) // OP_CONST
            emit_u16(ctx, const_idx, line)
        }
        <- Nothing
    }

    emit_byte(ctx, 2, line) // OP_NOTHING
    <- Nothing
}

function vm_io_write(v) {
    <- __builtin_output.write(v)
}
function vm_builtin_error(msg) {
    let m -> msg
    when m == Nothing {
        m -> `error`
    }
    <- __builtin.error_literal(m)
}
function vm_io_writeln(v) {
    <- __builtin_output.write_line(v)
}
function vm_io_print(v) {
    <- __builtin_output.write_line(v)
}
function vm_io_read(prompt) {
    <- __builtin_input.read(prompt)
}
function vm_io_readln() {
    <- __builtin_input.read_line()
}
function vm_file_read(p) {
    <- __builtin_file.read(p)
}
function vm_file_write(p, c) {
    <- __builtin_file.write(p, c)
}
function vm_file_exists(p) {
    <- __builtin_file.exists(p)
}
function vm_file_is_file(p) {
    <- __builtin_file.is_file(p)
}
function vm_file_is_dir(p) {
    <- __builtin_file.is_dir(p)
}
function vm_file_list_dir(p) {
    <- __builtin_file.list_dir(p)
}
function vm_term_width() {
    let sz -> __builtin_term.get_size()
    when sz != Nothing and sz is Map and sz[`width`] != Nothing {
        <- sz[`width`]
    }
    <- 80
}
function vm_term_height() {
    let sz -> __builtin_term.get_size()
    when sz != Nothing and sz is Map and sz[`height`] != Nothing {
        <- sz[`height`]
    }
    <- 24
}
function vm_sys_args() {
    let raw -> __builtin_sys.get_args()
    when raw == Nothing { <- [] }
    let n -> raw.length
    when n > 1 {
        let a0 -> Str.to_string(raw[0])
        when a0 == `zen` or Str.ends_with(a0, `/zen`) or Str.ends_with(a0, `zen-selfhost`) {
            let sliced -> []
            let i -> 1
            do while i < n {
                sliced.append(raw[i])
                i -> i + 1
            }
            <- sliced
        }
    }
    <- raw
}
function vm_sys_exit(code) {
    <- __builtin_sys.exit(code)
}
function vm_sys_env(k) {
    <- __builtin_sys.get_env(k)
}
function vm_time_now() {
    <- __builtin_time.now()
}
function vm_time_sleep(ms) {
    <- __builtin_time.sleep(ms)
}

function make_native(name) {
    <- { `is_native` -> true, `native_fn` -> name }
}

function vm_result_ok(v) {
    <- { `enum_name` -> `Result`, `variant_name` -> `Ok`, `data` -> [v], `__type__` -> `Result` }
}
function vm_result_error(e) {
    <- { `enum_name` -> `Result`, `variant_name` -> `Error`, `data` -> [e], `__type__` -> `Result` }
}
function vm_option_some(v) {
    <- { `enum_name` -> `Option`, `variant_name` -> `Some`, `data` -> [v], `__type__` -> `Option` }
}
function vm_option_none() {
    <- { `enum_name` -> `Option`, `variant_name` -> `None`, `data` -> [], `__type__` -> `Option` }
}
function vm_option_something(v) {
    <- { `enum_name` -> `Option`, `variant_name` -> `Something`, `data` -> [v], `__type__` -> `Option` }
}
function vm_option_nothing() {
    <- { `enum_name` -> `Option`, `variant_name` -> `Nothing`, `data` -> [], `__type__` -> `Option` }
}

export function create_vm_prelude() {
    let g -> {}
    
    // Output & IO
    let out_mod -> {
        `write` -> make_native(`io_write`),
        `write_line` -> make_native(`io_writeln`),
        `writeln` -> make_native(`io_writeln`),
        `print` -> make_native(`io_print`),
        `info` -> make_native(`io_writeln`),
        `warn` -> make_native(`io_writeln`),
        `error` -> make_native(`io_writeln`),
        `debug` -> make_native(`io_writeln`)
    }
    g[`output`] -> out_mod
    g[`__builtin_output`] -> out_mod
    
    let in_mod -> {
        `read` -> make_native(`io_read`),
        `read_line` -> make_native(`io_readln`),
        `readln` -> make_native(`io_readln`)
    }
    g[`input`] -> in_mod
    g[`__builtin_input`] -> in_mod
    
    let io_mod -> {
        `write` -> make_native(`io_write`),
        `write_line` -> make_native(`io_writeln`),
        `writeln` -> make_native(`io_writeln`),
        `print` -> make_native(`io_print`),
        `read` -> make_native(`io_read`),
        `read_line` -> make_native(`io_readln`),
        `readln` -> make_native(`io_readln`),
        `info` -> make_native(`io_writeln`),
        `warn` -> make_native(`io_writeln`),
        `error` -> make_native(`io_writeln`)
    }
    g[`io`] -> io_mod
    g[`IO`] -> io_mod
    g[`__builtin_io`] -> io_mod

    // Ambient streams & preludes
    let stdout_mod -> {
        `write` -> make_native(`io_write`),
        `write_line` -> make_native(`io_writeln`),
        `writeln` -> make_native(`io_writeln`),
        `flush` -> make_native(`io_flush`),
        `name` -> `stdout`,
        `kind` -> `Stream`
    }
    g[`stdout`] -> stdout_mod

    let stderr_mod -> {
        `write` -> make_native(`io_write_stderr`),
        `write_line` -> make_native(`io_writeln_stderr`),
        `writeln` -> make_native(`io_writeln_stderr`),
        `flush` -> make_native(`io_flush_stderr`),
        `name` -> `stderr`,
        `kind` -> `Stream`
    }
    g[`stderr`] -> stderr_mod

    let stdin_mod -> {
        `read` -> make_native(`io_read`),
        `read_line` -> make_native(`io_readln`),
        `readln` -> make_native(`io_readln`),
        `lines` -> make_native(`io_stdin_lines`),
        `name` -> `stdin`,
        `kind` -> `Stream`
    }
    g[`stdin`] -> stdin_mod

    g[`write`] -> make_native(`io_write`)
    g[`write_line`] -> make_native(`io_writeln`)
    g[`writeln`] -> make_native(`io_writeln`)
    g[`read`] -> make_native(`io_read`)
    g[`read_line`] -> make_native(`io_readln`)
    g[`readln`] -> make_native(`io_readln`)
    g[`type`] -> make_native(`builtin_type`)

    let cli_args -> vm_sys_args()
    when cli_args == Nothing { cli_args -> [] }
    g[`args`] -> cli_args

    let env_map -> __builtin_sys.get_env_map()
    when env_map == Nothing { env_map -> {} }
    g[`env`] -> env_map
    
    let builtin_mod -> {
        `error` -> make_native(`builtin_error`),
        `error_literal` -> make_native(`builtin_error`),
        `string_to_bytes` -> make_native(`builtin_string_to_bytes`),
        `bytes_to_string` -> make_native(`builtin_bytes_to_string`),
        `create_bytes_size` -> make_native(`builtin_create_bytes_size`),
        `create_bytes_list` -> make_native(`builtin_create_bytes_list`),
        `pack_binary` -> make_native(`builtin_pack_binary`),
        `unpack_binary` -> make_native(`builtin_unpack_binary`),
        `get_env` -> make_native(`sys_env`),
        `set_env` -> make_native(`sys_set_env`),
        `list_env` -> make_native(`sys_list_env`),
        `has_env` -> make_native(`sys_has_env`)
    }
    g[`__builtin`] -> builtin_mod
