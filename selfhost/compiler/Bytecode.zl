                when args != Nothing and args.length > 0 {
                    let obj -> args[0]
                    when obj is Map {
                        <- obj[`__type__`] != Nothing or obj[`kind`] != Nothing
                    }
                }
                <- false
            }
            when nfn == `reflect_fields` {
                when args != Nothing and args.length > 0 and (args[0] is Map) {
                    <- args[0].keys()
                }
                <- []
            }
            when nfn == `reflect_has_field` {
                when args != Nothing and args.length > 1 and (args[0] is Map) {
                    <- args[0].has(args[1])
                }
                <- false
            }
            when nfn == `reflect_field` {
                when args != Nothing and args.length > 1 and (args[0] is Map) {
                    <- args[0][args[1]]
                }
                <- Nothing
            }
            when nfn == `reflect_set_field` {
                when args != Nothing and args.length > 2 and (args[0] is Map) {
                    args[0][args[1]] -> args[2]
                    <- args[2]
                }
                <- Nothing
            }
            when nfn == `reflect_methods` {
                <- []
            }
            when nfn == `reflect_has_method` {
                when args != Nothing and args.length > 1 and (args[0] is Map) {
                    let m -> args[0][args[1]]
                    when m != Nothing and (m is Map) and (m[`is_closure`] == true or m[`is_native`] == true or m[`code`] != Nothing) {
                        <- true
                    }
                }
                <- false
            }
            when nfn == `reflect_call` {
                when args != Nothing and args.length > 1 and (args[0] is Map) {
                    let fn_val -> args[0][args[1]]
                    let fn_args -> []
                    when args.length > 2 and (args[2] is List) { fn_args -> args[2] }
                    <- invoke_callable_g(fn_val, fn_args, globals)
                }
                <- Nothing
            }
            when nfn == `reflect_apply` {
                when args != Nothing and args.length > 0 {
                    let fn_val -> args[0]
                    let fn_args -> []
                    when args.length > 1 and (args[1] is List) { fn_args -> args[1] }
                    <- invoke_callable_g(fn_val, fn_args, globals)
                }
                <- Nothing
            }
            <- Nothing
        }
        when callee[`is_method`] != Nothing {
            let recv -> callee[`target`]
            when callee[`method_fn`] != Nothing {
                let call_args -> [recv]
                let ai -> 0
                do while ai < args.length {
                    call_args.append(args[ai])
                    ai -> ai + 1
                }
                <- invoke_callable_g(callee[`method_fn`], call_args, globals)
            }
            let m -> callee[`method`]
            when recv is List {
                when m == `append` or m == `push` {
                    when args.length > 0 {
                        let item -> args[0]
                        let res -> vm_list_append(recv, item)
                    }
                    <- recv
                }
                when m == `pop` {
                    <- vm_list_pop(recv)
                }
                when m == `at` or m == `get` {
                    when args.length > 0 {
                        let idx -> args[0]
                        when idx != Nothing and idx >= 0 and idx < recv.length {
                            <- recv[idx]
                        }
                    }
                    <- Nothing
                }
                when m == `remove_at` {
                    when args.length > 0 {
                        let idx -> args[0]
                        when idx != Nothing and idx >= 0 and idx < recv.length {
                            <- __builtin_list.remove_at(recv, idx)
                        }
                    }
                    <- Nothing
                }
                when m == `size` or m == `count` or m == `length` {
                    <- recv.length
                }
                when m == `has` or m == `contains` {
                    when args.length > 0 {
                        let i -> 0
                        do while i < recv.length {
                            when recv[i] == args[0] { <- true }
                            i -> i + 1
                        }
                    }
                    <- false
                }
                when m == `clear` {
                    do while recv.length > 0 { recv.pop() }
                    <- Nothing
                }
                when m == `clone` {
                    let copy -> []
                    do for item in recv { copy.append(item) }
                    <- copy
                }
                when m == `reverse` {
                    let rev_res -> []
                    let ri -> recv.length - 1
                    do while ri >= 0 {
                        rev_res.append(recv[ri])
                        ri -> ri - 1
                    }
                    <- rev_res
                }
                when m == `unique` {
                    let unq_res -> []
                    do for x in recv {
                        when not (x in unq_res) { unq_res.append(x) }
                    }
                    <- unq_res
                }
                when m == `flatten` {
                    let flat_res -> []
                    do for x in recv {
                        when x is List {
                            do for sub in x { flat_res.append(sub) }
                        } or {
                            flat_res.append(x)
                        }
                    }
                    <- flat_res
                }
                when m == `chunk` {
                    let size -> 1
                    when args.length > 0 { size -> args[0] }
                    when size <= 0 { size -> 1 }
                    let chunk_res -> []
                    let chunk_curr -> []
                    let ci -> 0
                    do for x in recv {
                        when ci % size == 0 and ci > 0 {
                            chunk_res.append(chunk_curr)
                            chunk_curr -> []
                        }
                        chunk_curr.append(x)
                        ci -> ci + 1
                    }
                    when chunk_curr.length > 0 { chunk_res.append(chunk_curr) }
                    <- chunk_res
                }
                when m == `take` {
                    let n -> 0
                    when args.length > 0 { n -> args[0] }
                    when n <= 0 { <- [] }
                    let take_res -> []
                    let ti -> 0
                    do while ti < n and ti < recv.length {
                        take_res.append(recv[ti])
                        ti -> ti + 1
                    }
                    <- take_res
                }
                when m == `drop` {
                    let n -> 0
                    when args.length > 0 { n -> args[0] }
                    when n <= 0 { <- recv }
                    let drop_res -> []
                    let di -> n
                    do while di < recv.length {
                        drop_res.append(recv[di])
                        di -> di + 1
                    }
                    <- drop_res
                }
                when m == `join` {
                    let sep -> ``
                    when args.length > 0 { sep -> Str.to_string(args[0]) }
                    <- Str.join(recv, sep)
                }
                when m == `map` {
                    when args.length == 0 { <- recv }
                    let fn -> args[0]
                    let map_res -> []
                    do for x in recv {
                        map_res.append(invoke_callable_g(fn, [x], globals))
                    }
                    <- map_res
                }
                when m == `filter` {
                    when args.length == 0 { <- recv }
                    let fn -> args[0]
                    let filt_res -> []
                    do for x in recv {
                        when invoke_callable_g(fn, [x], globals) {
                            filt_res.append(x)
                        }
                    }
                    <- filt_res
                }
                when m == `reduce` {
                    when args.length < 2 { <- Nothing }
                    let acc -> args[0]
                    let fn -> args[1]
                    do for x in recv {
                        acc -> invoke_callable_g(fn, [acc, x], globals)
                    }
                    <- acc
                }
                when m == `each` {
                    when args.length > 0 {
                        let fn -> args[0]
                        do for x in recv {
                            invoke_callable_g(fn, [x], globals)
                        }
                    }
                    <- Nothing
                }
                when m == `find` {
                    when args.length == 0 { <- Nothing }
                    let fn -> args[0]
                    do for x in recv {
                        when invoke_callable_g(fn, [x], globals) {
                            <- x
                        }
                    }
                    <- Nothing
                }
                when m == `any` {
                    when args.length == 0 { <- false }
                    let fn -> args[0]
                    do for x in recv {
                        when invoke_callable_g(fn, [x], globals) {
                            <- true
                        }
                    }
                    <- false
                }
                when m == `all` {
                    when args.length == 0 { <- true }
                    let fn -> args[0]
                    do for x in recv {
                        when not invoke_callable_g(fn, [x], globals) {
                            <- false
                        }
                    }
                    <- true
                }
            }
            when recv is String {
                when m == `at` or m == `get` or m == `char_at` {
                    when args.length > 0 {
                        let idx -> args[0]
                        when idx != Nothing and idx >= 0 and idx < Str.length(recv) {
                            <- Str.at(recv, idx)
                        }
                    }
                    <- Nothing
                }
                when m == `length` or m == `size` or m == `count` {
                    <- Str.length(recv)
                }
                when m == `starts_with` {
                    when args.length > 0 { <- Str.starts_with(recv, args[0]) }
                    <- false
                }
                when m == `ends_with` {
                    when args.length > 0 { <- Str.ends_with(recv, args[0]) }
                    <- false
                }
                when m == `contains` or m == `has` {
                    when args.length > 0 { <- Str.contains(recv, args[0]) }
                    <- false
                }
                when m == `index_of` or m == `find` {
                    when args.length > 0 { <- Str.index_of(recv, args[0]) }
                    <- -1
                }
                when m == `substring` or m == `slice` {
                    when args.length > 1 { <- Str.substring(recv, args[0], args[1]) }
                    when args.length > 0 { <- Str.substring(recv, args[0], Str.length(recv)) }
                    <- recv
                }
                when m == `split` {
                    when args.length > 0 { <- Str.split(recv, args[0]) }
                    <- [recv]
                }
                when m == `trim` {
                    <- Str.trim(recv)
                }
                when m == `to_upper` or m == `upper` {
                    <- Str.to_upper(recv)
                }
                when m == `to_lower` or m == `lower` {
                    <- Str.to_lower(recv)
                }
                when m == `replace` {
                    when args.length > 1 { <- Str.replace(recv, args[0], args[1]) }
                    <- recv
                }
                when m == `to_number` or m == `to_int` or m == `to_float` or m == `to_decimal` {
                    when looks_int_str(recv) {
                        <- parse_int_str(recv)
                    } or {
                        <- recv.to_number()
                    }
                }
            }
            when recv is Set {
                when m == `size` or m == `count` or m == `length` {
                    <- recv.length
                }
                when m == `has` or m == `contains` {
                    when args.length > 0 {
                        <- __builtin_set.has(recv, args[0])
                    }
                    <- false
                }
                when m == `add` {
                    when args.length > 0 {
                        __builtin_set.add(recv, args[0])
                    }
                    <- recv
                }
                when m == `remove` {
                    when args.length > 0 {
                        __builtin_set.remove(recv, args[0])
                    }
                    <- recv
                }
                when m == `to_list` {
                    <- __builtin_set.to_list(recv)
                }
                when m == `union` {
                    when args.length == 0 { <- recv }
                    let res_items -> []
                    do for x in __builtin_set.to_list(recv) { res_items.append(x) }
                    let other_items -> __builtin_set.to_list(args[0])
                    do for item in other_items {
                        when not (item in res_items) { res_items.append(item) }
                    }
                    <- __builtin_set.from_list(res_items)
                }
                when m == `intersection` {
                    when args.length == 0 { <- __builtin_set.from_list([]) }
                    let inter_items -> []
                    let l1 -> __builtin_set.to_list(recv)
                    do for x in l1 {
                        when x in args[0] {
                            inter_items.append(x)
                        }
                    }
                    <- __builtin_set.from_list(inter_items)
                }
                when m == `difference` {
                    when args.length == 0 { <- recv }
                    let diff_items -> []
                    let l1 -> __builtin_set.to_list(recv)
                    do for x in l1 {
                        when not (x in args[0]) {
                            diff_items.append(x)
                        }
                    }
                    <- __builtin_set.from_list(diff_items)
                }
            }
            when (recv is Map) and (recv[`kind`] == `Stream` or recv[`__type__`] == `Stream`) {
                when m == `write` {
                    let val -> Nothing
                    when args.length > 0 { val -> args[0] }
                    when recv[`name`] == `stderr` { <- __builtin_io.write_stderr(val) }
                    <- __builtin_io.write(val)
                }
                when m == `writeln` or m == `write_line` {
                    let val -> ``
                    when args.length > 0 { val -> args[0] }
                    when recv[`name`] == `stderr` { <- __builtin_io.write_line_stderr(val) }
                    <- __builtin_io.write_line(val)
                }
                when m == `flush` {
                    when recv[`name`] == `stderr` { <- __builtin_io.flush_stderr() }
                    <- __builtin_io.flush()
                }
                when m == `read` {
                    when args.length > 0 { <- __builtin_io.read(args[0]) }
                    <- __builtin_io.read_line()
                }
                when m == `readln` or m == `read_line` {
                    when args.length > 0 { <- __builtin_io.read(args[0]) }
                    <- __builtin_io.read_line()
                }
                when m == `lines` {
                    <- __builtin_io.stdin_lines()
                }
            }
            when recv is Map {
                when recv[`__type__`] != Nothing {
                    let type_name -> Str.to_string(recv[`__type__`])
                    let full_mname -> type_name + `_` + m
                    when globals[full_mname] != Nothing {
                        let call_args -> [recv]
                        let ai -> 0
                        do while ai < args.length {
                            call_args.append(args[ai])
                            ai -> ai + 1
                        }
                        <- invoke_callable_g(globals[full_mname], call_args, globals)
                    }
                }
                when recv[m] != Nothing {
                    let fn_val -> recv[m]
                    let call_args -> [recv]
                    let ai -> 0
                    do while ai < args.length {
                        call_args.append(args[ai])
                        ai -> ai + 1
                    }
                    <- invoke_callable_g(fn_val, call_args, globals)
                }
                when m == `get` or m == `at` {
                    when args.length > 0 {
                        let k -> args[0]
                        when vm_map_has(recv, k) {
                            <- recv[k]
                        }
                        when args.length > 1 {
                            <- args[1]
                        }
                        <- Nothing
                    }
                    <- Nothing
                }
                when m == `has` or m == `has_key` {
                    when args.length > 0 {
                        <- vm_map_has(recv, args[0])
                    }
                    <- false
                }
                when m == `keys` {
                    <- vm_map_keys(recv)
                }
                when m == `values` {
                    <- vm_map_values(recv)
                }
                when m == `items` or m == `entries` {
                    let items -> []
                    do for k in recv.keys() {
                        items.append({`key` -> k, `value` -> recv[k]})
                    }
                    <- items
                }
                when m == `size` or m == `count` or m == `length` {
                    <- recv.keys().length
                }
                when m == `clear` {
                    let ks -> recv.keys()
                    do for k in ks { recv.remove(k) }
                    <- Nothing
                }
                when m == `delete` or m == `remove` {
                    when args.length > 0 and recv.has(args[0]) {
                        recv.remove(args[0])
                    }
                    <- recv
                }
                when m == `merge` {
                    let res_map -> {}
                    do for k in vm_map_keys(recv) { res_map[k] -> recv[k] }
                    when args.length > 0 {
                        do for k in vm_map_keys(args[0]) { res_map[k] -> args[0][k] }
                    }
                    <- res_map
                }
                when m == `invert` {
                    let inv_map -> {}
                    do for k in vm_map_keys(recv) {
                        inv_map[recv[k]] -> k
                    }
                    <- inv_map
                }
            }
            when m == `read` {
                <- recv.read()
            }
            when m == `write` {
                when args.length > 0 { <- recv.write(args[0]) }
                <- Nothing
            }
            when m == `close` {
                <- recv.close()
            }
            when m == `wait` {
                <- recv.wait()
            }
            when m == `get_stdout` {
                <- recv.get_stdout()
            }
            when m == `get_code` {
                <- recv.get_code()
            }
            when m == `kill` {
                <- recv.kill()
            }
            <- Nothing
        }
        when callee[`is_closure`] != Nothing {
            <- eval_chunk_fn(callee[`chunk`], args, globals, callee[`captures`])
        }
        when callee[`code`] != Nothing {
            <- eval_chunk_fn(callee, args, globals, Nothing)
        }
        when callee[`fn`] != Nothing {
            <- invoke_callable_g(callee[`fn`], args, globals)
        }
        when callee[`enum_name`] != Nothing or callee[`variant_name`] != Nothing {
            let en -> callee[`enum_name`]
            let vn -> callee[`variant_name`]
            when en == Nothing { en -> callee[`enum`] }
            when vn == Nothing { vn -> callee[`tag`] }
            <- {
                `enum_name` -> en,
                `variant_name` -> vn,
                `data` -> args,
                `__type__` -> en
            }
        }
    }
    <- __builtin_reflect.apply(callee, args)
}

function vm_is_default(v) {
    when v == Default { <- true }
    when (v is Map) and v[`kind`] == `DefaultSentinel` { <- true }
    <- false
}

function vm_is_zero(v) {
    when v == 0 or v == 0.0 or v == false or v == `` { <- true }
    when (v is List) and v.length == 0 { <- true }
    when (v is Map) and v.keys().length == 0 { <- true }
    <- false
}

function vm_equal(a, b) {
    let a_def -> vm_is_default(a)
    let b_def -> vm_is_default(b)
    when a_def and b_def { <- true }
    when a_def {
        when b == Nothing { <- false }
        <- vm_is_zero(b)
    }
    when b_def {
        when a == Nothing { <- false }
        <- vm_is_zero(a)
    }
    <- a == b
}

export function eval_chunk(chunk, globals) {
    when globals == Nothing or globals.keys().length == 0 {
        globals -> create_vm_prelude()
    }
    let code -> chunk[`code`]
    let consts -> chunk[`constants`]
    let stack -> []
    let locals -> []
    let li -> 0
    let num_loc -> chunk[`num_locals`]
    do while li < num_loc {
        locals.append(Nothing)
        li -> li + 1
    }
    let ip -> 0
    let n -> code.length

    do while ip < n {
        let op -> code[ip]
        ip -> ip + 1

        when op == 0 { // OP_NOP
            // do nothing
        }
        or when op == 1 { // OP_CONST
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            stack.append(consts[idx])
        }
        or when op == 2 { // OP_NOTHING
            stack.append(Nothing)
        }
        or when op == 3 { // OP_DEFAULT
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let tid -> (hi * 256) + lo
            when tid == 3 {
                stack.append(0)
            } or when tid == 4 {
                stack.append(0.0)
            } or when tid == 2 {
                stack.append(false)
            } or when tid == 5 {
                stack.append(``)
            } or when tid == 6 {
                stack.append([])
            } or when tid == 7 {
                stack.append({})
            } or {
                stack.append(Default)
            }
        }
        or when op == 4 { // OP_TRUE
            stack.append(true)
        }
        or when op == 5 { // OP_FALSE
            stack.append(false)
        }
        or when op == 16 { // OP_POP
            stack.pop()
        }
        or when op == 17 { // OP_DUP
            let top -> stack[stack.length - 1]
            stack.append(top)
        }
        or when op == 32 { // OP_LOAD_LOCAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let slot -> (hi * 256) + lo
            when slot < locals.length {
                stack.append(locals[slot])
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 33 { // OP_STORE_LOCAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let slot -> (hi * 256) + lo
            let val -> stack.pop()
            do while locals.length <= slot {
                locals.append(Nothing)
            }
            locals[slot] -> val
        }
        or when op == 34 { // OP_LOAD_GLOBAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let gname -> consts[idx]
            when globals[gname] != Nothing {
                stack.append(globals[gname])
            } or when Str.contains(gname, `_`) {
                let under_pos -> Str.index_of(gname, `_`)
                let prefix -> Str.substring(gname, 0, under_pos)
                let member_name -> Str.substring(gname, under_pos + 1, Str.length(gname))
                when globals[prefix] != Nothing and globals[prefix] is Map and globals[prefix][member_name] != Nothing {
                    stack.append(globals[prefix][member_name])
                } or when globals[member_name] != Nothing {
                    stack.append(globals[member_name])
                } or {
                    stack.append(Nothing)
                }
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 35 { // OP_STORE_GLOBAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let gname -> consts[idx]
            let val -> stack.pop()
            globals[gname] -> val
        }
        or when op == 48 { // OP_ADD
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a + b)
        }
        or when op == 49 { // OP_SUB
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_sub_vm(a, b))
        }
        or when op == 50 { // OP_MUL
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a * b)
        }
        or when op == 51 { // OP_DIV
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a / b)
        }
        or when op == 52 { // OP_MOD
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a % b)
        }
        or when op == 53 { // OP_NEG
            let a -> stack.pop()
            stack.append(-a)
        }
        or when op == 54 { // OP_NOT
            let a -> stack.pop()
            when a == false or a == Nothing or a == 0 or a == `` {
                stack.append(true)
            } or {
                stack.append(false)
            }
        }
        or when op == 55 { // OP_BIT_NOT
            let a -> stack.pop()
            stack.append(~parse_int_str(a))
        }
        or when op == 56 { // OP_BIT_AND
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) & parse_int_str(b))
        }
        or when op == 57 { // OP_BIT_OR
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) | parse_int_str(b))
        }
        or when op == 58 { // OP_BIT_XOR
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) ^^ parse_int_str(b))
        }
        or when op == 59 { // OP_SHL
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) << parse_int_str(b))
        }
        or when op == 60 { // OP_SHR
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) >> parse_int_str(b))
        }
        or when op == 61 { // OP_POW
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_pow_vm(a, b))
        }
        or when op == 64 { // OP_EQ
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(vm_equal(a, b))
        }
        or when op == 65 { // OP_NEQ
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(not vm_equal(a, b))
        }
        or when op == 66 { // OP_LT
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a < b)
        }
        or when op == 67 { // OP_LTE
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a <= b)
        }
        or when op == 68 { // OP_GT
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a > b)
        }
        or when op == 69 { // OP_GTE
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a >= b)
        }
        or when op == 80 { // OP_MAKE_LIST
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let cnt -> (hi * 256) + lo
            let l -> []
            let items -> []
            let ci -> 0
            do while ci < cnt {
                items.append(stack.pop())
                ci -> ci + 1
            }
            let ri -> items.length - 1
            do while ri >= 0 {
                l.append(items[ri])
                ri -> ri - 1
            }
            stack.append(l)
        }
        or when op == 81 { // OP_MAKE_MAP
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let cnt -> (hi * 256) + lo
            let m -> {}
            let pairs -> []
            let ci -> 0
            do while ci < cnt {
                let v -> stack.pop()
                let k -> stack.pop()
                pairs.append({ `k` -> k, `v` -> v })
                ci -> ci + 1
            }
            let ri -> pairs.length - 1
            do while ri >= 0 {
                let p -> pairs[ri]
                m[p[`k`]] -> p[`v`]
                ri -> ri - 1
            }
            stack.append(m)
        }
        or when op == 82 { // OP_GET_INDEX
            let key -> stack.pop()
            let obj -> stack.pop()
            when obj == Nothing {
                stack.append(Nothing)
            } or when obj is Map {
                stack.append(obj[key])
            } or when (obj is List) and ((key is Integer) or (key is Decimal) or looks_int_str(key)) {
                let kidx -> 0
                when (key is Integer) { kidx -> key } or { kidx -> parse_int_str(key) }
                when kidx < 0 { kidx -> kidx + obj.length }
                when kidx >= 0 and kidx < obj.length {
                    stack.append(obj[kidx])
                } or {
                    stack.append(Nothing)
                }
            } or when (obj is String) and ((key is Integer) or (key is Decimal) or looks_int_str(key)) {
                let kidx -> 0
                when (key is Integer) { kidx -> key } or { kidx -> parse_int_str(key) }
                when kidx < 0 { kidx -> kidx + Str.length(obj) }
                when kidx >= 0 and kidx < Str.length(obj) {
                    stack.append(Str.at(obj, kidx))
                } or {
                    stack.append(Nothing)
                }
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 83 { // OP_SET_INDEX
            let val -> stack.pop()
            let key -> stack.pop()
            let obj -> stack.pop()
            set_index(obj, key, val)
            stack.append(val)
        }
        or when op == 84 { // OP_GET_PROP
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let prop -> consts[idx]
            let obj -> stack.pop()
            when obj == Nothing {
                stack.append(Nothing)
            } or when (obj is Map) and obj[`__type__`] != Nothing and globals.has(obj[`__type__`] + `_` + prop) {
                stack.append({
                    `target` -> obj,
                    `method_fn` -> globals[obj[`__type__`] + `_` + prop],
                    `is_method` -> true
                })
            } or when (obj is Map) and obj[`__type`] != Nothing and globals.has(obj[`__type`] + `_` + prop) {
                stack.append({
                    `target` -> obj,
                    `method_fn` -> globals[obj[`__type`] + `_` + prop],
                    `is_method` -> true
                })
            } or when (obj is Map) and obj.has(prop) {
                stack.append(obj[prop])
            } or when prop == `length` {
                when obj is List or obj is String {
                    stack.append(obj.length)
                } or when obj is Map {
                    stack.append(obj.keys().length)
                } or {
                    stack.append(0)
                }
            } or when prop == `kind` {
                when obj is String {
                    stack.append(`String`)
                } or when obj is List {
                    stack.append(`List`)
                } or when obj is Integer {
                    stack.append(`Integer`)
                } or when obj is Decimal {
                    stack.append(`Decimal`)
                } or when obj is Boolean {
                    stack.append(`Boolean`)
                } or when obj is Rune {
                    stack.append(`Rune`)
                } or when obj is Bytes {
                    stack.append(`Bytes`)
                } or when obj is Set {
                    stack.append(`Set`)
                } or when obj is Map {
                    when obj[`kind`] != Nothing {
                        stack.append(obj[`kind`])
                    } or when obj[`__type__`] != Nothing {
                        stack.append(obj[`__type__`])
                    } or {
                        stack.append(`Map`)
                    }
                } or {
                    stack.append(Nothing)
                }
            } or when prop == `read` or prop == `write` or prop == `close` or prop == `flush` or prop == `get_stdout` or prop == `get_code` or prop == `wait` or prop == `kill` {
                stack.append({
                    `target` -> obj,
                    `method` -> prop,
                    `is_method` -> true
                })
            } or when (obj is List or obj is Map or obj is Set) and (
                prop == `append` or prop == `push` or prop == `pop` or prop == `has` or
                prop == `contains` or prop == `keys` or prop == `values` or prop == `items` or
                prop == `entries` or prop == `at` or prop == `get` or prop == `remove_at` or
                prop == `size` or prop == `count` or prop == `length` or prop == `add` or
                prop == `remove` or prop == `to_list` or prop == `clear` or prop == `clone`
            ) {
                stack.append({
                    `target` -> obj,
                    `method` -> prop,
                    `is_method` -> true
                })
            } or {
                stack.append({
                    `target` -> obj,
                    `method` -> prop,
                    `is_method` -> true
                })
            }
        }
        or when op == 85 { // OP_IS_TYPE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let tname -> consts[idx]
            let val -> stack.pop()
            stack.append(eval_is_type_vm(val, tname))
        }
        or when op == 86 { // OP_CAST
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let target_type -> consts[idx]
            let val -> stack.pop()
            stack.append(eval_cast_vm(val, target_type))
        }
        or when op == 87 { // OP_MAKE_CLOSURE
            let hi1 -> code[ip]
            let lo1 -> code[ip + 1]
            let hi2 -> code[ip + 2]
            let lo2 -> code[ip + 3]
            ip -> ip + 4
            let chunk_idx -> (hi1 * 256) + lo1
            let cap_cnt -> (hi2 * 256) + lo2
            let fn_chunk -> consts[chunk_idx]
            let caps -> []
            let ci -> 0
            do while ci < cap_cnt {
                caps.append(stack.pop())
                ci -> ci + 1
            }
            let rcaps -> []
            let ri -> caps.length - 1
            do while ri >= 0 {
                rcaps.append(caps[ri])
                ri -> ri - 1
            }
            stack.append({
                `chunk` -> fn_chunk,
                `captures` -> rcaps,
                `is_closure` -> true
            })
        }
        or when op == 94 { // OP_RANGE_BETWEEN (a..b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, false, true))
        }
        or when op == 88 { // OP_RANGE_EXCL (a..-b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, false, false))
        }
        or when op == 89 { // OP_RANGE_INCL (a...b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, true, false))
        }
        or when op == 93 { // OP_RANGE_INCL_END (a..+b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, true, true))
        }
        or when op == 90 { // OP_CONCAT_APPEND (a ++ b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_concat_append_vm(a, b))
        }
        or when op == 91 { // OP_DROP (a -- b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_drop_vm(a, b))
        }
        or when op == 92 { // OP_CHECK_UNWRAP
            let top -> stack.pop()
            when top is Error or (top != Nothing and top is Map and top[`__type__`] != Nothing and top[`__type__`] == `Error`) {
                stack.append(Nothing)
            } or {
                stack.append(top)
            }
        }
        or when op == 95 { // OP_IN (a in b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_in_vm(a, b))
        }
        or when op == 96 { // OP_JUMP
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            ip -> ip + offset
        }
        or when op == 97 { // OP_JUMP_IF_FALSE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack[stack.length - 1]
            when top == false or top == Nothing or top == 0 {
                ip -> ip + offset
            }
        }
        or when op == 98 { // OP_JUMP_IF_TRUE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack[stack.length - 1]
            when top != false and top != Nothing and top != 0 {
                ip -> ip + offset
            }
        }
        or when op == 99 { // OP_POP_JUMP_IF_FALSE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack.pop()
            when top == false or top == Nothing or top == 0 {
                ip -> ip + offset
            }
        }
        or when op == 100 { // OP_POP_JUMP_IF_TRUE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack.pop()
            when top != false and top != Nothing and top != 0 {
                ip -> ip + offset
            }
        }
        or when op == 101 { // OP_COALESCE (a ?? b)
            let b -> stack.pop()
            let a -> stack.pop()
            when a != Nothing {
                stack.append(a)
