                stack.append(b)
            }
        }
        or when op == 102 { // OP_SLICE
            let stp -> stack.pop()
            let e -> stack.pop()
            let s -> stack.pop()
            let obj -> stack.pop()
            stack.append(vm_slice(obj, s, e, stp))
        }
        or when op == 112 { // OP_CALL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let argc -> (hi * 256) + lo
            
            let args -> []
            let ai -> 0
            do while ai < argc {
                args.append(stack.pop())
                ai -> ai + 1
            }
            let rargs -> []
            let ri -> args.length - 1
            do while ri >= 0 {
                rargs.append(args[ri])
                ri -> ri - 1
            }
            let callee -> stack.pop()
            
            when callee != Nothing and (callee is Map) and callee[`is_method`] != Nothing and callee[`method_fn`] != Nothing {
                let call_args -> [callee[`target`]]
                let ai -> 0
                do while ai < rargs.length {
                    call_args.append(rargs[ai])
                    ai -> ai + 1
                }
                let fn_res -> eval_chunk_fn(callee[`method_fn`], call_args, globals, Nothing)
                stack.append(fn_res)
            } or when callee != Nothing and (callee is Map) and callee[`is_closure`] != Nothing {
                let fn_res -> eval_chunk_fn(callee[`chunk`], rargs, globals, callee[`captures`])
                stack.append(fn_res)
            } or when callee != Nothing and (callee is Map) and callee[`code`] != Nothing {
                let fn_res -> eval_chunk_fn(callee, rargs, globals, Nothing)
                stack.append(fn_res)
            } or {
                let fn_res -> invoke_callable_g(callee, rargs, globals)
                stack.append(fn_res)
            }
        }
        or when op == 113 { // OP_RETURN
            when stack.length > 0 {
                <- stack.pop()
            }
            <- Nothing
        }
        or when op == 255 { // OP_HALT
            when stack.length > 0 {
                <- stack.pop()
            }
            <- Nothing
        }
    }
    
    when stack.length > 0 {
        <- stack.pop()
    }
    <- Nothing
}

function eval_chunk_fn(chunk, args, globals, captures) {
    let code -> chunk[`code`]
    let consts -> chunk[`constants`]
    let stack -> []
    let locals -> []
    
    let ai -> 0
    let an -> args.length
    do while ai < an {
        locals.append(args[ai])
        ai -> ai + 1
    }
    
    let num_loc -> chunk[`num_locals`]
    do while locals.length < num_loc {
        locals.append(Nothing)
    }

    let ip -> 0
    let code_len -> code.length

    do while ip < code_len {
        let op -> code[ip]
        ip -> ip + 1

        when op == 0 { // OP_NOP
            // pass
        }
        or when op == 1 { // OP_CONST
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            stack.append(consts[idx])
        }
        or when op == 2 { // OP_NOTHING
            stack.append(Nothing)
        }
        or when op == 3 { // OP_DEFAULT
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let tid -> (hi * 256) + lo
            when tid == 3 {
                stack.append(0)
            } or when tid == 4 {
                stack.append(0.0)
            } or when tid == 2 {
                stack.append(false)
            } or when tid == 5 {
                stack.append(``)
            } or when tid == 6 {
                stack.append([])
            } or when tid == 7 {
                stack.append({})
            } or {
                stack.append(Default)
            }
        }
        or when op == 4 { // OP_TRUE
            stack.append(true)
        }
        or when op == 5 { // OP_FALSE
            stack.append(false)
        }
        or when op == 16 { // OP_POP
            stack.pop()
        }
        or when op == 17 { // OP_DUP
            let top -> stack[stack.length - 1]
            stack.append(top)
        }
        or when op == 32 { // OP_LOAD_LOCAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let slot -> (hi * 256) + lo
            when slot < locals.length {
                stack.append(locals[slot])
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 33 { // OP_STORE_LOCAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let slot -> (hi * 256) + lo
            let val -> stack.pop()
            do while locals.length <= slot {
                locals.append(Nothing)
            }
            locals[slot] -> val
        }
        or when op == 38 { // OP_LOAD_CAPTURE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            when captures != Nothing and idx < captures.length {
                stack.append(captures[idx])
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 39 { // OP_STORE_CAPTURE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let val -> stack[stack.length - 1]
            when captures != Nothing and idx < captures.length {
                captures[idx] -> val
            }
        }
        or when op == 34 { // OP_LOAD_GLOBAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let gname -> consts[idx]
            when globals[gname] != Nothing {
                stack.append(globals[gname])
            } or when Str.contains(gname, `_`) {
                let under_pos -> Str.index_of(gname, `_`)
                let prefix -> Str.substring(gname, 0, under_pos)
                let member_name -> Str.substring(gname, under_pos + 1, Str.length(gname))
                when globals[prefix] != Nothing and globals[prefix] is Map and globals[prefix][member_name] != Nothing {
                    stack.append(globals[prefix][member_name])
                } or when globals[member_name] != Nothing {
                    stack.append(globals[member_name])
                } or {
                    stack.append(Nothing)
                }
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 35 { // OP_STORE_GLOBAL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let gname -> consts[idx]
            let val -> stack.pop()
            globals[gname] -> val
        }
        or when op == 48 { // OP_ADD
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a + b)
        }
        or when op == 49 { // OP_SUB
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_sub_vm(a, b))
        }
        or when op == 50 { // OP_MUL
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a * b)
        }
        or when op == 51 { // OP_DIV
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a / b)
        }
        or when op == 52 { // OP_MOD
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a % b)
        }
        or when op == 53 { // OP_NEG
            let a -> stack.pop()
            stack.append(-a)
        }
        or when op == 54 { // OP_NOT
            let a -> stack.pop()
            when a == false or a == Nothing or a == 0 or a == `` {
                stack.append(true)
            } or {
                stack.append(false)
            }
        }
        or when op == 55 { // OP_BIT_NOT
            let a -> stack.pop()
            stack.append(~parse_int_str(a))
        }
        or when op == 56 { // OP_BIT_AND
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) & parse_int_str(b))
        }
        or when op == 57 { // OP_BIT_OR
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) | parse_int_str(b))
        }
        or when op == 58 { // OP_BIT_XOR
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) ^^ parse_int_str(b))
        }
        or when op == 59 { // OP_SHL
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) << parse_int_str(b))
        }
        or when op == 60 { // OP_SHR
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(parse_int_str(a) >> parse_int_str(b))
        }
        or when op == 61 { // OP_POW
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_pow_vm(a, b))
        }
        or when op == 64 { // OP_EQ
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a == b)
        }
        or when op == 65 { // OP_NEQ
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a != b)
        }
        or when op == 66 { // OP_LT
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a < b)
        }
        or when op == 67 { // OP_LTE
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a <= b)
        }
        or when op == 68 { // OP_GT
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a > b)
        }
        or when op == 69 { // OP_GTE
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(a >= b)
        }
        or when op == 80 { // OP_MAKE_LIST
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let cnt -> (hi * 256) + lo
            let l -> []
            let items -> []
            let ci -> 0
            do while ci < cnt {
                items.append(stack.pop())
                ci -> ci + 1
            }
            let ri -> items.length - 1
            do while ri >= 0 {
                l.append(items[ri])
                ri -> ri - 1
            }
            stack.append(l)
        }
        or when op == 81 { // OP_MAKE_MAP
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let cnt -> (hi * 256) + lo
            let m -> {}
            let pairs -> []
            let ci -> 0
            do while ci < cnt {
                let v -> stack.pop()
                let k -> stack.pop()
                pairs.append({ `k` -> k, `v` -> v })
                ci -> ci + 1
            }
            let ri -> pairs.length - 1
            do while ri >= 0 {
                let p -> pairs[ri]
                m[p[`k`]] -> p[`v`]
                ri -> ri - 1
            }
            stack.append(m)
        }
        or when op == 82 { // OP_GET_INDEX
            let key -> stack.pop()
            let obj -> stack.pop()
            when obj == Nothing {
                stack.append(Nothing)
            } or when obj is Map {
                stack.append(obj[key])
            } or when (obj is List) and ((key is Integer) or (key is Decimal) or looks_int_str(key)) {
                let kidx -> 0
                when (key is Integer) { kidx -> key } or { kidx -> parse_int_str(key) }
                when kidx < 0 { kidx -> kidx + obj.length }
                when kidx >= 0 and kidx < obj.length {
                    stack.append(obj[kidx])
                } or {
                    stack.append(Nothing)
                }
            } or when (obj is String) and ((key is Integer) or (key is Decimal) or looks_int_str(key)) {
                let kidx -> 0
                when (key is Integer) { kidx -> key } or { kidx -> parse_int_str(key) }
                when kidx < 0 { kidx -> kidx + Str.length(obj) }
                when kidx >= 0 and kidx < Str.length(obj) {
                    stack.append(Str.at(obj, kidx))
                } or {
                    stack.append(Nothing)
                }
            } or {
                stack.append(Nothing)
            }
        }
        or when op == 83 { // OP_SET_INDEX
            let val -> stack.pop()
            let key -> stack.pop()
            let obj -> stack.pop()
            set_index(obj, key, val)
            stack.append(val)
        }
        or when op == 84 { // OP_GET_PROP
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let prop -> consts[idx]
            let obj -> stack.pop()
            when obj == Nothing {
                stack.append(Nothing)
            } or when (obj is Map) and obj[`__type__`] != Nothing and globals.has(obj[`__type__`] + `_` + prop) {
                stack.append({
                    `target` -> obj,
                    `method_fn` -> globals[obj[`__type__`] + `_` + prop],
                    `is_method` -> true
                })
            } or when (obj is Map) and obj[`__type`] != Nothing and globals.has(obj[`__type`] + `_` + prop) {
                stack.append({
                    `target` -> obj,
                    `method_fn` -> globals[obj[`__type`] + `_` + prop],
                    `is_method` -> true
                })
            } or when (obj is Map) and obj.has(prop) {
                stack.append(obj[prop])
            } or when prop == `length` {
                when obj is List or obj is String {
                    stack.append(obj.length)
                } or when obj is Map {
                    stack.append(obj.keys().length)
                } or {
                    stack.append(0)
                }
            } or when prop == `kind` {
                when obj is String {
                    stack.append(`String`)
                } or when obj is List {
                    stack.append(`List`)
                } or when obj is Integer {
                    stack.append(`Integer`)
                } or when obj is Decimal {
                    stack.append(`Decimal`)
                } or when obj is Boolean {
                    stack.append(`Boolean`)
                } or when obj is Rune {
                    stack.append(`Rune`)
                } or when obj is Bytes {
                    stack.append(`Bytes`)
                } or when obj is Set {
                    stack.append(`Set`)
                } or when obj is Map {
                    when obj[`kind`] != Nothing {
                        stack.append(obj[`kind`])
                    } or when obj[`__type__`] != Nothing {
                        stack.append(obj[`__type__`])
                    } or {
                        stack.append(`Map`)
                    }
                } or {
                    stack.append(Nothing)
                }
            } or when prop == `read` or prop == `write` or prop == `close` or prop == `flush` or prop == `get_stdout` or prop == `get_code` or prop == `wait` or prop == `kill` {
                stack.append({
                    `target` -> obj,
                    `method` -> prop,
                    `is_method` -> true
                })
            } or when (obj is List or obj is Map or obj is Set) and (
                prop == `append` or prop == `push` or prop == `pop` or prop == `has` or
                prop == `contains` or prop == `keys` or prop == `values` or prop == `items` or
                prop == `entries` or prop == `at` or prop == `get` or prop == `remove_at` or
                prop == `size` or prop == `count` or prop == `length` or prop == `add` or
                prop == `remove` or prop == `to_list` or prop == `clear` or prop == `clone`
            ) {
                stack.append({
                    `target` -> obj,
                    `method` -> prop,
                    `is_method` -> true
                })
            } or {
                stack.append({
                    `target` -> obj,
                    `method` -> prop,
                    `is_method` -> true
                })
            }
        }
        or when op == 85 { // OP_IS_TYPE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let tname -> consts[idx]
            let val -> stack.pop()
            stack.append(eval_is_type_vm(val, tname))
        }
        or when op == 86 { // OP_CAST
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let idx -> (hi * 256) + lo
            let target_type -> consts[idx]
            let val -> stack.pop()
            stack.append(eval_cast_vm(val, target_type))
        }
        or when op == 87 { // OP_MAKE_CLOSURE
            let hi1 -> code[ip]
            let lo1 -> code[ip + 1]
            let hi2 -> code[ip + 2]
            let lo2 -> code[ip + 3]
            ip -> ip + 4
            let chunk_idx -> (hi1 * 256) + lo1
            let cap_cnt -> (hi2 * 256) + lo2
            let fn_chunk -> consts[chunk_idx]
            let caps -> []
            let ci -> 0
            do while ci < cap_cnt {
                caps.append(stack.pop())
                ci -> ci + 1
            }
            let rcaps -> []
            let ri -> caps.length - 1
            do while ri >= 0 {
                rcaps.append(caps[ri])
                ri -> ri - 1
            }
            stack.append({
                `chunk` -> fn_chunk,
                `captures` -> rcaps,
                `is_closure` -> true
            })
        }
        or when op == 94 { // OP_RANGE_BETWEEN (a..b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, false, true))
        }
        or when op == 88 { // OP_RANGE_EXCL (a..-b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, false, false))
        }
        or when op == 89 { // OP_RANGE_INCL (a...b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, true, false))
        }
        or when op == 93 { // OP_RANGE_INCL_END (a..+b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_range_vm(a, b, true, true))
        }
        or when op == 90 { // OP_CONCAT_APPEND (a ++ b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_concat_append_vm(a, b))
        }
        or when op == 91 { // OP_DROP (a -- b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_drop_vm(a, b))
        }
        or when op == 92 { // OP_CHECK_UNWRAP
            let top -> stack.pop()
            when top is Error or (top != Nothing and top is Map and top[`__type__`] != Nothing and top[`__type__`] == `Error`) {
                stack.append(Nothing)
            } or {
                stack.append(top)
            }
        }
        or when op == 95 { // OP_IN (a in b)
            let b -> stack.pop()
            let a -> stack.pop()
            stack.append(eval_in_vm(a, b))
        }
        or when op == 96 { // OP_JUMP
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            ip -> ip + offset
        }
        or when op == 97 { // OP_JUMP_IF_FALSE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack[stack.length - 1]
            when top == false or top == Nothing or top == 0 {
                ip -> ip + offset
            }
        }
        or when op == 98 { // OP_JUMP_IF_TRUE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack[stack.length - 1]
            when top != false and top != Nothing and top != 0 {
                ip -> ip + offset
            }
        }
        or when op == 99 { // OP_POP_JUMP_IF_FALSE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack.pop()
            when top == false or top == Nothing or top == 0 {
                ip -> ip + offset
            }
        }
        or when op == 100 { // OP_POP_JUMP_IF_TRUE
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let offset -> (hi * 256) + lo
            when offset > 32767 {
                offset -> offset - 65536
            }
            let top -> stack.pop()
            when top != false and top != Nothing and top != 0 {
                ip -> ip + offset
            }
        }
        or when op == 101 { // OP_COALESCE (a ?? b)
            let b -> stack.pop()
            let a -> stack.pop()
            when a != Nothing {
                stack.append(a)
            } or {
                stack.append(b)
            }
        }
        or when op == 102 { // OP_SLICE
            let stp -> stack.pop()
            let e -> stack.pop()
            let s -> stack.pop()
            let obj -> stack.pop()
            stack.append(vm_slice(obj, s, e, stp))
        }
        or when op == 112 { // OP_CALL
            let hi -> code[ip]
            let lo -> code[ip + 1]
            ip -> ip + 2
            let argc -> (hi * 256) + lo
            
            let args2 -> []
            let ai2 -> 0
            do while ai2 < argc {
                args2.append(stack.pop())
                ai2 -> ai2 + 1
            }
            let rargs2 -> []
            let ri2 -> args2.length - 1
            do while ri2 >= 0 {
                rargs2.append(args2[ri2])
                ri2 -> ri2 - 1
            }
            let callee2 -> stack.pop()
            
            when callee2 != Nothing and (callee2 is Map) and callee2[`is_method`] != Nothing and callee2[`method_fn`] != Nothing {
                let call_args2 -> [callee2[`target`]]
                let ai2 -> 0
                do while ai2 < rargs2.length {
                    call_args2.append(rargs2[ai2])
                    ai2 -> ai2 + 1
                }
                let fn_res2 -> eval_chunk_fn(callee2[`method_fn`], call_args2, globals, Nothing)
                stack.append(fn_res2)
            } or when callee2 != Nothing and (callee2 is Map) and callee2[`is_closure`] != Nothing {
                let fn_res2 -> eval_chunk_fn(callee2[`chunk`], rargs2, globals, callee2[`captures`])
                stack.append(fn_res2)
            } or when callee2 != Nothing and (callee2 is Map) and callee2[`code`] != Nothing {
                let fn_res2 -> eval_chunk_fn(callee2, rargs2, globals, Nothing)
                stack.append(fn_res2)
            } or when callee2 == Nothing {
                stack.append(Nothing)
            } or {
                let fn_res2 -> invoke_callable_g(callee2, rargs2, globals)
                stack.append(fn_res2)
            }
        }
        or when op == 113 { // OP_RETURN
            when stack.length > 0 {
                <- stack.pop()
            }
            <- Nothing
        }
        or when op == 255 { // OP_HALT
            when stack.length > 0 {
                <- stack.pop()
            }
            <- Nothing
        }
    }
    
    when stack.length > 0 {
        <- stack.pop()
    }
    <- Nothing
}

// --- Bytecode Serialization, Caching (.zbc) & Packaging ---

export function serialize_chunk(chunk, src_hash) {
    when src_hash == Nothing {
        src_hash -> `0`
    }
    let num_locals -> chunk[`num_locals`]
    let cname -> chunk[`name`]
    when cname == Nothing {
        cname -> `main`
    }
    let out -> `ZENB:1:` + Str.to_string(src_hash) + `:` + Str.to_string(num_locals) + `:` + Str.to_string(cname) + `\n`
    
    // Constants
    let consts -> chunk[`constants`]
    let cn -> 0
    when consts != Nothing {
        cn -> consts.length
    }
    out -> out + `CONSTANTS:` + Str.to_string(cn) + `\n`
    let ci -> 0
    do while ci < cn {
        let cv -> consts[ci]
        when cv is Map and cv[`code`] != Nothing {
            let sub_text -> serialize_chunk(cv, `sub`)
            sub_text -> Str.replace(sub_text, `\\`, `\\\\`)
            sub_text -> Str.replace(sub_text, `\n`, `\\n`)
            out -> out + `F:` + sub_text + `\n`
        } or when cv == Nothing {
            out -> out + `N:\n`
        } or when cv == Default {
            out -> out + `D:\n`
        } or when cv == True or cv == true {
            out -> out + `B:1\n`
        } or when cv == False or cv == false {
            out -> out + `B:0\n`
        } or {
            let sval -> Str.to_string(cv)
            let slen -> Str.length(sval)
            let is_num -> True
            when slen == 0 {
                is_num -> False
            }
            let si -> 0
            when slen > 0 and Str.at(sval, 0) == `-` {
                si -> 1
            }
            do while si < slen and is_num {
                let ch -> Str.at(sval, si)
                when Str.index_of(`0123456789`, ch) == -1 {
                    is_num -> False
                }
                si -> si + 1
            }
            when is_num {
                out -> out + `I:` + sval + `\n`
            } or {
                sval -> Str.replace(sval, `\\`, `\\\\`)
                sval -> Str.replace(sval, `\n`, `\\n`)
                out -> out + `S:` + sval + `\n`
            }
        }
        ci -> ci + 1
    }

    // Code
    let code -> chunk[`code`]
    let code_len -> 0
    when code != Nothing {
        code_len -> code.length
    }
    out -> out + `CODE:` + Str.to_string(code_len) + `\n`
    let cdi -> 0
    let code_str -> ``
    do while cdi < code_len {
        let b -> Str.to_string(code[cdi])
        when code_str == `` {
            code_str -> b
        } or {
            code_str -> code_str + `,` + b
        }
        cdi -> cdi + 1
    }
    out -> out + code_str + `\n`

    // Lines
    let lines -> chunk[`lines`]
    let lines_len -> 0
    when lines != Nothing {
        lines_len -> lines.length
    }
    out -> out + `LINES:` + Str.to_string(lines_len) + `\n`
    let ldi -> 0
    let lines_str -> ``
    do while ldi < lines_len {
        let ln -> Str.to_string(lines[ldi])
        when lines_str == `` {
            lines_str -> ln
        } or {
            lines_str -> lines_str + `,` + ln
        }
        ldi -> ldi + 1
    }
    out -> out + lines_str + `\n`

    <- out
}

export function deserialize_chunk(raw_text) {
    when raw_text == Nothing or raw_text == `` {
        <- {`ok` -> false, `error` -> `empty bytecode payload`}
    }
    let lines -> Str.split(raw_text, `\n`)
    when lines.length < 5 {
        <- {`ok` -> false, `error` -> `invalid bytecode format: too short`}
    }
    let hparts -> Str.split(lines[0], `:`)
    when hparts.length < 5 or hparts[0] != `ZENB` {
        <- {`ok` -> false, `error` -> `invalid magic header in bytecode`}
    }
    let src_hash -> hparts[2]
    let num_locals -> parse_int_str(hparts[3])
    let cname -> hparts[4]

    let li -> 1
    // Parse Constants
    let c_header -> Str.split(lines[li], `:`)
    when c_header[0] != `CONSTANTS` {
        <- {`ok` -> false, `error` -> `expected CONSTANTS section`}
    }
    let const_count -> parse_int_str(c_header[1])
    li -> li + 1

    let consts -> []
    let ci -> 0
    do while ci < const_count and li < lines.length {
        let cline -> lines[li]
        let colon -> Str.index_of(cline, `:`)
        when colon != -1 {
            let tag -> Str.substring(cline, 0, colon)
            let val_str -> Str.substring(cline, colon + 1, Str.length(cline))
            when tag == `F` {
                let sub_raw -> Str.replace(val_str, `\\n`, `\n`)
                sub_raw -> Str.replace(sub_raw, `\\\\`, `\\`)
                let sub_res -> deserialize_chunk(sub_raw)
                when sub_res[`ok`] {
                    consts.append(sub_res[`chunk`])
                } or {
                    consts.append(Nothing)
                }
            } or when tag == `N` {
                consts.append(Nothing)
            } or when tag == `D` {
                consts.append(Default)
            } or when tag == `B` {
                when val_str == `1` { consts.append(True) } or { consts.append(False) }
            } or when tag == `S` {
                let sval -> Str.replace(val_str, `\\n`, `\n`)
                sval -> Str.replace(sval, `\\\\`, `\\`)
                consts.append(sval)
            } or when tag == `I` {
                consts.append(parse_int_str(val_str))
            } or {
                consts.append(val_str)
            }
        }
        li -> li + 1
        ci -> ci + 1
    }

    // Parse Code
    when li >= lines.length {
        <- {`ok` -> false, `error` -> `missing CODE section`}
    }
    let code_header -> Str.split(lines[li], `:`)
    when code_header[0] != `CODE` {
        <- {`ok` -> false, `error` -> `expected CODE section`}
    }
    let code_count -> parse_int_str(code_header[1])
    li -> li + 1

    let code_bytes -> []
    when code_count > 0 and li < lines.length {
        let byte_tokens -> Str.split(lines[li], `,`)
        let bi -> 0
        let bn -> byte_tokens.length
        do while bi < bn and bi < code_count {
            code_bytes.append(parse_int_str(byte_tokens[bi]))
            bi -> bi + 1
        }
    }
    li -> li + 1

    // Parse Lines
    let debug_lines -> []
    when li < lines.length {
        let lines_header -> Str.split(lines[li], `:`)
        when lines_header[0] == `LINES` {
            let line_count -> parse_int_str(lines_header[1])
            li -> li + 1
            when line_count > 0 and li < lines.length {
                let line_tokens -> Str.split(lines[li], `,`)
                let lti -> 0
                let ltn -> line_tokens.length
                do while lti < ltn and lti < line_count {
                    debug_lines.append(parse_int_str(line_tokens[lti]))
                    lti -> lti + 1
                }
            }
        }
    }

    let chunk -> {
        `code` -> code_bytes,
        `constants` -> consts,
        `lines` -> debug_lines,
        `num_locals` -> num_locals,
        `name` -> cname
    }
    <- {`ok` -> true, `chunk` -> chunk, `src_hash` -> src_hash}
}

export function is_bytecode_file(filepath) {
    when filepath == Nothing {
        <- False
    }
    when Str.ends_with(filepath, `.zbc`) {
        <- True
    }
    when __builtin_file.is_file(filepath) {
        let content -> __builtin_file.read(filepath)
        when Str.starts_with(content, `ZENB:`) {
            <- True
        }
    }
    <- False
}

export function write_bytecode_file(chunk, filepath, src_hash) {
    let payload -> serialize_chunk(chunk, src_hash)
    <- __builtin_file.write(filepath, payload)
}

export function read_bytecode_file(filepath) {
    when not __builtin_file.is_file(filepath) {
        <- {`ok` -> false, `error` -> `bytecode file not found: ` + filepath}
    }
    let content -> __builtin_file.read(filepath)
    <- deserialize_chunk(content)
}

export function get_cache_path(src_path) {
    let filename -> src_path
    do while Str.contains(filename, `/`) {
        let sl -> Str.index_of(filename, `/`)
        filename -> Str.substring(filename, sl + 1, Str.length(filename))
    }
    let stem -> filename
    when Str.ends_with(stem, `.zl`) {
        stem -> Str.substring(stem, 0, Str.length(stem) - 3)
    }
    <- `__zcache__/` + stem + `.zbc`
}

export function compile_file_to_bundle(src_path, out_zbc_path) {
    when not __builtin_file.is_file(src_path) {
        <- {`ok` -> false, `error` -> `source file not found: ` + src_path}
    }
    let src -> __builtin_file.read(src_path)
    let prog -> Parser.parse_source(src)
    when prog == Nothing or AST.prog_err(prog) != Nothing {
        let err -> AST.prog_err(prog)
        when err == Nothing { err -> `parse error` }
        <- {`ok` -> false, `error` -> Str.to_string(err)}
    }
    let b_res -> compile_program(prog)
    when b_res[`ok`] != true {
        <- {`ok` -> false, `error` -> `bytecode compile failed`}
    }
    let chunk -> b_res[`chunk`]
    write_bytecode_file(chunk, out_zbc_path, Str.length(src))
    <- {`ok` -> true, `zbc_path` -> out_zbc_path, `chunk` -> chunk}
}

export function eval_bytecode_file(zbc_path, globals) {
    let r -> read_bytecode_file(zbc_path)
    when r[`ok`] != true {
        <- Nothing
    }
    let chunk -> r[`chunk`]
    when globals == Nothing {
        globals -> {}
    }
    <- eval_chunk(chunk, globals)
}

function eval_range_vm(st, en, inclusive, open_start) {
    let res -> []
    when st is Integer and en is Integer {
        when st <= en {
            let cur -> st
            when open_start { cur -> cur + 1 }
            let limit -> en
            when inclusive { limit -> limit + 1 }
            do while cur < limit {
                res.append(cur)
                cur -> cur + 1
            }
        } or {
            let cur -> st
            when open_start { cur -> cur - 1 }
            let limit -> en
            when inclusive { limit -> limit - 1 }
            do while cur > limit {
                res.append(cur)
                cur -> cur - 1
            }
        }
        <- res
    }
    when st is String and en is String {
        let s0 -> Str.at(st, 0)
        let s1 -> Str.at(en, 0)
        let c0 -> Str.index_of(`abcdefghijklmnopqrstuvwxyz`, s0)
        let c1 -> Str.index_of(`abcdefghijklmnopqrstuvwxyz`, s1)
        when c0 != -1 and c1 != -1 {
            let chars -> `abcdefghijklmnopqrstuvwxyz`
            when c0 <= c1 {
                let cur -> c0
                when open_start { cur -> cur + 1 }
                let limit -> c1
                when inclusive { limit -> limit + 1 }
                do while cur < limit {
                    res.append(Str.at(chars, cur))
                    cur -> cur + 1
                }
            } or {
                let cur -> c0
                when open_start { cur -> cur - 1 }
                let limit -> c1
                when inclusive { limit -> limit - 1 }
                do while cur > limit {
                    res.append(Str.at(chars, cur))
                    cur -> cur - 1
                }
            }
            <- res
        }
    }
    <- res
}

function eval_pow_vm(a, b) {
    when a == Nothing or b == Nothing { <- 0 }
    let base -> a
    let exp -> b
    when exp is Integer and exp >= 0 {
        let res -> 1
        let i -> 0
        do while i < exp {
            res -> res * base
            i -> i + 1
        }
        <- res
    }
    <- __builtin_math.pow(a, b)
}

function eval_is_type_vm(val, type_name) {
    when type_name == `Integer` or type_name == `Int` or type_name == `Int64` or
         type_name == `Int32` or type_name == `Int16` or type_name == `Int8` or type_name == `Byte` {
        <- val is Integer
    }
    when type_name == `Decimal` or type_name == `Float` or type_name == `Double` {
        <- val is Decimal
    }
    when type_name == `String` or type_name == `Str` {
        <- val is String
    }
    when type_name == `Boolean` or type_name == `Bool` {
        <- val is Boolean
    }
    when type_name == `Rune` or type_name == `Char` or type_name == `Glyph` {
        when val is Rune { <- true }
        when val is String and Str.length(val) == 1 { <- true }
        <- false
    }
    when type_name == `Bytes` or type_name == `Buffer` {
        <- val is Bytes
    }
    when type_name == `List` {
        <- val is List
    }
    when type_name == `Set` {
        <- val is Set
    }
    when type_name == `Map` {
        <- val is Map
    }
    when type_name == `Nothing` or type_name == `nothing` or type_name == `None` {
        <- val == Nothing
    }
    when type_name == `Error` {
        when val is Error {
            <- true
        }
        when val != Nothing and val is Map and val[`__type__`] != Nothing and val[`__type__`] == `Error` {
            <- true
        }
        when val != Nothing and (val is Map) and (val[`enum_name`] == `Error` or val[`variant_name`] == `Error`) {
            <- true
        }
        <- false
    }
    when type_name == `Variant` {
        when val is Variant {
            <- true
        }
        when val != Nothing and (val is Map) and val[`enum_name`] != Nothing {
            <- true
        }
        <- false
    }
    when val != Nothing and (val is Map) and val[`enum_name`] != Nothing {
        when val[`enum_name`] == type_name or val[`variant_name`] == type_name {
            <- true
        }
    }
    when val != Nothing and val is Map and val[`__type__`] != Nothing and val[`__type__`] == type_name {
        <- true
    }
    <- false
}

function eval_sub_vm(a, b) {
    when ((a is Integer) or looks_int_str(a)) and (b is List) {
        let n -> 0
        when (a is Integer) { n -> a } or { n -> parse_int_str(a) }
        let res -> []
        let i -> n
        do while i < b.length {
            res.append(b[i])
            i -> i + 1
        }
        <- res
    }
    when (a is List) and ((b is Integer) or looks_int_str(b)) {
        let n -> 0
        when (b is Integer) { n -> b } or { n -> parse_int_str(b) }
        let res -> []
        let i -> 0
        let limit -> a.length - n
        do while i < limit {
            res.append(a[i])
            i -> i + 1
        }
        <- res
    }
    <- a - b
}

function eval_concat_append_vm(a, b) {
    when a is List {
        let res -> []
        let i -> 0
        do while i < a.length {
            res.append(a[i])
            i -> i + 1
        }
        when b is List {
            let j -> 0
            do while j < b.length {
                res.append(b[j])
                j -> j + 1
            }
        } or {
            res.append(b)
        }
        <- res
    }
    when b is List {
        let res -> [a]
        let j -> 0
        do while j < b.length {
            res.append(b[j])
            j -> j + 1
        }
        <- res
    }
    when a is Integer and b is Integer {
        <- a + b
    }
    when a is Decimal and b is Decimal {
        <- a + b
    }
    when a is String {
        <- a + Str.to_string(b)
    }
    <- Str.to_string(a) + Str.to_string(b)
}

function eval_drop_vm(a, b) {
    when a is Integer and b is Integer {
        <- a - b
    }
    when a is Decimal and b is Decimal {
        <- a - b
    }
    when a is String and b is Integer {
        let n -> b
        when n <= 0 { <- a }
        let slen -> Str.length(a)
        when n >= slen { <- `` }
        <- Str.substring(a, 0, slen - n)
    }
    when a is Integer and b is String {
        let n -> a
        when n <= 0 { <- b }
        let slen -> Str.length(b)
        when n >= slen { <- `` }
        <- Str.substring(b, n, slen)
    }
    when a is List and b is Integer {
        let n -> b
        let res -> []
        when n <= 0 { <- a }
        let llen -> a.length
        when n >= llen { <- [] }
        let i -> 0
        do while i < (llen - n) {
            res.append(a[i])
            i -> i + 1
        }
        <- res
    }
    when a is Integer and b is List {
        let n -> a
        let res -> []
        when n <= 0 { <- b }
        let llen -> b.length
        when n >= llen { <- [] }
        let i -> n
        do while i < llen {
            res.append(b[i])
            i -> i + 1
        }
        <- res
    }
    <- a
}

function eval_in_vm(item, container) {
    when container == Nothing {
        <- false
    }
    when container is List {
        let i -> 0
        let n -> container.length
        do while i < n {
            when container[i] == item {
                <- true
            }
            i -> i + 1
        }
        <- false
    }
    when container is Map {
        <- container.has(item)
    }
    when container is Set {
        <- container.has(item)
    }
    when container is String {
        <- Str.contains(container, Str.to_string(item))
    }
    <- false
}

function is_type_name_str(s) {
    when s == `Integer` or s == `Int` or s == `Int64` or s == `Int32` or s == `Int16` or s == `Int8` or s == `Byte` { <- true }
    when s == `Decimal` or s == `Float` or s == `Double` { <- true }
    when s == `String` or s == `Str` { <- true }
    when s == `Boolean` or s == `Bool` { <- true }
    when s == `Rune` or s == `Char` or s == `Glyph` { <- true }
    when s == `Bytes` or s == `Buffer` { <- true }
    when s == `List` or s == `Set` or s == `Map` { <- true }
    when s == `Error` or s == `Nothing` or s == `nothing` { <- true }
    <- false
}

function eval_cast_vm(val, target_type) {
    when target_type == `Integer` or target_type == `Int` or target_type == `Int64` or
         target_type == `Int32` or target_type == `Int16` or target_type == `Int8` or target_type == `Byte` {
        when val is Integer { <- val }
        when val is Decimal { <- parse_int_str(Str.to_string(val)) }
        when val == true { <- 1 }
        when val == false { <- 0 }
        when val == Nothing { <- 0 }
        when val is String {
            when val == `` { <- 0 }
            when Str.length(val) == 1 and not Str.contains(`0123456789`, val) {
                <- parse_int_str(Str.to_string(val))
            }
            <- parse_int_str(val)
        }
        when val is List { <- val.length }
        when val is Map { <- val.length }
        <- 0
    }
    when target_type == `Decimal` or target_type == `Float` or target_type == `Double` {
        when val is Decimal { <- val }
        when val is Integer { <- val + 0.0 }
        when val == true { <- 1.0 }
        when val == false { <- 0.0 }
        when val == Nothing { <- 0.0 }
        when val is String {
            let clean -> strip_underscores(val)
            let num -> clean.to_number()
            when num is Decimal { <- num }
            when num is Integer { <- num + 0.0 }
            <- 0.0
        }
        <- 0.0
    }
    when target_type == `String` or target_type == `Str` {
        when val is String { <- val }
        when val == true { <- `True` }
        when val == false { <- `False` }
        when val == Nothing { <- `` }
        <- Str.to_string(val)
    }
    when target_type == `Boolean` or target_type == `Bool` {
        when val == true or val == false { <- val }
        when val is Integer { <- val != 0 }
        when val is Decimal { <- val != 0.0 }
        when val is String {
            when val == `True` or val == `true` or val == `1` { <- true }
            <- false
        }
        when val is List or val is Map { <- val.length > 0 }
        when val == Nothing { <- false }
        <- true
    }
    when target_type == `Rune` or target_type == `Char` or target_type == `Glyph` {
        when val is String {
            when Str.length(val) >= 1 {
                <- Str.substring(val, 0, 1)
            }
            <- ``
        }
        when val is Integer {
            let s -> Str.to_string(val)
            <- Str.substring(s, 0, 1)
        }
        <- ``
    }
    when target_type == `Bytes` or target_type == `Buffer` {
        when val is String {
            let res -> []
            let len -> Str.length(val)
            let i -> 0
            do while i < len {
                res.append(Str.substring(val, i, i + 1))
                i -> i + 1
            }
            <- res
        }
        when val is List { <- val }
        when val is Integer { <- [val] }
        <- []
    }
    when target_type == `List` {
        when val is List { <- val }
        when val is String {
            let res -> []
            let len -> Str.length(val)
            let i -> 0
            do while i < len {
                res.append(Str.substring(val, i, i + 1))
                i -> i + 1
            }
            <- res
        }
        <- [val]
    }
    when target_type == `Set` {
        when val is Set { <- val }
        when val is List {
            <- __builtin_set.from_list(val)
        }
        when val is String {
            let list_val -> eval_cast_vm(val, `List`)
            <- __builtin_set.from_list(list_val)
        }
        <- __builtin_set.from_list([val])
    }
    when target_type == `Map` {
        when val is Map { <- val }
        <- {}
    }
    when target_type == `Data` or target_type == `ZenData` {
        when val is Map or val is List {
            <- val
        }
        <- {}
    }
    when target_type == `Default` or target_type == `default` {
        <- Default
    }
    when target_type == `Nothing` or target_type == `nothing` {
        <- Nothing
    }
    <- val
}
