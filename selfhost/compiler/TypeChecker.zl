/!
 Type checker — Stage 4 + endgame depth.
 Walks Stage 2 AST nodes; dual-path free functions + module state.
 Reports undefined names, basic redeclares, simple type clashes.
 Covers with/alias scope, class methods (self), enumerators, is, lambdas.
 Phase C: method/call resolution + arity, typed with alias, opt-in owned/borrowed.
 !/

import compiler.Types as Ty
import compiler.AST as AST
import compiler.Parser as Parser
import compiler.Diagnostics as Diag
import zen.text.string as Str

// Checker work state (module map — dual-path safe).
let C -> {
    `scope` -> Nothing,
    `errors` -> [],
    `notes` -> [],
    `current_return` -> Nothing,
    `inferred_return` -> Nothing,
    `in_function` -> false,
    `with_depth` -> 0,
    `src` -> Nothing,
    `filename` -> `<source>`
}

function err_list() {
    <- C[`errors`]
}

function push_error(msg) {
    let errs -> C[`errors`]
    errs.append(msg)
    C[`errors`] -> errs
}

function push_node_error(node, msg) {
    let line -> AST.ast_line(node)
    let col -> AST.ast_col(node)
    when line > 0 and C[`src`] != Nothing and C[`src`] != `` {
        let formatted -> Diag.format_error(C[`src`], C[`filename`], msg, line, col, 1)
        push_error(formatted)
    } or {
        when line > 0 {
            push_error(msg + ` (line ` + Str.to_string(line) + `, col ` + Str.to_string(col) + `)`)
        } or {
            push_error(msg)
        }
    }
}

function push_note(msg) {
    let ns -> C[`notes`]
    ns.append(msg)
    C[`notes`] -> ns
}

function checker_reset(scope) {
    C[`scope`] -> scope
    C[`errors`] -> []
    C[`notes`] -> []
    C[`current_return`] -> Ty.t_void()
    C[`inferred_return`] -> Nothing
    C[`in_function`] -> false
    C[`with_depth`] -> 0
    C[`has_extern`] -> false
}

function kind_str(node) {
    when node == Nothing {
        <- ``
    }
    <- Str.to_string(AST.ast_kind(node))
}

function is_kind(node, name) {
    when node == Nothing or name == Nothing {
        <- false
    }
    <- AST.ast_kind(node) == name
}

// ---------- Public API ----------

/!
 Check source text (lex+parse via caller or internal parse).
 Prefer check_program after Parser.parse_source.
 !/
export function check_source_file(src, filename) {
    C[`scope`] -> Nothing
    C[`errors`] -> []
    C[`notes`] -> []
    C[`current_return`] -> Nothing
    C[`inferred_return`] -> Nothing
    C[`in_function`] -> false
    C[`with_depth`] -> 0
    C[`src`] -> src
    C[`filename`] -> filename
    let prog -> Parser.parse_source_file(src, filename)
    <- check_program(prog)
}

export function check_source(src) {
    <- check_source_file(src, `<source>`)
}

/!
 Typecheck an AST Program map → { errors: [...] }.
 !/
export function check_program(prog) {
    let global -> Ty.sc_create(Nothing)
    // Builtins (minimal)
    global -> Ty.sc_define(global, `io`, Ty.t_variant(), `MODULE`, false)
    global -> Ty.sc_define(global, `write`, Ty.t_function(`write`, [], Ty.t_void()), `FUNCTION`, false)
    global -> Ty.sc_define(global, `writeln`, Ty.t_function(`writeln`, [], Ty.t_void()), `FUNCTION`, false)
    global -> Ty.sc_define(global, `read`, Ty.t_function(`read`, [], Ty.t_string()), `FUNCTION`, false)
    global -> Ty.sc_define(global, `readln`, Ty.t_function(`readln`, [], Ty.t_string()), `FUNCTION`, false)
    global -> Ty.sc_define(global, `type`, Ty.t_function(`type`, [], Ty.t_string()), `FUNCTION`, false)
    global -> Ty.sc_define(global, `stdout`, Ty.t_variant(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `stderr`, Ty.t_variant(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `stdin`, Ty.t_variant(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `args`, Ty.t_list(Ty.t_string()), `VARIABLE`, false)
    global -> Ty.sc_define(global, `env`, Ty.t_variant(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `true`, Ty.t_boolean(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `false`, Ty.t_boolean(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `True`, Ty.t_boolean(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `False`, Ty.t_boolean(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `Nothing`, Ty.t_nothing(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `Default`, Ty.t_default(), `VARIABLE`, false)
    global -> Ty.sc_define(global, `__builtin_file`, Ty.t_variant(), `MODULE`, false)
    global -> Ty.sc_define(global, `__builtin_term`, Ty.t_variant(), `MODULE`, false)
    global -> Ty.sc_define(global, `__builtin_math`, Ty.t_variant(), `MODULE`, false)
    global -> Ty.sc_define(global, `__builtin_reflect`, Ty.t_variant(), `MODULE`, false)
    global -> Ty.sc_define(global, `__builtin_memory`, Ty.t_variant(), `MODULE`, false)

    checker_reset(global)

    // Two passes over statements by index (native for-in moves/consumes lists).
    let stmts -> AST.prog_stmts(prog)
    when stmts != Nothing {
        walk_stmts_entry(stmts, 0)
        walk_stmts_entry(stmts, 1)
    }

    let errs -> err_list()
    let n -> errs.length
    <- {
        `ok` -> n == 0,
        `errors` -> errs,
        `notes` -> C[`notes`],
        `program` -> prog
    }
}

/!
 mode 0 = declare_toplevel, mode 1 = check_stmt
 Supports both flat statement lists and linked StmtChunk chains.
 !/
function walk_stmts_entry(stmts, mode) {
    when stmts == Nothing {
        <- Nothing
    }
    when AST.ast_kind(stmts) == AST.K_STMT_CHUNK {
        let chunk -> stmts
        do while chunk != Nothing and AST.ast_kind(chunk) == AST.K_STMT_CHUNK {
            let slice -> AST.stmt_chunk_stmts(chunk)
            when slice != Nothing {
                walk_stmts_slice(slice, 0, slice.length, mode)
            }
            chunk -> AST.stmt_chunk_next(chunk)
        }
        <- Nothing
    }
    walk_stmts_slice(stmts, 0, stmts.length, mode)
    <- Nothing
}

function walk_stmts_slice(stmts, i, n, mode) {
    let j -> i
    do while j < n {
        let s -> stmts[j]
        when mode == 0 {
            declare_toplevel(s)
        } or {
            check_stmt(s)
        }
        j -> j + 1
    }
    <- Nothing
}

// ---------- Declare ----------

function declare_toplevel(node) {
    when node == Nothing {
        <- Nothing
    }
    when is_kind(node, AST.K_FUNCTION) {
        let name -> AST.fn_name(node)
        let gens -> AST.fn_generics(node)
        let old_tp -> Ty.set_active_type_params(gens)
        let params -> AST.fn_params(node)
        let ptypes -> []
        when params != Nothing {
            do for p in params {
                let pt -> Ty.t_variant()
                when AST.param_type(p) != Nothing {
                    pt -> Ty.type_from_ann(AST.param_type(p))
                }
                ptypes.append(pt)
            }
        }
        let ret -> Ty.t_variant()
        when AST.fn_ret(node) != Nothing {
            ret -> Ty.type_from_ann(AST.fn_ret(node))
        }
        Ty.reset_active_type_params(old_tp)
        let ft -> Ty.t_function(name, ptypes, ret)
        when gens != Nothing and gens.length > 0 {
            ft[`generics`] -> gens
        }
        let sc -> C[`scope`]
        sc -> Ty.sc_define(sc, name, ft, `FUNCTION`, false)
        C[`scope`] -> sc
        <- Nothing
    }
    when is_kind(node, AST.K_STRUCTURE) {
        let name -> AST.struct_name(node)
        let gens -> AST.struct_generics(node)
        let old_tp -> Ty.set_active_type_params(gens)
        let members -> {}
        let ms -> AST.struct_members(node)
        when ms != Nothing {
            do for m in ms {
                when is_kind(m, AST.K_STRUCT_MEMBER) or Str.contains(kind_str(m), `Member`) {
                    let mn -> AST.struct_member_name(m)
                    let mt -> Ty.t_variant()
                    when AST.struct_member_type(m) != Nothing {
                        mt -> Ty.type_from_ann(AST.struct_member_type(m))
                    }
                    members[mn] -> mt
                }
            }
        }
        Ty.reset_active_type_params(old_tp)
        let st -> Ty.t_structure(name, members)
        when gens != Nothing and gens.length > 0 {
            st[`generics`] -> gens
        }
        let sc -> C[`scope`]
        sc -> Ty.sc_define(sc, name, st, `STRUCTURE`, false)
        C[`scope`] -> sc
        <- Nothing
    }
    when is_kind(node, AST.K_CLASS) {
        declare_class(node)
        <- Nothing
    }
    when is_kind(node, AST.K_ENUMERATOR) {
        declare_enumerator(node)
        <- Nothing
    }
    when is_kind(node, AST.K_EXTERN_IMPORT) {
        declare_extern_import(node)
        <- Nothing
    }
}

function header_default_alias(hdr) {
    when hdr == Nothing or hdr == `` {
        <- ``
    }
    let s -> Str.to_string(hdr)
    when Str.starts_with(s, `<`) or Str.starts_with(s, `"`) or Str.starts_with(s, `'`) {
        s -> Str.substring(s, 1, s.length - 1)
    }
    when Str.ends_with(s, `.h`) {
        s -> Str.substring(s, 0, s.length - 2)
    }
    when Str.contains(s, `.`) {
        let parts -> Str.split(s, `.`)
        <- parts[parts.length - 1]
    }
    when Str.contains(s, `/`) {
        let parts -> Str.split(s, `/`)
        <- parts[parts.length - 1]
    }
    <- s
}

function declare_extern_import(node) {
    C[`has_extern`] -> true
    let alias -> AST.extern_alias(node)
    let hdr -> AST.extern_header(node)
    let names -> AST.extern_names(node)
    when alias == Nothing or alias == `` {
        when names == Nothing {
            alias -> header_default_alias(hdr)
        }
    }
    when alias != Nothing and alias != `` {
        let sc -> C[`scope`]
        sc -> Ty.sc_define(sc, alias, Ty.t_variant(), `MODULE`, false)
        C[`scope`] -> sc
    }
    when names != Nothing {
        let ni -> 0
        let sc -> C[`scope`]
        do while ni < names.length {
            sc -> Ty.sc_define(sc, names[ni], Ty.t_variant(), `FUNCTION`, false)
            ni -> ni + 1
        }
        C[`scope`] -> sc
    }
}

function declare_class(node) {
    let name -> AST.class_name(node)
    let gens -> AST.class_generics(node)
    let old_tp -> Ty.set_active_type_params(gens)
    let members -> {}
    let ms -> AST.class_members(node)
    when ms != Nothing {
        do for m in ms {
            let mn -> AST.let_name(m)
            when mn != Nothing {
                let mt -> Ty.t_variant()
                when AST.let_type(m) != Nothing {
                    mt -> Ty.type_from_ann(AST.let_type(m))
                }
                members[mn] -> mt
            }
        }
    }
    let method_tab -> {}
    let methods -> AST.class_methods(node)
    when methods != Nothing {
        do for meth in methods {
            when is_kind(meth, AST.K_FUNCTION) {
                let mname -> AST.fn_name(meth)
                let params -> AST.fn_params(meth)
                let user_ptypes -> []
                let ptypes -> [Ty.t_variant()]
                when params != Nothing {
                    do for p in params {
                        let pt -> Ty.t_variant()
                        when AST.param_type(p) != Nothing {
                            pt -> Ty.type_from_ann(AST.param_type(p))
                        }
                        ptypes.append(pt)
                        user_ptypes.append(pt)
                    }
                }
                let ret -> Ty.t_variant()
                when AST.fn_ret(meth) != Nothing {
                    ret -> Ty.type_from_ann(AST.fn_ret(meth))
                }
                let fname -> name + `_` + Str.to_string(mname)
                let ft -> Ty.t_function(fname, ptypes, ret)
                let user_ft -> Ty.t_function(mname, user_ptypes, ret)
                method_tab[mname] -> user_ft
                let sc0 -> C[`scope`]
                sc0 -> Ty.sc_define(sc0, fname, ft, `FUNCTION`, false)
                C[`scope`] -> sc0
            }
        }
    }
    Ty.reset_active_type_params(old_tp)
    let st -> Ty.t_class(name, members, method_tab)
    when gens != Nothing and gens.length > 0 {
        st[`generics`] -> gens
    }
    let sc -> C[`scope`]
    sc -> Ty.sc_define(sc, name, st, `CLASS`, false)
    C[`scope`] -> sc
}

function declare_enumerator(node) {
    let name -> AST.enum_name(node)
    let members -> {}
    let ms -> AST.enum_members(node)
    when ms != Nothing {
        do for m in ms {
            let mn -> AST.enum_mem_name(m)
            when mn != Nothing {
                members[mn] -> Ty.t_variant()
            }
        }
    }
    let st -> Ty.t_structure(name, members)
    let sc -> C[`scope`]
    sc -> Ty.sc_define(sc, name, st, `STRUCTURE`, false)
    C[`scope`] -> sc
}

// ---------- Statements ----------

function check_stmt(node) {
    when node == Nothing {
        <- Nothing
    }
    when is_kind(node, AST.K_FUNCTION) {
        check_function(node)
        <- Nothing
    }
    when is_kind(node, AST.K_LET) {
        check_let(node)
        <- Nothing
    }
    when is_kind(node, AST.K_BLOCK) {
        check_block(node)
        <- Nothing
    }
    when is_kind(node, AST.K_RETURN) {
        check_return(node)
        <- Nothing
    }
    when is_kind(node, AST.K_WHEN) {
        check_when(node)
        <- Nothing
    }
    when is_kind(node, AST.K_CHECK_STMT) {
        check_check(node)
        <- Nothing
    }
    when is_kind(node, AST.K_WHILE) or is_kind(node, AST.K_DO_WHILE) {
        check_loop(node)
        <- Nothing
    }
    when is_kind(node, AST.K_FOR) {
        check_for(node)
        <- Nothing
    }
    when is_kind(node, AST.K_ASSERT) {
        let _t -> check_expr(AST.assert_expr(node))
        <- Nothing
    }
    when is_kind(node, AST.K_EXPR_STMT) {
        let _t -> check_expr(AST.expr_stmt_expr(node))
        <- Nothing
    }
    when is_kind(node, AST.K_STRUCTURE) {
        // already declared
        <- Nothing
    }
    when is_kind(node, AST.K_CLASS) {
        check_class(node)
        <- Nothing
    }
    when is_kind(node, AST.K_ENUMERATOR) {
        // declared in pass 0; members are variant tags
        <- Nothing
    }
    when is_kind(node, AST.K_WITH) {
        check_with(node)
        <- Nothing
    }
    when is_kind(node, AST.K_IMPORT) or is_kind(node, AST.K_FROM_IMPORT) {
        // Stage 4: treat imports as defining alias modules as Variant
        let alias -> AST.import_alias(node)
        when alias != Nothing and alias != `` {
            let sc -> C[`scope`]
            sc -> Ty.sc_define(sc, alias, Ty.t_variant(), `MODULE`, false)
            C[`scope`] -> sc
        }
        <- Nothing
    }
    when is_kind(node, AST.K_SCOPE) {
        check_block(AST.scope_body(node))
        <- Nothing
    }
}

function check_with(node) {
    let rt -> check_expr(AST.with_expr(node))
    when not Ty.is_arena_type(rt) {
        push_note(`with: resource type ` + Ty.type_name(rt) + ` is not an arena`)
    }
    let alias_t -> Ty.copy_type_plain(rt)
    // Untyped (Variant) with-alias is a plain value; typed/arena alias is borrowed.
    when not is_untyped(rt) {
        alias_t[`qualifier`] -> `borrowed`
    }
    let outer -> C[`scope`]
    let inner -> Ty.sc_create(outer)
    let alias -> AST.with_alias(node)
    when alias != Nothing and alias != `` {
        inner -> Ty.sc_define(inner, alias, alias_t, `VARIABLE`, false)
    }
    let prev_d -> C[`with_depth`]
    C[`with_depth`] -> prev_d + 1
    C[`scope`] -> inner
    when AST.with_body(node) != Nothing {
        check_stmt(AST.with_body(node))
    }
    C[`scope`] -> outer
    C[`with_depth`] -> prev_d
}

function check_class(node) {
    // Fields already in type; walk method bodies with self (+ soft parent for extends)
    let methods -> AST.class_methods(node)
    when methods == Nothing {
        <- Nothing
    }
    let cname -> AST.class_name(node)
    let base_name -> AST.class_base(node)
    let class_gens -> AST.class_generics(node)
    let old_tp -> Ty.set_active_type_params(class_gens)
    do for meth in methods {
        when is_kind(meth, AST.K_FUNCTION) {
            let outer -> C[`scope`]
            let body_scope -> Ty.sc_create(outer)
            when class_gens != Nothing {
                do for cg in class_gens {
                    body_scope -> Ty.sc_define(body_scope, cg, Ty.t_param(cg), `TYPE`, false)
                }
            }
            body_scope -> Ty.sc_define(body_scope, `self`, Ty.t_variant(), `PARAMETER`, true)
            when base_name != Nothing and base_name != `` {
                // soft name for parent.meth receiver resolution only
                body_scope -> Ty.sc_define(body_scope, `parent`, Ty.t_variant(), `PARAMETER`, false)
            }
            let params -> AST.fn_params(meth)
            when params != Nothing {
                do for p in params {
                    let pt -> Ty.t_variant()
                    when AST.param_type(p) != Nothing {
                        pt -> Ty.type_from_ann(AST.param_type(p))
                    }
                    body_scope -> Ty.sc_define(body_scope, AST.param_name(p), pt, `PARAMETER`, false)
                }
            }
            let prev_ret -> C[`current_return`]
            let prev_in -> C[`in_function`]
            let ret -> Ty.t_variant()
            when AST.fn_ret(meth) != Nothing {
                ret -> Ty.type_from_ann(AST.fn_ret(meth))
            }
            C[`current_return`] -> ret
            C[`in_function`] -> true
            C[`scope`] -> body_scope
            let body -> AST.fn_body(meth)
            when body != Nothing {
                when is_kind(body, AST.K_BLOCK) {
                    let stmts -> AST.block_stmts(body)
                    when stmts != Nothing {
                        do for s in stmts {
                            check_stmt(s)
                        }
                    }
                } or {
                    check_stmt(body)
                }
            }
            C[`scope`] -> outer
            C[`current_return`] -> prev_ret
            C[`in_function`] -> prev_in
        }
    }
    Ty.reset_active_type_params(old_tp)
    // silence unused
    when cname == Nothing {
        <- Nothing
    }
}

function check_function(node) {
    let name -> AST.fn_name(node)
    let outer -> C[`scope`]
    let body_scope -> Ty.sc_create(outer)
    let gens -> AST.fn_generics(node)
    let old_tp -> Ty.set_active_type_params(gens)
    when gens != Nothing {
        do for g in gens {
            body_scope -> Ty.sc_define(body_scope, g, Ty.t_param(g), `TYPE`, false)
        }
    }
    // params
    let params -> AST.fn_params(node)
    when params != Nothing {
        do for p in params {
            let pt -> Ty.t_variant()
            when AST.param_type(p) != Nothing {
                pt -> Ty.type_from_ann(AST.param_type(p))
            }
            body_scope -> Ty.sc_define(body_scope, AST.param_name(p), pt, `PARAMETER`, false)
        }
    }
    let prev_ret -> C[`current_return`]
    let prev_inferred -> C[`inferred_return`]
    let prev_in -> C[`in_function`]
    let ret -> Nothing
    when AST.fn_ret(node) != Nothing {
        ret -> Ty.type_from_ann(AST.fn_ret(node))
    }
    C[`current_return`] -> ret
    C[`inferred_return`] -> Nothing
    C[`in_function`] -> true
    C[`scope`] -> body_scope

    let body -> AST.fn_body(node)
    when body != Nothing {
        when is_kind(body, AST.K_BLOCK) {
            // don't create extra scope; already in function scope
            let stmts -> AST.block_stmts(body)
            when stmts != Nothing {
                do for s in stmts {
                    check_stmt(s)
                }
            }
        } or {
            check_stmt(body)
        }
    }

    C[`scope`] -> outer
    C[`current_return`] -> prev_ret
    C[`inferred_return`] -> prev_inferred
    C[`in_function`] -> prev_in
    Ty.reset_active_type_params(old_tp)
}

function check_let(node) {
    let name -> AST.let_name(node)
    let sc -> C[`scope`]
    when Ty.sc_has_local(sc, name) {
        push_node_error(node, `Redeclaration of '` + name + `'`)
    }
    let declared -> Nothing
    when AST.let_type(node) != Nothing {
        let ann -> AST.let_type(node)
        let tname -> Ty.type_ann_name(ann)
        when Ty.is_forbidden_type_name(tname) {
            push_node_error(node, `Type '` + tname + `' is not supported in Zenlang. Use canonical types ('Integer', 'Decimal', 'String', 'Boolean', 'Byte', 'Rune')`)
        }
        declared -> Ty.type_from_ann(ann)
    }
    let value_t -> Ty.t_variant()
    let val_node -> AST.let_val(node)
    when val_node != Nothing {
        value_t -> check_expr(val_node)
        maybe_mark_move(val_node)
    }
    let mut -> true
    when AST.let_mut(node) == false {
        mut -> false
    }
    when declared == Nothing {
        let final_t -> Nothing
        when Ty.is_borrowed_type(value_t) or Ty.is_owned_type(value_t) {
            final_t -> Ty.copy_type_plain(value_t)
        } or {
            final_t -> value_t
        }
        sc -> Ty.sc_define(sc, name, final_t, `VARIABLE`, mut)
    } or {
        when Ty.type_equal(declared, value_t) {
            when declared[`bits`] != Nothing and val_node != Nothing and is_kind(val_node, AST.K_LITERAL) {
                check_literal_bounds(node, declared, AST.lit_val(val_node))
            }
        } or {
            // materialize Default literal to declared type
            when Str.to_string(value_t[`kind`]) == `Default` and val_node != Nothing and is_kind(val_node, AST.K_LITERAL) {
                materialize_default(val_node, declared)
            } or {
                // allow Variant / Unknown
                when Str.to_string(value_t[`kind`]) != `Variant` and Str.to_string(value_t[`kind`]) != `Unknown` {
                    when Str.to_string(declared[`kind`]) != `Variant` {
                        push_node_error(node, `Type mismatch in let '` + name + `': expected ` + Ty.type_name(declared) + ` got ` + Ty.type_name(value_t))
                    }
                }
            }
        }
        sc -> Ty.sc_define(sc, name, declared, `VARIABLE`, mut)
    }
    C[`scope`] -> sc
}

function check_block(node) {
    when node == Nothing {
        <- Nothing
    }
    let outer -> C[`scope`]
    let inner -> Ty.sc_create(outer)
    C[`scope`] -> inner
    let stmts -> AST.block_stmts(node)
    when stmts != Nothing {
        do for s in stmts {
            check_stmt(s)
        }
    }
    C[`scope`] -> outer
}

function check_return(node) {
    when C[`in_function`] != true {
        push_node_error(node, `Return outside function`)
    }
    let val_node -> AST.ret_val(node)
    when val_node != Nothing {
        let vt -> check_expr(val_node)
        maybe_mark_move(val_node)
        when C[`with_depth`] > 0 {
            when is_borrowed_expr(val_node) {
                push_node_error(node, `borrowed escape from with`)
            }
        }
        let expect -> C[`current_return`]
        when expect != Nothing {
            when not Ty.type_equal(expect, vt) {
                when Str.to_string(expect[`kind`]) != `Variant` and Str.to_string(vt[`kind`]) != `Variant` and Str.to_string(expect[`kind`]) != `Unknown` and Str.to_string(vt[`kind`]) != `Unknown` {
                    push_node_error(node, `Return type mismatch: expected ` + Ty.type_name(expect) + ` got ` + Ty.type_name(vt))
                }
            }
        } or {
            when C[`inferred_return`] == Nothing {
                C[`inferred_return`] -> vt
            } or {
                let inf -> C[`inferred_return`]
                when not Ty.type_equal(inf, vt) {
                    when Str.to_string(inf[`kind`]) != `Variant` and Str.to_string(vt[`kind`]) != `Variant` and Str.to_string(inf[`kind`]) != `Unknown` and Str.to_string(vt[`kind`]) != `Unknown` {
                        push_node_error(node, `Inconsistent return type: expected ` + Ty.type_name(inf) + ` got ` + Ty.type_name(vt))
                    }
                }
            }
        }
    }
}

function check_when(node) {
    let cases -> AST.when_cases(node)
    when cases == Nothing {
        <- Nothing
    }
    do for c in cases {
        let outer -> C[`scope`]
        let inner -> Ty.sc_create(outer)
        C[`scope`] -> inner
        let cond -> AST.case_cond(c)
        when cond != Nothing {
            when is_kind(cond, AST.K_IS) {
                let _vt -> check_expr(AST.is_expr_val(cond))
                check_pattern_binds(AST.is_expr_pat(cond))
            } or {
                let _ct -> check_expr(cond)
            }
        }
        when AST.case_guard(c) != Nothing {
            let _gt -> check_expr(AST.case_guard(c))
        }
        when AST.case_body(c) != Nothing {
            check_stmt(AST.case_body(c))
        }
        C[`scope`] -> outer
    }
}

function check_check(node) {
    let expr -> AST.check_stmt_expr(node)
    when expr != Nothing {
        when is_kind(expr, AST.K_BLOCK) {
            check_stmt(expr)
        } or {
            let _st -> check_expr(expr)
        }
    }
    let cases -> AST.check_stmt_cases(node)
    when cases != Nothing {
        do for c in cases {
            let outer -> C[`scope`]
            let inner -> Ty.sc_create(outer)
            C[`scope`] -> inner
            when AST.case_cond(c) != Nothing {
                check_pattern_binds(AST.case_cond(c))
            }
            when AST.case_guard(c) != Nothing {
                let _gt -> check_expr(AST.case_guard(c))
            }
            when AST.case_body(c) != Nothing {
                check_stmt(AST.case_body(c))
            }
            C[`scope`] -> outer
        }
    }
    when AST.check_stmt_or_block(node) != Nothing {
        check_stmt(AST.check_stmt_or_block(node))
    }
    when AST.check_stmt_raise(node) != Nothing {
        let _rt -> check_expr(AST.check_stmt_raise(node))
    }
}

function check_pattern_binds(pat) {
    when pat == Nothing {
        <- Nothing
    }
    when is_kind(pat, AST.K_VARIABLE) {
        let name -> AST.var_name(pat)
        when name != `_` {
            C[`scope`] -> Ty.sc_define(C[`scope`], name, Ty.t_variant(), `VARIABLE`, true)
        }
        <- Nothing
    }
    when is_kind(pat, AST.K_REST) {
        let name -> AST.rest_name(pat)
        when name != Nothing and name != `_` {
            C[`scope`] -> Ty.sc_define(C[`scope`], name, Ty.t_list(Ty.t_variant()), `VARIABLE`, true)
        }
        <- Nothing
    }
    when is_kind(pat, AST.K_LIST) {
        let elems -> AST.list_elems(pat)
        when elems != Nothing {
            do for el in elems {
                check_pattern_binds(el)
            }
        }
        <- Nothing
    }
    when is_kind(pat, AST.K_MAP) {
        let fields -> AST.map_entries(pat)
        when fields != Nothing {
            do for f in fields {
                check_pattern_binds(AST.struct_field_val(f))
            }
        }
        <- Nothing
    }
    when is_kind(pat, AST.K_STRUCT_INIT) {
        let fields -> AST.struct_init_fields(pat)
        when fields != Nothing {
            do for f in fields {
                check_pattern_binds(AST.struct_field_val(f))
            }
        }
        <- Nothing
    }
    when is_kind(pat, AST.K_CALL) {
        let args -> AST.call_args(pat)
        when args != Nothing {
            do for a in args {
                check_pattern_binds(a)
            }
        }
        <- Nothing
    }
}

function check_loop(node) {
    when AST.while_cond(node) != Nothing {
        let _t -> check_expr(AST.while_cond(node))
    }
    when AST.while_body(node) != Nothing {
        check_stmt(AST.while_body(node))
    }
}

function check_for(node) {
    let outer -> C[`scope`]
    let inner -> Ty.sc_create(outer)
    let vname -> AST.for_var(node)
    when vname != Nothing {
        inner -> Ty.sc_define(inner, vname, Ty.t_variant(), `VARIABLE`, true)
    }
    C[`scope`] -> inner
    when AST.for_iter(node) != Nothing {
        let _it -> check_expr(AST.for_iter(node))
    }
    when AST.for_body(node) != Nothing {
        check_stmt(AST.for_body(node))
    }
    C[`scope`] -> outer
}

// ---------- Expressions ----------

function check_expr(node) {
    when node == Nothing {
        <- Ty.t_unknown()
    }
    when is_kind(node, AST.K_WHEN) {
        check_when(node)
        <- Ty.t_unknown()
    }
    when is_kind(node, AST.K_LITERAL) {
        <- infer_literal(AST.lit_val(node))
    }
    when is_kind(node, AST.K_VARIABLE) {
        let name -> AST.var_name(node)
        let sym -> Ty.sc_lookup(C[`scope`], name)
        when sym == Nothing and Str.contains(Str.to_string(name), `<`) and Str.ends_with(Str.to_string(name), `>`) {
            let base_name -> Str.substring(Str.to_string(name), 0, Str.index_of(Str.to_string(name), `<`))
            let base_sym -> Ty.sc_lookup(C[`scope`], base_name)
            when base_sym != Nothing {
                let inst_t -> Ty.instantiate_generic_symbol(base_sym[`type`], name)
                <- inst_t
            }
        }
        when sym == Nothing {
            when C[`has_extern`] == true {
                <- Ty.t_variant()
            }
            push_node_error(node, `Undefined variable '` + Str.to_string(name) + `'`)
            <- Ty.t_unknown()
        }
        when sym[`moved`] == true {
            push_node_error(node, `Use after move of '` + Str.to_string(name) + `'`)
        }
        <- sym[`type`]
    }
    when is_kind(node, AST.K_BINARY) {
        let left -> AST.bin_left(node)
        let right -> AST.bin_right(node)
        let lt -> check_expr(left)
        let rt -> check_expr(right)
        
        when Str.to_string(lt[`kind`]) == `Default` and is_kind(left, AST.K_LITERAL) {
            materialize_default(left, rt)
        }
        when Str.to_string(rt[`kind`]) == `Default` and is_kind(right, AST.K_LITERAL) {
            materialize_default(right, lt)
        }
        
        let op -> Str.to_string(AST.bin_op(node))
        <- infer_binary(op, lt, rt)
    }
    when is_kind(node, AST.K_UNARY) {
        let rt -> check_expr(AST.un_right(node))
        let op -> Str.to_string(AST.un_op(node))
        when op == `not` {
            <- Ty.t_boolean()
        }
        when op == `-` {
            <- rt
        }
        <- rt
    }
    when is_kind(node, AST.K_LOGICAL) {
        let _l -> check_expr(AST.log_left(node))
        let _r -> check_expr(AST.log_right(node))
        <- Ty.t_boolean()
    }
    when is_kind(node, AST.K_CALL) {
        <- check_call(node)
    }
    when is_kind(node, AST.K_GET) {
        <- check_get(node)
    }
    when is_kind(node, AST.K_INDEX) {
        let _ot -> check_expr(AST.idx_obj(node))
        let _it -> check_expr(AST.idx_expr(node))
        when Str.to_string(_ot[`kind`]) == `List` {
            when _ot[`element`] != Nothing {
                <- _ot[`element`]
            }
            <- Ty.t_variant()
        }
        when Str.to_string(_ot[`kind`]) == `Map` {
            when _ot[`value`] != Nothing {
                <- _ot[`value`]
            }
            <- Ty.t_variant()
        }
        when Str.to_string(_ot[`kind`]) == `String` {
            <- Ty.t_rune()
        }
        <- Ty.t_variant()
    }
    when is_kind(node, AST.K_ASSIGN) {
        let name -> AST.assign_name(node)
        let sym -> Ty.sc_lookup(C[`scope`], name)
        when sym == Nothing {
            push_node_error(node, `Undefined variable '` + Str.to_string(name) + `' in assignment`)
        }
        let val_node -> AST.assign_val(node)
        let vt -> check_expr(val_node)
        when sym != Nothing and not Ty.type_equal(sym[`type`], vt) {
            // materialize Default literal to declared type
            when Str.to_string(vt[`kind`]) == `Default` and val_node != Nothing and is_kind(val_node, AST.K_LITERAL) {
                materialize_default(val_node, sym[`type`])
                vt -> sym[`type`]
            } or {
                when Str.to_string(sym[`type`][`kind`]) != `Variant` and Str.to_string(vt[`kind`]) != `Variant` {
                    push_node_error(node, `Assignment type mismatch for '` + Str.to_string(name) + `'`)
                }
            }
        }
        <- vt
    }
    when is_kind(node, AST.K_SET) {
        let _ot -> check_expr(AST.set_obj(node))
        let vt -> check_expr(AST.set_val(node))
        <- vt
    }
    when is_kind(node, AST.K_GROUPING) {
        <- check_expr(AST.group_expr(node))
    }
    when is_kind(node, AST.K_CAST) {
        let _src_t -> check_expr(AST.cast_expr(node))
        let target_type_str -> Str.to_string(AST.cast_type(node))
        when Ty.is_forbidden_type_name(target_type_str) {
            push_node_error(node, `Type '` + target_type_str + `' is not supported in Zenlang. Use canonical types ('Integer', 'Decimal', 'String', 'Boolean', 'Byte', 'Rune')`)
        }
        <- type_from_name_str(target_type_str)
    }
    when is_kind(node, AST.K_REST) {
        let rt -> check_expr(AST.rest_expr(node))
        when rt != Nothing and (rt is Map) and rt[`kind`] == `List` and rt[`element`] != Nothing {
            <- rt[`element`]
        }
        <- Ty.t_variant()
    }
    when is_kind(node, AST.K_LIST) {
        let elems -> AST.list_elems(node)
        let et -> Ty.t_variant()
        when elems != Nothing and elems.length > 0 {
            et -> check_expr(elems[0])
            let idx -> 1
            let all_same -> true
            do while idx < elems.length {
                let curr_t -> check_expr(elems[idx])
                when not Ty.type_equal(et, curr_t) {
                    all_same -> false
                }
                idx -> idx + 1
            }
            when not all_same {
                et -> Ty.t_variant()
            }
        }
        <- Ty.t_list(et)
    }
    when is_kind(node, AST.K_MAP) {
        let entries -> AST.list_elems(node)
        let kt -> Ty.t_string()
        let vt -> Ty.t_variant()
        when entries != Nothing and entries.length > 0 {
            let f0 -> entries[0]
            when AST.struct_field_val(f0) != Nothing {
                vt -> check_expr(AST.struct_field_val(f0))
            }
            let idx -> 1
            let all_same -> true
            do while idx < entries.length {
                let f -> entries[idx]
                when AST.struct_field_val(f) != Nothing {
                    let curr_t -> check_expr(AST.struct_field_val(f))
                    when not Ty.type_equal(vt, curr_t) {
                        all_same -> false
                    }
                }
                idx -> idx + 1
            }
            when not all_same {
                vt -> Ty.t_variant()
            }
        }
        <- Ty.t_map(kt, vt)
    }
    when is_kind(node, AST.K_STRUCT_INIT) {
        let name -> AST.struct_init_name(node)
        let sname -> Str.to_string(name)
        let sym -> Ty.sc_lookup(C[`scope`], name)
        let struct_type -> Nothing
        when sym == Nothing and Str.contains(sname, `<`) and Str.ends_with(sname, `>`) {
            let base_name -> Str.substring(sname, 0, Str.index_of(sname, `<`))
            let base_sym -> Ty.sc_lookup(C[`scope`], base_name)
            when base_sym != Nothing {
                sym -> base_sym
                struct_type -> Ty.instantiate_generic_symbol(base_sym[`type`], sname)
            }
        }
        when struct_type == Nothing and sym != Nothing {
            struct_type -> sym[`type`]
        }
        when sym == Nothing {
            push_node_error(node, `Undefined structure '` + sname + `'`)
            <- Ty.t_unknown()
        }
        // check fields exist if structure type
        let fields -> AST.struct_init_fields(node)
        when fields != Nothing and Str.to_string(struct_type[`kind`]) == `Structure` {
            let mems -> struct_type[`members`]
            do for f in fields {
                let fn -> AST.struct_field_name(f)
                when mems != Nothing and not mems.has(fn) {
                    push_node_error(node, `Unknown field '` + Str.to_string(fn) + `' on ` + sname)
                }
                when AST.struct_field_val(f) != Nothing {
                    let ft -> check_expr(AST.struct_field_val(f))
                    when mems != Nothing and mems.has(fn) {
                        let expected_ft -> mems[fn]
                        when not is_untyped(expected_ft) and not is_untyped(ft) {
                            when not Ty.type_equal(expected_ft, ft) {
                                push_node_error(node, `Type mismatch for field '` + Str.to_string(fn) + `': expected ` + Ty.type_name(expected_ft) + `, got ` + Ty.type_name(ft))
                            }
                        }
                    }
                }
            }
        }
        when struct_type != Nothing {
            <- struct_type
        }
        <- Ty.t_unknown()
    }
    when is_kind(node, AST.K_CHECK) {
        <- check_expr(AST.check_expr_expr(node))
    }
    when is_kind(node, AST.K_IS) {
        let _vt -> check_expr(AST.is_expr_val(node))
        // pattern may be GetExpression (Enum.Variant) or literal; soft-check
        when AST.is_expr_pat(node) != Nothing {
            let _pt -> check_expr(AST.is_expr_pat(node))
        }
        <- Ty.t_boolean()
    }
    when is_kind(node, AST.K_FUNC_EXPR) {
        // lambda: scope params, check body, type is Function
        let outer -> C[`scope`]
        let body_scope -> Ty.sc_create(outer)
        let params -> AST.fn_expr_params(node)
        let ptypes -> []
        when params != Nothing {
            do for p in params {
                let pt -> Ty.t_variant()
                when AST.param_type(p) != Nothing {
                    pt -> Ty.type_from_ann(AST.param_type(p))
                }
                ptypes.append(pt)
                body_scope -> Ty.sc_define(body_scope, AST.param_name(p), pt, `PARAMETER`, false)
            }
        }
        let prev_ret -> C[`current_return`]
        let prev_in -> C[`in_function`]
        C[`current_return`] -> Ty.t_variant()
        C[`in_function`] -> true
        C[`scope`] -> body_scope
        let body -> AST.fn_expr_body(node)
        when body != Nothing {
            when is_kind(body, AST.K_BLOCK) {
                let stmts -> AST.block_stmts(body)
                when stmts != Nothing {
                    do for s in stmts {
                        check_stmt(s)
                    }
                }
            } or {
                check_stmt(body)
            }
        }
        C[`scope`] -> outer
        C[`current_return`] -> prev_ret
        C[`in_function`] -> prev_in
        <- Ty.t_function(`lambda`, ptypes, Ty.t_variant())
    }
    when is_kind(node, AST.K_INDEX_ASSIGN) {
        let _ot -> check_expr(AST.idx_assign_obj(node))
        let _it -> check_expr(AST.idx_assign_expr(node))
        let vt -> check_expr(AST.idx_assign_val(node))
        when Str.to_string(_ot[`kind`]) == `List` and _ot[`element`] != Nothing {
            when not Ty.type_equal(_ot[`element`], vt) {
                when Str.to_string(vt[`kind`]) != `Variant` and Str.to_string(_ot[`element`][`kind`]) != `Variant` and Str.to_string(vt[`kind`]) != `Unknown` and Str.to_string(_ot[`element`][`kind`]) != `Unknown` {
                    push_node_error(node, `Type mismatch in list index assignment: expected ` + Ty.type_name(_ot[`element`]) + ` got ` + Ty.type_name(vt))
                }
            }
        }
        when Str.to_string(_ot[`kind`]) == `Map` {
            when _ot[`key`] != Nothing and not Ty.type_equal(_ot[`key`], _it) {
                when Str.to_string(_it[`kind`]) != `Variant` and Str.to_string(_ot[`key`][`kind`]) != `Variant` and Str.to_string(_it[`kind`]) != `Unknown` and Str.to_string(_ot[`key`][`kind`]) != `Unknown` {
                    push_node_error(node, `Type mismatch in map key assignment: expected ` + Ty.type_name(_ot[`key`]) + ` got ` + Ty.type_name(_it))
                }
            }
            when _ot[`value`] != Nothing and not Ty.type_equal(_ot[`value`], vt) {
                when Str.to_string(vt[`kind`]) != `Variant` and Str.to_string(_ot[`value`][`kind`]) != `Variant` and Str.to_string(vt[`kind`]) != `Unknown` and Str.to_string(_ot[`value`][`kind`]) != `Unknown` {
                    push_node_error(node, `Type mismatch in map value assignment: expected ` + Ty.type_name(_ot[`value`]) + ` got ` + Ty.type_name(vt))
                }
            }
        }
        <- vt
    }
    // Fallback
    <- Ty.t_variant()
}

function check_call(node) {
    let callee -> AST.call_callee(node)
    let args -> AST.call_args(node)
    let argc -> 0
    when args != Nothing {
        argc -> args.length
        let ai -> 0
        do while ai < argc {
            let _at -> check_expr(args[ai])
            maybe_mark_move(args[ai])
            ai -> ai + 1
        }
    }
    when is_kind(callee, AST.K_VARIABLE) {
        let vname -> Str.to_string(AST.var_name(callee))
        when Ty.is_forbidden_type_name(vname) {
            push_node_error(node, `Type '` + vname + `' is not supported in Zenlang. Use canonical types ('Integer', 'Decimal', 'String', 'Boolean', 'Byte', 'Rune')`)
            <- Ty.t_variant()
        }
    }
    let callee_t -> check_expr(callee)
    let ck -> Str.to_string(callee_t[`kind`])
    when ck == `Class` or ck == `Structure` {
        let cname -> Ty.type_name(callee_t)
        check_ctor_arity(node, cname, callee_t, argc)
        <- callee_t
    }
    when ck == `Function` {
        let cname -> callee_t[`name`]
        let act_callee_t -> callee_t
        when callee_t.has(`generics`) and callee_t[`generics`] != Nothing {
            let gparams -> callee_t[`generics`]
            let substs -> {}
            let params0 -> callee_t[`params`]
            when params0 != Nothing and args != Nothing {
                let min_len -> params0.length
                when args.length < min_len { min_len -> args.length }
                let pi -> 0
                do while pi < min_len {
                    let act_at -> check_expr(args[pi])
                    Ty.infer_type_substitutions(params0[pi], act_at, gparams, substs)
                    pi -> pi + 1
                }
            }
            when substs.keys().length > 0 {
                act_callee_t -> Ty.substitute_type(callee_t, substs)
            }
        }
        check_arity(node, cname, act_callee_t, argc)
        let params -> act_callee_t[`params`]
        when params != Nothing and args != Nothing {
            let min_len -> params.length
            when args.length < min_len {
                min_len -> args.length
            }
            let pi -> 0
            do while pi < min_len {
                let exp_pt -> params[pi]
                let act_at -> check_expr(args[pi])
                when exp_pt != Nothing and act_at != Nothing and not Ty.type_equal(exp_pt, act_at) {
                    when Str.to_string(exp_pt[`kind`]) != `Variant` and Str.to_string(act_at[`kind`]) != `Variant` and Str.to_string(exp_pt[`kind`]) != `Unknown` and Str.to_string(act_at[`kind`]) != `Unknown` and Str.to_string(exp_pt[`kind`]) != `TypeParam` {
                        push_node_error(args[pi], `Argument ` + Str.to_string(pi + 1) + ` type mismatch in call to '` + Str.to_string(cname) + `': expected ` + Ty.type_name(exp_pt) + ` got ` + Ty.type_name(act_at))
                    }
                }
                pi -> pi + 1
            }
        }
        when act_callee_t[`return`] != Nothing {
            <- act_callee_t[`return`]
        }
    }
    <- Ty.t_variant()
}

function check_ctor_arity(node, name, inst, argc) {
    when inst == Nothing {
        <- Nothing
    }
    let methods -> inst[`methods`]
    when methods == Nothing {
        when argc != 0 {
            push_node_error(node, `Wrong arity for '` + Str.to_string(name) + `': expected 0 got ` + Str.to_string(argc))
        }
        <- Nothing
    }
    when methods.has(`init`) {
        let init_t -> methods[`init`]
        check_arity(node, Str.to_string(name), init_t, argc)
        <- Nothing
    }
    when argc != 0 {
        push_node_error(node, `Wrong arity for '` + Str.to_string(name) + `': expected 0 got ` + Str.to_string(argc))
    }
}

function check_arity(node, name, ft, argc) {
    when ft == Nothing {
        <- Nothing
    }
    when name == `writeln` or name == `write` {
        <- Nothing
    }
    let params -> ft[`params`]
    let expect -> 0
    when params != Nothing {
        expect -> params.length
    }
    when expect != argc {
        push_node_error(node, `Wrong arity for '` + Str.to_string(name) + `': expected ` + Str.to_string(expect) + ` got ` + Str.to_string(argc))
    }
}

function check_get(node) {
    let ot -> check_expr(AST.get_obj(node))
    let mn -> AST.get_name(node)
    let k -> Str.to_string(ot[`kind`])
    when k == `List` {
        when mn == `length` {
            <- Ty.t_integer()
        }
        when mn == `append` {
            let elem -> ot[`element`]
            when elem == Nothing { elem -> Ty.t_variant() }
            <- Ty.t_function(`append`, [elem], Ty.t_void())
        }
        when mn == `get` {
            let elem -> ot[`element`]
            when elem == Nothing { elem -> Ty.t_variant() }
            <- Ty.t_function(`get`, [Ty.t_integer()], elem)
        }
        when mn == `has` {
            let elem -> ot[`element`]
            when elem == Nothing { elem -> Ty.t_variant() }
            <- Ty.t_function(`has`, [elem], Ty.t_boolean())
        }
        when mn == `reverse` or mn == `unique` or mn == `flatten` {
            <- Ty.t_function(mn, [], ot)
        }
    }
    when k == `Map` {
        when mn == `length` {
            <- Ty.t_integer()
        }
        when mn == `has` {
            let kt -> ot[`key`]
            when kt == Nothing { kt -> Ty.t_variant() }
            <- Ty.t_function(`has`, [kt], Ty.t_boolean())
        }
        when mn == `get` {
            let kt -> ot[`key`]
            when kt == Nothing { kt -> Ty.t_variant() }
            let vt -> ot[`value`]
            when vt == Nothing { vt -> Ty.t_variant() }
            <- Ty.t_function(`get`, [kt], vt)
        }
        when mn == `keys` {
            let kt -> ot[`key`]
            when kt == Nothing { kt -> Ty.t_variant() }
            <- Ty.t_function(`keys`, [], Ty.t_list(kt))
        }
        when mn == `values` {
            let vt -> ot[`value`]
            when vt == Nothing { vt -> Ty.t_variant() }
            <- Ty.t_function(`values`, [], Ty.t_list(vt))
        }
    }
    when k == `Set` {
        when mn == `length` {
            <- Ty.t_integer()
        }
        when mn == `has` or mn == `add` or mn == `remove` {
            let elem -> ot[`element`]
            when elem == Nothing { elem -> Ty.t_variant() }
            <- Ty.t_function(mn, [elem], Ty.t_boolean())
        }
        when mn == `to_list` {
            let elem -> ot[`element`]
            when elem == Nothing { elem -> Ty.t_variant() }
            <- Ty.t_function(`to_list`, [], Ty.t_list(elem))
        }
    }
    when k == `String` {
        when mn == `length` {
            <- Ty.t_integer()
        }
    }
    when k == `Structure` or k == `Class` {
        let mems -> ot[`members`]
        when mems != Nothing and mems.has(mn) {
            <- mems[mn]
        }
        let methods -> ot[`methods`]
        when methods != Nothing and methods.has(mn) {
            <- methods[mn]
        }
        when mn == `length` {
            <- Ty.t_variant()
        }
        when k == `Class` {
            push_node_error(node, `Unknown method '` + Str.to_string(mn) + `' on ` + Ty.type_name(ot))
        }
    }
    <- Ty.t_variant()
}

function maybe_mark_move(node) {
    when node == Nothing {
        <- Nothing
    }
    when is_kind(node, AST.K_VARIABLE) {
        let name -> AST.var_name(node)
        let sym -> Ty.sc_lookup(C[`scope`], name)
        when sym != Nothing {
            when is_owned_sym(sym) {
                sym[`moved`] -> true
            }
        }
    }
}

function is_untyped(t) {
    when t == Nothing {
        <- true
    }
    let k -> Str.to_string(t[`kind`])
    when k == `Variant` or k == `Unknown` {
        <- true
    }
    <- false
}

function is_owned_sym(sym) {
    when sym == Nothing {
        <- false
    }
    when sym[`qualifier`] == `owned` {
        <- true
    }
    <- Ty.is_owned_type(sym[`type`])
}

function is_borrowed_expr(node) {
    when node == Nothing {
        <- false
    }
    when is_kind(node, AST.K_VARIABLE) {
        let sym -> Ty.sc_lookup(C[`scope`], AST.var_name(node))
        when sym == Nothing {
            <- false
        }
        when sym[`qualifier`] == `borrowed` {
            <- true
        }
        <- Ty.is_borrowed_type(sym[`type`])
    }
    <- false
}

function infer_literal(value) {
    when value == Nothing {
        <- Ty.t_nothing()
    }
    when value == true or value == false {
        <- Ty.t_boolean()
    }
    let s -> Str.to_string(value)
    when s == `true` or s == `false` or s == `True` or s == `False` {
        <- Ty.t_boolean()
    }
    when s == `Nothing` or s == `Nothing` or s == `None` {
        <- Ty.t_nothing()
    }
    when s == `Default` or s == `Default` {
        <- Ty.t_default()
    }
    when Str.contains(s, `.`) {
        // decimal or dotted — if mostly digits, decimal
        when looks_decimal(s) {
            <- Ty.t_decimal()
        }
    }
    when looks_integer(s) {
        <- Ty.t_integer()
    }
    <- Ty.t_string()
}

function looks_integer(s) {
    let n -> Str.length(s)
    when n == 0 {
        <- false
    }
    let digits -> `0123456789`
    let i -> 0
    let ch0 -> Str.at(s, 0)
    when ch0 == `-` {
        when n == 1 {
            <- false
        }
        i -> 1
    }
    <- all_in(s, i, n, digits)
}

function looks_decimal(s) {
    // one dot, digits around
    when not Str.contains(s, `.`) {
        <- false
    }
    <- true
}

function all_in(s, i, n, alphabet) {
    when i >= n {
        <- true
    }
    let ch -> Str.at(s, i)
    when not Str.contains(alphabet, ch) {
        <- false
    }
    <- all_in(s, i + 1, n, alphabet)
}

function parse_integer_value(s) {
    when s == Nothing { <- 0 }
    let str -> Str.to_string(s)
    let n -> Str.length(str)
    when n == 0 { <- 0 }
    let sign -> 1
    let i -> 0
    let ch0 -> Str.at(str, 0)
    when ch0 == `-` {
        sign -> -1
        i -> 1
    }
    let res -> 0
    let digits -> `0123456789`
    do while i < n {
        let ch -> Str.at(str, i)
        let d -> Str.index_of(digits, ch)
        when d != -1 {
            res -> res * 10 + d
        }
        i -> i + 1
    }
    <- sign * res
}

function check_literal_bounds(node, declared, val) {
    when val == Nothing { <- Nothing }
    let s -> Str.to_string(val)
    when not looks_integer(s) { <- Nothing }
    let n -> parse_integer_value(s)
    let bits -> declared[`bits`]
    let unsigned -> declared[`unsigned`]
    when unsigned == true and bits == 8 {
        when n < 0 or n > 255 {
            push_node_error(node, `Literal value ` + Str.to_string(n) + ` exceeds bounds for ` + Ty.type_name(declared) + ` (0..255)`)
        }
    }
    when unsigned == false and bits == 8 {
        when n < -128 or n > 127 {
            push_node_error(node, `Literal value ` + Str.to_string(n) + ` exceeds bounds for ` + Ty.type_name(declared) + ` (-128..127)`)
        }
    }
    when bits == 16 {
        when n < -32768 or n > 32767 {
            push_node_error(node, `Literal value ` + Str.to_string(n) + ` exceeds bounds for ` + Ty.type_name(declared) + ` (-32768..32767)`)
        }
    }
    when bits == 32 {
        when n < -2147483648 or n > 2147483647 {
            push_node_error(node, `Literal value ` + Str.to_string(n) + ` exceeds bounds for ` + Ty.type_name(declared) + ` (-2147483648..2147483647)`)
        }
    }
}

function materialize_default(node, target_type) {
    let k -> Str.to_string(target_type[`kind`])
    when k == `Integer` {
        AST.set_lit_val(node, 0)
    }
    when k == `Decimal` {
        AST.set_lit_val(node, 0.0)
    }
    when k == `String` {
        AST.set_lit_val(node, ``)
    }
    when k == `Rune` {
        AST.set_lit_val(node, ``)
    }
    when k == `Boolean` {
        AST.set_lit_val(node, `False`)
    }
    when k == `Nothing` or k == `Void` {
        AST.set_lit_val(node, `Nothing`)
    }
    when k == `List` {
        AST.set_ast_kind(node, AST.K_LIST)
        AST.set_list_elems(node, [])
    }
    when k == `Structure` or k == `Named` {
        // null-pointer equivalent
        AST.set_lit_val(node, `Nothing`)
    }
}

function infer_binary(op, lt, rt) {
    when op == `+` or op == `-` or op == `*` or op == `/` or op == `%` or op == `**` {
        when Str.to_string(lt[`kind`]) == `String` or Str.to_string(rt[`kind`]) == `String` {
            when op == `+` {
                <- Ty.t_string()
            }
        }
        when Str.to_string(lt[`kind`]) == `Decimal` or Str.to_string(rt[`kind`]) == `Decimal` {
            <- Ty.t_decimal()
        }
        <- Ty.t_integer()
    }
    when op == `==` or op == `=` or op == `!=` or op == `<` or op == `>` or op == `<=` or op == `>=` or op == `in` {
        <- Ty.t_boolean()
    }
    when op == `..` or op == `..+` or op == `..-` or op == `...` {
        <- Ty.t_variant()
    }
    when op == `and` or op == `or` {
        <- Ty.t_boolean()
    }
    <- Ty.t_variant()
}

function is_type_name_str(s) {
    when Ty.is_forbidden_type_name(s) { <- false }
    when s == `Integer` or s == `Decimal` or s == `String` or s == `Boolean` or s == `Byte` or s == `Bytes` or s == `Rune` { <- true }
    when s == `List` or s == `Set` or s == `Map` or s == `Vector` or s == `Tuple` { <- true }
    when s == `Structure` or s == `Object` or s == `Class` or s == `Enumerator` or s == `Function` or s == `Task` or s == `Channel` { <- true }
    when s == `Variant` or s == `Void` or s == `Nothing` or s == `nothing` or s == `Default` or s == `Error` { <- true }
    when s == `Number` or s == `Text` or s == `Collection` or s == `Container` { <- true }
    when Str.contains(s, `[`) and Str.ends_with(s, `]`) { <- true }
    when Str.contains(s, `<`) and Str.ends_with(s, `>`) { <- true }
    let ch -> Str.substring(s, 0, 1)
    when ch >= `A` and ch <= `Z` { <- true }
    <- false
}

function type_from_name_str(s) {
    when Str.contains(s, `[`) and Str.ends_with(s, `]`) {
        <- Ty.type_from_name(s)
    }
    when Str.contains(s, `<`) and Str.ends_with(s, `>`) {
        <- Ty.type_from_name(s)
    }
    when s == `Integer` {
        <- Ty.t_integer()
    }
    when s == `Byte` {
        <- Ty.t_byte()
    }
    when s == `Decimal` {
        <- Ty.t_decimal()
    }
    when s == `Vector` {
        <- Ty.t_vector(Ty.t_variant(), 0)
    }
    when s == `String` {
        <- Ty.t_string()
    }
    when s == `Boolean` {
        <- Ty.t_boolean()
    }
    when s == `Rune` {
        <- Ty.t_rune()
    }
    when s == `Bytes` {
        <- Ty.t_list(Ty.t_integer_sized(8, false))
    }
    when s == `List` {
        <- Ty.t_list(Ty.t_variant())
    }
    when s == `Set` {
        <- Ty.t_set(Ty.t_variant())
    }
    when s == `Map` {
        <- Ty.t_map(Ty.t_variant(), Ty.t_variant())
    }
    when s == `Option` {
        <- Ty.t_option(Ty.t_variant())
    }
    when s == `Result` {
        <- Ty.t_result(Ty.t_variant(), Ty.t_variant())
    }
    when s == `Task` {
        <- Ty.t_task(Ty.t_variant())
    }
    when s == `Nothing` {
        <- Ty.t_nothing()
    }
    when s == `Default` {
        <- Ty.t_default()
    }
    when s == `Void` {
        <- Ty.t_void()
    }
    <- Ty.type_from_name(s)
}
