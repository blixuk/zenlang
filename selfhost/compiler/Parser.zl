/!
 Self-hosted recursive-descent parser — Stage 2.
 Dual-path: token list + index (no class cursor mutation).
 AST nodes are maps from compiler.AST factories.
 Input tokens from compiler.Lexer (Tok.token maps; struct IR later).
 !/

import compiler.AST as AST
import compiler.Lexer as Lexer
import compiler.Token as Tok
from compiler.Token import TokenType
import zen.text.string as Str
import zen.time.time as Time
import zen.sys.sys as Sys
import compiler.Diagnostics as Diag
import zen.io.io as io

let G_SRC -> 0
let G_TOKENS -> 1
let G_LEN -> 2
let G_FILENAME -> 3
let G_ALLOW_STRUCT -> 4
let G_ALLOW_ASSIGN -> 5
let G_GENERIC_PARAMS -> 6

let G -> [``, [], 0, `<source>`, true, true, []]

// ---------- Token helpers ----------

function _ks(t) {
    <- Str.to_string(Tok.tok_kind(t))
}

export function _ch_esc() {
    <- Lexer._ch_esc()
}

function unescape_string_literal(s) {
    when s == Nothing or s == `` {
        <- ``
    }
    when Str.index_of(s, `\\`) < 0 {
        <- s
    }
    let n -> Str.length(s)
    let acc -> ``
    let i -> 0
    do while i < n {
        let c -> Str.at(s, i)
        when c == `\\` and i + 1 < n {
            let esc -> Str.at(s, i + 1)
            when esc == `x` and i + 3 < n {
                let h1 -> Str.at(s, i + 2)
                let h2 -> Str.at(s, i + 3)
                when (h1 == `1`) and (h2 == `b` or h2 == `B`) {
                    acc -> acc + Lexer._ch_esc()
                    i -> i + 4
                } or {
                    acc -> acc + `\\x` + h1 + h2
                    i -> i + 4
                }
            } or when esc == `e` {
                acc -> acc + Lexer._ch_esc()
                i -> i + 2
            } or when esc == `0` and i + 3 < n and Str.at(s, i + 2) == `3` and Str.at(s, i + 3) == `3` {
                acc -> acc + Lexer._ch_esc()
                i -> i + 4
            } or when esc == `0` {
                acc -> acc + `\\0`
                i -> i + 2
            } or {
                acc -> acc + Lexer.escape_piece(esc)
                i -> i + 2
            }
        } or {
            acc -> acc + c
            i -> i + 1
        }
    }
    <- acc
}

/!
 Exact token-kind match. Do NOT use ends_with/contains — those false-positive:
   is_kind(NOTHING, NOT) via ".NOT" prefix of ".NOTHING"
   is_kind(NOT_EQUAL, EQUAL) via ends_with "EQUAL"
   is_kind(FOR, OR) via ends_with "OR"
 Kind is an integer id (Token.kind_id). Compare ints on the native host.
 !/
function is_kind(t, name) {
    when t == Nothing or name == Nothing {
        <- false
    }
    let k -> Tok.tok_kind(t)
    // Same representation on each host (int==int native, variant==variant interpret).
    when k == name {
        <- true
    }
    <- k == Tok.kind_id(name)
}

function is_eof(t) {
    <- is_kind(t, TokenType.EOF)
}

function is_val(t, v) {
    let src -> G[G_SRC]
    when src != Nothing and Str.length(src) > 0 {
        <- Tok.tok_lexeme(src, t) == v
    }
    <- Tok.tok_value(t) == v
}

function tok_at(i) {
    let toks -> G[G_TOKENS]
    let n -> G[G_LEN]
    when i >= n {
        <- toks[n - 1]
    }
    <- toks[i]
}

function line_of(t) {
    <- Tok.tok_line(t)
}

function col_of(t) {
    <- Tok.tok_column(t)
}

function val_of(t) {
    let src -> G[G_SRC]
    let raw -> ``
    when src != Nothing and Str.length(src) > 0 {
        raw -> Tok.tok_lexeme(src, t)
    } or {
        raw -> Tok.tok_value(t)
    }
    when is_kind(t, TokenType.STRING) {
        let n -> Str.length(raw)
        when n >= 2 and (Str.at(raw, 0) == `"` or Str.at(raw, 0) == `\``) {
            <- unescape_string_literal(Str.substring(raw, 1, n - 1))
        }
        <- raw
    }
    when is_kind(t, TokenType.RUNE) {
        let n -> Str.length(raw)
        when n >= 2 and Str.at(raw, 0) == `'` {
            <- unescape_string_literal(Str.substring(raw, 1, n - 1))
        }
        <- raw
    }
    <- raw
}

function kind_of(t) {
    <- Tok.tok_kind(t)
}

// ---------- Result helpers: { node|stmts, i, err } ----------

function parser_ok(node, i) {
    <- {`node` -> node, `i` -> i, `err` -> Nothing}
}

function parser_ok_list(stmts, i) {
    <- {`stmts` -> stmts, `i` -> i, `err` -> Nothing}
}

function fail(i, msg) {
    when Str.starts_with(msg, `error:`) {
        <- {`node` -> Nothing, `stmts` -> Nothing, `i` -> i, `err` -> msg}
    }
    let t -> tok_at(i)
    let line -> Tok.tok_line(t)
    let col -> Tok.tok_column(t)
    let len -> Tok.tok_length(t)
    let fn -> G[G_FILENAME]
    let formatted -> Diag.format_error(G[G_SRC], fn, msg, line, col, len)
    <- {`node` -> Nothing, `stmts` -> Nothing, `i` -> i, `err` -> formatted, `raw_err` -> msg, `line` -> line, `col` -> col}
}

// ---------- Public API ----------

/!
 Parse source text with filename → Program AST map.
 !/
export function parse_source_file(src, filename) {
    let want -> Sys.get_env(`ZEN_PROFILE`) == `1`
    let t0 -> Time.monotonic()
    G[G_SRC] -> src
    G[G_FILENAME] -> filename
    let tokens -> Lexer.tokenize_source(src)
    let t1 -> Time.monotonic()
    let prog -> parse_tokens(tokens)
    let t2 -> Time.monotonic()
    when want == true {
        io.writeln(`profile lex ` + Str.to_string((t1 - t0) * 1000) + ` ms`)
        io.writeln(`profile parse ` + Str.to_string((t2 - t1) * 1000) + ` ms`)
    }
    <- prog
}

/!
 Parse source text → Program AST map.
 !/
export function parse_source(src) {
    <- parse_source_file(src, `<source>`)
}

/!
 Parse token list → Program AST map.
 !/
function stmt_push(stmts, node) {
    when stmts == Nothing {
        stmts -> []
    }
    let grown -> stmts.append(node)
    when grown != Nothing {
        <- grown
    }
    <- stmts
}

export function parse_tokens(tokens) {
    G[G_TOKENS] -> tokens
    G[G_LEN] -> tokens.length
    G[G_ALLOW_STRUCT] -> true
    G[G_ALLOW_ASSIGN] -> true
    G[G_GENERIC_PARAMS] -> []
    let stmts -> []
    let i -> 0
    let err -> Nothing
    do while i < G[G_LEN] and not is_eof(tok_at(i)) and err == Nothing {
        let step -> parse_one_top(i, stmts)
        err -> step[`err`]
        i -> step[`i`]
        stmts -> step[`stmts`]
    }
    when err != Nothing {
        <- AST.program_error(err)
    }
    <- AST.program(stmts)
}

function parse_one_top(i, stmts) {
    when is_kind(tok_at(i), TokenType.DOC_COMMENT) {
        <- { `i` -> i + 1, `stmts` -> stmts, `err` -> Nothing }
    }
    let d -> parse_declaration(i)
    when d[`err`] != Nothing {
        <- { `i` -> i, `stmts` -> stmts, `err` -> d[`err`] }
    }
    let nxt -> d[`i`]
    when nxt == Nothing or nxt <= i {
        <- { `i` -> i, `stmts` -> stmts, `err` -> `Parser stuck.` }
    }
    when d[`node`] != Nothing {
        <- { `i` -> nxt, `stmts` -> stmt_push(stmts, d[`node`]), `err` -> Nothing }
    }
    <- { `i` -> nxt, `stmts` -> stmts, `err` -> Nothing }
}

// Class wrapper (prefer free functions under -g)
class Parser {
    let tokens

    function init(tokens) {
        self.tokens -> tokens
    }

    function parse() {
        <- parse_tokens(self.tokens)
    }
}

// ---------- Program / declarations ----------

function parse_program(i, stmts) {
    <- parse_tokens(G[G_TOKENS])
}

function parse_declaration(i) {
    let t -> tok_at(i)
    when is_kind(t, TokenType.DOC_COMMENT) or is_kind(t, TokenType.COMMENT) {
        <- parser_ok(Nothing, i + 1)
    }
    // export function / export let — skip modifier (stdlib + selfhost)
    when is_kind(t, TokenType.EXPORT) or is_val(t, `export`) {
        <- parse_declaration(i + 1)
    }
    // extern use / extern from ... use
    when is_kind(t, TokenType.EXTERN) or is_val(t, `extern`) {
        <- parse_extern_declaration(i + 1)
    }
    // from module import Name  → treat as import module (Stage 3/7.x)
    when is_kind(t, TokenType.FROM) or is_val(t, `from`) {
        <- parse_from_import(i + 1)
    }
    when is_kind(t, TokenType.KEYWORD) or is_kind(t, TokenType.SCOPE) or is_kind(t, TokenType.IMPORT) or is_kind(t, TokenType.FROM) {
        let v -> val_of(t)
        when v == `function` {
            <- parse_function(i + 1)
        }
        when v == `let` or v == `set` {
            <- parse_let(i + 1, v == `let`)
        }
        when v == `structure` {
            <- parse_structure(i + 1)
        }
        when v == `scope` {
            <- parse_scope(i + 1)
        }
        when v == `import` or v == `use` {
            <- parse_import(i + 1)
        }
        when v == `class` {
            <- parse_class(i + 1)
        }
        when v == `enumerator` {
            <- parse_enumerator(i + 1)
        }
    }
    when is_kind(t, TokenType.TYPE_LET) {
        // :> sugar start — uncommon alone; fall through
    }
    <- parse_statement(i)
}

// ---------- Statements ----------

function parse_statement(i) {
    let t -> tok_at(i)
    // check expr { case ... } / check expr or { ... } / check expr raise ...
    when is_kind(t, TokenType.CHECK) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `check`)) {
        <- parse_check(i + 1)
    }
    // with resource [as alias] { body } — TokenType.WITH
    when is_kind(t, TokenType.WITH) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `with`)) {
        <- parse_with(i + 1)
    }
    when is_kind(t, TokenType.IS) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `is`)) {
        <- parse_is_case_arm(i + 1, t)
    }
    when is_kind(t, TokenType.OR) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `or`)) {
        let j -> i + 1
        let tj -> tok_at(j)
        when is_kind(tj, TokenType.IS) or (is_kind(tj, TokenType.KEYWORD) and is_val(tj, `is`)) {
            <- parse_is_case_arm(j + 1, t)
        }
        when is_kind(tj, TokenType.RETURN) or is_val(tj, `<-`) {
            let ret_res -> parse_expression(j + 1)
            when ret_res[`err`] != Nothing { <- ret_res }
            let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(tj), col_of(tj))
            let body_node -> AST.block([ret_stmt], line_of(tj), col_of(tj))
            <- parser_ok(AST.case_clause(Nothing, body_node, line_of(t), col_of(t)), ret_res[`i`])
        }
        when is_kind(tj, TokenType.LEFT_BRACE) {
            let br -> parse_block(j)
            when br[`err`] != Nothing {
                <- br
            }
            <- parser_ok(AST.case_clause(Nothing, br[`node`], line_of(t), col_of(t)), br[`i`])
        }
    }
    when is_kind(t, TokenType.RAISE) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `raise`)) {
        <- parse_raise_stmt(i + 1)
    }
    when is_kind(t, TokenType.KEYWORD) or is_kind(t, TokenType.ASSERT) or
         is_kind(t, TokenType.ASSERT_SYMBOL) or is_kind(t, TokenType.DEFER) or is_kind(t, TokenType.CASE) {
        let v -> val_of(t)
        when v == `raise` {
            <- parse_raise_stmt(i + 1)
        }
        when v == `check` {
            <- parse_check(i + 1)
        }
        when v == `when` {
            <- parse_when(i + 1)
        }
        when v == `while` {
            <- parse_while(i + 1)
        }
        when v == `do` {
            <- parse_do(i + 1)
        }
        when v == `for` {
            <- parse_for(i + 1)
        }
        when v == `return` {
            <- parse_return_kw(i + 1)
        }
        when v == `assert` or is_kind(t, TokenType.ASSERT_SYMBOL) or v == `!` {
            when is_kind(t, TokenType.ASSERT_SYMBOL) or v == `!` {
                <- parse_assert(i + 1)
            }
            when v == `assert` {
                <- parse_assert(i + 1)
            }
        }
        when v == `defer` {
            <- parse_defer(i + 1)
        }
        when v == `with` {
            <- parse_with(i + 1)
        }
        when v == `let` or v == `set` {
            <- parse_let(i + 1, v == `let`)
        }
        when v == `break` or v == `continue` {
            <- parser_ok(AST.expr_stmt(AST.lit(v, line_of(t), col_of(t)), line_of(t), col_of(t)), i + 1)
        }
    }
    when is_kind(t, TokenType.RETURN) or is_val(t, `<-`) {
        <- parse_return_arrow(i + 1)
    }
    when is_kind(t, TokenType.ASSERT) or is_kind(t, TokenType.ASSERT_SYMBOL) or is_val(t, `!`) or is_val(t, `assert`) {
        // only if start of statement — assert expression
        // careful: ! also appears in expressions; at statement start it's assert
        <- parse_assert(i + 1)
    }
    when is_kind(t, TokenType.LEFT_BRACE) {
        <- parse_block(i)
    }
    <- parse_expression_statement(i)
}

function parse_block(i) {
    // expects '{'
    let open -> tok_at(i)
    when not is_kind(open, TokenType.LEFT_BRACE) {
        <- fail(i, `Expected '{'.`)
    }
    let stmts -> []
    let j -> i + 1
    let err -> Nothing
    do while j < G[G_LEN] and not is_eof(tok_at(j)) and not is_kind(tok_at(j), TokenType.RIGHT_BRACE) and err == Nothing {
        let step -> parse_one_block(j, stmts)
        err -> step[`err`]
        j -> step[`j`]
        stmts -> step[`stmts`]
    }
    when err != Nothing {
        <- fail(j, err)
    }
    when not is_kind(tok_at(j), TokenType.RIGHT_BRACE) {
        <- fail(j, `Expected '}'.`)
    }
    <- parser_ok(AST.block(stmts, line_of(open), col_of(open)), j + 1)
}

function parse_one_block(j, stmts) {
    let s -> parse_declaration(j)
    when s[`err`] != Nothing {
        <- { `j` -> j, `stmts` -> stmts, `err` -> s[`err`] }
    }
    let nxt -> s[`i`]
    when nxt == Nothing or nxt <= j {
        <- { `j` -> j, `stmts` -> stmts, `err` -> `Parser stuck.` }
    }
    when s[`node`] != Nothing {
        <- { `j` -> nxt, `stmts` -> stmt_push(stmts, s[`node`]), `err` -> Nothing }
    }
    <- { `j` -> nxt, `stmts` -> stmts, `err` -> Nothing }
}

function parse_block_body(i, stmts) {
    <- parser_ok_list(stmts, i)
}

function parse_let(i, mutable) {
    // after 'let'/'set'
    let name_t -> tok_at(i)
    when not is_name_token(name_t) {
        <- fail(i, `Expected variable name.`)
    }
    let name -> val_of(name_t)
    let j -> i + 1
    let type_ann -> Nothing
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.TYPE_SET) or is_val(tj, `:`) {
        let tr -> parse_type_name(j + 1)
        when tr[`err`] != Nothing {
            <- tr
        }
        type_ann -> tr[`node`]
        j -> tr[`i`]
        tj -> tok_at(j)
    }
    when is_kind(tj, TokenType.TYPE_LET) or is_val(tj, `:>`) {
        let er -> parse_expression(j + 1)
        when er[`err`] != Nothing {
            <- er
        }
        <- parser_ok(AST.let_stmt(name, er[`node`], type_ann, mutable, line_of(name_t), col_of(name_t)), er[`i`])
    }
    when not (is_kind(tj, TokenType.ASSIGNMENT) or is_val(tj, `->`)) {
        // bare let name without init
        <- parser_ok(AST.let_stmt(name, Nothing, type_ann, mutable, line_of(name_t), col_of(name_t)), j)
    }
    j -> j + 1
    let er -> parse_expression(j)
    when er[`err`] != Nothing {
        <- er
    }
    <- parser_ok(AST.let_stmt(name, er[`node`], type_ann, mutable, line_of(name_t), col_of(name_t)), er[`i`])
}

function parse_function(i) {
    // after 'function'
    let name_t -> tok_at(i)
    when not is_name_token(name_t) {
        <- fail(i, `Expected function name.`)
    }
    let name -> val_of(name_t)
    let j -> i + 1
    let generic_params -> []
    let tj0 -> tok_at(j)
    when is_kind(tj0, TokenType.LESS_THAN) or is_val(tj0, `<`) {
        let gp_res -> parse_generic_param_list(j + 1)
        when gp_res[`err`] != Nothing {
            <- gp_res
        }
        generic_params -> gp_res[`params`]
        j -> gp_res[`i`]
    }

    let old_gp -> G[G_GENERIC_PARAMS]
    when generic_params != Nothing and generic_params.length > 0 {
        G[G_GENERIC_PARAMS] -> generic_params
    }

    let ret_type -> Nothing

    // Check if return type precedes parameters: function foo : ReturnType
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.TYPE_SET) or is_val(tj, `:`) {
        let tr -> parse_type_name(j + 1)
        when tr[`err`] != Nothing {
            G[G_GENERIC_PARAMS] -> old_gp
            <- tr
        }
        ret_type -> tr[`node`]
        j -> tr[`i`]
    }

    // optional ()
    let res -> Nothing
    when is_kind(tok_at(j), TokenType.LEFT_PAREN) {
        let pr -> parse_param_list(j + 1, [])
        when pr[`err`] != Nothing {
            G[G_GENERIC_PARAMS] -> old_gp
            <- pr
        }
        when not is_kind(tok_at(pr[`i`]), TokenType.RIGHT_PAREN) {
            G[G_GENERIC_PARAMS] -> old_gp
            <- fail(pr[`i`], `Expected ')'.`)
        }
        j -> pr[`i`] + 1

        // If return type was not before params, check if it follows params: function foo(params) : ReturnType
        when ret_type == Nothing {
            let tj2 -> tok_at(j)
            when is_kind(tj2, TokenType.TYPE_SET) or is_val(tj2, `:`) {
                let tr2 -> parse_type_name(j + 1)
                when tr2[`err`] != Nothing {
                    G[G_GENERIC_PARAMS] -> old_gp
                    <- tr2
                }
                ret_type -> tr2[`node`]
                j -> tr2[`i`]
            }
        }
        res -> parse_function_body(name, pr[`stmts`], name_t, ret_type, j, generic_params)
    } or {
        res -> parse_function_body(name, [], name_t, ret_type, j, generic_params)
    }
    G[G_GENERIC_PARAMS] -> old_gp
    <- res
}

function parse_function_after_params(name, params, name_t, j) {
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.TYPE_SET) or is_val(tj, `:`) {
        let tr -> parse_type_name(j + 1)
        when tr[`err`] != Nothing {
            <- tr
        }
        <- parse_function_body(name, params, name_t, tr[`node`], tr[`i`], [])
    }
    <- parse_function_body(name, params, name_t, Nothing, j, [])
}

function parse_function_body(name, params, name_t, ret, j, generic_params) {
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.RETURN) or is_val(tj, `<-`) or is_kind(tj, TokenType.ASSIGNMENT) or is_val(tj, `->`) {
        let er -> parse_expression(j + 1)
        when er[`err`] != Nothing {
            <- er
        }
        let ret_stmt -> AST.return_stmt(er[`node`], line_of(tj), col_of(tj))
        let body_node -> AST.block([ret_stmt], line_of(tj), col_of(tj))
        <- parser_ok(AST.function_stmt(name, params, body_node, ret, line_of(name_t), col_of(name_t), generic_params), er[`i`])
    }
    let br -> parse_block(j)
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.function_stmt(name, params, br[`node`], ret, line_of(name_t), col_of(name_t), generic_params), br[`i`])
}

/!
 Lambda: after 'function', next is '(' or '{' or '->' or '<-' (no name).
 !/
function parse_function_expression(i) {
    // i at '(' or '{' or arrow
    let t0 -> tok_at(i - 1)
    let params -> []
    let j -> i
    when is_kind(tok_at(j), TokenType.LEFT_PAREN) {
        let pr -> parse_param_list(j + 1, [])
        when pr[`err`] != Nothing {
            <- pr
        }
        params -> pr[`stmts`]
        j -> pr[`i`]
        when not is_kind(tok_at(j), TokenType.RIGHT_PAREN) {
            <- fail(j, `Expected ')' after lambda params.`)
        }
        j -> j + 1
    }
    when is_kind(tok_at(j), TokenType.TYPE_SET) or is_val(tok_at(j), `:`) {
        let tr -> parse_type_name(j + 1)
        j -> tr[`i`]
    }
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.RETURN) or is_val(tj, `<-`) or is_kind(tj, TokenType.ASSIGNMENT) or is_val(tj, `->`) {
        let er -> parse_expression(j + 1)
        when er[`err`] != Nothing {
            <- er
        }
        let ret_stmt -> AST.return_stmt(er[`node`], line_of(tj), col_of(tj))
        let body_node -> AST.block([ret_stmt], line_of(tj), col_of(tj))
        <- parser_ok(AST.function_expr(params, body_node, line_of(t0), col_of(t0)), er[`i`])
    }
    let br -> parse_block(j)
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.function_expr(params, br[`node`], line_of(t0), col_of(t0)), br[`i`])
}

/!
 True when token can be a binding name (param, let, field). Soft keywords included.
 !/
function is_name_token(t) {
    when is_kind(t, TokenType.IDENTIFIER) or is_kind(t, TokenType.KEYWORD) {
        <- true
    }
    // Soft/dedicated keyword kinds used as identifiers in selfhost sources
    when is_kind(t, TokenType.SCOPE) or is_kind(t, TokenType.SELF) or is_kind(t, TokenType.PARENT) or
         is_kind(t, TokenType.TYPE) or is_kind(t, TokenType.OBJECT) or is_kind(t, TokenType.TASK) or
         is_kind(t, TokenType.WITH) or is_kind(t, TokenType.AS) or is_kind(t, TokenType.FROM) or
         is_kind(t, TokenType.IMPORT) or is_kind(t, TokenType.EXPORT) {
        <- true
    }
    // Type words (`List`, `Map`, `String`, …) are TokenType.LIST etc.
    // Needed for `when value is List` in stdlib (json.zl).
    when is_kind(t, TokenType.LIST) or is_kind(t, TokenType.MAP) or is_kind(t, TokenType.SET) or
         is_kind(t, TokenType.VECTOR) or is_kind(t, TokenType.TUPLE) or is_kind(t, TokenType.CHANNEL) or
         is_kind(t, TokenType.STRING) or is_kind(t, TokenType.RUNE) or
         is_kind(t, TokenType.BYTE) or is_kind(t, TokenType.BYTES) or
         is_kind(t, TokenType.INTEGER) or is_kind(t, TokenType.DECIMAL) or is_kind(t, TokenType.BOOLEAN) or
         is_kind(t, TokenType.NOTHING) or is_kind(t, TokenType.VOID) or is_kind(t, TokenType.VARIANT) or
         is_kind(t, TokenType.FUNCTION) or is_kind(t, TokenType.ENUMERATOR) or is_kind(t, TokenType.STRUCTURE) or
         is_kind(t, TokenType.CLASS) or is_kind(t, TokenType.DEFAULT) {
        <- true
    }
    <- false
}

function parse_param_list(i, acc) {
    let params -> []
    let j -> i
    let err -> Nothing
    do while j < G[G_LEN] and not is_eof(tok_at(j)) and not is_kind(tok_at(j), TokenType.RIGHT_PAREN) and err == Nothing {
        let name_t -> tok_at(j)
        when not is_name_token(name_t) {
            err -> `Expected parameter name.`
        } or {
            let name -> val_of(name_t)
            j -> j + 1
            let ty -> Nothing
            when is_kind(tok_at(j), TokenType.TYPE_SET) or is_val(tok_at(j), `:`) {
                let tr -> parse_type_name(j + 1)
                when tr[`err`] != Nothing {
                    err -> tr[`err`]
                } or {
                    ty -> tr[`node`]
                    j -> tr[`i`]
                }
            }
            params.append(AST.param(name, ty, line_of(name_t), col_of(name_t)))
            when is_kind(tok_at(j), TokenType.COMMA) or is_val(tok_at(j), `,`) {
                j -> j + 1
            }
        }
    }
    when err != Nothing {
        <- fail(j, err)
    }
    <- parser_ok_list(params, j)
}

function parse_generic_param_list(i) {
    let params -> []
    let j -> i
    let err -> Nothing
    do while j < G[G_LEN] and not is_eof(tok_at(j)) and not is_kind(tok_at(j), TokenType.GREATER_THAN) and not is_val(tok_at(j), `>`) and err == Nothing {
        do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
            j -> j + 1
        }
        let name_t -> tok_at(j)
        when is_kind(name_t, TokenType.GREATER_THAN) or is_val(name_t, `>`) {
            // trailing comma
        } or when not is_name_token(name_t) {
            err -> `Expected type parameter name in generic parameter list.`
        } or {
            let name -> val_of(name_t)
            params.append(name)
            j -> j + 1
            do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                j -> j + 1
            }
            when is_kind(tok_at(j), TokenType.COMMA) or is_val(tok_at(j), `,`) {
                j -> j + 1
            }
        }
    }
    when err != Nothing {
        <- fail(j, err)
    }
    when not is_kind(tok_at(j), TokenType.GREATER_THAN) and not is_val(tok_at(j), `>`) {
        <- fail(j, `Expected '>' after generic parameter list.`)
    }
    <- {
        `params` -> params,
        `i` -> j + 1,
        `err` -> Nothing
    }
}

function parser_is_forbidden_type_name(target_name) {
    let gp -> G[G_GENERIC_PARAMS]
    when gp != Nothing and gp.length > 0 {
        let gi -> 0
        let gn -> gp.length
        do while gi < gn {
            when Str.to_string(gp[gi]) == target_name {
                <- false
            }
            gi -> gi + 1
        }
    }
    when target_name == `Int` or target_name == `Int64` or target_name == `Int32` or target_name == `Int16` or target_name == `Int8` or target_name == `UInt8` { <- true }
    when target_name == `UInt16` or target_name == `UInt32` or target_name == `UInt64` { <- true }
    when target_name == `Float` or target_name == `Float64` or target_name == `Float32` or target_name == `Double` { <- true }
    when target_name == `Str` or target_name == `Bool` or target_name == `Char` or target_name == `Character` or target_name == `Glyph` or target_name == `Buffer` { <- true }
    when target_name == `V` or target_name == `L` or target_name == `S` or target_name == `T` or target_name == `M` { <- true }
    <- false
}

function is_type_name_str(target_name) {
    let gp -> G[G_GENERIC_PARAMS]
    when gp != Nothing and gp.length > 0 {
        let gi -> 0
        let gn -> gp.length
        do while gi < gn {
            when Str.to_string(gp[gi]) == target_name {
                <- true
            }
            gi -> gi + 1
        }
    }
    when parser_is_forbidden_type_name(target_name) { <- false }
    when target_name == `Integer` or target_name == `Decimal` or target_name == `String` or target_name == `Boolean` or target_name == `Byte` or target_name == `Bytes` or target_name == `Rune` { <- true }
    when target_name == `List` or target_name == `Set` or target_name == `Map` or target_name == `Vector` or target_name == `Tuple` { <- true }
    when target_name == `Structure` or target_name == `Object` or target_name == `Class` or target_name == `Enumerator` or target_name == `Function` or target_name == `Task` or target_name == `Channel` { <- true }
    when target_name == `Variant` or target_name == `Void` or target_name == `Nothing` or target_name == `nothing` or target_name == `Default` or target_name == `Error` { <- true }
    when target_name == `Number` or target_name == `Text` or target_name == `Collection` or target_name == `Container` { <- true }
    when Str.contains(target_name, `[`) and Str.ends_with(target_name, `]`) { <- true }
    when Str.contains(target_name, `<`) and Str.ends_with(target_name, `>`) { <- true }
    let ch -> Str.substring(target_name, 0, 1)
    when ch >= `A` and ch <= `Z` { <- true }
    <- false
}

function parse_type_name(i) {
    let t -> tok_at(i)
    let j -> i
    let qual -> ``
    when is_kind(t, TokenType.KEYWORD) and (is_val(t, `owned`) or is_val(t, `borrowed`)) {
        qual -> val_of(t)
        j -> j + 1
        t -> tok_at(j)
    }
    when is_kind(t, TokenType.TYPE) or is_kind(t, TokenType.IDENTIFIER) or is_kind(t, TokenType.KEYWORD) or
         is_kind(t, TokenType.INTEGER) or is_kind(t, TokenType.STRING) or is_kind(t, TokenType.BOOLEAN) or
         is_kind(t, TokenType.VOID) or is_kind(t, TokenType.LIST) or is_kind(t, TokenType.MAP) or
         is_kind(t, TokenType.SET) or is_kind(t, TokenType.TYPE_SET) or is_kind(t, TokenType.VARIANT) or
         is_kind(t, TokenType.NOTHING) or is_kind(t, TokenType.DECIMAL) or is_kind(t, TokenType.RUNE) or
         is_kind(t, TokenType.STRUCTURE) or is_kind(t, TokenType.FUNCTION) or is_kind(t, TokenType.CLASS) or
         is_kind(t, TokenType.BYTE) or is_kind(t, TokenType.BYTES) or is_kind(t, TokenType.VECTOR) or
         is_kind(t, TokenType.TUPLE) or is_kind(t, TokenType.DEFAULT) or is_kind(t, TokenType.AUTO) or
         is_kind(t, TokenType.CHANNEL) or is_kind(t, TokenType.LITERAL) {
        // dotted types A.B
        let name -> val_of(t)
        when parser_is_forbidden_type_name(name) {
            <- fail(i, `Type '` + name + `' is not supported in Zenlang. Use canonical types ('Integer', 'Decimal', 'String', 'Boolean', 'Byte', 'Rune')`)
        }
        j -> j + 1
        when is_kind(tok_at(j), TokenType.DOT) {
            let n2 -> tok_at(j + 1)
            name -> name + `.` + val_of(n2)
            j -> j + 2
        }
        when is_kind(tok_at(j), TokenType.LEFT_BRACKET) {
            j -> j + 1
            let params_str -> ``
            let first -> true
            do while not is_kind(tok_at(j), TokenType.RIGHT_BRACKET) and not is_eof(tok_at(j)) {
                do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                    j -> j + 1
                }
                when not first {
                    when is_kind(tok_at(j), TokenType.COMMA) {
                        j -> j + 1
                    }
                }
                do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                    j -> j + 1
                }
                when is_kind(tok_at(j), TokenType.RIGHT_BRACKET) {
                    // trailing comma
                } or {
                    first -> false
                    let sub_res -> parse_type_name(j)
                    when sub_res[`err`] != Nothing {
                        <- sub_res
                    }
                    let sub_ann -> sub_res[`node`]
                    let sub_name -> AST.type_ann_name(sub_ann)
                    when params_str == `` {
                        params_str -> sub_name
                    } or {
                        params_str -> params_str + `, ` + sub_name
                    }
                    j -> sub_res[`i`]
                    do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                        j -> j + 1
                    }
                    when is_kind(tok_at(j), TokenType.COMMA) {
                        j -> j + 1
                    }
                }
            }
            when is_kind(tok_at(j), TokenType.RIGHT_BRACKET) {
                j -> j + 1
            }
            name -> name + `[` + params_str + `]`
        }
        when is_kind(tok_at(j), TokenType.LESS_THAN) {
            j -> j + 1
            let gen_str -> ``
            let first_gen -> true
            do while not is_kind(tok_at(j), TokenType.GREATER_THAN) and not is_eof(tok_at(j)) {
                do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                    j -> j + 1
                }
                when not first_gen {
                    when is_kind(tok_at(j), TokenType.COMMA) {
                        j -> j + 1
                    }
                }
                do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                    j -> j + 1
                }
                when is_kind(tok_at(j), TokenType.GREATER_THAN) {
                    // trailing comma
                } or {
                    first_gen -> false
                    let sub_res -> parse_type_name(j)
                    when sub_res[`err`] != Nothing {
                        <- sub_res
                    }
                    let sub_ann -> sub_res[`node`]
                    let sub_name -> AST.type_ann_name(sub_ann)
                    when gen_str == `` {
                        gen_str -> sub_name
                    } or {
                        gen_str -> gen_str + `, ` + sub_name
                    }
                    j -> sub_res[`i`]
                    do while is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT) {
                        j -> j + 1
                    }
                    when is_kind(tok_at(j), TokenType.COMMA) {
                        j -> j + 1
                    }
                }
            }
            when not is_kind(tok_at(j), TokenType.GREATER_THAN) {
                <- fail(j, `Expected '>' after generic type arguments.`)
            }
            j -> j + 1
            name -> name + `<` + gen_str + `>`
        }
        <- parser_ok(type_ann(name, qual), j)
    }
    <- parser_ok(type_ann(val_of(t), qual), j + 1)
}

function type_ann(name, qual) {
    <- AST.type_ann(name, qual)
}

function parse_raise_stmt(i) {
    let t0 -> tok_at(i - 1)
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    <- parser_ok(AST.raise_stmt(er[`node`], line_of(t0), col_of(t0)), er[`i`])
}

function parse_return_kw(i) {
    let t -> tok_at(i - 1)
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) or is_eof(tok_at(i)) {
        <- parser_ok(AST.return_stmt(Nothing, line_of(t), col_of(t)), i)
    }
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    <- parser_ok(AST.return_stmt(er[`node`], line_of(t), col_of(t)), er[`i`])
}

function parse_return_arrow(i) {
    // after '<-'
    let t -> tok_at(i - 1)
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) or is_eof(tok_at(i)) {
        <- parser_ok(AST.return_stmt(Nothing, line_of(t), col_of(t)), i)
    }
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    <- parser_ok(AST.return_stmt(er[`node`], line_of(t), col_of(t)), er[`i`])
}

function parse_assert(i) {
    let t -> tok_at(i - 1)
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    <- parser_ok(AST.assert_stmt(er[`node`], line_of(t), col_of(t)), er[`i`])
}

function parse_defer(i) {
    let t -> tok_at(i - 1)
    let br -> parse_statement(i)
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.defer_stmt(br[`node`], line_of(t), col_of(t)), br[`i`])
}

/!
 with <expr> [as <alias>] { body }
 !/
function parse_with(i) {
    // after 'with'
    let t0 -> tok_at(i - 1)
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    let j -> er[`i`]
    let alias -> ``
    when is_kind(tok_at(j), TokenType.AS) or (is_kind(tok_at(j), TokenType.KEYWORD) and is_val(tok_at(j), `as`)) {
        j -> j + 1
        let a_t -> tok_at(j)
        when not is_name_token(a_t) {
            <- fail(j, `Expected alias after as.`)
        }
        alias -> val_of(a_t)
        j -> j + 1
    }
    let br -> parse_block(j)
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.with_stmt(er[`node`], alias, br[`node`], line_of(t0), col_of(t0)), br[`i`])
}

function parse_when(i) {
    // after 'when' — condition [when guard] ({ body } | <- expr) (or when cond ... )* (or ... )?
    let t0 -> tok_at(i - 1)
    let old_allow -> G[G_ALLOW_STRUCT]
    G[G_ALLOW_STRUCT] -> false
    let er -> parse_expression(i)
    G[G_ALLOW_STRUCT] -> old_allow
    when er[`err`] != Nothing {
        <- er
    }
    let cond -> er[`node`]
    let j -> er[`i`]
    let guard -> Nothing
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.KEYWORD) and is_val(tj, `when`) {
        let old_g_allow -> G[G_ALLOW_STRUCT]
        G[G_ALLOW_STRUCT] -> false
        let gr -> parse_expression(j + 1)
        G[G_ALLOW_STRUCT] -> old_g_allow
        when gr[`err`] != Nothing {
            <- gr
        }
        guard -> gr[`node`]
        j -> gr[`i`]
        tj -> tok_at(j)
    }
    when is_kind(tj, TokenType.RETURN) or is_val(tj, `<-`) {
        let ret_res -> parse_expression(j + 1)
        when ret_res[`err`] != Nothing { <- ret_res }
        let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(tj), col_of(tj))
        let body_node -> AST.block([ret_stmt], line_of(tj), col_of(tj))
        let cases -> [AST.case_clause_guard(cond, body_node, guard, line_of(t0), col_of(t0))]
        let r -> parse_when_tail(ret_res[`i`], cases)
        when r[`err`] != Nothing { <- r }
        <- parser_ok(AST.when_stmt(r[`stmts`], line_of(t0), col_of(t0)), r[`i`])
    }
    when is_kind(tj, TokenType.LEFT_BRACE) {
        let t_next -> tok_at(j + 1)
        when (is_kind(t_next, TokenType.KEYWORD) and (is_val(t_next, `is`) or is_val(t_next, `or`))) or is_kind(t_next, TokenType.IS) or is_kind(t_next, TokenType.OR) {
            <- parse_when_pattern_match_block(j + 1, cond, line_of(t0), col_of(t0))
        }
    }
    let br -> parse_block(j)
    when br[`err`] != Nothing {
        <- br
    }
    let cases -> [AST.case_clause_guard(cond, br[`node`], guard, line_of(t0), col_of(t0))]
    let r -> parse_when_tail(br[`i`], cases)
    when r[`err`] != Nothing { <- r }
    <- parser_ok(AST.when_stmt(r[`stmts`], line_of(t0), col_of(t0)), r[`i`])
}

function parse_when_pattern_match_block(i, subject, line, col) {
    let cases -> []
    let cur -> i
    do while not is_kind(tok_at(cur), TokenType.RIGHT_BRACE) and not is_eof(tok_at(cur)) {
        let t -> tok_at(cur)
        when is_kind(t, TokenType.OR) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `or`)) {
            let next_t -> tok_at(cur + 1)
            when is_kind(next_t, TokenType.RETURN) or is_val(next_t, `<-`) {
                let ret_res -> parse_expression(cur + 2)
                when ret_res[`err`] != Nothing { <- ret_res }
                let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(next_t), col_of(next_t))
                let body_node -> AST.block([ret_stmt], line_of(next_t), col_of(next_t))
                cases.append(AST.case_clause(AST.lit(true, line_of(t), col_of(t)), body_node, line_of(t), col_of(t)))
                cur -> ret_res[`i`]
            } or {
                let br -> parse_block(cur + 1)
                when br[`err`] != Nothing { <- br }
                cases.append(AST.case_clause(AST.lit(true, line_of(t), col_of(t)), br[`node`], line_of(t), col_of(t)))
                cur -> br[`i`]
            }
        } or when is_kind(t, TokenType.IS) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `is`)) {
            let pr -> Nothing
            let tr -> parse_type_name(cur + 1)
            when tr[`err`] == Nothing and (Str.contains(AST.type_ann_name(tr[`node`]), `<`) or (Str.contains(AST.type_ann_name(tr[`node`]), `[`) and Str.ends_with(AST.type_ann_name(tr[`node`]), `]`))) {
                let tname -> AST.type_ann_name(tr[`node`])
                let tvar -> AST.variable(tname, line_of(t), col_of(t))
                pr -> parser_ok(tvar, tr[`i`])
            } or {
                pr -> parse_comparison(cur + 1)
            }
            when pr[`err`] != Nothing { <- pr }
            let pat -> pr[`node`]
            let k -> pr[`i`]
            let guard -> Nothing
            let tk -> tok_at(k)
            when is_kind(tk, TokenType.KEYWORD) and is_val(tk, `when`) {
                let gr -> parse_expression(k + 1)
                when gr[`err`] != Nothing { <- gr }
                guard -> gr[`node`]
                k -> gr[`i`]
                tk -> tok_at(k)
            }
            let is_node -> AST.is_expr(subject, pat, line_of(t), col_of(t))
            when is_kind(tk, TokenType.RETURN) or is_val(tk, `<-`) {
                let ret_res -> parse_expression(k + 1)
                when ret_res[`err`] != Nothing { <- ret_res }
                let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(tk), col_of(tk))
                let body_node -> AST.block([ret_stmt], line_of(tk), col_of(tk))
                cases.append(AST.case_clause_guard(is_node, body_node, guard, line_of(t), col_of(t)))
                cur -> ret_res[`i`]
            } or {
                let br -> parse_block(k)
                when br[`err`] != Nothing { <- br }
                cases.append(AST.case_clause_guard(is_node, br[`node`], guard, line_of(t), col_of(t)))
                cur -> br[`i`]
            }
        } or {
            cur -> cur + 1
        }
    }
    when is_kind(tok_at(cur), TokenType.RIGHT_BRACE) {
        cur -> cur + 1
    }
    <- parser_ok(AST.when_stmt(cases, line, col), cur)
}

function parse_when_tail(i, cases) {
    // } or { ... }   or   or when expr ...   or   or <- expr
    let ti -> tok_at(i)
    when not is_kind(ti, TokenType.OR) and not is_val(ti, `or`) {
        <- parser_ok_list(cases, i)
    }
    // consume 'or'
    let j -> i + 1
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.KEYWORD) and is_val(tj, `when`) {
        let old_allow -> G[G_ALLOW_STRUCT]
        G[G_ALLOW_STRUCT] -> false
        let er -> parse_expression(j + 1)
        G[G_ALLOW_STRUCT] -> old_allow
        when er[`err`] != Nothing {
            <- er
        }
        let cond -> er[`node`]
        let k -> er[`i`]
        let guard -> Nothing
        let tk -> tok_at(k)
        when is_kind(tk, TokenType.KEYWORD) and is_val(tk, `when`) {
            let old_g_allow -> G[G_ALLOW_STRUCT]
            G[G_ALLOW_STRUCT] -> false
            let gr -> parse_expression(k + 1)
            G[G_ALLOW_STRUCT] -> old_g_allow
            when gr[`err`] != Nothing {
                <- gr
            }
            guard -> gr[`node`]
            k -> gr[`i`]
            tk -> tok_at(k)
        }
        when is_kind(tk, TokenType.RETURN) or is_val(tk, `<-`) {
            let ret_res -> parse_expression(k + 1)
            when ret_res[`err`] != Nothing { <- ret_res }
            let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(tk), col_of(tk))
            let body_node -> AST.block([ret_stmt], line_of(tk), col_of(tk))
            cases.append(AST.case_clause_guard(cond, body_node, guard, line_of(ti), col_of(ti)))
            <- parse_when_tail(ret_res[`i`], cases)
        }
        let br -> parse_block(k)
        when br[`err`] != Nothing {
            <- br
        }
        cases.append(AST.case_clause_guard(cond, br[`node`], guard, line_of(ti), col_of(ti)))
        <- parse_when_tail(br[`i`], cases)
    }
    // else branch: or <- expr
    when is_kind(tj, TokenType.RETURN) or is_val(tj, `<-`) {
        let ret_res -> parse_expression(j + 1)
        when ret_res[`err`] != Nothing { <- ret_res }
        let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(tj), col_of(tj))
        let body_node -> AST.block([ret_stmt], line_of(tj), col_of(tj))
        cases.append(AST.case_clause(Nothing, body_node, line_of(ti), col_of(ti)))
        <- parser_ok_list(cases, ret_res[`i`])
    }
    // else branch: or { ... }
    when is_kind(tj, TokenType.LEFT_BRACE) {
        let br -> parse_block(j)
        when br[`err`] != Nothing {
            <- br
        }
        cases.append(AST.case_clause(Nothing, br[`node`], line_of(ti), col_of(ti)))
        <- parser_ok_list(cases, br[`i`])
    }
    <- parser_ok_list(cases, i)
}

function parse_is_case_arm(i, t0) {
    let pr -> parse_comparison(i)
    when pr[`err`] != Nothing {
        <- pr
    }
    let pat -> pr[`node`]
    let j -> pr[`i`]
    let guard -> Nothing
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.KEYWORD) and is_val(tj, `when`) {
        let gr -> parse_expression(j + 1)
        when gr[`err`] != Nothing {
            <- gr
        }
        guard -> gr[`node`]
        j -> gr[`i`]
        tj -> tok_at(j)
    }
    when is_kind(tj, TokenType.RETURN) or is_val(tj, `<-`) {
        let ret_res -> parse_expression(j + 1)
        when ret_res[`err`] != Nothing { <- ret_res }
        let ret_stmt -> AST.return_stmt(ret_res[`node`], line_of(tj), col_of(tj))
        let body_node -> AST.block([ret_stmt], line_of(tj), col_of(tj))
        <- parser_ok(AST.case_clause_guard(pat, body_node, guard, line_of(t0), col_of(t0)), ret_res[`i`])
    }
    let br -> parse_block(j)
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.case_clause_guard(pat, br[`node`], guard, line_of(t0), col_of(t0)), br[`i`])
}

function parse_check(i) {
    // 1. check { ... } [or { ... }]
    // 2. check expr { case ... } [or { ... }]
    let t0 -> tok_at(i - 1)
    let subj -> Nothing
    let cases -> []
    let or_block -> Nothing
    let raise_expr -> Nothing
    let j -> i
    when is_kind(tok_at(j), TokenType.LEFT_BRACE) {
        let br -> parse_block(j)
        when br[`err`] != Nothing {
            <- br
        }
        subj -> br[`node`]
        j -> br[`i`]
    } or {
        let er -> parse_expression(j)
        when er[`err`] != Nothing {
            <- er
        }
        subj -> er[`node`]
        j -> er[`i`]
        when is_kind(tok_at(j), TokenType.LEFT_BRACE) {
            let cr -> parse_check_cases(j + 1, [])
            when cr[`err`] != Nothing {
                <- cr
            }
            cases -> cr[`stmts`]
            j -> cr[`i`]
            when is_kind(tok_at(j), TokenType.RIGHT_BRACE) {
                j -> j + 1
            } or {
                <- fail(j, `Expected '}' after check cases.`)
            }
        }
    }
    when is_kind(tok_at(j), TokenType.OR) or is_val(tok_at(j), `or`) {
        j -> j + 1
        when is_kind(tok_at(j), TokenType.LEFT_BRACE) {
            let br -> parse_block(j)
            when br[`err`] != Nothing {
                <- br
            }
            or_block -> br[`node`]
            j -> br[`i`]
        } or {
            let sr -> parse_statement(j)
            when sr[`err`] != Nothing {
                <- sr
            }
            or_block -> sr[`node`]
            j -> sr[`i`]
        }
    }
    <- parser_ok(AST.check_statement(subj, cases, or_block, raise_expr, line_of(t0), col_of(t0)), j)
}

function parse_check_cases(i, acc) {
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) or is_eof(tok_at(i)) {
        <- parser_ok_list(acc, i)
    }
    let t -> tok_at(i)
    when is_kind(t, TokenType.CASE) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `case`)) {
        let pat_res -> parse_expression(i + 1)
        when pat_res[`err`] != Nothing {
            <- pat_res
        }
        let pat -> pat_res[`node`]
        let j -> pat_res[`i`]
        let guard -> Nothing
        when is_kind(tok_at(j), TokenType.KEYWORD) and is_val(tok_at(j), `when`) {
            let gr -> parse_expression(j + 1)
            when gr[`err`] != Nothing {
                <- gr
            }
            guard -> gr[`node`]
            j -> gr[`i`]
        }
        let br -> parse_block(j)
        when br[`err`] != Nothing {
            <- br
        }
        acc.append(AST.case_clause_guard(pat, br[`node`], guard, line_of(t), col_of(t)))
        when is_kind(tok_at(br[`i`]), TokenType.COMMA) {
            <- parse_check_cases(br[`i`] + 1, acc)
        }
        <- parse_check_cases(br[`i`], acc)
    }
    <- parser_ok_list(acc, i)
}

function parse_while(i) {
    let t0 -> tok_at(i - 1)
    let old_allow -> G[G_ALLOW_STRUCT]
    G[G_ALLOW_STRUCT] -> false
    let er -> parse_expression(i)
    G[G_ALLOW_STRUCT] -> old_allow
    when er[`err`] != Nothing {
        <- er
    }
    let br -> parse_block(er[`i`])
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.while_stmt(er[`node`], br[`node`], line_of(t0), col_of(t0)), br[`i`])
}

function parse_do(i) {
    // after 'do' — do { } while cond   |  do while cond { }  |  do for ...
    let t0 -> tok_at(i - 1)
    when is_kind(tok_at(i), TokenType.KEYWORD) and is_val(tok_at(i), `while`) {
        // do while cond { body }
        let old_allow -> G[G_ALLOW_STRUCT]
        G[G_ALLOW_STRUCT] -> false
        let er -> parse_expression(i + 1)
        G[G_ALLOW_STRUCT] -> old_allow
        when er[`err`] != Nothing {
            <- er
        }
        let br -> parse_block(er[`i`])
        when br[`err`] != Nothing {
            <- br
        }
        <- parser_ok(AST.do_while_stmt(br[`node`], er[`node`], line_of(t0), col_of(t0), true), br[`i`])
    }
    when is_kind(tok_at(i), TokenType.KEYWORD) and is_val(tok_at(i), `for`) {
        <- parse_for(i + 1)
    }
    // do { body } while cond
    when is_kind(tok_at(i), TokenType.LEFT_BRACE) {
        let br -> parse_block(i)
        when br[`err`] != Nothing {
            <- br
        }
        when is_kind(tok_at(br[`i`]), TokenType.KEYWORD) and is_val(tok_at(br[`i`]), `while`) {
            let er -> parse_expression(br[`i`] + 1)
            when er[`err`] != Nothing {
                <- er
            }
            <- parser_ok(AST.do_while_stmt(br[`node`], er[`node`], line_of(t0), col_of(t0), false), er[`i`])
        }
        // bare do-block
        <- br
    }
    <- fail(i, `Expected do while/for/block.`)
}

function parse_for(i) {
    // after 'for' — name [: Type] in expr { body }
    let t0 -> tok_at(i - 1)
    let name_t -> tok_at(i)
    when not is_name_token(name_t) {
        <- fail(i, `Expected for variable.`)
    }
    let j -> i + 1
    let tj -> tok_at(j)
    when is_kind(tj, TokenType.TYPE_SET) or is_val(tj, `:`) {
        let tr -> parse_type_name(j + 1)
        when tr[`err`] != Nothing {
            <- tr
        }
        j -> tr[`i`]
        tj -> tok_at(j)
    }
    when not (is_kind(tj, TokenType.KEYWORD) and is_val(tj, `in`)) {
        <- fail(j, `Expected 'in'.`)
    }
    j -> j + 1
    let old_allow -> G[G_ALLOW_STRUCT]
    G[G_ALLOW_STRUCT] -> false
    let er -> parse_expression(j)
    G[G_ALLOW_STRUCT] -> old_allow
    when er[`err`] != Nothing {
        <- er
    }
    let br -> parse_block(er[`i`])
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.for_stmt(val_of(name_t), er[`node`], br[`node`], line_of(t0), col_of(t0)), br[`i`])
}

function parse_structure(i) {
    let name_t -> tok_at(i)
    let name -> val_of(name_t)
    let j -> i + 1
    let generic_params -> []
    let tj0 -> tok_at(j)
    when is_kind(tj0, TokenType.LESS_THAN) or is_val(tj0, `<`) {
        let gp_res -> parse_generic_param_list(j + 1)
        when gp_res[`err`] != Nothing {
            <- gp_res
        }
        generic_params -> gp_res[`params`]
        j -> gp_res[`i`]
    }
    let old_gp -> G[G_GENERIC_PARAMS]
    when generic_params != Nothing and generic_params.length > 0 {
        G[G_GENERIC_PARAMS] -> generic_params
    }
    let traits -> []
    when is_kind(tok_at(j), TokenType.IS) or is_val(tok_at(j), `is`) {
        j -> j + 1
        do while is_name_token(tok_at(j)) {
            traits.append(val_of(tok_at(j)))
            j -> j + 1
            when is_val(tok_at(j), `,`) {
                j -> j + 1
            }
        }
    }
    when not is_kind(tok_at(j), TokenType.LEFT_BRACE) {
        G[G_GENERIC_PARAMS] -> old_gp
        <- fail(j, `Expected '{' after structure name.`)
    }
    let mr -> parse_struct_members(j + 1, [])
    G[G_GENERIC_PARAMS] -> old_gp
    when mr[`err`] != Nothing {
        <- mr
    }
    when not is_kind(tok_at(mr[`i`]), TokenType.RIGHT_BRACE) {
        <- fail(mr[`i`], `Expected '}'.`)
    }
    <- parser_ok(AST.structure_stmt(name, mr[`stmts`], line_of(name_t), col_of(name_t), traits, generic_params), mr[`i`] + 1)
}

/!
 class Name [extends Parent] { let/set fields; function methods; }
 Emits ClassStatement with members + methods lists.
 !/
function parse_class(i) {
    // after 'class'
    let name_t -> tok_at(i)
    when not is_name_token(name_t) {
        <- fail(i, `Expected class name.`)
    }
    let name -> val_of(name_t)
    let j -> i + 1
    let generic_params -> []
    let tj0 -> tok_at(j)
    when is_kind(tj0, TokenType.LESS_THAN) or is_val(tj0, `<`) {
        let gp_res -> parse_generic_param_list(j + 1)
        when gp_res[`err`] != Nothing {
            <- gp_res
        }
        generic_params -> gp_res[`params`]
        j -> gp_res[`i`]
    }
    let old_gp -> G[G_GENERIC_PARAMS]
    when generic_params != Nothing and generic_params.length > 0 {
        G[G_GENERIC_PARAMS] -> generic_params
    }
    // Do not bind name `parent` — reserved (ParentExpression under bootstrap).
    let base_name -> Nothing
    // Lexer emits TokenType.EXTENDS (not KEYWORD+value).
    when is_kind(tok_at(j), TokenType.EXTENDS) or (is_kind(tok_at(j), TokenType.KEYWORD) and is_val(tok_at(j), `extends`)) {
        j -> j + 1
        let p_t -> tok_at(j)
        when not is_name_token(p_t) {
            G[G_GENERIC_PARAMS] -> old_gp
            <- fail(j, `Expected parent class name after extends.`)
        }
        base_name -> val_of(p_t)
        j -> j + 1
    }
    let traits -> []
    when is_kind(tok_at(j), TokenType.IS) or is_val(tok_at(j), `is`) {
        j -> j + 1
        do while is_name_token(tok_at(j)) {
            traits.append(val_of(tok_at(j)))
            j -> j + 1
            when is_val(tok_at(j), `,`) {
                j -> j + 1
            }
        }
    }
    when not is_kind(tok_at(j), TokenType.LEFT_BRACE) {
        G[G_GENERIC_PARAMS] -> old_gp
        <- fail(j, `Expected '{' after class name.`)
    }
    let br -> parse_class_body(j + 1, [], [])
    G[G_GENERIC_PARAMS] -> old_gp
    when br[`err`] != Nothing {
        <- br
    }
    when not is_kind(tok_at(br[`i`]), TokenType.RIGHT_BRACE) {
        <- fail(br[`i`], `Expected '}' after class body.`)
    }
    <- parser_ok(AST.class_stmt(name, base_name, br[`members`], br[`methods`], line_of(name_t), col_of(name_t), traits, generic_params), br[`i`] + 1)
}

/!
 Parse class body into { members, methods, i, err }.
 members: LetStatement fields; methods: FunctionStatement list.
 !/
function parse_class_body(i, members, methods) {
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) or is_eof(tok_at(i)) {
        <- {
            `members` -> members,
            `methods` -> methods,
            `i` -> i,
            `err` -> Nothing
        }
    }
    let t -> tok_at(i)
    // Skip comments if any slip through
    when is_kind(t, TokenType.COMMENT) or is_kind(t, TokenType.DOC_COMMENT) {
        <- parse_class_body(i + 1, members, methods)
    }
    when is_kind(t, TokenType.KEYWORD) and is_val(t, `function`) {
        let fr -> parse_function(i + 1)
        when fr[`err`] != Nothing {
            <- {
                `members` -> members,
                `methods` -> methods,
                `i` -> fr[`i`],
                `err` -> fr[`err`]
            }
        }
        methods.append(fr[`node`])
        <- parse_class_body(fr[`i`], members, methods)
    }
    when is_kind(t, TokenType.KEYWORD) and (is_val(t, `let`) or is_val(t, `set`)) {
        <- parse_class_body_after_let(i, t, members, methods)
    }
    // bare field: name [: Type]  (structure-style)
    when is_name_token(t) {
        let j -> i + 1
        let ty -> Nothing
        when is_kind(tok_at(j), TokenType.TYPE_SET) or is_val(tok_at(j), `:`) {
            let tr -> parse_type_name(j + 1)
            ty -> tr[`node`]
            j -> tr[`i`]
        }
        // Treat as field let with optional type, no init
        members.append(AST.let_stmt(val_of(t), Nothing, ty, false, line_of(t), col_of(t)))
        <- parse_class_body(j, members, methods)
    }
    <- {
        `members` -> members,
        `methods` -> methods,
        `i` -> i,
        `err` -> `Unexpected token in class body: ` + Str.to_string(val_of(t))
    }
}

function parse_class_body_after_let(i, t, members, methods) {
    let is_set -> is_val(t, `set`)
    let lr -> parse_let(i + 1, is_set != true)
    when lr[`err`] != Nothing {
        <- {
            `members` -> members,
            `methods` -> methods,
            `i` -> lr[`i`],
            `err` -> lr[`err`]
        }
    }
    members.append(lr[`node`])
    <- parse_class_body(lr[`i`], members, methods)
}

function parse_struct_members(i, acc) {
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) {
        <- parser_ok_list(acc, i)
    }
    when is_eof(tok_at(i)) {
        <- parser_ok_list(acc, i)
    }
    let name_t -> tok_at(i)
    // method or field
    when is_kind(name_t, TokenType.KEYWORD) and is_val(name_t, `function`) {
        let fr -> parse_function(i + 1)
        when fr[`err`] != Nothing {
            <- fr
        }
        acc.append(fr[`node`])
        <- parse_struct_members(fr[`i`], acc)
    }
    when is_val(name_t, `let`) {
        i -> i + 1
        name_t -> tok_at(i)
    }
    when is_kind(name_t, TokenType.IDENTIFIER) or is_kind(name_t, TokenType.KEYWORD) {
        let j -> i + 1
        let ty -> Nothing
        when is_kind(tok_at(j), TokenType.TYPE_SET) or is_val(tok_at(j), `:`) {
            let tr -> parse_type_name(j + 1)
            ty -> tr[`node`]
            j -> tr[`i`]
        }
        acc.append(AST.struct_member(val_of(name_t), ty, line_of(name_t), col_of(name_t)))
        <- parse_struct_members(j, acc)
    }
    // skip unknown
    <- parse_struct_members(i + 1, acc)
}

function parse_enumerator(i) {
    // enumerator Name { A, B, C -> `x`, ... }
    let name_t -> tok_at(i)
    let j -> i + 1
    when not is_kind(tok_at(j), TokenType.LEFT_BRACE) {
        <- fail(j, `Expected '{' after enumerator.`)
    }
    let mr -> parse_enum_members(j + 1, [])
    when mr[`err`] != Nothing {
        <- mr
    }
    when not is_kind(tok_at(mr[`i`]), TokenType.RIGHT_BRACE) {
        <- fail(mr[`i`], `Expected '}' after enumerator body.`)
    }
    <- parser_ok(AST.enumerator_stmt(val_of(name_t), mr[`stmts`], line_of(name_t), col_of(name_t)), mr[`i`] + 1)
}

function parse_enum_member_value(j) {
    when is_kind(tok_at(j), TokenType.ASSIGNMENT) or is_val(tok_at(j), `->`) {
        let er -> parse_expression(j + 1)
        when er[`err`] != Nothing {
            <- er
        }
        <- parser_ok(er[`node`], er[`i`])
    }
    <- parser_ok(Nothing, j)
}

function parse_enum_members(i, acc) {
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) or is_eof(tok_at(i)) {
        <- parser_ok_list(acc, i)
    }
    let t -> tok_at(i)
    when is_kind(t, TokenType.COMMA) or is_kind(t, TokenType.SEMICOLON) {
        <- parse_enum_members(i + 1, acc)
    }
    when not is_name_token(t) {
        <- parse_enum_members(i + 1, acc)
    }
    let after -> parse_enum_member_value(i + 1)
    when after[`err`] != Nothing {
        <- after
    }
    let nxt -> after[`i`]
    when nxt == Nothing or nxt <= i {
        <- fail(i, `Parser stuck.`)
    }
    <- parse_enum_members(nxt, stmt_push(acc, AST.enum_member(val_of(t), after[`node`], line_of(t), col_of(t))))
}

function skip_braced(i) {
    // i at '{'; return index after matching '}'
    let depth -> 1
    let j -> i + 1
    <- skip_braced_rec(j, depth)
}

function skip_braced_rec(j, depth) {
    when depth == 0 or j >= G[G_LEN] or is_eof(tok_at(j)) {
        <- j
    }
    when is_kind(tok_at(j), TokenType.LEFT_BRACE) {
        <- skip_braced_rec(j + 1, depth + 1)
    }
    when is_kind(tok_at(j), TokenType.RIGHT_BRACE) {
        <- skip_braced_rec(j + 1, depth - 1)
    }
    <- skip_braced_rec(j + 1, depth)
}

function parse_scope(i) {
    let name_t -> tok_at(i)
    let br -> parse_block(i + 1)
    when br[`err`] != Nothing {
        <- br
    }
    <- parser_ok(AST.scope_stmt(val_of(name_t), br[`node`], line_of(name_t), col_of(name_t)), br[`i`])
}

function parse_import(i) {
    // import path [as Alias]  — path may be dotted or string
    let t0 -> tok_at(i - 1)
    let path -> ``
    let j -> i
    when is_kind(tok_at(j), TokenType.STRING) {
        path -> val_of(tok_at(j))
        j -> j + 1
    } or {
        let pr -> parse_dotted_name(j)
        path -> pr[`node`]
        j -> pr[`i`]
    }
    let alias -> Nothing
    when is_kind(tok_at(j), TokenType.AS) or (is_kind(tok_at(j), TokenType.KEYWORD) and is_val(tok_at(j), `as`)) {
        j -> j + 1
        alias -> val_of(tok_at(j))
        j -> j + 1
    }
    <- parser_ok(AST.import_stmt(path, alias, line_of(t0), col_of(t0)), j)
}

/!
 from compiler.Token import TokenType
 → ImportStatement path=compiler.Token alias=TokenType (MVP merge strips imports).
 !/
function parse_from_import(i) {
    // after 'from'
    let t0 -> tok_at(i - 1)
    let pr -> parse_dotted_name(i)
    let path -> pr[`node`]
    let j -> pr[`i`]
    when is_kind(tok_at(j), TokenType.IMPORT) or is_val(tok_at(j), `import`) {
        j -> j + 1
    }
    let alias -> Nothing
    when is_name_token(tok_at(j)) or is_kind(tok_at(j), TokenType.IDENTIFIER) or is_kind(tok_at(j), TokenType.KEYWORD) {
        alias -> val_of(tok_at(j))
        j -> j + 1
    }
    <- parser_ok(AST.import_stmt(path, alias, line_of(t0), col_of(t0)), j)
}

function parse_extern_declaration(i) {
    let t -> tok_at(i)
    let t0 -> tok_at(i - 1)
    // 1. extern from <header> use/import func1, func2, ...
    when is_kind(t, TokenType.FROM) or is_val(t, `from`) {
        let j -> i + 1
        let hdr -> ``
        when is_kind(tok_at(j), TokenType.STRING) {
            hdr -> val_of(tok_at(j))
            j -> j + 1
        } or {
            let pr -> parse_dotted_name(j)
            hdr -> pr[`node`]
            j -> pr[`i`]
        }
        when is_kind(tok_at(j), TokenType.IMPORT) or is_val(tok_at(j), `use`) or is_val(tok_at(j), `import`) {
            j -> j + 1
        }
        let names -> []
        let done -> false
        do while j < G[G_LEN] and not done {
            let tj -> tok_at(j)
            when is_name_token(tj) or is_kind(tj, TokenType.IDENTIFIER) or is_kind(tj, TokenType.KEYWORD) {
                names.append(val_of(tj))
                j -> j + 1
                when is_kind(tok_at(j), TokenType.COMMA) {
                    j -> j + 1
                } or {
                    done -> true
                }
            } or {
                done -> true
            }
        }
        <- parser_ok(AST.extern_import_stmt(hdr, Nothing, names, line_of(t0), col_of(t0)), j)
    }
    // 2. extern use/import <header> [as Alias]
    when is_kind(t, TokenType.IMPORT) or is_val(t, `use`) or is_val(t, `import`) {
        let j -> i + 1
        let hdr -> ``
        when is_kind(tok_at(j), TokenType.STRING) {
            hdr -> val_of(tok_at(j))
            j -> j + 1
        } or {
            let pr -> parse_dotted_name(j)
            hdr -> pr[`node`]
            j -> pr[`i`]
        }
        let alias -> Nothing
        when is_kind(tok_at(j), TokenType.AS) or (is_kind(tok_at(j), TokenType.KEYWORD) and is_val(tok_at(j), `as`)) {
            j -> j + 1
            alias -> val_of(tok_at(j))
            j -> j + 1
        }
        <- parser_ok(AST.extern_import_stmt(hdr, alias, Nothing, line_of(t0), col_of(t0)), j)
    }
    <- fail(i, `Expected 'use', 'import', or 'from' after 'extern'.`)
}

function parse_dotted_name(i) {
    let t -> tok_at(i)
    let name -> val_of(t)
    let j -> i + 1
    <- parse_dotted_name_tail(j, name)
}

function parse_dotted_name_tail(j, name) {
    when is_kind(tok_at(j), TokenType.DOT) {
        let n -> val_of(tok_at(j + 1))
        <- parse_dotted_name_tail(j + 2, name + `.` + n)
    }
    <- parser_ok(name, j)
}

function parse_expression_statement(i) {
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    let node -> er[`node`]
    let t -> tok_at(i)
    // In-place statement updates:
    // 1. `ident ++ expr`  =>  `ident -> ident ++ expr`
    // 2. `ident -- expr`  =>  `ident -> ident -- expr`
    // 3. `expr -- ident`  =>  `ident -> expr -- ident`
    when node != Nothing and node.length > 5 and node[0] == 0 { // K_BINARY
        let left -> node[3]
        let op -> node[4]
        let right -> node[5]
        when (op == `++` or op == `--`) and left != Nothing and left.length > 3 and left[0] == 4 { // K_VARIABLE
            let var_name -> left[3]
            <- parser_ok(AST.assign(var_name, node, line_of(t), col_of(t)), er[`i`])
        }
        when op == `--` and right != Nothing and right.length > 3 and right[0] == 4 { // K_VARIABLE (e.g. 7 -- prefix)
            let var_name -> right[3]
            <- parser_ok(AST.assign(var_name, node, line_of(t), col_of(t)), er[`i`])
        }
    }
    <- parser_ok(AST.expr_stmt(node, line_of(t), col_of(t)), er[`i`])
}

// ---------- Expressions (Pratt / precedence climbing via layers) ----------

function parse_expression(i) {
    <- parse_assignment(i)
}

function parse_assignment(i) {
    let left -> parse_pipeline(i)
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    // Kind-only for ops: is_val(`-`) etc. would match STRING values like `-`.
    when G[G_ALLOW_ASSIGN] != false and is_kind(tok_at(j), TokenType.ASSIGNMENT) {
        let right -> parse_assignment(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let ln -> left[`node`]
        let ln_k -> AST.ast_kind(ln)
        when ln_k == AST.K_VARIABLE {
            <- parser_ok(AST.assign(AST.var_name(ln), right[`node`], AST.ast_line(ln), AST.ast_col(ln)), right[`i`])
        }
        when ln_k == AST.K_GET {
            <- parser_ok(AST.set_expr(AST.get_obj(ln), AST.get_name(ln), right[`node`], AST.ast_line(ln), AST.ast_col(ln)), right[`i`])
        }
        when ln_k == AST.K_INDEX {
            // treat as set via synthetic
            <- parser_ok(AST.index_assign(AST.idx_obj(ln), AST.idx_expr(ln), right[`node`], AST.ast_line(ln), AST.ast_col(ln)), right[`i`])
        }
        <- fail(j, `Invalid assignment target.`)
    }
    <- left
}

function parse_pipeline(i) {
    let left -> parse_coalesce(i)
    <- parse_pipeline_tail(left)
}

function parse_pipeline_tail(left) {
    when left[`err`] != Nothing { <- left }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.PIPELINE) or is_val(t, `|>`) {
        let right -> parse_call(j + 1)
        when right[`err`] != Nothing { <- right }
        let rn -> right[`node`]
        let rk -> AST.ast_kind(rn)
        let desugared -> Nothing
        when rk == AST.K_CALL {
            let callee -> AST.call_callee(rn)
            let old_args -> AST.call_args(rn)
            let new_args -> [left[`node`]]
            let ai -> 0
            do while ai < old_args.length {
                new_args.append(old_args[ai])
                ai -> ai + 1
            }
            desugared -> AST.call(callee, new_args, line_of(t), col_of(t))
        } or {
            desugared -> AST.call(rn, [left[`node`]], line_of(t), col_of(t))
        }
        <- parse_pipeline_tail(parser_ok(desugared, right[`i`]))
    }
    <- left
}

function parse_coalesce(i) {
    let left -> parse_or(i)
    <- parse_coalesce_tail(left)
}

function parse_coalesce_tail(left) {
    when left[`err`] != Nothing { <- left }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.COALESCE) or is_val(t, `??`) {
        let right -> parse_or(j + 1)
        when right[`err`] != Nothing { <- right }
        let node -> AST.binary(left[`node`], `??`, right[`node`], line_of(t), col_of(t))
        <- parse_coalesce_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_or(i) {
    let left -> parse_and(i)
    <- parse_or_tail(left)
}

function parse_or_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    when is_kind(tok_at(j), TokenType.OR) {
        let op -> val_of(tok_at(j))
        let right -> parse_and(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.logical(left[`node`], op, right[`node`], line_of(tok_at(j)), col_of(tok_at(j)))
        <- parse_or_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_and(i) {
    let left -> parse_bitwise_or(i)
    <- parse_and_tail(left)
}

function parse_and_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    when is_kind(tok_at(j), TokenType.AND) {
        let op -> val_of(tok_at(j))
        let right -> parse_bitwise_or(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.logical(left[`node`], op, right[`node`], line_of(tok_at(j)), col_of(tok_at(j)))
        <- parse_and_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_bitwise_or(i) {
    let left -> parse_bitwise_xor(i)
    <- parse_bitwise_or_tail(left)
}

function parse_bitwise_or_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.BITWISE_OR) or is_val(t, `|`) or is_val(t, `||`) {
        let op -> `|`
        let right -> parse_bitwise_xor(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_bitwise_or_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_bitwise_xor(i) {
    let left -> parse_bitwise_and(i)
    <- parse_bitwise_xor_tail(left)
}

function parse_bitwise_xor_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.BITWISE_XOR) or is_val(t, `^`) or is_val(t, `^^`) {
        let op -> `^`
        let right -> parse_bitwise_and(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_bitwise_xor_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_bitwise_and(i) {
    let left -> parse_equality(i)
    <- parse_bitwise_and_tail(left)
}

function parse_bitwise_and_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.BITWISE_AND) or is_val(t, `&`) or is_val(t, `&&`) {
        let op -> `&`
        let right -> parse_equality(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_bitwise_and_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_equality(i) {
    let left -> parse_comparison(i)
    <- parse_equality_tail(left)
}

function parse_equality_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    // Pattern test: value is Pattern / value is not Pattern
    when is_kind(t, TokenType.IS) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `is`)) {
        let is_not -> false
        let next_idx -> j + 1
        when is_kind(tok_at(next_idx), TokenType.NOT) or is_val(tok_at(next_idx), `not`) {
            is_not -> true
            next_idx -> next_idx + 1
        }
        let right -> Nothing
        let tr -> parse_type_name(next_idx)
        when tr[`err`] == Nothing and (Str.contains(AST.type_ann_name(tr[`node`]), `<`) or (Str.contains(AST.type_ann_name(tr[`node`]), `[`) and Str.ends_with(AST.type_ann_name(tr[`node`]), `]`))) {
            let tname -> AST.type_ann_name(tr[`node`])
            let tvar -> AST.variable(tname, line_of(t), col_of(t))
            right -> parser_ok(tvar, tr[`i`])
        } or {
            right -> parse_comparison(next_idx)
        }
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.is_expr(left[`node`], right[`node`], line_of(t), col_of(t))
        when is_not {
            node -> AST.unary(`not`, node, line_of(t), col_of(t))
        }
        // allow chaining: is a and is b
        <- parse_equality_tail(parser_ok(node, right[`i`]))
    }
    when is_kind(t, TokenType.EQUAL) or is_kind(t, TokenType.NOT_EQUAL) {
        let op -> val_of(t)
        let right -> parse_comparison(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_equality_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_comparison(i) {
    let left -> parse_bitwise_shift(i)
    <- parse_comparison_tail(left)
}

function parse_bitwise_shift(i) {
    let left -> parse_range(i)
    <- parse_bitwise_shift_tail(left)
}

function parse_bitwise_shift_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.BITWISE_LEFT_SHIFT) or is_val(t, `<<`) or
         is_kind(t, TokenType.BITWISE_RIGHT_SHIFT) or is_val(t, `>>`) {
        let op -> val_of(t)
        let right -> parse_range(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_bitwise_shift_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_comparison_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.LESS_THAN) or is_kind(t, TokenType.GREATER_THAN) or
         is_kind(t, TokenType.LESS_THAN_OR_EQUAL) or is_kind(t, TokenType.GREATER_THAN_OR_EQUAL) or
         is_val(t, `in`) {
        let op -> val_of(t)
        let right -> parse_range(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_comparison_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_range(i) {
    let left -> parse_term(i)
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.RANGE) or
         is_kind(t, TokenType.RANGE_INCL_END) or is_kind(t, TokenType.RANGE_EXCL_END) or
         is_kind(t, TokenType.RANGE_FULL_INCL) {
        let op -> val_of(t)
        let right -> parse_term(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        <- parser_ok(AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t)), right[`i`])
    }
    <- left
}

function parse_term(i) {
    let left -> parse_factor(i)
    <- parse_term_tail(left)
}

function parse_term_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.ADDITION) or is_kind(t, TokenType.SUBTRACTION) or
         is_kind(t, TokenType.INCREMENT) or is_val(t, `++`) or
         is_kind(t, TokenType.DECREMENT) or is_val(t, `--`) {
        let op -> val_of(t)
        let right -> parse_factor(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_term_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_factor(i) {
    let left -> parse_unary(i)
    <- parse_factor_tail(left)
}

function parse_factor_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.MULTIPLICATION) or is_kind(t, TokenType.DIVISION) or is_kind(t, TokenType.MODULO) or
         is_kind(t, TokenType.EXPONENTIATION) {
        let op -> val_of(t)
        let right -> parse_unary(j + 1)
        when right[`err`] != Nothing {
            <- right
        }
        let node -> AST.binary(left[`node`], op, right[`node`], line_of(t), col_of(t))
        <- parse_factor_tail(parser_ok(node, right[`i`]))
    }
    <- left
}

function parse_unary(i) {
    let t -> tok_at(i)
    // Kind-only: never is_val(`-`)/`not` — STRING "`-`" and IDENT would false-match.
    when is_kind(t, TokenType.NOT) or is_kind(t, TokenType.SUBTRACTION) or is_kind(t, TokenType.BITWISE_NOT) {
        let right -> parse_unary(i + 1)
        when right[`err`] != Nothing {
            <- right
        }
        <- parser_ok(AST.unary(val_of(t), right[`node`], line_of(t), col_of(t)), right[`i`])
    }
    when is_kind(t, TokenType.CHECK) or (is_kind(t, TokenType.KEYWORD) and is_val(t, `check`)) {
        let right -> parse_cast(i + 1)
        when right[`err`] != Nothing {
            <- right
        }
        <- parser_ok(AST.ast_check_expr(right[`node`], line_of(t), col_of(t)), right[`i`])
    }
    // check/raise postfix and type cast handled in call/cast chain
    <- parse_cast(i)
}

function parse_cast(i) {
    let left -> parse_call(i)
    <- parse_cast_tail(left)
}

function parse_cast_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.TYPE_CAST) or is_val(t, `<:`) {
        let tr -> parse_type_name(j + 1)
        when tr[`err`] != Nothing {
            <- tr
        }
        let type_name -> tr[`node`]
        when AST.is_type_ann(type_name) {
            type_name -> AST.type_ann_name(type_name)
        }
        let node -> AST.cast(left[`node`], type_name, line_of(t), col_of(t))
        <- parse_cast_tail(parser_ok(node, tr[`i`]))
    }
    <- left
}

function parse_call(i) {
    let left -> parse_primary(i)
    <- parse_call_tail(left)
}

function parse_call_tail(left) {
    when left[`err`] != Nothing {
        <- left
    }
    let j -> left[`i`]
    let t -> tok_at(j)
    when is_kind(t, TokenType.LEFT_PAREN) {
        let ar -> parse_arg_list(j + 1, [])
        when ar[`err`] != Nothing {
            <- ar
        }
        when not is_kind(tok_at(ar[`i`]), TokenType.RIGHT_PAREN) {
            <- fail(ar[`i`], `Expected ')'.`)
        }
        let node -> AST.call(left[`node`], ar[`stmts`], line_of(t), col_of(t))
        <- parse_call_tail(parser_ok(node, ar[`i`] + 1))
    }
    when is_kind(t, TokenType.DOT) {
        let name_t -> tok_at(j + 1)
        let node -> AST.get(left[`node`], val_of(name_t), line_of(t), col_of(t))
        <- parse_call_tail(parser_ok(node, j + 2))
    }
    when is_kind(t, TokenType.LEFT_BRACKET) {
        let next_t -> tok_at(j + 1)
        when is_kind(next_t, TokenType.TYPE_SET) or is_val(next_t, `:`) {
            let k -> j + 2
            let end_node -> Nothing
            when not is_kind(tok_at(k), TokenType.RIGHT_BRACKET) and not is_kind(tok_at(k), TokenType.TYPE_SET) and not is_val(tok_at(k), `:`) {
                let er -> parse_expression(k)
                when er[`err`] != Nothing { <- er }
                end_node -> er[`node`]
                k -> er[`i`]
            }
            let step_node -> Nothing
            when is_kind(tok_at(k), TokenType.TYPE_SET) or is_val(tok_at(k), `:`) {
                k -> k + 1
                when not is_kind(tok_at(k), TokenType.RIGHT_BRACKET) {
                    let sr -> parse_expression(k)
                    when sr[`err`] != Nothing { <- sr }
                    step_node -> sr[`node`]
                    k -> sr[`i`]
                }
            }
            when not is_kind(tok_at(k), TokenType.RIGHT_BRACKET) {
                <- fail(k, `Expected ']'.`)
            }
            let node -> AST.make_slice(left[`node`], Nothing, end_node, step_node, line_of(t), col_of(t))
            <- parse_call_tail(parser_ok(node, k + 1))
        }
        let ir -> parse_expression(j + 1)
        when ir[`err`] != Nothing {
            <- ir
        }
        when is_kind(tok_at(ir[`i`]), TokenType.TYPE_SET) or is_val(tok_at(ir[`i`]), `:`) {
            let k -> ir[`i`] + 1
            let end_node -> Nothing
            when not is_kind(tok_at(k), TokenType.RIGHT_BRACKET) and not is_kind(tok_at(k), TokenType.TYPE_SET) and not is_val(tok_at(k), `:`) {
                let er -> parse_expression(k)
                when er[`err`] != Nothing { <- er }
                end_node -> er[`node`]
                k -> er[`i`]
            }
            let step_node -> Nothing
            when is_kind(tok_at(k), TokenType.TYPE_SET) or is_val(tok_at(k), `:`) {
                k -> k + 1
                when not is_kind(tok_at(k), TokenType.RIGHT_BRACKET) {
                    let sr -> parse_expression(k)
                    when sr[`err`] != Nothing { <- sr }
                    step_node -> sr[`node`]
                    k -> sr[`i`]
                }
            }
            when not is_kind(tok_at(k), TokenType.RIGHT_BRACKET) {
                <- fail(k, `Expected ']'.`)
            }
            let node -> AST.make_slice(left[`node`], ir[`node`], end_node, step_node, line_of(t), col_of(t))
            <- parse_call_tail(parser_ok(node, k + 1))
        }
        when not is_kind(tok_at(ir[`i`]), TokenType.RIGHT_BRACKET) {
            <- fail(ir[`i`], `Expected ']'.`)
        }
        let node -> AST.make_index(left[`node`], ir[`node`], line_of(t), col_of(t))
        <- parse_call_tail(parser_ok(node, ir[`i`] + 1))
    }
    when is_kind(t, TokenType.CHECK_SYMBOL) or is_val(t, `?`) {
        let node -> AST.ast_check_expr(left[`node`], line_of(t), col_of(t))
        <- parse_call_tail(parser_ok(node, j + 1))
    }
    when is_kind(t, TokenType.RAISE_SYMBOL) or is_val(t, `^`) {
        // postfix raise rare; treat as binary start only if followed by expr — skip
    }
    <- left
}

function parse_arg_list(i, acc) {
    when is_kind(tok_at(i), TokenType.RIGHT_PAREN) {
        <- parser_ok_list(acc, i)
    }
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    acc.append(er[`node`])
    when is_kind(tok_at(er[`i`]), TokenType.COMMA) {
        <- parse_arg_list(er[`i`] + 1, acc)
    }
    <- parser_ok_list(acc, er[`i`])
}

function parse_primary(i) {
    let t -> tok_at(i)
    when is_eof(t) {
        <- fail(i, `Unexpected EOF in expression.`)
    }
    // Anonymous function: function(params) { body }
    when (is_kind(t, TokenType.KEYWORD) and is_val(t, `function`)) or is_kind(t, TokenType.FUNCTION) {
        when is_kind(tok_at(i + 1), TokenType.LEFT_PAREN) or is_kind(tok_at(i + 1), TokenType.LEFT_BRACE) {
            <- parse_function_expression(i + 1)
        }
    }
    // When expression: when cond { expr } or { expr }
    when (is_kind(t, TokenType.KEYWORD) and is_val(t, `when`)) or is_kind(t, `WHEN`) {
        <- parse_when(i + 1)
    }
    // literals
    when is_kind(t, TokenType.STRING) {
        let s_val -> val_of(t)
        when Str.starts_with(s_val, `f\``) or Str.starts_with(s_val, `F\``) or Str.starts_with(s_val, `f"`) or Str.starts_with(s_val, `F"`) {
            <- parse_fstring(s_val, line_of(t), col_of(t), i + 1)
        }
        <- parser_ok(AST.lit_tok(s_val, kind_of(t), line_of(t), col_of(t)), i + 1)
    }
    when is_kind(t, TokenType.INTEGER) or is_kind(t, TokenType.DECIMAL) or
         is_kind(t, TokenType.RUNE) or is_kind(t, TokenType.BOOLEAN) or is_kind(t, TokenType.NOTHING) or is_kind(t, TokenType.DEFAULT) {
        <- parser_ok(AST.lit_tok(val_of(t), kind_of(t), line_of(t), col_of(t)), i + 1)
    }
    when is_val(t, `true`) or is_val(t, `false`) or is_val(t, `True`) or is_val(t, `False`) or
         is_val(t, `nothing`) or is_val(t, `Nothing`) or is_val(t, `default`) or is_val(t, `Default`) {
        // Note: lowercase 'nothing' and 'default' are deprecated. Use 'Nothing' and 'Default'.
        <- parser_ok(AST.lit_tok(val_of(t), kind_of(t), line_of(t), col_of(t)), i + 1)
    }
    // Soft keywords as variables: self, parent, scope, ...
    when is_kind(t, TokenType.SELF) or is_kind(t, TokenType.PARENT) or is_kind(t, TokenType.SCOPE) or
         is_kind(t, TokenType.TASK) or is_kind(t, TokenType.WITH) or is_kind(t, TokenType.OBJECT) {
        <- parser_ok(AST.variable(val_of(t), line_of(t), col_of(t)), i + 1)
    }
    // list literal or list comprehension
    when is_kind(t, TokenType.LEFT_BRACKET) {
        let k0 -> tok_at(i + 1)
        when is_val(k0, `for`) or (is_kind(k0, TokenType.KEYWORD) and val_of(k0) == `for`) {
            <- parse_list_comprehension(i)
        }
        let er -> parse_list_elements(i + 1, [])
        when er[`err`] != Nothing {
            <- er
        }
        when not is_kind(tok_at(er[`i`]), TokenType.RIGHT_BRACKET) {
            <- fail(er[`i`], `Expected ']'.`)
        }
        <- parser_ok(AST.list_lit(er[`stmts`], line_of(t), col_of(t)), er[`i`] + 1)
    }
    // grouping
    when is_kind(t, TokenType.LEFT_PAREN) {
        let old_allow -> G[G_ALLOW_STRUCT]
        G[G_ALLOW_STRUCT] -> true
        let er -> parse_expression(i + 1)
        G[G_ALLOW_STRUCT] -> old_allow
        when er[`err`] != Nothing {
            <- er
        }
        when not is_kind(tok_at(er[`i`]), TokenType.RIGHT_PAREN) {
            <- fail(er[`i`], `Expected ')'.`)
        }
        <- parser_ok(AST.grouping(er[`node`], line_of(t), col_of(t)), er[`i`] + 1)
    }
    // Map literal: { `key` -> expr, ... } or { name -> expr, ... } or { a, b } or { ...map } or {for x in list -> ...}
    // Distinguishes from blocks by requiring key -> value or shorthand after `{`.
    when is_kind(t, TokenType.LEFT_BRACE) {
        let k0 -> tok_at(i + 1)
        when is_val(k0, `for`) or (is_kind(k0, TokenType.KEYWORD) and val_of(k0) == `for`) {
            <- parse_map_comprehension(i)
        }
        when is_kind(tok_at(i + 1), TokenType.RIGHT_BRACE) {
            <- parser_ok(AST.map_lit([], line_of(t), col_of(t)), i + 2)
        }
        // Peek: STRING/IDENT/KEYWORD then -> or , or } or ...
        let k1 -> tok_at(i + 2)
        let keyish -> is_kind(k0, TokenType.STRING) or is_kind(k0, TokenType.IDENTIFIER) or is_kind(k0, TokenType.KEYWORD)
        let arrow -> is_kind(k1, TokenType.ASSIGNMENT) or is_val(k1, `->`)
        let shorthand -> is_kind(k1, TokenType.COMMA) or is_kind(k1, TokenType.RIGHT_BRACE)
        let is_spread -> is_kind(k0, TokenType.ELLIPSIS) or is_val(k0, `...`)
        when (keyish and (arrow or shorthand)) or is_spread {
            let fr -> parse_map_entries(i + 1, [])
            when fr[`err`] != Nothing {
                <- fr
            }
            when not is_kind(tok_at(fr[`i`]), TokenType.RIGHT_BRACE) {
                <- fail(fr[`i`], `Expected '}' after map literal.`)
            }
            <- parser_ok(AST.map_lit(fr[`stmts`], line_of(t), col_of(t)), fr[`i`] + 1)
        }
        // Block expression { stmt; ... expr }
        let blk -> parse_block(i)
        when blk[`err`] != Nothing {
            <- blk
        }
        <- blk
    }
    // structure init: Name { field -> expr, ... } or Name { x, y }
    // Ambiguity: `do for i in xs { ... }` must not parse `xs {` as struct init.
    // Convention: only attempt struct init when the name looks like a type (A-Z / TYPE token).
    when is_name_token(t) {
        let name -> val_of(t)
        let j -> i + 1
        when is_kind(tok_at(j), TokenType.LESS_THAN) {
            let tr -> parse_type_name(i)
            when tr[`err`] == Nothing and Str.contains(AST.type_ann_name(tr[`node`]), `<`) {
                let full_type -> AST.type_ann_name(tr[`node`])
                let next_tok -> tok_at(tr[`i`])
                when is_kind(next_tok, TokenType.LEFT_BRACE) and G[G_ALLOW_STRUCT] != false {
                    let fr -> parse_struct_init_fields(tr[`i`] + 1, [])
                    when fr[`err`] == Nothing and is_kind(tok_at(fr[`i`]), TokenType.RIGHT_BRACE) {
                        <- parser_ok(AST.struct_init(full_type, fr[`stmts`], line_of(t), col_of(t)), fr[`i`] + 1)
                    }
                }
                when is_kind(next_tok, TokenType.LEFT_PAREN) or is_type_name_str(name) {
                    <- parser_ok(AST.variable(full_type, line_of(t), col_of(t)), tr[`i`])
                }
            }
        }
        when (name == `Vector` or name == `Integer` or name == `Decimal` or name == `String`) and is_kind(tok_at(j), TokenType.LEFT_BRACKET) {
            let tr -> parse_type_name(i)
            when tr[`err`] == Nothing and (Str.contains(AST.type_ann_name(tr[`node`]), `[`) or Str.contains(AST.type_ann_name(tr[`node`]), `<`)) {
                let full_type -> AST.type_ann_name(tr[`node`])
                let next_tok -> tok_at(tr[`i`])
                when is_kind(next_tok, TokenType.LEFT_PAREN) or is_kind(next_tok, TokenType.LEFT_BRACE) {
                    <- parser_ok(AST.variable(full_type, line_of(t), col_of(t)), tr[`i`])
                }
            }
        }
        let try_struct -> false
        when is_kind(t, TokenType.TYPE) or is_kind(t, TokenType.STRUCTURE) or is_kind(t, TokenType.CLASS) {
            try_struct -> true
        }
        when try_struct == false and Str.length(name) > 0 {
            let c0 -> Str.at(name, 0)
            when Str.index_of(`ABCDEFGHIJKLMNOPQRSTUVWXYZ`, c0) >= 0 {
                try_struct -> true
            }
        }
        when G[G_ALLOW_STRUCT] != false and is_kind(tok_at(j), TokenType.DOT) and is_name_token(tok_at(j + 1)) and is_kind(tok_at(j + 2), TokenType.LEFT_BRACE) {
            let sname_tok -> tok_at(j + 1)
            let sname_str -> val_of(sname_tok)
            let s_try -> false
            when is_kind(sname_tok, TokenType.TYPE) or is_kind(sname_tok, TokenType.STRUCTURE) or is_kind(sname_tok, TokenType.CLASS) {
                s_try -> true
            }
            when s_try == false and Str.length(sname_str) > 0 {
                let sc0 -> Str.at(sname_str, 0)
                when Str.index_of(`ABCDEFGHIJKLMNOPQRSTUVWXYZ`, sc0) >= 0 {
                    s_try -> true
                }
            }
            when s_try {
                let fr -> parse_struct_init_fields(j + 3, [])
                when fr[`err`] == Nothing and is_kind(tok_at(fr[`i`]), TokenType.RIGHT_BRACE) {
                    let full_name -> name + `.` + sname_str
                    <- parser_ok(AST.struct_init(full_name, fr[`stmts`], line_of(t), col_of(t)), fr[`i`] + 1)
                }
            }
        }
        when G[G_ALLOW_STRUCT] != false and try_struct and is_kind(tok_at(j), TokenType.LEFT_BRACE) {
            when name == `Map` {
                let mr -> parse_map_entries(j + 1, [])
                when mr[`err`] != Nothing {
                    <- mr
                }
                when not is_kind(tok_at(mr[`i`]), TokenType.RIGHT_BRACE) {
                    <- fail(mr[`i`], `Expected '}' after Map literal.`)
                }
                <- parser_ok(AST.map_lit(mr[`stmts`], line_of(t), col_of(t)), mr[`i`] + 1)
            }
            when name == `Tuple` {
                let k0 -> tok_at(j + 1)
                let k1 -> tok_at(j + 2)
                let is_named -> (is_kind(k0, TokenType.STRING) or is_kind(k0, TokenType.IDENTIFIER) or is_kind(k0, TokenType.KEYWORD)) and (is_kind(k1, TokenType.ASSIGNMENT) or is_val(k1, `->`))
                when is_named {
                    let mr -> parse_map_entries(j + 1, [])
                    when mr[`err`] != Nothing {
                        <- mr
                    }
                    when not is_kind(tok_at(mr[`i`]), TokenType.RIGHT_BRACE) {
                        <- fail(mr[`i`], `Expected '}' after Tuple literal.`)
                    }
                    <- parser_ok(AST.map_lit(mr[`stmts`], line_of(t), col_of(t)), mr[`i`] + 1)
                }
                let lr -> parse_braced_collection_elements(j + 1, [])
                when lr[`err`] != Nothing {
                    <- lr
                }
                when not is_kind(tok_at(lr[`i`]), TokenType.RIGHT_BRACE) {
                    <- fail(lr[`i`], `Expected '}' after Tuple literal.`)
                }
                <- parser_ok(AST.list_lit(lr[`stmts`], line_of(t), col_of(t)), lr[`i`] + 1)
            }
            when name == `Set` {
                let lr -> parse_braced_collection_elements(j + 1, [])
                when lr[`err`] != Nothing {
                    <- lr
                }
                when not is_kind(tok_at(lr[`i`]), TokenType.RIGHT_BRACE) {
                    <- fail(lr[`i`], `Expected '}' after Set literal.`)
                }
                let list_node -> AST.list_lit(lr[`stmts`], line_of(t), col_of(t))
                <- parser_ok(AST.cast(list_node, `Set`, line_of(t), col_of(t)), lr[`i`] + 1)
            }
            when name == `List` or name == `Vector` {
                let lr -> parse_braced_collection_elements(j + 1, [])
                when lr[`err`] != Nothing {
                    <- lr
                }
                when not is_kind(tok_at(lr[`i`]), TokenType.RIGHT_BRACE) {
                    <- fail(lr[`i`], `Expected '}' after ` + name + ` literal.`)
                }
                <- parser_ok(AST.list_lit(lr[`stmts`], line_of(t), col_of(t)), lr[`i`] + 1)
            }
            let fr -> parse_struct_init_fields(j + 1, [])
            when fr[`err`] != Nothing {
                // not struct init; fall through to variable
            } or {
                when is_kind(tok_at(fr[`i`]), TokenType.RIGHT_BRACE) {
                    <- parser_ok(AST.struct_init(name, fr[`stmts`], line_of(t), col_of(t)), fr[`i`] + 1)
                }
            }
        }
        <- parser_ok(AST.variable(name, line_of(t), col_of(t)), i + 1)
    }
    <- fail(i, `Unexpected token in expression: ` + Str.to_string(val_of(t)) + ` (` + Str.to_string(kind_of(t)) + ` @` + Str.to_string(i) + `)`)
}

function parse_list_comprehension(i) {
    let t0 -> tok_at(i)
    let j -> i + 1
    when is_val(tok_at(j), `for`) or (is_kind(tok_at(j), TokenType.KEYWORD) and val_of(tok_at(j)) == `for`) {
        j -> j + 1
    }
    let var_t -> tok_at(j)
    when not is_name_token(var_t) {
        <- fail(j, `Expected loop variable in list comprehension.`)
    }
    let var_name -> val_of(var_t)
    j -> j + 1
    when is_val(tok_at(j), `,`) or is_kind(tok_at(j), TokenType.COMMA) {
        j -> j + 1
        let var2_t -> tok_at(j)
        when not is_name_token(var2_t) {
            <- fail(j, `Expected second loop variable in list comprehension.`)
        }
        var_name -> val_of(var2_t)
        j -> j + 1
    }
    when not (is_val(tok_at(j), `in`) or (is_kind(tok_at(j), TokenType.KEYWORD) and val_of(tok_at(j)) == `in`)) {
        <- fail(j, `Expected 'in' in list comprehension.`)
    }
    j -> j + 1
    let old_allow -> G[G_ALLOW_STRUCT]
    let old_assign -> G[G_ALLOW_ASSIGN]
    G[G_ALLOW_STRUCT] -> false
    G[G_ALLOW_ASSIGN] -> false
    let iter_r -> parse_expression(j)
    G[G_ALLOW_STRUCT] -> old_allow
    G[G_ALLOW_ASSIGN] -> old_assign
    when iter_r[`err`] != Nothing {
        <- iter_r
    }
    let iter_node -> iter_r[`node`]
    j -> iter_r[`i`]
    let cond_node -> Nothing
    when is_val(tok_at(j), `when`) or (is_kind(tok_at(j), TokenType.KEYWORD) and val_of(tok_at(j)) == `when`) {
        j -> j + 1
        let old_allow_c -> G[G_ALLOW_STRUCT]
        let old_assign_c -> G[G_ALLOW_ASSIGN]
        G[G_ALLOW_STRUCT] -> false
        G[G_ALLOW_ASSIGN] -> false
        let cond_r -> parse_expression(j)
        G[G_ALLOW_STRUCT] -> old_allow_c
        G[G_ALLOW_ASSIGN] -> old_assign_c
        when cond_r[`err`] != Nothing {
            <- cond_r
        }
        cond_node -> cond_r[`node`]
        j -> cond_r[`i`]
    }
    when not (is_val(tok_at(j), `->`) or is_kind(tok_at(j), TokenType.ASSIGNMENT)) {
        <- fail(j, `Expected '->' in list comprehension.`)
    }
    j -> j + 1
    let yield_r -> parse_expression(j)
    when yield_r[`err`] != Nothing {
        <- yield_r
    }
    let yield_node -> yield_r[`node`]
    j -> yield_r[`i`]
    when not is_kind(tok_at(j), TokenType.RIGHT_BRACKET) {
        <- fail(j, `Expected ']' at end of list comprehension.`)
    }
    j -> j + 1
    
    let line -> line_of(t0)
    let col -> col_of(t0)
    let acc_name -> `__lc_` + Str.to_string(line) + `_` + Str.to_string(col)
    let init_stmt -> AST.let_stmt(acc_name, AST.list_lit([], line, col), Nothing, false, line, col)
    let acc_var -> AST.variable(acc_name, line, col)
    let append_fn -> AST.get(acc_var, `append`, line, col)
    let append_call -> AST.call(append_fn, [yield_node], line, col)
    let push_stmt -> AST.expr_stmt(append_call, line, col)
    let loop_inner -> Nothing
    when cond_node != Nothing {
        let case_cl -> AST.case_clause(cond_node, AST.block([push_stmt], line, col), line, col)
        loop_inner -> AST.when_stmt([case_cl], line, col)
    } or {
        loop_inner -> push_stmt
    }
    let loop_body -> AST.block([loop_inner], line, col)
    let for_node -> AST.for_stmt(var_name, iter_node, loop_body, line, col)
    let result_stmt -> AST.expr_stmt(AST.variable(acc_name, line, col), line, col)
    let block_node -> AST.block([init_stmt, for_node, result_stmt], line, col)
    <- parser_ok(block_node, j)
}

function parse_map_comprehension(i) {
    let t0 -> tok_at(i)
    let j -> i + 1
    when is_val(tok_at(j), `for`) or (is_kind(tok_at(j), TokenType.KEYWORD) and val_of(tok_at(j)) == `for`) {
        j -> j + 1
    }
    let var_t -> tok_at(j)
    when not is_name_token(var_t) {
        <- fail(j, `Expected loop variable in map comprehension.`)
    }
    let var_name -> val_of(var_t)
    j -> j + 1
    when is_val(tok_at(j), `,`) or is_kind(tok_at(j), TokenType.COMMA) {
        j -> j + 1
        let var2_t -> tok_at(j)
        when not is_name_token(var2_t) {
            <- fail(j, `Expected second loop variable in map comprehension.`)
        }
        var_name -> val_of(var2_t)
        j -> j + 1
    }
    when not (is_val(tok_at(j), `in`) or (is_kind(tok_at(j), TokenType.KEYWORD) and val_of(tok_at(j)) == `in`)) {
        <- fail(j, `Expected 'in' in map comprehension.`)
    }
    j -> j + 1
    let old_allow -> G[G_ALLOW_STRUCT]
    let old_assign -> G[G_ALLOW_ASSIGN]
    G[G_ALLOW_STRUCT] -> false
    G[G_ALLOW_ASSIGN] -> false
    let iter_r -> parse_expression(j)
    G[G_ALLOW_STRUCT] -> old_allow
    G[G_ALLOW_ASSIGN] -> old_assign
    when iter_r[`err`] != Nothing {
        <- iter_r
    }
    let iter_node -> iter_r[`node`]
    j -> iter_r[`i`]
    let cond_node -> Nothing
    when is_val(tok_at(j), `when`) or (is_kind(tok_at(j), TokenType.KEYWORD) and val_of(tok_at(j)) == `when`) {
        j -> j + 1
        let old_allow_c -> G[G_ALLOW_STRUCT]
        let old_assign_c -> G[G_ALLOW_ASSIGN]
        G[G_ALLOW_STRUCT] -> false
        G[G_ALLOW_ASSIGN] -> false
        let cond_r -> parse_expression(j)
        G[G_ALLOW_STRUCT] -> old_allow_c
        G[G_ALLOW_ASSIGN] -> old_assign_c
        when cond_r[`err`] != Nothing {
            <- cond_r
        }
        cond_node -> cond_r[`node`]
        j -> cond_r[`i`]
    }
    when not (is_val(tok_at(j), `->`) or is_kind(tok_at(j), TokenType.ASSIGNMENT)) {
        <- fail(j, `Expected '->' in map comprehension.`)
    }
    j -> j + 1
    let old_allow_k -> G[G_ALLOW_STRUCT]
    let old_assign_k -> G[G_ALLOW_ASSIGN]
    G[G_ALLOW_STRUCT] -> false
    G[G_ALLOW_ASSIGN] -> false
    let key_r -> parse_expression(j)
    G[G_ALLOW_STRUCT] -> old_allow_k
    G[G_ALLOW_ASSIGN] -> old_assign_k
    when key_r[`err`] != Nothing {
        <- key_r
    }
    let key_node -> key_r[`node`]
    j -> key_r[`i`]
    when is_val(tok_at(j), `:`) or is_kind(tok_at(j), TokenType.TYPE_SET) or is_val(tok_at(j), `->`) or is_kind(tok_at(j), TokenType.ASSIGNMENT) {
        j -> j + 1
    } or {
        <- fail(j, `Expected ':' or '->' between key and value in map comprehension.`)
    }
    let val_r -> parse_expression(j)
    when val_r[`err`] != Nothing {
        <- val_r
    }
    let val_node -> val_r[`node`]
    j -> val_r[`i`]
    when not is_kind(tok_at(j), TokenType.RIGHT_BRACE) {
        <- fail(j, `Expected '}' at end of map comprehension.`)
    }
    j -> j + 1
    
    let line -> line_of(t0)
    let col -> col_of(t0)
    let acc_name -> `__mc_` + Str.to_string(line) + `_` + Str.to_string(col)
    let init_stmt -> AST.let_stmt(acc_name, AST.map_lit([], line, col), Nothing, false, line, col)
    let acc_var -> AST.variable(acc_name, line, col)
    let assign_node -> AST.index_assign(acc_var, key_node, val_node, line, col)
    let assign_stmt -> AST.expr_stmt(assign_node, line, col)
    let loop_inner -> Nothing
    when cond_node != Nothing {
        let case_cl -> AST.case_clause(cond_node, AST.block([assign_stmt], line, col), line, col)
        loop_inner -> AST.when_stmt([case_cl], line, col)
    } or {
        loop_inner -> assign_stmt
    }
    let loop_body -> AST.block([loop_inner], line, col)
    let for_node -> AST.for_stmt(var_name, iter_node, loop_body, line, col)
    let result_stmt -> AST.expr_stmt(AST.variable(acc_name, line, col), line, col)
    let block_node -> AST.block([init_stmt, for_node, result_stmt], line, col)
    <- parser_ok(block_node, j)
}

function parse_list_elements(i, acc) {
    do while i < G[G_LEN] and (is_kind(tok_at(i), TokenType.COMMENT) or is_kind(tok_at(i), TokenType.DOC_COMMENT)) {
        i -> i + 1
    }
    when is_kind(tok_at(i), TokenType.RIGHT_BRACKET) {
        <- parser_ok_list(acc, i)
    }
    let t -> tok_at(i)
    when is_kind(t, TokenType.ELLIPSIS) or is_val(t, `...`) {
        let er -> parse_expression(i + 1)
        when er[`err`] != Nothing {
            <- er
        }
        acc.append(AST.rest_pattern(er[`node`], line_of(t), col_of(t)))
        let j -> er[`i`]
        do while j < G[G_LEN] and (is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT)) {
            j -> j + 1
        }
        when is_kind(tok_at(j), TokenType.COMMA) {
            <- parse_list_elements(j + 1, acc)
        }
        <- parser_ok_list(acc, j)
    }
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    acc.append(er[`node`])
    let j -> er[`i`]
    do while j < G[G_LEN] and (is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT)) {
        j -> j + 1
    }
    when is_kind(tok_at(j), TokenType.COMMA) {
        <- parse_list_elements(j + 1, acc)
    }
    <- parser_ok_list(acc, j)
}

function parse_braced_collection_elements(i, acc) {
    do while i < G[G_LEN] and (is_kind(tok_at(i), TokenType.COMMENT) or is_kind(tok_at(i), TokenType.DOC_COMMENT)) {
        i -> i + 1
    }
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) {
        <- parser_ok_list(acc, i)
    }
    let t -> tok_at(i)
    when is_kind(t, TokenType.ELLIPSIS) or is_val(t, `...`) {
        let er -> parse_expression(i + 1)
        when er[`err`] != Nothing {
            <- er
        }
        acc.append(AST.rest_pattern(er[`node`], line_of(t), col_of(t)))
        let j -> er[`i`]
        do while j < G[G_LEN] and (is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT)) {
            j -> j + 1
        }
        when is_kind(tok_at(j), TokenType.COMMA) {
            <- parse_braced_collection_elements(j + 1, acc)
        }
        <- parser_ok_list(acc, j)
    }
    let er -> parse_expression(i)
    when er[`err`] != Nothing {
        <- er
    }
    acc.append(er[`node`])
    let j -> er[`i`]
    do while j < G[G_LEN] and (is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT)) {
        j -> j + 1
    }
    when is_kind(tok_at(j), TokenType.COMMA) {
        <- parse_braced_collection_elements(j + 1, acc)
    }
    <- parser_ok_list(acc, j)
}

function parse_struct_init_fields(i, acc) {
    <- parse_map_entries(i, acc)
}

/!
 Parse map / struct-init entries: key -> expr (, key -> expr)* or shorthand: key (, key)* or ...spread
 Keys: STRING (``name``), IDENTIFIER, or KEYWORD.
 !/
function parse_map_entries(i, acc) {
    do while i < G[G_LEN] and (is_kind(tok_at(i), TokenType.COMMENT) or is_kind(tok_at(i), TokenType.DOC_COMMENT)) {
        i -> i + 1
    }
    when is_kind(tok_at(i), TokenType.RIGHT_BRACE) {
        <- parser_ok_list(acc, i)
    }
    let name_t -> tok_at(i)
    when is_kind(name_t, TokenType.ELLIPSIS) or is_val(name_t, `...`) {
        let er -> parse_expression(i + 1)
        when er[`err`] != Nothing {
            <- er
        }
        acc.append(AST.rest_pattern(er[`node`], line_of(name_t), col_of(name_t)))
        let j -> er[`i`]
        do while j < G[G_LEN] and (is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT)) {
            j -> j + 1
        }
        when is_kind(tok_at(j), TokenType.COMMA) {
            <- parse_map_entries(j + 1, acc)
        }
        <- parser_ok_list(acc, j)
    }
    when not (is_kind(name_t, TokenType.IDENTIFIER) or is_kind(name_t, TokenType.KEYWORD) or is_kind(name_t, TokenType.STRING)) {
        <- fail(i, `Expected field/map key.`)
    }
    let j -> i + 1
    let val_node -> Nothing
    when is_kind(tok_at(j), TokenType.ASSIGNMENT) or is_val(tok_at(j), `->`) or is_kind(tok_at(j), TokenType.TYPE_SET) or is_val(tok_at(j), `:`) {
        let er -> parse_expression(j + 1)
        when er[`err`] != Nothing {
            <- er
        }
        val_node -> er[`node`]
        j -> er[`i`]
    } or {
        // shorthand field: Point { x, y } -> field "x" has value Variable("x")
        val_node -> AST.variable(val_of(name_t), line_of(name_t), col_of(name_t))
    }
    acc.append(AST.struct_init_field(val_of(name_t), val_node, line_of(name_t), col_of(name_t)))
    do while j < G[G_LEN] and (is_kind(tok_at(j), TokenType.COMMENT) or is_kind(tok_at(j), TokenType.DOC_COMMENT)) {
        j -> j + 1
    }
    when is_kind(tok_at(j), TokenType.COMMA) {
        <- parse_map_entries(j + 1, acc)
    }
    <- parser_ok_list(acc, j)
}

function parse_sub_expr_tokens(sub_toks, expr_src) {
    let old_tokens -> G[G_TOKENS]
    let old_len -> G[G_LEN]
    let old_src -> G[G_SRC]
    G[G_TOKENS] -> sub_toks
    G[G_LEN] -> sub_toks.length
    G[G_SRC] -> expr_src
    let res -> parse_expression(0)
    G[G_TOKENS] -> old_tokens
    G[G_LEN] -> old_len
    G[G_SRC] -> old_src
    <- res
}

function parse_fstring(s_val, line, col, next_i) {
    let raw -> ``
    when Str.length(s_val) >= 2 {
        raw -> Str.substring(s_val, 2, Str.length(s_val) - 1)
    }
    let parts -> []
    let buf -> ``
    let idx -> 0
    let n -> Str.length(raw)
    do while idx < n {
        let ch -> Str.at(raw, idx)
        let ch_next -> ``
        when idx + 1 < n {
            ch_next -> Str.at(raw, idx + 1)
        }
        when ch == `{` and ch_next == `{` {
            buf -> buf + `{`
            idx -> idx + 2
        } or when ch == `}` and ch_next == `}` {
            buf -> buf + `}`
            idx -> idx + 2
        } or when ch == `{` {
            when Str.length(buf) > 0 {
                parts.append(AST.lit_tok(buf, TokenType.STRING, line, col))
                buf -> ``
            }
            idx -> idx + 1
            let start_expr -> idx + 0
            let depth -> 1
            do while idx < n and depth > 0 {
                let c -> Str.at(raw, idx)
                when c == `{` {
                    depth -> depth + 1
                } or when c == `}` {
                    depth -> depth - 1
                }
                idx -> idx + 1
            }
            let expr_str -> Str.substring(raw, start_expr, idx - 1)
            expr_str -> Str.trim(expr_str)
            when Str.length(expr_str) > 0 {
                let sub_toks -> Lexer.tokenize(expr_str)
                let sub_res -> parse_sub_expr_tokens(sub_toks, expr_str)
                when sub_res[`err`] != Nothing {
                    <- fail(next_i - 1, `Invalid expression in f-string: ` + expr_str)
                }
                parts.append(sub_res[`node`])
            }
        } or {
            buf -> buf + ch
            idx -> idx + 1
        }
    }
    when Str.length(buf) > 0 or parts.length == 0 {
        parts.append(AST.lit_tok(buf, TokenType.STRING, line, col))
    }

    let res -> parts[0]
    let first_kind -> AST.ast_kind(res)
    when first_kind != AST.K_LITERAL or not is_kind(AST.lit_tok_kind(res), TokenType.STRING) {
        res -> AST.binary(AST.lit_tok(``, TokenType.STRING, line, col), `+`, res, line, col)
    }
    let pi -> 1
    do while pi < parts.length {
        res -> AST.binary(res, `+`, parts[pi], line, col)
        pi -> pi + 1
    }
    <- parser_ok(res, next_i)
}
