import `compiler/Token` as TokenModule
from `compiler/AST` import ASTNode, ASTKind, FunctionStatement, StructureStatement, EnumeratorStatement, ClassStatement, ImportStatement, FromImportStatement, WhenStatement, WhileStatement, DoWhileStatement, ForStatement, ListLiteralExpression, StructureInitializationExpression, StructureInitField, GetExpression, SetExpression, VariableExpression, LiteralExpression, BinaryExpression, CallExpression, IndexExpression, UnaryExpression, GroupingExpression, LogicalExpression, AssignmentExpression, RaiseExpression, StructureMember, Parameter, LetStatement, ReturnStatement, ExpressionStatement, AssertStatement, DeferStatement
import `lib/zen/string` as Str
import `lib/zen/io` as IO

class Transpiler {
    let statements: List
    let output: List
    let variable_types: List // List of pairs [name, type]
    let class_names: List // List of strings
    let current_class_name: String
    let module_aliases: List // List of pairs [alias, real_name]
    let unique_counter: Integer
    let defer_functions: List
    let current_base_depth_var: String
    let global_initializers: List
    let is_in_function: Boolean
    let indent_level: Integer

    function init(statements: List) : Void {
        self.statements -> statements
        self.output -> []
        self.variable_types -> [] // Initialize as empty list
        self.class_names -> []
        self.current_class_name -> ``
        self.module_aliases -> [
            [`s`, `Str`],
            [`Str`, `Str`],
            [`IO`, `IO`],
            [`Sys`, `Sys`]
        ]
        self.unique_counter -> 0
        self.defer_functions -> []
        self.current_base_depth_var -> ``
        self.global_initializers -> []
        self.is_in_function -> False
        self.indent_level -> 0
    }

    function int_to_string(n: Integer) : String {
        when (n = 0) { <- `0` }
        
        let res -> ``
        let digits -> `0123456789`
        let temp -> n
        
        while (temp > 0) {
            let d: Integer -> temp % 10
            let ch: String -> Str.at(digits, d)
            res -> ch + res
            temp -> temp / 10
        }
        
        <- res
    }

    function get_unique_id() : String {
        self.unique_counter -> self.unique_counter + 1
        <- self.int_to_string(self.unique_counter)
    }

    function emit(line: String) : Void {
        let out : List -> self.output
        out.append(line)
    }

    function collect_classes(statements: List) : Void {
        for stmt in statements {
            let s : ASTNode -> stmt
            when (s.kind = ASTKind.CLASS_STATEMENT) {
                 let cls : ClassStatement -> s
                 self.class_names.append(cls.name.value)
            }
        }
    }

    function transpile_header(guard_name: String) : String {
        self.output -> []
        self.emit(`#ifndef ` + guard_name)
        self.emit(`#define ` + guard_name)
        self.emit(``)
        self.emit(`#include "bootstrap_runtime.h"`)
        self.emit(`#include <stdbool.h>`)
        self.emit(``)
        self.emit(``)
        
        // Essential Forward Declarations
        self.emit(`typedef struct Variant Variant;`) 
        self.emit(`typedef struct ZenList ZenList;`)
        self.emit(`typedef struct ZenMap ZenMap;`)
        self.emit(`typedef struct Token Token;`)
        self.emit(`typedef struct ASTNode ASTNode;`)
        self.emit(`typedef struct ImportStatement ImportStatement;`)
        self.emit(`typedef struct FromImportStatement FromImportStatement;`)
        self.emit(`typedef struct FunctionStatement FunctionStatement;`)
        self.emit(`typedef struct ClassStatement ClassStatement;`)
        self.emit(`typedef struct StructureStatement StructureStatement;`)
        self.emit(`typedef struct BlockStatement BlockStatement;`)
        self.emit(`typedef struct ForStatement ForStatement;`)
        self.emit(`typedef struct WhileStatement WhileStatement;`)
        self.emit(`typedef struct VariableExpression VariableExpression;`)
        self.emit(`typedef struct CallExpression CallExpression;`)
        self.emit(`typedef struct ListLiteralExpression ListLiteralExpression;`)
        self.emit(`typedef struct StructureInitializationExpression StructureInitializationExpression;`)
        self.emit(``)
        
        self.emit_includes()
        
        for stmt in self.statements {
            let s : ASTNode -> stmt
            when (s.kind = ASTKind.CLASS_STATEMENT) {
                let cls : ClassStatement -> s
                self.emit(`typedef struct ` + cls.name.value + ` ` + cls.name.value + `;`)
            }
        }
        self.emit(``)
        
        // Pass 1: Types and Prototypes
        for stmt in self.statements {
            let s : ASTNode -> stmt
            when (s.kind = ASTKind.STRUCTURE_STATEMENT) {
                self.emit_structure_statement(s)
            } or when (s.kind = ASTKind.ENUMERATOR_STATEMENT) {
                self.emit_enumerator_statement(s)
            } or when (s.kind = ASTKind.CLASS_STATEMENT) {
                let cls : ClassStatement -> s
                self.class_names.append(cls.name.value)
                self.emit_class_declaration(s)
            }
        }
        
        for stmt in self.statements {
            let s : ASTNode -> stmt
            when (s.kind = ASTKind.FUNCTION_STATEMENT) {
                 self.emit_function_prototype(s)
            } or when (s.kind = ASTKind.CLASS_STATEMENT) {
                 let cls : ClassStatement -> s
                 self.current_class_name -> cls.name.value
                 for meth in cls.methods {
                     self.emit_function_prototype(meth)
                 }
                 self.current_class_name -> ``
            }
        }

        self.emit(`#endif // ` + guard_name)
        <- Str.join(self.output, `\n`)
    }

    function transpile_source(header_name: String) : String {
        self.output -> []
        self.emit_includes()
        
        when (header_name != ``) {
             self.emit(`#include "` + header_name + `"`)
        }
        self.emit(``)
        self.emit(``)
        
        self.collect_classes(self.statements)
        
        // Pass 2: Implementation
        // If no header, emit declarations first
        when (header_name == ``) {
            for stmt in self.statements {
                let s : ASTNode -> stmt
                when (s.kind = ASTKind.STRUCTURE_STATEMENT) {
                     self.emit_structure_statement(s)
                } or when (s.kind = ASTKind.ENUMERATOR_STATEMENT) {
                     self.emit_enumerator_statement(s)
                } or when (s.kind = ASTKind.CLASS_STATEMENT) {
                     self.emit_class_declaration(s)
                } or when (s.kind = ASTKind.FUNCTION_STATEMENT) {
                     self.emit_function_prototype(s)
                }
            }
        }
        self.emit(``)

        // Pass 3: Implementations
        for stmt in self.statements {
            let s : ASTNode -> stmt
            self.emit_statement(s)
        }
        
        let final_output : String -> Str.join(self.defer_functions, `\n`)
        final_output -> final_output + `\n` + Str.join(self.output, `\n`)
        <- final_output
    }

    function emit_includes() : Void {
        self.emit(`#include <stdbool.h>`)
        self.emit(`#include "bootstrap_runtime.h"`)
        self.emit(`#include <assert.h>`)
        self.emit(`#include <stdio.h>`)
        self.emit(`#include <stdlib.h>`)
        self.emit(``)
        
        // Forward declarations for required types
        self.emit(`typedef struct ZenList ZenList;`)
        self.emit(`typedef struct ZenMap ZenMap;`)
        self.emit(`typedef struct Variant Variant;`)
        self.emit(`typedef struct Token Token;`)
        self.emit(`typedef struct ASTNode ASTNode;`)
        self.emit(`typedef struct ImportStatement ImportStatement;`)
        self.emit(`typedef struct FromImportStatement FromImportStatement;`)
        self.emit(`typedef struct FunctionStatement FunctionStatement;`)
        self.emit(`typedef struct ClassStatement ClassStatement;`)
        self.emit(`typedef struct StructureStatement StructureStatement;`)
        self.emit(`typedef struct BlockStatement BlockStatement;`)
        self.emit(`typedef struct ForStatement ForStatement;`)
        self.emit(`typedef struct WhileStatement WhileStatement;`)
        self.emit(`typedef struct VariableExpression VariableExpression;`)
        self.emit(`typedef struct CallExpression CallExpression;`)
        self.emit(`typedef struct ListLiteralExpression ListLiteralExpression;`)
        self.emit(`typedef struct StructureInitializationExpression StructureInitializationExpression;`)
        self.emit(``)
        
        // Emit imports
        for stmt in self.statements {
             let s : ASTNode -> stmt
             when (s.kind = ASTKind.IMPORT_STATEMENT) {
                 self.emit_import_statement(s)
             } or when (s.kind = ASTKind.FROM_IMPORT_STATEMENT) {
                 self.emit_from_import_statement(s)
             }
        }
    }

    function emit_import_statement(stmt: ASTNode) : Void {
        let imp : ImportStatement -> stmt
        self.emit(`// import ` + imp.path.value)
        
        let path_str: String -> imp.path.value
        let parts: List -> Str.split(path_str, `/`)
        let default_name: String -> parts[parts.length - 1]
        let local_name: String -> default_name
        
        self.emit(`#include "` + default_name + `.h"`)
        
        when (imp.alias != Nothing) {
            let tok: Token -> imp.alias
            local_name -> tok.value
        }
        
        self.module_aliases.append([local_name, default_name])
    }

    function emit_from_import_statement(stmt: ASTNode) : Void {
        let imp : FromImportStatement -> stmt
        self.emit(`// from ` + imp.path.value + ` import ...`)
        
        let path_str: String -> imp.path.value
        let parts: List -> Str.split(path_str, `/`)
        let default_name: String -> parts[parts.length - 1]
        self.emit(`#include "` + default_name + `.h"`)
        
        for imp_item in imp.imports {
            let tok: Token -> imp_item
            self.module_aliases.append([tok.value, tok.value])
        }
    }

    function emit_statement(stmt: ASTNode) : Void {
        when (stmt = Nothing) {
            return
        }
        
        when (stmt.kind = ASTKind.FUNCTION_STATEMENT) {
            self.emit_function(stmt)
        } or when (stmt.kind = ASTKind.LET_STATEMENT) {
            let let_stmt : LetStatement -> stmt
            let val_code : String -> self.transpile_expression(let_stmt.initializer)
            let type_name : String -> `void*`
            
            // Check for explicit type annotation
            when (let_stmt.type_annotation != Nothing) {
                type_name -> self.map_type(let_stmt.type_annotation)
                self.variable_types.append([let_stmt.name.value, let_stmt.type_annotation])
            } or {
                // Infer type
                type_name -> `ZenValue`
                
                // Simplified heuristic for self-host bootstrap build (avoids emitting complex or-chains that break C type rules)
                when (let_stmt.initializer != Nothing) {
                    type_name -> `ZenValue`
                }
                // Save inferred type
                self.variable_types.append([let_stmt.name.value, type_name])
            }
            
            // Basic type detection for classes
            let init_node : ASTNode -> let_stmt.initializer
            when (init_node.kind = ASTKind.CALL_EXPRESSION) {
                let callee_node : CallExpression -> let_stmt.initializer
                let callee_base : ASTNode -> callee_node.callee
                
                when (callee_base.kind = ASTKind.VARIABLE_EXPRESSION) {
                    let var_expr : VariableExpression -> callee_node.callee
                    let func_name : String -> var_expr.name.value
                    
                    // Check if it is a known class constructor
                    let is_constructor -> False
                    for c_name in self.class_names {
                        when (c_name = func_name) {
                            is_constructor -> True
                        }
                    }

                    when (is_constructor) {
                         type_name -> func_name + `*`
                         self.variable_types.append([let_stmt.name.value, func_name])
                    } or {
                         // Heuristic for known classes
                         when (func_name = `Lexer` or func_name = `Parser` or func_name = `Transpiler`) {
                             type_name -> func_name + `*`
                             self.variable_types.append([let_stmt.name.value, func_name])
                         }
                    }
                }
            }
            when (type_name = `void*`) {
                type_name -> `ZenValue`
            }

            // Force ZenValue for everything in self-host bootstrap to avoid all native type + .as.boolean / concat issues
            type_name -> `ZenValue`

            let s_name : String -> self.sanitize_identifier(let_stmt.name.value)
            when (self.is_in_function) {
                when (type_name = `ZenValue`) {
                    self.emit(`    ZenValue ` + s_name + ` = ` + self.box_if_needed(val_code) + `;`)
                } or {
                    let hint : String -> `(` + type_name + `)0`
                    self.emit(`    ` + type_name + ` ` + s_name + ` = ZEN_UNBOX(` + self.box_if_needed(val_code) + `, ` + hint + `);`)
                }
            } or {
                // Global variable
                self.emit(`ZenValue ` + s_name + `;`)
                let init_code : String -> s_name + ` = ` + self.box_if_needed(val_code) + `;`
                self.global_initializers.append(init_code)
            }
        } or when (stmt.kind = ASTKind.RETURN_STATEMENT) {
            let ret_stmt : ReturnStatement -> stmt
            let val_code : String -> self.transpile_expression(ret_stmt.value)
            
            when (self.current_base_depth_var != ``) {
                 when (val_code != ``) {
                      self.emit(`    {`)
                      self.emit(`        ZEN_ASSIGN(_res, ` + val_code + `);`)
                      self.emit(`        zen_defer_run_to(` + self.current_base_depth_var + `);`)
                      self.emit(`        return _res;`)
                      self.emit(`    }`)
                 } or {
                      self.emit(`    zen_defer_run_to(` + self.current_base_depth_var + `);`)
                      self.emit(`    return ZEN_NOTHING_VAL;`)
                 }
            } or {
                 self.emit(`    return ` + self.box_if_needed(val_code) + `;`)
            }
        } or when (stmt.kind = ASTKind.EXPRESSION_STATEMENT) {
            let expr_stmt : ExpressionStatement -> stmt
            let expr_code : String -> self.transpile_expression(expr_stmt.expression)
            self.emit(`    ` + expr_code + `;`)
        } or when (stmt.kind = ASTKind.WHEN_STATEMENT) {
            self.emit_when_statement(stmt)
        } or when (stmt.kind = ASTKind.WHILE_STATEMENT) {
            self.emit_while_statement(stmt)
        } or when (stmt.kind = ASTKind.DO_WHILE_STATEMENT) {
            self.emit_do_while_statement(stmt)
        } or when (stmt.kind = ASTKind.FOR_STATEMENT) {
            self.emit_for_statement(stmt)
        } or when (stmt.kind = ASTKind.CLASS_STATEMENT) {
            self.emit_class_statement(stmt)
        } or when (stmt.kind = ASTKind.BLOCK_STATEMENT) {
            let block : BlockStatement -> stmt
            self.emit(`    {`)
            for s in block.statements {
                self.emit_statement(s)
            }
            self.emit(`    }`)
        } or when (stmt.kind = ASTKind.DEFER_STATEMENT) {
            let defer_stmt : DeferStatement -> stmt
            let defer_id : String -> self.get_unique_id()
            let defer_func_name : String -> `defer_` + defer_id
            
            let old_output : List -> self.output
            self.output -> []
            
            self.emit(`static void ` + defer_func_name + `(void* _data) {`)
            self.emit_statement(defer_stmt.statement)
            self.emit(`}`)
            
            self.defer_functions.append(Str.join(self.output, `\n`))
            
            self.output -> old_output
            self.emit(`    zen_defer_push(` + defer_func_name + `, NULL);`)
        }
    }

    function emit_when_statement(stmt: ASTNode) : Void {
        let when_stmt: WhenStatement -> stmt
        self.emit(`    if ((` + self.transpile_expression(when_stmt.condition) + `).as.boolean) {`)
        self.emit_statement(when_stmt.then_branch)
        self.emit(`    }`)
        
        // else_branch
        when (when_stmt.else_branch != Nothing) {
             self.emit(`    else {`)
             self.emit_statement(when_stmt.else_branch)
             self.emit(`    }`)
        }
    }

    function emit_while_statement(stmt: ASTNode) : Void {
        let while_stmt: WhileStatement -> stmt
        self.emit(`    while ((` + self.transpile_expression(while_stmt.condition) + `).as.boolean) {`)
        self.indent_level -> self.indent_level + 1
        self.emit_statement(while_stmt.body)
        self.indent_level -> self.indent_level - 1
        self.emit(`    }`)
    }

    function emit_do_while_statement(stmt: ASTNode) : Void {
        let while_stmt: DoWhileStatement -> stmt
        self.emit(`    do {`)
        self.indent_level -> self.indent_level + 1
        self.emit_statement(while_stmt.body)
        self.indent_level -> self.indent_level - 1
        self.emit(`    } while ((` + self.transpile_expression(while_stmt.condition) + `).as.boolean);`)
    }

    function emit_for_statement(stmt: ASTNode) : Void {
        let for_stmt: ForStatement -> stmt
        // Minimal implementation for bootstrap: assume iterable is a list
        let iter_id -> `_i_` + self.get_unique_id()
        let list_id -> `_list_` + self.get_unique_id()
        self.emit(`    ZenList* ` + list_id + ` = ZEN_UNBOX(` + self.box_if_needed(self.transpile_expression(for_stmt.iterable)) + `, (ZenList*)0);`)
        self.emit(`    for (int ` + iter_id + ` = 0; ` + iter_id + ` < ZenList_length(` + list_id + `); ` + iter_id + `++) {`)
        self.indent_level -> self.indent_level + 1
        self.emit(`        ZenValue ` + for_stmt.variable.value + ` = ZenValue_get_index(zen_val_list(` + list_id + `), ZEN_BOX(zen_int(` + iter_id + `)));`)
        self.emit_statement(for_stmt.body)
        self.indent_level -> self.indent_level - 1
        self.emit(`    }`)
    }

    function emit_class_statement(stmt: ASTNode) : Void {
        let class_stmt: ClassStatement -> stmt
        let cname: String -> class_stmt.name.value
        self.emit(`// Class implementation ` + cname)
        let old_class_name : String -> self.current_class_name
        self.current_class_name -> cname
        
        // Methods are functions; emit them (simple this-less for now, or pass self as first)
        for meth in class_stmt.methods {
            // emit as C functions named like ClassName_method for manual dispatch later
            self.emit_function(meth)
        }
        
        self.current_class_name -> old_class_name
    }

    function emit_structure_statement(stmt: ASTNode) : Void {
        let struct_stmt: StructureStatement -> stmt
        self.emit(`// Structure ` + struct_stmt.name.value)
        self.emit(`typedef struct ` + struct_stmt.name.value + ` {`)
        for m in struct_stmt.members {
            let mem: StructureMember -> m
            let mname: String -> self.sanitize_identifier(mem.name.value)
            self.emit(`    ZenValue ` + mname + `;`)
        }
        self.emit(`} ` + struct_stmt.name.value + `;`)
        self.emit(``)
    }

    function emit_enumerator_statement(stmt: ASTNode) : Void {
        let enum_stmt: EnumeratorStatement -> stmt
        let ename: String -> enum_stmt.name.value
        self.emit(`// Enumerator ` + ename)
        self.emit(`typedef enum ` + ename + ` {`)
        let first: Boolean -> True
        for m in enum_stmt.members {
            when (not first) {
                self.emit(`,`)
            }
            let member_name: String -> ``
            // Self-host parser stores members as list of String (the .value)
            when (m != Nothing) {
                // if it's already a plain string value from append(.value)
                member_name -> Str.to_string(m)
                // if somehow a token-like
                when (member_name = `` or member_name = `Nothing`) {
                    when (m.name != Nothing) {
                        let t: Token -> m.name
                        member_name -> t.value
                    }
                }
            }
            when (member_name = `` or member_name = `Nothing`) {
                member_name -> `MEMBER` + self.get_unique_id()
            }
            self.emit(`    ` + member_name)
            first -> False
        }
        self.emit(``)
        self.emit(`} ` + ename + `;`)
        self.emit(``)
    }

    function emit_class_declaration(stmt: ASTNode) : Void {
        let class_stmt: ClassStatement -> stmt
        let cname: String -> class_stmt.name.value
        self.emit(`// Class Declaration ` + cname)
        self.emit(`typedef struct ` + cname + ` {`)
        self.emit(`    ZenValue _vt; // placeholder for methods`)
        // Emit member fields from the 'members'
        for mem in class_stmt.members {
            let m: StructureMember -> mem
            let mn: String -> self.sanitize_identifier(m.name.value)
            self.emit(`    ZenValue ` + mn + `;`)
        }
        self.emit(`} ` + cname + `;`)
        self.emit(``)
    }

    function emit_get_expression(expr: Object) : String {
        let get_expr : GetExpression -> expr
        let obj_code : String -> self.transpile_expression(get_expr.object)
        when (obj_code = `TokenType` or obj_code = `ASTKind` or obj_code = `SymbolKind` or obj_code = `TypeKind`) {
            <- `zen_int(` + get_expr.name.value + `)`
        }
        <- `ZenValue_get_member(` + self.box_if_needed(obj_code) + `, zen_str("` + get_expr.name.value + `"))`
    }

    function emit_set_expression(expr: Object) : String {
        let set_expr : SetExpression -> expr
        let obj_code : String -> self.transpile_expression(set_expr.object)
        let val_code : String -> self.transpile_expression(set_expr.value)
        <- `ZenValue_set_member(` + self.box_if_needed(obj_code) + `, zen_str("` + set_expr.name.value + `"), ` + self.box_if_needed(val_code) + `)`
    }

    function is_expression_string(expr: Object) : Boolean {
        let node : ASTNode -> expr
        when (node.kind = ASTKind.LITERAL_EXPRESSION) {
            let lit : LiteralExpression -> expr
            <- lit.is_string
        }
        when (node.kind = ASTKind.VARIABLE_EXPRESSION) {
             let v_expr : VariableExpression -> expr
             let v_name -> v_expr.name.value
             for pair in self.variable_types {
                 when (pair[0] = v_name) {
                     when (pair[1] = `char*` or pair[1] = `ZenString` or pair[1] = `String`) { <- True }
                 }
             }
        }
        when (node.kind = ASTKind.BINARY_EXPRESSION) {
             let bin_expr : BinaryExpression -> expr
             when (bin_expr.operator.value = `+`) {
                 <- self.is_expression_string(bin_expr.left) or self.is_expression_string(bin_expr.right)
             }
        }
        when (node.kind = ASTKind.GROUPING_EXPRESSION) {
             let grp_expr : GroupingExpression -> expr
             <- self.is_expression_string(grp_expr.expression)
        }
        <- False
    }

    function transpile_expression(expr: Object) : String {
        let node : ASTNode -> expr
        
        when (node.kind = ASTKind.LITERAL_EXPRESSION) {
            let lit : LiteralExpression -> expr
            when (lit.is_string) {
                <- `zen_str("` + self.escape_c_string(lit.value) + `")`
            } or {
                let val : String -> Str.to_string(lit.value)
                when (val = `Nothing` or val = `None`) { <- `ZEN_NOTHING_VAL` }
                when (val = `True` or val = `true`) { <- `ZEN_TRUE` }
                when (val = `False` or val = `false`) { <- `ZEN_FALSE` }
                when (val = `break` or val = `continue`) { <- val }
                <- `zen_int(` + val + `)`
            }
        } or when (node.kind = ASTKind.VARIABLE_EXPRESSION) {
            let v_expr : VariableExpression -> expr
            <- self.sanitize_identifier(v_expr.name.value)
        } or when (node.kind = ASTKind.BINARY_EXPRESSION) {
            let bin_expr : BinaryExpression -> expr
            let left : String -> self.transpile_expression(bin_expr.left)
            let right : String -> self.transpile_expression(bin_expr.right)
            let op : String -> bin_expr.operator.value
            
            let is_string -> False
            when (self.is_expression_string(bin_expr.left)) { is_string -> True }
            when (self.is_expression_string(bin_expr.right)) { is_string -> True }

            let left_boxed : String -> self.box_if_needed(left)
            let right_boxed : String -> self.box_if_needed(right)

            when (op = `+`) {
                when (is_string) { <- `ZenString_concatenate(` + left_boxed + `, ` + right_boxed + `)` }
                <- `ZenValue_add(` + left_boxed + `, ` + right_boxed + `)` 
            }
            when (op = `-`) { <- `ZenValue_subtract(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `*`) { <- `ZenValue_multiply(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `/`) { <- `ZenValue_divide(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `%`) { <- `ZenValue_modulo(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `==` or op = `=`) { 
                <- `ZenValue_equal(` + left_boxed + `, ` + right_boxed + `)` 
            }
            when (op = `!=`) { <- `ZenValue_not_equal(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `<`) { <- `ZenValue_less_than(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `>`) { <- `ZenValue_greater_than(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `<=`) { <- `ZenValue_less_than_or_equal(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `>=`) { <- `ZenValue_greater_than_or_equal(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `**`) { <- `ZenValue_power(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `&&`) { <- `ZenValue_and(` + left_boxed + `, ` + right_boxed + `)` }
            when (op = `||`) { <- `ZenValue_or(` + left_boxed + `, ` + right_boxed + `)` }
            
            <- `(` + left + ` ` + op + ` ` + right + `)`
        } or when (node.kind = ASTKind.CALL_EXPRESSION) {
            <- self.transpile_call(expr)
        } or when (node.kind = ASTKind.GET_EXPRESSION) {
            <- self.emit_get_expression(expr)
        } or when (node.kind = ASTKind.SET_EXPRESSION) {
            <- self.emit_set_expression(expr)
        } or when (node.kind = ASTKind.INDEX_EXPRESSION) {
             let idx_expr : IndexExpression -> expr
             let obj : String -> self.transpile_expression(idx_expr.object)
             let idx_code : String -> self.transpile_expression(idx_expr.index)
             <- `ZenValue_get_index(` + self.box_if_needed(obj) + `, ` + self.box_if_needed(idx_code) + `)`
        } or when (node.kind = ASTKind.UNARY_EXPRESSION) {
             let un_expr : UnaryExpression -> expr
             let right : String -> self.transpile_expression(un_expr.right)
             let op : String -> un_expr.operator.value
             when (op = `not` or op = `!`) { <- `ZenValue_not(` + self.box_if_needed(right) + `)` }
             when (op = `-`) { <- `ZenValue_neg(` + self.box_if_needed(right) + `)` }
             <- op + right
        } or when (node.kind = ASTKind.LOGICAL_EXPRESSION) {
             let log_expr : LogicalExpression -> expr
             let left_it : String -> self.transpile_expression(log_expr.left)
             let right_it : String -> self.transpile_expression(log_expr.right)
             let op : String -> log_expr.operator.value
             when (op = `and`) { <- `ZenValue_and(` + self.box_if_needed(left_it) + `, ` + self.box_if_needed(right_it) + `)` }
             when (op = `or`) { <- `ZenValue_or(` + self.box_if_needed(left_it) + `, ` + self.box_if_needed(right_it) + `)` }
             <- `ZenValue_and(` + self.box_if_needed(left_it) + `, ` + self.box_if_needed(right_it) + `)`
        } or when (node.kind = ASTKind.ASSIGNMENT_EXPRESSION) {
             let assign_expr : AssignmentExpression -> expr
             let val_code : String -> self.transpile_expression(assign_expr.value)
             <- `ZEN_ASSIGN(` + assign_expr.name.value + `, ` + val_code + `)`
        } or when (node.kind = ASTKind.LIST_LITERAL_EXPRESSION) {
             <- self.transpile_list_literal(expr)
        } or when (node.kind = ASTKind.GROUPING_EXPRESSION) {
             let grp_expr : GroupingExpression -> expr
             <- `(` + self.transpile_expression(grp_expr.expression) + `)`
        }
        <- `/* unknown expression */`
    }

    function transpile_call(expr: Object) : String {
        let call_expr : CallExpression -> expr
        let callee_node : ASTNode -> call_expr.callee
        let callee_code -> `/* unknown callee */`
        let class_name -> `UnknownClass`
        let method_name -> ``
        let is_module_call -> False
        
        when (callee_node.kind = ASTKind.VARIABLE_EXPRESSION) {
             let callee_var : VariableExpression -> call_expr.callee
             let c_name : String -> callee_var.name.value
             let is_constructor -> False
             for cls in self.class_names {
                 when (cls = c_name) {
                     is_constructor -> True
                 }
             }

             when (is_constructor) {
                  callee_code -> c_name + `_` + c_name
             } or {
                  when (c_name = `exit`) { callee_code -> `ZenSys_exit` }
                  or when (c_name = `read`) { callee_code -> `ZenIO_read` }
                  or when (c_name = `write`) { callee_code -> `ZenIO_write` }
                  or when (c_name = `info`) { callee_code -> `ZenIO_info` }
                  or when (c_name = `warn`) { callee_code -> `ZenIO_warn` }
                  or when (c_name = `error`) { callee_code -> `ZenIO_error` }
                  or when (c_name = `debug`) { callee_code -> `ZenIO_debug` }
                  or { callee_code -> c_name }
             }
        } or when (callee_node.kind = ASTKind.GET_EXPRESSION) {
             let callee_get : GetExpression -> call_expr.callee
             let obj_expr : ASTNode -> callee_get.object
             method_name -> callee_get.name.value
             
             let obj_node : VariableExpression -> obj_expr
             when (obj_node.kind = ASTKind.VARIABLE_EXPRESSION) {
                 let v_expr : VariableExpression -> obj_expr
                 let v_name : String -> v_expr.name.value
                 when (v_name = `self`) { class_name -> self.current_class_name }
                 or {
                     for pair in self.variable_types {
                         when (pair[0] = v_name) { class_name -> self.strip_module_prefix(pair[1]) }
                     }
                     for pair in self.module_aliases {
                         when (pair[0] = v_name) { class_name -> self.strip_module_prefix(pair[1]) is_module_call -> True }
                     }
                 }
             }
             
             when (class_name = `List`) { class_name -> `ZenList` }
             when (class_name = `String` or class_name = `Str`) { class_name -> `ZenString` }
             when (class_name = `IO`) { class_name -> `IO` }
             when (class_name = `Sys`) { class_name -> `Sys` }
             
             callee_code -> class_name + `_` + method_name 
             when (class_name = `IO` and method_name = `list_dir`) { callee_code -> `ZenIO_list_dir` }
             when (class_name = `Sys` and method_name = `exec`) { callee_code -> `ZenSys_exec` }
        } or {
             callee_code -> self.transpile_expression(call_expr.callee)
        }
        
        let args_str -> ``
        let is_first_arg -> True
        
        when (callee_node.kind = ASTKind.GET_EXPRESSION) {
            let callee_get : GetExpression -> call_expr.callee
            let callee_obj : VariableExpression -> callee_get.object
            
            when (not is_module_call) {
                let obj_code : String -> self.transpile_expression(callee_obj)
                let subject -> self.box_if_needed(obj_code)
                when (class_name = `ZenList`) { subject -> `ZEN_UNBOX(` + subject + `, (ZenList*)0)` }
                args_str -> subject
                is_first_arg -> False
            }
        }

        for arg in call_expr.arguments {
            when (not is_first_arg) { args_str -> args_str + `, ` }
            let arg_code : String -> self.transpile_expression(arg)
            let final_arg : String -> ``
            when (class_name = `IO`) {
                final_arg -> `ZEN_UNBOX(` + self.box_if_needed(arg_code) + `, (char*)0)`
            } or when (class_name = `Sys`) {
                when (method_name = `exit`) {
                    final_arg -> `ZEN_UNBOX(` + self.box_if_needed(arg_code) + `, (long long)0)`
                } or {
                    final_arg -> `ZEN_UNBOX(` + self.box_if_needed(arg_code) + `, (char*)0)`
                }
            } or {
                final_arg -> self.box_if_needed(arg_code)
            }
            args_str -> args_str + final_arg
            is_first_arg -> False
        }
        
        <- callee_code + `(` + args_str + `)`
    }

    function emit_function_prototype(s: ASTNode) : Void {
         let func_stmt : FunctionStatement -> s
         let s_name : String -> self.sanitize_identifier(func_stmt.name.value)
         when (self.current_class_name != ``) {
              s_name -> self.current_class_name + `_` + s_name
         }
         
         let params -> ``
         let first -> True
         when (self.current_class_name != ``) {
              params -> `ZenValue self_val`
              first -> False
         }
         
         for p in func_stmt.parameters {
             let param : Parameter -> p
             when (not first) { params -> params + `, ` }
             params -> params + `ZenValue ` + self.sanitize_identifier(param.name.value) + `_val`
             first -> False
         }
         self.emit(`ZenValue ` + s_name + `(` + params + `);`)
    }

    function emit_function(stmt: ASTNode) : Void {
        let func_stmt : FunctionStatement -> stmt
        self.variable_types -> []
        let s_name : String -> self.sanitize_identifier(func_stmt.name.value)
        when (self.current_class_name != ``) {
             s_name -> self.current_class_name + `_` + s_name
        }
        
        let params -> ``
        let first -> True
        
        when (self.current_class_name != ``) {
             params -> `ZenValue self_val`
             first -> False
             self.variable_types.append([`self`, `ZenValue`])
        }
        
        for p in func_stmt.parameters {
            let param : Parameter -> p
            let p_name : String -> self.sanitize_identifier(param.name.value)
            when (not first) { params -> params + `, ` }
            params -> params + `ZenValue ` + p_name + `_val`
            first -> False
            self.variable_types.append([param.name.value, `ZenValue`])
        }

        self.emit(`ZenValue ` + s_name + `(` + params + `) {`)
        self.emit(`    ZenValue _res = ZEN_NOTHING_VAL;`)
        
        when (self.current_class_name != ``) {
             self.emit(`    ZenValue self = self_val;`)
        }
        
        for p in func_stmt.parameters {
            let param : Parameter -> p
            let p_name : String -> self.sanitize_identifier(param.name.value)
            self.emit(`    ZenValue ` + p_name + ` = ` + p_name + `_val;`)
        }
        
        self.current_base_depth_var -> `base_depth_` + self.get_unique_id()
        self.emit(`    int ` + self.current_base_depth_var + ` = zen_defer_depth();`)
        
        self.is_in_function -> True
        for s in func_stmt.body.statements {
            IO.write(`.`)
            self.emit_statement(s)
        }
        self.is_in_function -> False
        
        self.emit(`    zen_defer_run_to(` + self.current_base_depth_var + `);`)
        self.emit(`    return _res;`)
        self.emit(`}`)
        self.current_base_depth_var -> ``
    }

    function transpile_list_literal(expr: ListLiteralExpression) : String {
        let items -> ``
        let first -> True
        for item in expr.elements {
            when (not first) { items -> items + `, ` }
            items -> items + self.box_if_needed(self.transpile_expression(item))
            first -> False
        }
        let length_str: String -> self.int_to_string(expr.elements.length)
        let items_suffix -> ``
        when (expr.elements.length > 0) {
            items_suffix -> `, ` + items
        }
        <- `zen_val_list(ZenList_from_args(` + length_str + items_suffix + `))`
    }

    function sanitize_identifier(id: String) : String {
        when (id = `self`) { <- `self` }
        when (id = `exit` or id = `write` or id = `read`) { <- `zl_` + id }
        when (id = `main`) { <- `zen_main` }   // for host_main.c compatibility
        <- id
    }

    function escape_c_string(s: String) : String {
        let res -> ``
        let i -> 0
        while (i < Str.length(s)) {
            let ch -> Str.at(s, i)
            when (ch = `\n`) { res -> res + `\\n` }
            or when (ch = `\r`) { res -> res + `\\r` }
            or when (ch = `\t`) { res -> res + `\\t` }
            or when (ch = `\"`) { res -> res + `\\\"` }
            or when (ch = `\\`) { res -> res + `\\\\` }
            or { res -> res + ch }
            i -> i + 1
        }
        <- res
    }

    function box_if_needed(code: String) : String {
        <- `ZEN_BOX(` + code + `)`
    }

    function strip_module_prefix(name: String) : String {
        let parts: List -> Str.split(name, `.`)
        <- parts[parts.length - 1]
    }

    function map_type(type_name: String) : String {
        let clean_name: String -> self.strip_module_prefix(type_name)
        when (clean_name = `Integer`) { <- `ZenInteger` }
        when (clean_name = `Decimal`) { <- `ZenDecimal` }
        when (clean_name = `Boolean`) { <- `ZenBoolean` }
        when (clean_name = `String`) { <- `ZenString` }
        when (clean_name = `List`) { <- `ZenList*` }
        when (clean_name = `Void`) { <- `void` }
        <- clean_name + `*`
    }
    
}
