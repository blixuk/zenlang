/!
 AST node kinds, positional constructors, and field accessors for the self-hosted compiler.
 Compact positional list representation [kind, line, column, ...payload] eliminates
 dictionary allocation overhead on the lexer/parser/checker/codegen hot path.
 !/

// --- Kind constants (small integers; compare with ==) ---
export let K_BINARY -> 0
export let K_UNARY -> 1
export let K_LITERAL -> 2
export let K_GROUPING -> 3
export let K_VARIABLE -> 4
export let K_CALL -> 5
export let K_GET -> 6
export let K_SET -> 7
export let K_INDEX -> 8
export let K_ASSIGN -> 9
export let K_LOGICAL -> 10
export let K_LIST -> 11
export let K_MAP -> 12
export let K_STRUCT_INIT -> 13
export let K_STRUCT_FIELD -> 14
export let K_CHECK -> 15
export let K_RAISE -> 16
export let K_REST -> 17

export let K_EXPR_STMT -> 18
export let K_LET -> 19
export let K_BLOCK -> 20
export let K_FUNCTION -> 21
export let K_RETURN -> 22
export let K_WHEN -> 23
export let K_CHECK_STMT -> 24
export let K_WHILE -> 25
export let K_DO_WHILE -> 26
export let K_FOR -> 27
export let K_ASSERT -> 28
export let K_DEFER -> 29
export let K_PARAM -> 30
export let K_CASE -> 31

export let K_STRUCTURE -> 32
export let K_STRUCT_MEMBER -> 33
export let K_CLASS -> 34
export let K_ENUMERATOR -> 35
export let K_ENUM_MEMBER -> 36
export let K_FUNC_EXPR -> 37
export let K_IS -> 38
export let K_WITH -> 39
export let K_IMPORT -> 40
export let K_FROM_IMPORT -> 41
export let K_SCOPE -> 42
export let K_PROGRAM -> 43
export let K_INDEX_ASSIGN -> 44
export let K_TYPE_ANN -> 45
export let K_STMT_CHUNK -> 46
export let K_CAST -> 47
export let K_REASSIGN -> 9
export let K_REASSIGNMENT -> 9

// --- Universal Node Header Accessors ---
export function ast_kind(n) {
    when n == Nothing { <- Nothing }
    <- n[0]
}

export function ast_line(n) {
    when n == Nothing { <- 0 }
    <- n[1]
}

export function ast_col(n) {
    when n == Nothing { <- 0 }
    <- n[2]
}

// --- Constructors ---

export function lit(value, line, column) {
    <- lit_tok(value, ``, line, column)
}

export function lit_tok(value, token_kind, line, column) {
    <- [K_LITERAL, line, column, value, token_kind]
}

export function variable(name, line, column) {
    <- [K_VARIABLE, line, column, name]
}

export function binary(left, op, right, line, column) {
    <- [K_BINARY, line, column, left, op, right]
}

export function unary(op, right, line, column) {
    <- [K_UNARY, line, column, op, right]
}

export function logical(left, op, right, line, column) {
    <- [K_LOGICAL, line, column, left, op, right]
}

export function grouping(expr, line, column) {
    <- [K_GROUPING, line, column, expr]
}

export function call(callee, args, line, column) {
    <- [K_CALL, line, column, callee, args]
}

export function get(obj, name, line, column) {
    <- [K_GET, line, column, obj, name]
}

export function make_index(obj, index_expr, line, column) {
    <- [K_INDEX, line, column, obj, index_expr]
}

export function index_assign(obj, index_expr, value, line, column) {
    <- [K_INDEX_ASSIGN, line, column, obj, index_expr, value]
}

export function assign(name, value, line, column) {
    <- [K_ASSIGN, line, column, name, value]
}

export function set_expr(obj, name, value, line, column) {
    <- [K_SET, line, column, obj, name, value]
}

export function list_lit(elements, line, column) {
    <- [K_LIST, line, column, elements]
}

export function map_lit(entries, line, column) {
    <- [K_MAP, line, column, entries]
}

export function expr_stmt(expression, line, column) {
    <- [K_EXPR_STMT, line, column, expression]
}

export function let_stmt(name, value, type_ann, mutable, line, column) {
    <- [K_LET, line, column, name, value, type_ann, mutable]
}

export function block(statements, line, column) {
    <- [K_BLOCK, line, column, statements]
}

export function function_stmt(name, params, body, return_type, line, column) {
    <- [K_FUNCTION, line, column, name, params, body, return_type]
}

export function param(name, type_ann, line, column) {
    <- [K_PARAM, line, column, name, type_ann]
}

export function return_stmt(value, line, column) {
    <- [K_RETURN, line, column, value]
}

export function when_stmt(cases, line, column) {
    <- [K_WHEN, line, column, cases]
}

export function check_statement(expression, cases, or_block, raise_expr, line, column) {
    <- [K_CHECK_STMT, line, column, expression, cases, or_block, raise_expr]
}

export function raise_stmt(expr, line, column) {
    <- [K_RAISE, line, column, expr]
}

export function raise_expr(n) { <- n[3] }
export function set_raise_expr(n, e) { n[3] -> e }

export function ast_check_expr(expression, line, column) {
    <- [K_CHECK, line, column, expression]
}

export function case_clause(condition, body, line, column) {
    <- [K_CASE, line, column, condition, body, Nothing]
}

export function case_clause_guard(condition, body, guard, line, column) {
    <- [K_CASE, line, column, condition, body, guard]
}

export function rest_pattern(name, line, column) {
    <- [K_REST, line, column, name]
}

export function while_stmt(condition, body, line, column) {
    <- [K_WHILE, line, column, condition, body]
}

export function do_while_stmt(body, condition, line, column, test_first) {
    when test_first == Nothing {
        test_first -> true
    }
    <- [K_DO_WHILE, line, column, body, condition, test_first]
}

export function for_stmt(variable, iterable, body, line, column) {
    <- [K_FOR, line, column, variable, iterable, body]
}

export function assert_stmt(expression, line, column) {
    <- [K_ASSERT, line, column, expression]
}

export function defer_stmt(body, line, column) {
    <- [K_DEFER, line, column, body]
}

export function structure_stmt(name, members, line, column, traits) {
    when traits == Nothing {
        traits -> []
    }
    <- [K_STRUCTURE, line, column, name, members, traits]
}

export function class_stmt(name, base_name, members, methods, line, column, traits) {
    when traits == Nothing {
        traits -> []
    }
    <- [K_CLASS, line, column, name, base_name, members, methods, traits]
}

export function enumerator_stmt(name, members, line, column) {
    <- [K_ENUMERATOR, line, column, name, members]
}

export function enum_member(name, value, line, column) {
    <- [K_ENUM_MEMBER, line, column, name, value]
}

export function function_expr(params, body, line, column) {
    <- [K_FUNC_EXPR, line, column, params, body]
}

export function is_expr(value, pattern, line, column) {
    <- [K_IS, line, column, value, pattern]
}

export function with_stmt(expression, alias, body, line, column) {
    <- [K_WITH, line, column, expression, alias, body]
}

export function struct_member(name, type_ann, line, column) {
    <- [K_STRUCT_MEMBER, line, column, name, type_ann]
}

export function cast(expr, target_type, line, column) {
    <- [K_CAST, line, column, expr, target_type]
}

export function struct_init(name, fields, line, column) {
    <- [K_STRUCT_INIT, line, column, name, fields]
}

export function struct_init_field(name, value, line, column) {
    <- [K_STRUCT_FIELD, line, column, name, value]
}

export function scope_stmt(name, body, line, column) {
    <- [K_SCOPE, line, column, name, body]
}

export function import_stmt(path, alias, line, column) {
    <- [K_IMPORT, line, column, path, alias]
}

export function from_import_stmt(module_path, names, line, column) {
    <- [K_FROM_IMPORT, line, column, module_path, names]
}

export function type_ann(name, qual) {
    <- [K_TYPE_ANN, 0, 0, name, qual]
}

export function type_ann_node(name, qual, line, column) {
    <- [K_TYPE_ANN, line, column, name, qual]
}

export function program(statements) {
    <- [K_PROGRAM, 0, 0, statements, Nothing]
}

export function program_error(error) {
    <- [K_PROGRAM, 0, 0, [], error]
}

export function program_node(statements, error, line, column) {
    <- [K_PROGRAM, line, column, statements, error]
}

// --- Specific Node Field Accessors ---

export function lit_val(n) { <- n[3] }
export function lit_tok_kind(n) { <- n[4] }

export function var_name(n) { <- n[3] }

export function bin_left(n) { <- n[3] }
export function bin_op(n) { <- n[4] }
export function bin_right(n) { <- n[5] }

export function un_op(n) { <- n[3] }
export function un_right(n) { <- n[4] }

export function log_left(n) { <- n[3] }
export function log_op(n) { <- n[4] }
export function log_right(n) { <- n[5] }

export function group_expr(n) { <- n[3] }
export function grp_expr(n) { <- n[3] }

export function call_callee(n) { <- n[3] }
export function call_args(n) { <- n[4] }

export function get_obj(n) { <- n[3] }
export function set_get_obj(n, obj) {
    n[3] -> obj
    <- n
}
export function get_name(n) { <- n[4] }
export function mem_obj(n) { <- n[3] }
export function mem_prop(n) { <- n[4] }

export function set_obj(n) { <- n[3] }
export function set_name(n) { <- n[4] }
export function set_val(n) { <- n[5] }

export function idx_obj(n) { <- n[3] }
export function idx_expr(n) { <- n[4] }

export function idx_assign_obj(n) { <- n[3] }
export function idx_assign_expr(n) { <- n[4] }
export function idx_assign_val(n) { <- n[5] }

export function assign_name(n) { <- n[3] }
export function set_assign_name(n, name) {
    n[3] -> name
    <- n
}
export function assign_val(n) { <- n[4] }
export function reassign_val(n) { <- n[4] }

export function list_elems(n) { <- n[3] }
export function map_entries(n) { <- n[3] }

export function expr_stmt_expr(n) { <- n[3] }

export function let_name(n) { <- n[3] }
export function let_val(n) { <- n[4] }
export function let_type(n) { <- n[5] }
export function let_mut(n) { <- n[6] }

export function block_stmts(n) { <- n[3] }

export function is_function(n) {
    when n == Nothing { <- false }
    <- n[0] == K_FUNCTION
}

export function fn_name(n) { <- n[3] }
export function fn_params(n) {
    when n[0] == K_FUNC_EXPR {
        <- n[3]
    }
    <- n[4]
}
export function fn_body(n) {
    when n[0] == K_FUNC_EXPR {
        <- n[4]
    }
    <- n[5]
}
export function fn_ret(n) { <- n[6] }

export function func_expr_params(n) { <- n[3] }
export function func_expr_body(n) { <- n[4] }

export function param_name(n) { <- n[3] }
export function param_type(n) { <- n[4] }

export function ret_val(n) { <- n[3] }

export function when_cases(n) { <- n[3] }

export function check_stmt_expr(n) { <- n[3] }
export function check_stmt_cases(n) { <- n[4] }
export function check_stmt_or_block(n) { <- n[5] }
export function check_stmt_raise(n) { <- n[6] }

export function check_expr_expr(n) { <- n[3] }

export function case_cond(n) { <- n[3] }
export function case_body(n) { <- n[4] }
export function case_guard(n) { <- n[5] }

export function rest_name(n) { <- n[3] }

export function while_cond(n) { <- n[3] }
export function while_body(n) { <- n[4] }

export function do_while_body(n) { <- n[3] }
export function do_while_cond(n) { <- n[4] }
export function do_while_test_first(n) { <- n[5] }

export function for_var(n) { <- n[3] }
export function for_iter(n) { <- n[4] }
export function for_body(n) { <- n[5] }

export function assert_expr(n) { <- n[3] }
export function defer_body(n) { <- n[3] }

export function struct_name(n) { <- n[3] }
export function struct_members(n) { <- n[4] }
export function struct_traits(n) {
    when n.length > 5 {
        <- n[5]
    }
    <- []
}

export function struct_member_name(n) { <- n[3] }
export function struct_member_type(n) { <- n[4] }

export function struct_init_name(n) { <- n[3] }
export function struct_init_fields(n) { <- n[4] }

export function struct_field_name(n) { <- n[3] }
export function struct_field_val(n) { <- n[4] }

export function class_name(n) { <- n[3] }
export function class_base(n) { <- n[4] }
export function class_members(n) { <- n[5] }
export function class_methods(n) { <- n[6] }
export function class_traits(n) {
    when n.length > 7 {
        <- n[7]
    }
    <- []
}

export function enum_name(n) { <- n[3] }
export function enum_members(n) { <- n[4] }

export function enum_mem_name(n) { <- n[3] }
export function enum_mem_val(n) { <- n[4] }

export function fn_expr_params(n) { <- n[3] }
export function fn_expr_body(n) { <- n[4] }

export function is_expr_val(n) { <- n[3] }
export function is_expr_pat(n) { <- n[4] }

export function with_expr(n) { <- n[3] }
export function with_alias(n) { <- n[4] }
export function with_body(n) { <- n[5] }

export function cast_expr(n) { <- n[3] }
export function cast_type(n) { <- n[4] }

export function scope_name(n) { <- n[3] }
export function scope_body(n) { <- n[4] }

export function import_path(n) { <- n[3] }
export function import_alias(n) { <- n[4] }

export function from_import_mod(n) { <- n[3] }
export function from_import_names(n) { <- n[4] }

export function is_type_ann(n) {
    when n == Nothing {
        <- false
    }
    when ast_kind(n) == K_TYPE_ANN {
        <- true
    }
    <- false
}

export function type_ann_name(n) { <- n[3] }
export function type_ann_qual(n) { <- n[4] }

export function prog_stmts(n) { <- n[3] }
export function prog_err(n) { <- n[4] }

// --- Statement Chunk (Zero-Copy Arena Chaining) ---
export function stmt_chunk(statements, next_chunk) {
    <- [K_STMT_CHUNK, 0, 0, statements, next_chunk]
}

export function stmt_chunk_stmts(n) {
    when n == Nothing { <- [] }
    <- n[3]
}

export function stmt_chunk_next(n) {
    when n == Nothing { <- Nothing }
    <- n[4]
}

export function set_stmt_chunk_next(n, next) {
    when n != Nothing {
        n[4] -> next
    }
}

/!
  Flatten a statement chunk chain or flat list into a single flat array.
  Used as a bridge for legacy array-indexing consumers.
 !/
export function flatten_stmts(node_or_list) {
    when node_or_list == Nothing {
        <- []
    }
    when ast_kind(node_or_list) != K_STMT_CHUNK {
        <- node_or_list
    }
    let res -> []
    let cur -> node_or_list
    do while cur != Nothing and ast_kind(cur) == K_STMT_CHUNK {
        let chunk_stmts -> stmt_chunk_stmts(cur)
        when chunk_stmts != Nothing {
            let n -> chunk_stmts.length
            let i -> 0
            do while i < n {
                res.append(chunk_stmts[i])
                i -> i + 1
            }
        }
        cur -> stmt_chunk_next(cur)
    }
    <- res
}

// --- Node Mutation Helpers ---
export function set_ast_kind(n, k) { n[0] -> k }
export function set_lit_val(n, v) { n[3] -> v }
export function set_list_elems(n, elems) { n[3] -> elems }
export function set_var_name(n, name) { n[3] -> name }
export function set_fn_name(n, name) { n[3] -> name }
export function set_let_name(n, name) { n[3] -> name }
export function set_enum_name(n, name) { n[3] -> name }
export function set_struct_name(n, name) { n[3] -> name }
export function set_class_name(n, name) { n[3] -> name }
export function set_struct_init_name(n, name) { n[3] -> name }
