    // and native to_string overflows. Bootstrap .kind and -g ZenValue_get_kind
    // both return Integer/String/List/Map (or a stored kind field on maps).
    let k -> v.kind
    when k == `Integer` or k == `Decimal` or k == `Boolean` or k == `String` or k == `Nothing` or k == `Rune` {
        <- true
    }
    <- false
}

function guest_get(obj, name) {
    when name == `length` {
