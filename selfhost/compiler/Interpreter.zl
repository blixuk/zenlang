function call_fn(fn, args, env) {
    let closure -> fn[`closure`]
    when closure == Nothing {
        closure -> env
    }
    let frame -> env_create(closure)
    let params -> fn[`params`]
    when params != Nothing {
        let i -> 0
        let n -> params.length
        let an -> args.length
        do while i < n {
            let p -> params[i]
            let pname -> Str.to_string(AST.param_name(p))
            let pval -> Nothing
            when i < an {
                pval -> args[i]
            }
            frame -> env_define(frame, pname, pval, true)
            i -> i + 1
        }
    }
    let body -> fn[`body`]
    when body == Nothing {
        <- Nothing
    }
    let result -> Nothing
    when is_kind(body, AST.K_BLOCK) {
        let stmts -> AST.block_stmts(body)
        when stmts != Nothing {
            result -> eval_block_stmts(stmts, 0, frame, Nothing)
        }
    } or {
        result -> eval_stmt(body, frame)
    }
    // function boundary consumes return signal
    when is_returning() {
        <- take_return()
    }
    <- result
}

function eval_binary(op, l, r) {
    when op == `+` {
        <- l + r
    }
    when op == `-` {
        <- l - r
    }
    when op == `*` {
        <- l * r
    }
    when op == `/` {
        <- l / r
    }
    when op == `%` {
        <- l % r
    }
    when op == `**` {
        let base -> l
        let exp -> r
        when exp is Integer and exp >= 0 {
            let res -> 1
            let i -> 0
            do while i < exp {
                res -> res * base
                i -> i + 1
            }
            <- res
        }
        <- __builtin_math.pow(l, r)
    }
    when op == `==` or op == `=` {
        <- values_equal(l, r)
    }
    when op == `!=` {
        when values_equal(l, r) {
            <- false
        }
        <- true
    }
    when op == `<` {
        when l < r {
            <- true
        }
        <- false
    }
    when op == `>` {
        when l > r {
            <- true
        }
        <- false
    }
    when op == `<=` {
        when l <= r {
            <- true
        }
        <- false
    }
    when op == `>=` {
        when l >= r {
            <- true
        }
        <- false
    }
    when op == `and` {
        when is_truthy(l) and is_truthy(r) {
            <- true
        }
        <- false
    }
    when op == `or` {
        when is_truthy(l) or is_truthy(r) {
            <- true
        }
        <- false
    }
    when op == `..` or op == `..-` {
        <- eval_range(l, r, false, false)
    }
    when op == `..=` or op == `...` {
        <- eval_range(l, r, true, false)
    }
    when op == `..+` {
        <- eval_range(l, r, true, true)
    }
    when op == `in` {
        when r == Nothing {
            <- false
        }
        when r is List {
            let i -> 0
            let n -> r.length
            do while i < n {
                when values_equal(l, r[i]) {
                    <- true
                }
                i -> i + 1
            }
            <- false
        }
        when r is Map {
            <- r.has(l)
        }
        when r is Set {
            <- r.has(l)
        }
        when r is String {
            <- Str.contains(r, Str.to_string(l))
        }
        <- false
    }
    <- Nothing
}

let ASCII_CHARS -> ` !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_` + "`" + `abcdefghijklmnopqrstuvwxyz{|}~`

function char_to_codepoint(c) {
    when c == Nothing {
        <- 0
    }
    let s -> Str.to_string(c)
    when s.length != 1 {
        <- 0
    }
    let idx -> Str.index_of(ASCII_CHARS, s)
    when idx >= 0 {
        <- 32 + idx
    }
    when s == `\n` {
        <- 10
    }
    when s == `\t` {
        <- 9
    }
    <- 0
}

function codepoint_to_char(code) {
    when code >= 32 and code < 32 + ASCII_CHARS.length {
        <- Str.at(ASCII_CHARS, code - 32)
    }
    when code == 10 {
        <- `\n`
    }
    when code == 9 {
        <- `\t`
    }
    <- ``
}

function eval_range(start, end, inclusive, open_start) {
    let out -> []
    let as_char -> false
    let s -> 0
    let e -> 0
    when (start.kind == `String` or start.kind == `Rune`) and (end.kind == `String` or end.kind == `Rune`) {
        as_char -> true
        s -> char_to_codepoint(start)
        e -> char_to_codepoint(end)
    } or {
        s -> start
        e -> end
    }
    when s <= e {
        let stop -> when inclusive == true { e + 1 } or { e }
        let cur -> when open_start == true { s + 1 } or { s }
        do while cur < stop {
            when as_char == true {
                out.append(codepoint_to_char(cur))
            } or {
                out.append(cur)
            }
            cur -> cur + 1
        }
    } or {
        let stop -> when inclusive == true { e - 1 } or { e }
        let cur -> when open_start == true { s - 1 } or { s }
        do while cur > stop {
            when as_char == true {
                out.append(codepoint_to_char(cur))
            } or {
                out.append(cur)
            }
            cur -> cur - 1
        }
    }
    <- out
}

function values_equal(l, r) {
    when is_variant_val(l) and is_variant_val(r) {
        when l[`enum`] == r[`enum`] and l[`tag`] == r[`tag`] {
            <- true
        }
        <- false
    }
    when is_default_sentinel(l) and is_default_sentinel(r) {
        <- true
    }
    when is_default_sentinel(l) {
        when r == zero_of_value(r) {
            <- true
        }
        <- false
    }
    when is_default_sentinel(r) {
        when l == zero_of_value(l) {
            <- true
        }
        <- false
    }
    when l == Nothing and r == Nothing {
        <- true
    }
    when l == Nothing or r == Nothing {
        <- false
    }
    when l == r {
        <- true
    }
    <- false
}

function lists_equal(l, r) {
    when l.length != r.length {
        <- false
    }
    let i -> 0
    let n -> l.length
    do while i < n {
        when not values_equal(l[i], r[i]) {
            <- false
        }
        i -> i + 1
    }
    <- true
}

function maps_equal(l, r) {
    let lk -> l.keys()
    let rk -> r.keys()
    when lk.length != rk.length {
        <- false
    }
    let i -> 0
    let n -> lk.length
    do while i < n {
        let k -> lk[i]
        when not r.has(k) {
            <- false
        }
        when not values_equal(l[k], r[k]) {
            <- false
        }
        i -> i + 1
    }
    <- true
}

function is_truthy(v) {
    when v == Nothing {
        <- false
    }
    when v == false {
        <- false
    }
    when v == 0 {
        <- false
    }
    when v == `` {
        <- false
    }
    <- true
}

/!
 Lexer/parser store INTEGER/DECIMAL token values as strings; coerce for arithmetic.
 !/
function coerce_literal_node(node) {
    let value -> AST.lit_val(node)
    let tk -> AST.lit_tok_kind(node)
    when tk == TokenType.STRING or tk == TokenType.RUNE {
        <- value
    }
    when tk == TokenType.DEFAULT {
        <- default_sentinel()
    }
    when tk == TokenType.NOTHING {
        <- Nothing
    }
    let tid -> Tok.kind_id(tk)
    when tid == 24 or tid == 25 {
        <- value
    }
    when tid == 20 {
        <- default_sentinel()
    }
    when tid == 19 {
        <- Nothing
    }
    <- coerce_literal(value)
}

function default_sentinel() {
    <- DEFAULT_SENTINEL
}

function is_default_sentinel(val) {
    when val == DEFAULT_SENTINEL {
        <- true
    }
    <- false
}

function interp_materialize_default(val, type_ann) {
    when not is_default_sentinel(val) {
        <- val
    }
    <- zero_of_type(type_ann)
}

/!
 Parser stores let types as TypeAnn maps (kind, name, qualifier).
 Never stringify the whole map — that is not List or Integer.
 !/
function ann_type_name(ann) {
    when ann == Nothing or ann == `` or ann == true or ann == false {
        <- ``
    }
    when ann == `Integer` or ann == `Int` or ann == `int` or ann == `String` or ann == `Boolean` or ann == `Bool` or ann == `Void` or ann == `List` or ann == `Map` or ann == `Decimal` or ann == `Float` or ann == `Nothing` or ann == `Default` or ann == `Variant` or ann == `Rune` or ann == `Arena` or ann == `Region` {
        <- Str.to_string(ann)
    }
    when is_primitive(ann) {
        <- Str.to_string(ann)
    }
    when AST.is_type_ann(ann) {
        <- Str.to_string(AST.type_ann_name(ann))
    }
    <- Str.to_string(ann)
}

function zero_of_type(type_ann) {
    when type_ann == Nothing or type_ann == `` {
        <- default_sentinel()
    }
    let n -> ann_type_name(type_ann)
    when n == `Integer` or n == `Int` or n == `int` {
        <- 0
    }
    when n == `Decimal` or n == `Float` {
        <- 0.0
    }
    when n == `Boolean` or n == `Bool` {
        <- false
    }
    when n == `String` or n == `Str` or n == `Rune` or n == `Char` {
        <- ``
    }
    when n == `List` {
        <- []
    }
    when n == `Map` {
        <- {}
    }
    <- default_sentinel()
}

/!
 Guest length. Bootstrap maps raise on a missing length key; lists work.
 Default is a tagged map — never call length on it. Do not use has here:
 lists are not maps and has also raises under bootstrap.
 !/
function value_length(obj) {
    when obj == Nothing {
        <- 0
    }
    when is_default_sentinel(obj) {
        <- 0
    }
    when obj == true or obj == false {
        <- 0
    }
    <- obj.length
}

function zero_of_value(v) {
    when is_default_sentinel(v) {
        <- v
    }
    when v == true or v == false {
        <- false
    }
    when v == Nothing {
        <- Nothing
    }
    let k -> v.kind
    when k == `List` {
        <- []
    }
    when k == `Map` {
        <- {}
    }
    when k == `Integer` or k == `Int` {
        <- 0
    }
    when k == `Decimal` or k == `Float` {
        <- 0.0
    }
    when k == `Boolean` or k == `Bool` {
        <- false
    }
    when k == `String` or k == `Str` or k == `Rune` or k == `Char` {
        <- ``
    }
    let s -> Str.to_string(v)
    when looks_int_str(s) {
        <- 0
    }
    when looks_dec_str(s) {
        <- 0.0
    }
    <- ``
}

function looks_dec_str(s) {
    let n -> Str.length(s)
    when n == 0 {
        <- false
    }
    let dot -> Str.contains(s, `.`)
    when not dot {
        <- false
    }
    let digits -> `0123456789.`
    <- all_in_chars(s, 0, n, digits)
}

function all_in_chars(s, i, n, alphabet) {
    when i >= n {
        <- true
    }
    let ch -> Str.at(s, i)
    when ch == `-` {
        when i == 0 {
            <- all_in_chars(s, i + 1, n, alphabet)
        }
        <- false
    }
    when Str.index_of(alphabet, ch) == -1 {
        <- false
    }
    <- all_in_chars(s, i + 1, n, alphabet)
}

function coerce_literal(value) {
    when value == Nothing {
        <- Nothing
    }
    when value == true or value == false {
        <- value
    }
    let s -> Str.to_string(value)
    when s == `true` or s == `True` {
        <- true
    }
    when s == `false` or s == `False` {
        <- false
    }
    when s == `Nothing` or s == `nothing` or s == `None` {
        <- Nothing
    }
    when s == `Default` or s == `default` {
        <- default_sentinel()
    }
    // integer?
    when looks_int_str(s) {
        <- parse_int_str(s)
    }
    // leave strings / decimals as-is (decimal parse optional later)
    <- value
}

function strip_underscores(s) {
    let s_str -> Str.to_string(s)
    when Str.index_of(s_str, `_`) == -1 {
        <- s_str
    }
    let n -> Str.length(s_str)
    let res -> ``
    let i -> 0
    do while i < n {
        let ch -> Str.at(s_str, i)
        when ch != `_` {
            res -> res + ch
        }
        i -> i + 1
    }
    <- res
}

function looks_int_str(s) {
    let s_str -> Str.to_string(s)
    let n -> Str.length(s_str)
    when n == 0 {
        <- false
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `x` or Str.at(s_str, 1) == `X`) {
        let hex_digits -> `0123456789abcdefABCDEF`
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` and Str.index_of(hex_digits, ch) == -1 {
                <- false
            }
            i -> i + 1
        }
        <- true
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `b` or Str.at(s_str, 1) == `B`) {
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` and ch != `0` and ch != `1` {
                <- false
            }
            i -> i + 1
        }
        <- true
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `o` or Str.at(s_str, 1) == `O`) {
        let oct_digits -> `01234567`
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` and Str.index_of(oct_digits, ch) == -1 {
                <- false
            }
            i -> i + 1
        }
        <- true
    }
    let digits -> `0123456789`
    let i -> 0
    let ch0 -> Str.at(s_str, 0)
    when ch0 == `-` {
        when n == 1 {
            <- false
        }
        i -> 1
    }
    <- all_digits(s_str, i, n, digits)
}

function all_digits(s, i, n, digits) {
    when i >= n {
        <- true
    }
    let ch -> Str.at(s, i)
    when ch != `_` and Str.index_of(digits, ch) == -1 {
        <- false
    }
    <- all_digits(s, i + 1, n, digits)
}

function parse_int_str(s) {
    when s == Nothing { <- 0 }
    when s is Integer { <- s }
    let s_str -> Str.to_string(s)
    let n -> Str.length(s_str)
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `x` or Str.at(s_str, 1) == `X`) {
        let hex_digits -> `0123456789abcdef`
        let hex_lower -> Str.to_lower(s_str)
        let acc -> 0
        let i -> 2
        do while i < n {
            let ch -> Str.at(hex_lower, i)
            when ch != `_` {
                let d -> Str.index_of(hex_digits, ch)
                when d != -1 {
                    acc -> (acc * 16) + d
                }
            }
            i -> i + 1
        }
        <- acc
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `b` or Str.at(s_str, 1) == `B`) {
        let acc -> 0
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch == `1` {
                acc -> (acc * 2) + 1
            } or when ch == `0` {
                acc -> acc * 2
            }
            i -> i + 1
        }
        <- acc
    }
    when n > 2 and Str.at(s_str, 0) == `0` and (Str.at(s_str, 1) == `o` or Str.at(s_str, 1) == `O`) {
        let oct_digits -> `01234567`
        let acc -> 0
        let i -> 2
        do while i < n {
            let ch -> Str.at(s_str, i)
            when ch != `_` {
                let d -> Str.index_of(oct_digits, ch)
                when d != -1 {
                    acc -> (acc * 8) + d
                }
            }
            i -> i + 1
        }
        <- acc
    }
    let dot -> Str.index_of(s_str, `.`)
    when dot != -1 {
        s_str -> Str.substring(s_str, 0, dot)
        n -> Str.length(s_str)
    }
    when n == 0 {
        <- 0
    }
    let i -> 0
    let neg -> false
    when Str.at(s_str, 0) == `-` {
        neg -> true
        i -> 1
    }
    let acc -> 0
    let digits -> `0123456789`
    do while i < n {
        let ch -> Str.at(s_str, i)
        when ch != `_` {
            let d -> Str.index_of(digits, ch)
            when d != -1 {
                acc -> acc * 10 + d
            }
        }
        i -> i + 1
    }
    when neg {
        <- 0 - acc
    }
    <- acc
}
