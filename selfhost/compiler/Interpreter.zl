        when val == Nothing { <- false }
        <- true
    }
    when target_type == `Rune` or target_type == `Char` or target_type == `Glyph` {
        when val is String {
            when Str.length(val) >= 1 {
                <- Str.substring(val, 0, 1)
            }
            <- ``
        }
        when val is Integer {
            let s -> Str.to_string(val)
            <- Str.substring(s, 0, 1)
        }
        <- ``
    }
    when target_type == `Bytes` or target_type == `Buffer` {
        when val is String {
            let res -> []
            let len -> Str.length(val)
            let i -> 0
            do while i < len {
                res.append(Str.substring(val, i, i + 1))
                i -> i + 1
            }
            <- res
        }
        when val is List { <- val }
        when val is Integer { <- [val] }
        <- []
    }
    when target_type == `List` {
        when val is List { <- val }
        when val is String {
            let res -> []
            let len -> Str.length(val)
            let i -> 0
            do while i < len {
                res.append(Str.substring(val, i, i + 1))
                i -> i + 1
