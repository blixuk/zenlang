    when obj != Nothing {
        when is_primitive(obj) {
            when obj is String {
                when name == `starts_with` or name == `ends_with` or name == `contains` or
                     name == `index_of` or name == `split` or name == `trim` or
                     name == `substring` or name == `replace` {
