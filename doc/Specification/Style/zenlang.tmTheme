<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>name</key>
		<string>ZenLang Nord</string>
		<key>settings</key>
		<array>
			<dict>
				<key>settings</key>
				<dict>
					<key>background</key>
					<string>#2e3440</string>
					<key>foreground</key>
					<string>#d8dee9</string>
					<key>selection</key>
					<string>#434c5e</string>
				</dict>
			</dict>

			<!-- Line Comments -->
			<dict>
				<key>scope</key>
				<string>comment.line, comment.block</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#a3be8c</string>
					<key>fontStyle</key>
					<string>italic</string>
				</dict>
			</dict>

			<!-- Documentation Comments /! ... !/ -->
			<dict>
				<key>scope</key>
				<string>comment.doc</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#b48ead</string>
					<key>fontStyle</key>
					<string>italic</string>
				</dict>
			</dict>

			<!-- Docblock Tags @param, @return, @example -->
			<dict>
				<key>scope</key>
				<string>keyword.other.documentation.tag</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#ebcb8b</string>
					<key>fontStyle</key>
					<string>bold</string>
				</dict>
			</dict>

			<!-- Strings -->
			<dict>
				<key>scope</key>
				<string>string, string.quoted, constant.character</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#a3be8c</string>
				</dict>
			</dict>

			<!-- Character Escape Codes -->
			<dict>
				<key>scope</key>
				<string>constant.character.escape</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#ebcb8b</string>
					<key>fontStyle</key>
					<string>bold</string>
				</dict>
			</dict>

			<!-- Numbers -->
			<dict>
				<key>scope</key>
				<string>constant.numeric</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#b48ead</string>
				</dict>
			</dict>

			<!-- Booleans & Sentinels (Nothing, Default, True, False) -->
			<dict>
				<key>scope</key>
				<string>constant.language.boolean, constant.language.sentinel</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#d08770</string>
					<key>fontStyle</key>
					<string>bold</string>
				</dict>
			</dict>

			<!-- Language Variables (self, parent, module, entry) -->
			<dict>
				<key>scope</key>
				<string>variable.language</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#ebcb8b</string>
					<key>fontStyle</key>
					<string>italic</string>
				</dict>
			</dict>

			<!-- Keywords & Declarations -->
			<dict>
				<key>scope</key>
				<string>keyword.control, keyword.declaration</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#81a1c1</string>
					<key>fontStyle</key>
					<string>bold</string>
				</dict>
			</dict>

			<!-- Types & Generics -->
			<dict>
				<key>scope</key>
				<string>storage.type, support.type</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#8fbcbb</string>
				</dict>
			</dict>

			<!-- Function Names & Declarations -->
			<dict>
				<key>scope</key>
				<string>entity.name.function, variable.function</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#88c0d0</string>
				</dict>
			</dict>

			<!-- Data Flow Operators (-> and <-) -->
			<dict>
				<key>scope</key>
				<string>keyword.operator.flow</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#a3be8c</string>
					<key>fontStyle</key>
					<string>bold</string>
				</dict>
			</dict>

			<!-- Standard Operators -->
			<dict>
				<key>scope</key>
				<string>keyword.operator</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#81a1c1</string>
				</dict>
			</dict>

			<!-- Punctuation -->
			<dict>
				<key>scope</key>
				<string>punctuation.definition.generic, punctuation.definition.string, punctuation.definition.comment</string>
				<key>settings</key>
				<dict>
					<key>foreground</key>
					<string>#d8dee9</string>
				</dict>
			</dict>

		</array>
	</dict>
</plist>