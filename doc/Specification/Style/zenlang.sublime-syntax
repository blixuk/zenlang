%YAML 1.2
---
name: ZenLang
file_extensions:
  - zl
  - zs
scope: source.zenlang

variables:
  # Logical groupings for easier reading
  control_flow: 'do|while|until|for|in|when|or|and|not|xor|break|continue|return|check|case|match|default|spawn|await|task'
  logic: 'and|or|not|xor|in|with|is|reflectable'
  errors: 'raise|assert|defer|check'
  dependencies: 'use|import|from|as|extend|extends|export'
  declarations: 'let|set|function|class|struct|structure|enum|enumerator|type|scope|auto'
  constants: 'Nothing|nothing|Default|default|Void'
  booleans: 'True|False|true|false'
  builtins: 'self|parent|module|entry'
  types: 'Void|Variant|Integer|Decimal|Boolean|Rune|String|Dictionary|Dict|Tuple|List|Vector|Map|Set|Error|Task|Function|Class|Structure|Struct|Enumerator|Enum|Object'

contexts:
  main:
    # Documentation Comments /! ... !/
    - match: '/!'
      scope: punctuation.definition.comment.begin.zenlang
      push: documentation_comment

    # Single-line Comments // ...
    - match: '//.*$'
      scope: comment.line.double-slash.zenlang

    # Block Comments /* ... */
    - match: '/\*'
      scope: punctuation.definition.comment.begin.zenlang
      push: block_comment

    # Generic Types: List<String>, Map<K, V>
    - match: '\b([A-Z]\w*)(<)'
      captures:
        1: storage.type.zenlang
        2: punctuation.definition.generic.begin.zenlang
      push: generic_parameters

    # Double Quoted Strings "..."
    - match: '"'
      scope: punctuation.definition.string.begin.zenlang
      push: double_string

    # Backtick Strings `...`
    - match: '([a-zA-Z_]\w*)?(`)'
      captures:
        1: storage.type.string-prefix.zenlang
        2: punctuation.definition.string.begin.zenlang
      push: backtick_string

    # Characters 'c', '\n'
    - match: "'(\\\\.|[^'])'"
      scope: constant.character.zenlang

    # Hex, Octal, Binary Numbers
    - match: '\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+)\b'
      scope: constant.numeric.base.zenlang

    # Scientific / Float: 1.25e-5, 3.14159
    - match: '\b\d[\d_]*\.\d[\d_]*([eE][+-]?\d+)?\b|\b\d[\d_]+[eE][+-]?\d+\b'
      scope: constant.numeric.float.zenlang

    # Integer: 42, 1_000_000
    - match: '\b\d[\d_]*\b'
      scope: constant.numeric.integer.zenlang

    # Booleans
    - match: '\b({{booleans}})\b'
      scope: constant.language.boolean.zenlang

    # Constants & Sentinels (Nothing, Default, Void)
    - match: '\b({{constants}})\b'
      scope: constant.language.sentinel.zenlang

    # Language Variables (self, parent, module, entry)
    - match: '\b({{builtins}})\b'
      scope: variable.language.zenlang

    # Function declarations: function my_func(...)
    - match: '\b(function)\s+([a-zA-Z_]\w*)\s*(?=\()'
      captures:
        1: keyword.declaration.function.zenlang
        2: entity.name.function.zenlang

    # Function calls: my_func(...)
    - match: '\b([a-zA-Z_]\w*)\s*(?=\()'
      scope: meta.function-call.zenlang
      captures:
        1: variable.function.zenlang

    # Keywords & Control Flow
    - match: '\b({{control_flow}}|{{logic}}|{{errors}}|{{dependencies}}|{{declarations}})\b'
      scope: keyword.control.zenlang

    # Built-in Types
    - match: '\b({{types}})\b'
      scope: storage.type.zenlang

    # Data Flow & Range Operators
    - match: '->|<-|:>|=>|\.\.=|\.\.'
      scope: keyword.operator.flow.zenlang

    # Comparison, Arithmetic & Logic Operators
    - match: '==|!=|>=|<=|\+\+|--|\*\*|[+\-*/%^=<>:?&|~]'
      scope: keyword.operator.zenlang

  block_comment:
    - meta_scope: comment.block.zenlang
    - match: '\*/'
      scope: punctuation.definition.comment.end.zenlang
      pop: true

  documentation_comment:
    - meta_scope: comment.doc.zenlang
    - match: '(@[a-zA-Z_]\w*)'
      scope: keyword.other.documentation.tag.zenlang
    - match: '!/'
      scope: punctuation.definition.comment.end.zenlang
      pop: true

  backtick_string:
    - meta_scope: string.quoted.other.zenlang
    - match: '`'
      scope: punctuation.definition.string.end.zenlang
      pop: true
    - match: '\\.'
      scope: constant.character.escape.zenlang

  double_string:
    - meta_scope: string.quoted.double.zenlang
    - match: '"'
      scope: punctuation.definition.string.end.zenlang
      pop: true
    - match: '\\.'
      scope: constant.character.escape.zenlang

  generic_parameters:
    - match: '>'
      scope: punctuation.definition.generic.end.zenlang
      pop: true
    - include: main