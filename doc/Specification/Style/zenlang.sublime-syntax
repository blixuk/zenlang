%YAML 1.2
---
name: ZenLang
file_extensions:
  - zl
  - zs
scope: source.zenlang

variables:
  # logical groupings for easier reading
  control_flow: 'do|for|while|until|when|break|continue|return|check|assign'
  logic: 'and|or|not|in|with|is'
  errors: 'raise|assert|defer'
  dependencies: 'import|from|as|extend|export'
  declarations: 'let|set|function|class|structure|type|scope|enumerator'
  constants: 'Nothing'
  types: 'Void|Variant|Integer|Decimal|Boolean|Rune|String|Dictionary|Tuple|List|Vector|Function|Class|Structure|Enumerator'

contexts:
  main:
    # Comments
    - match: '/!'
      push: documentation_comment

    - match: '//.*$'
      scope: comment.line.zenlang

    - match: '/\*'
      push: block_comment

    # Generic Types
    - match: '\b([A-Z]\w*)(<)'
      captures:
        1: storage.type.zenlang
        2: punctuation.definition.generic.begin.zenlang
      push: generic_parameters

    # Strings (backticks)
    - match: '`'
      push: backtick_string

    # Characters
    - match: "'[^']'"
      scope: string.character.zenlang

    # Numbers

    # Hex, Oct, Bin
    - match: '\b(0x[0-9a-fA-F]+(?:_[0-9a-fA-F]+)*|0b[0-1]+(?:_[0-1]+)*|0o[0-7]+(?:_[0-7]+)*)\b' #'\b(0x[0-9a-fA-F]+|0b[0-1]+|0o[0-7]+)\b'
      scope: constant.numeric.zenlang

    # Scientific: 1e-5
    - match: '[0-9]+[eE][+-]?[0-9]+'
      scope: constant.numeric.zenlang

    # Matches: 1, 100, .1, 1.0, 10., 1_00_00
    - match: '\b\d[\d_]*(\.[\d_]*)?|\.\d[\d_]*' #'\b\d+(\.\d+)?\b'
      scope: constant.numeric.zenlang

    # Booleans
    - match: '\b(True|False)\b'
      scope: constant.language.boolean.zenlang

    # Keywords
    - match: '\b({{control_flow}}|{{logic}}|{{errors}}|{{dependencies}}|{{declarations}})\b'
      scope: keyword.control.zenlang

    # Types
    - match: '\b({{types}})\b'
      scope: storage.type.zenlang

    # Operators
    - match: '->|<-|:>|==|!=|>=|<=|\+\+|--|[+\-*/%^=<>:]'
      scope: keyword.operator.zenlang

  block_comment:
    - meta_scope: comment.block.zenlang
    - match: '\*/'
      pop: true
    - match: '.'
      scope: comment.block.zenlang

  documentation_comment:
    - meta_scope: comment.doc.zenlang
    - match: '!/'
      pop: true
    - match: '.'
      scope: comment.doc.zenlang

  backtick_string:
    - meta_scope: string.quoted.other.zenlang
    - match: '`'
      pop: true
    - match: '.'
      scope: string.quoted.other.zenlang

  generic_parameters:
    # Detect the closing '>' and exit the context
    - match: '>'
      scope: punctuation.definition.generic.end.zenlang
      pop: true
    
    # Allow normal syntax (types, numbers, etc.) inside the brackets
    - include: main