import `lib/zen/io` as IO
import `lib/zen/string` as Str

class Greeter {
    let prefix -> `Hello, `
    
    function greet(name: String) : Void {
        let message -> self.prefix + name + `!`
        IO.write(message + `\n`)
    }
}

function main {
    let g -> Greeter()
    g.greet(`Zen User`)
    
    let parts -> Str.split(`one,two,three`, `,`)
    for p in parts {
        IO.write(`Part: ` + p + `\n`)
    }
}
