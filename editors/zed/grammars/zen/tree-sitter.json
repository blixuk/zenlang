{
  "grammars": [
    {
      "name": "zen",
      "camelcase": "Zen",
      "scope": "source.zenlang",
      "path": ".",
      "file-types": [
        "zl",
        "zs"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Zenlang",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-zen"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
