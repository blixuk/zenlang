{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zen Syntax Pattern",
  "scopeName": "source.zsp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#placements" },
    { "include": "#optionals" },
    { "include": "#operators" },
    { "include": "#keywords" },
    { "include": "#sentinels" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zsp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zsp",
          "begin": "/!",
          "end": "!/"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "markup.heading.section.zsp",
          "match": "^\\s*(###?\\s+.*|\\b(SHAPE|EXAMPLES|DESUGAR|DUAL-PATH)\\b.*)$"
        }
      ]
    },
    "placements": {
      "patterns": [
        {
          "name": "variable.parameter.placement.zsp",
          "match": "<[a-zA-Z_][a-zA-Z0-9_]*>"
        }
      ]
    },
    "optionals": {
      "patterns": [
        {
          "name": "entity.other.optional.zsp",
          "match": "\\[[^\\]]+\\]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow.zsp",
          "match": "(->|<-)"
        },
        {
          "name": "keyword.operator.choice.zsp",
          "match": "(\\||\\.\\.\\.)"
        },
        {
          "name": "keyword.operator.comparison.zsp",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.zsp",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zsp",
          "match": "\\b(when|or|and|not|function|class|structure|enumerator|let|set|do|while|until|for|in|return|break|continue|import|use|from|export|check|raise|assert|defer|with|is|extends)\\b"
        }
      ]
    },
    "sentinels": {
      "patterns": [
        {
          "name": "constant.language.sentinel.zsp",
          "match": "\\b(Nothing|Default|True|False)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.backtick.zsp",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.double.zsp",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.zsp",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
