{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zenlang",
  "scopeName": "source.zenlang",
  "patterns": [
    { "include": "#doc_comments" },
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#imports" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#properties" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#punctuations" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "doc_comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.zenlang",
          "begin": "/!",
          "end": "!/",
          "patterns": [
            {
              "name": "keyword.other.documentation.zenlang",
              "match": "@(param|return|example|throws|see)\\b"
            }
          ]
        },
        {
          "name": "comment.line.documentation.zenlang",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zenlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zenlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.annotation.zenlang",
          "match": "@\\[[^\\]]+\\]"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(export)\\s+(function|class|structure|enumerator|let|set)?",
          "captures": {
            "1": { "name": "keyword.control.export.zenlang" },
            "2": { "name": "storage.type.zenlang" }
          }
        },
        {
          "match": "\\b(from|import)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.zenlang" },
            "2": { "name": "entity.name.namespace.zenlang" }
          }
        },
        {
          "match": "\\b(from|import)\\s+(`)([^`]*)(`)",
          "captures": {
            "1": { "name": "keyword.control.import.zenlang" },
            "2": { "name": "punctuation.definition.string.begin.zenlang" },
            "3": { "name": "string.quoted.other.zenlang" },
            "4": { "name": "punctuation.definition.string.end.zenlang" }
          }
        },
        {
          "match": "\\b(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.zenlang" },
            "2": { "name": "entity.name.namespace.zenlang" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.zenlang",
          "begin": "```",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.zenlang" }
          },
          "end": "```",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.zenlang" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zenlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.zenlang",
          "begin": "([a-zA-Z_][a-zA-Z0-9_]*)?(`)",
          "beginCaptures": {
            "1": { "name": "storage.type.string-prefix.zenlang" },
            "2": { "name": "punctuation.definition.string.begin.zenlang" }
          },
          "end": "`",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.zenlang" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zenlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.zenlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zenlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.rune.zenlang",
          "match": "'(\\\\.|[^'])'"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zenlang",
          "match": "\\b(when|or|and|not|xor|nor|nand|xnor|do|while|until|for|in|break|continue|return|case|with|check|raise|assert|defer|export|extends?|object|scope|task|assign|is|type|yield|before|after)\\b"
        },
        {
          "name": "storage.type.zenlang",
          "match": "\\b(let|set|function|class|structure|enumerator|import|use|from|auto|reflectable)\\b"
        },
        {
          "name": "variable.language.zenlang",
          "match": "\\b(self|parent)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.zenlang",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "constant.language.null.zenlang",
          "match": "\\b(Nothing|nothing|Default|default|Void)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.zenlang",
          "match": "\\b(Void|Nothing|Variant|Integer|Int|Decimal|Float|String|Str|Boolean|Bool|Rune|Char|Byte|Bytes|Buffer|List|Map|Dictionary|Tuple|Vector|Set|Iterable|Iterator|Auto|Function|Structure|Class|Object|Enumerator|Error|Task)\\b"
        },
        {
          "name": "entity.name.type.zenlang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.zenlang" },
            "2": { "name": "entity.name.function.zenlang" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.zenlang" }
          }
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.zenlang" },
            "2": { "name": "variable.other.property.zenlang" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.zenlang",
          "match": "->|<-|<~|:>|=>|<:"
        },
        {
          "name": "keyword.operator.range.zenlang",
          "match": "\\.\\.\\.|\\.\\.\\+|\\.\\.\\-|\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.comparison.zenlang",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.arithmetic.zenlang",
          "match": "\\+\\+|\\-\\-|\\*\\*|//|\\+|\\-|\\*|/|%|%%"
        },
        {
          "name": "keyword.operator.logical.zenlang",
          "match": "&&|\\|\\||!!|\\^\\^|!\\||!&|!\\^|<<|>>"
        },
        {
          "name": "keyword.operator.assignment.compound.zenlang",
          "match": "<<=|>>=|&=|\\|=|\\^=|%=|\\+=|\\-=|\\*="
        },
        {
          "name": "keyword.operator.zenlang",
          "match": "[=?:^!]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zenlang",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.zenlang",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.zenlang",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.zenlang",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.zenlang",
          "match": "\\b\\d[\\d_]*([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "punctuations": {
      "patterns": [
        {
          "name": "punctuation.separator.zenlang",
          "match": "[,;]"
        },
        {
          "name": "punctuation.section.block.begin.zenlang",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.zenlang",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.zenlang",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.zenlang",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.zenlang",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.zenlang",
          "match": "\\]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.zenlang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
