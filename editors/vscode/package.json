{
  "name": "zenlang",
  "displayName": "ZenLang",
  "description": "Syntax highlighting, snippets, and diagnostics for Zenlang (.zl / .zs)",
  "version": "0.1.0",
  "publisher": "zenlang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "zen",
    "zenlang",
    "syntax"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:zenlang",
    "onLanguage:zendata",
    "onLanguage:zenmark",
    "onLanguage:zsp",
    "onCommand:zenlang.checkFile",
    "onCommand:zenlang.runFile",
    "onCommand:zenlang.runFileNative"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenlang",
        "aliases": [
          "Zenlang",
          "ZenLang",
          "zen"
        ],
        "extensions": [
          ".zl",
          ".zs"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zendata",
        "aliases": [
          "Zen Data",
          "zendata"
        ],
        "extensions": [
          ".zd",
          ".zen"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zenmark",
        "aliases": [
          "Zen Mark",
          "zenmark"
        ],
        "extensions": [
          ".zm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zsp",
        "aliases": [
          "Zen Syntax Pattern",
          "zsp"
        ],
        "extensions": [
          ".zsp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zenlang",
        "scopeName": "source.zenlang",
        "path": "./syntaxes/zen.tmLanguage.json"
      },
      {
        "language": "zendata",
        "scopeName": "source.zendata",
        "path": "./syntaxes/zendata.tmLanguage.json"
      },
      {
        "language": "zenmark",
        "scopeName": "source.zenmark",
        "path": "./syntaxes/zenmark.tmLanguage.json"
      },
      {
        "language": "zsp",
        "scopeName": "source.zsp",
        "path": "./syntaxes/zsp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zenlang",
        "path": "./snippets.json"
      }
    ],
    "configuration": {
      "title": "Zenlang",
      "properties": {
        "zenlang.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable native Zenlang Language Server Protocol (LSP) daemon for real-time diagnostics, completions, hover, and symbols."
        },
        "zenlang.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to bin/zen or zen-selfhost binary. Empty = auto-detect."
        },
        "zenlang.bootstrapPath": {
          "type": "string",
          "default": "",
          "description": "Path to bootstrap/Zen.py (absolute or workspace-relative). Empty = auto-detect from workspace."
        },
        "zenlang.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show diagnostics for Zenlang files."
        },
        "zenlang.diagnostics.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Refresh diagnostics when a .zl/.zs file is saved."
        },
        "zenlang.diagnostics.onOpen": {
          "type": "boolean",
          "default": true,
          "description": "Refresh diagnostics when a .zl/.zs file is opened."
        },
        "zenlang.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to run the bootstrap compiler."
        }
      }
    },
    "commands": [
      {
        "command": "zenlang.checkFile",
        "title": "Zenlang: Typecheck Current File"
      },
      {
        "command": "zenlang.runFile",
        "title": "Zenlang: Run Current File (interpret)"
      },
      {
        "command": "zenlang.runFileNative",
        "title": "Zenlang: Run Current File (native -g)"
      },
      {
        "command": "zenlang.restartLsp",
        "title": "Zenlang: Restart Language Server (LSP)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == zenlang",
          "command": "zenlang.checkFile",
          "group": "zenlang@1"
        },
        {
          "when": "resourceLangId == zenlang",
          "command": "zenlang.runFile",
          "group": "zenlang@2"
        },
        {
          "when": "resourceLangId == zenlang",
          "command": "zenlang.restartLsp",
          "group": "zenlang@3"
        }
      ]
    }
  }
}
