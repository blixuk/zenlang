import zen.crypto.hash as hash
import zen.crypto.base64 as b64

/!
 Cryptography Example.
 Demonstrates hashing and Base64 encoding.
 !/
function main() {
    let secret -> `Zenlang is the future of Unix-native programming.`
    
    writeln(`Original Message: ` + secret)
    writeln(``)
    
    // Hashing
    writeln(`--- Hashes ---`)
    writeln(`MD5:    ` + hash.md5(secret))
    writeln(`SHA1:   ` + hash.sha1(secret))
    writeln(`SHA256: ` + hash.sha256(secret))
    writeln(``)
    
    // Base64
    let encoded -> b64.encode(secret)
    writeln(`--- Base64 ---`)
    writeln(`Encoded: ` + encoded)
    
    let decoded -> b64.decode(encoded)
    writeln(`Decoded: ` + decoded)
    
    when secret == decoded {
        writeln(`Status: Success (Decoded matches original)`)
    }
}
