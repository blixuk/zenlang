import zen.io.file as file
import zen.io.io as io
import zen.crypto.hash as hash
import zen.log as log
import zen.text.string as str

/!
 Secure Backup Utility.
 Demonstrates File IO, Cryptography, and Logging.
 !/
function main() {
    let source -> `examples/crypto_demo.zl`
    let target -> `examples/crypto_demo.zl.bak`
    
    log.info(`Starting backup of ` + source, nothing)
    
    check {
        // Read source file
        let content -> file.read(source)
        
        // Calculate SHA256 checksum
        let checksum -> hash.sha256(content)
        log.info(`Source Checksum: ` + checksum, nothing)
        
        // Write backup
        file.write(target, content)
        log.info(`Backup written to ` + target, nothing)
        
        // Verify backup
        let back_content -> file.read(target)
        let back_checksum -> hash.sha256(back_content)
        
        when checksum == back_checksum {
            log.info(`Verification Success: Checksums match.`, nothing)
            io.writeln(`SUCCESS: Backup created and verified.`)
        } or {
            log.error(`Verification Failed: Checksum mismatch!`, nothing)
            io.writeln(`FAILURE: Backup corrupted.`)
        }
        
    } or {
        // In Zenlang, we don't have a direct way to get the error in the 'or' block 
        // without 'case' patterns. For now, we just log failure.
        log.error(`Backup failed due to a system error.`, nothing)
        io.writeln(`ERROR: Backup failed.`)
    }
}
