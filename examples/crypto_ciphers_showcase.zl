/!
  examples/crypto_ciphers_showcase.zl - Demonstrates Zenlang Cryptography Platform.
  Showcases:
    - Symmetric stream ciphers (ChaCha20, RC4, XOR/OTP)
    - Key derivation: PBKDF2-HMAC-SHA256 (password -> 256-bit key)
    - Authenticated Encryption: ChaCha20-Poly1305 AEAD with tamper verification
    - Block ciphers: AES-128 (FIPS 197) and XTEA in CBC mode with PKCS#7 padding
    - Asymmetric key exchange: Diffie-Hellman discrete-log agreement
    - Classical ciphers: Caesar, ROT13, Vigenere, Atbash, Rail Fence
    - Data integrity checksums: CRC-32 & Adler-32
    - Cryptographic & non-cryptographic hashes: SHA-256, SHA-224, SHA-512, SHA-384, SHA-1, MD5, FNV-1a
    - Binary encodings: Base16 (Hex), Base32, Base58 (Base58Check), Base64 (Base64URL), Base85 (Ascii85/Z85)
    - Merkle trees: Binary hashing, layer building, inclusion audit proofs & verification
    - Blockchain distributed ledger: Proof-of-Work mining, transactions, mempool, balances, Base58Check addresses, tamper detection
  100% pure Zenlang with zero C dependencies.
!/

use zen.crypto as Crypto
use zen.crypto.hex as Hex
use zen.text.string as Str

function print_header(title) {
    writeln(`\x1b[1;36m======================================================================\x1b[0m`)
    writeln(`\x1b[1;36m  ` + title + `\x1b[0m`)
    writeln(`\x1b[1;36m======================================================================\x1b[0m`)
    writeln(``)
}

function print_section(num, title) {
    writeln(`\x1b[1;33m[` + String(num) + `] ` + title + `\x1b[0m`)
}

function main() {
    print_header(`Zenlang Complete Cryptography & Ciphers Platform Showcase`)

    let secret_payload -> `Zenlang: Visual data flow with -> and <-, Unix-native and fast.`
    writeln(`\x1b[1;37mOriginal Plaintext:\x1b[0m`)
    writeln(`  "` + secret_payload + `"`)
    writeln(`  Length: ` + String(Str.length(secret_payload)) + ` bytes`)
    writeln(``)

    // 1. Password-Based Key Derivation (PBKDF2-HMAC-SHA256)
    print_section(1, `Password-Based Key Derivation (PBKDF2-HMAC-SHA256 / RFC 2898)`)
    let human_password -> `SuperSecureUserPassphrase2026!`
    let salt -> `random-salt-16-bytes`
    let derived_key_hex -> Crypto.PBKDF2.derive_hex(human_password, salt, 16, 32)
    writeln(`  Passphrase:  \x1b[90m` + human_password + `\x1b[0m`)
    writeln(`  Salt:        \x1b[90m` + salt + `\x1b[0m (16 iterations)`)
    writeln(`  Derived Key: \x1b[1;32m` + derived_key_hex + `\x1b[0m (256 bits)`)
    writeln(``)



    // 2. Authenticated Encryption with Associated Data (ChaCha20-Poly1305 AEAD)
    print_section(2, `Authenticated Encryption with Associated Data (ChaCha20-Poly1305 AEAD / RFC 8439)`)
    let aead_key -> Crypto.Hex.decode_bytes(derived_key_hex)
    let aead_nonce -> `nonce-12byte`
    let aad -> `Header: user_id=42, role=admin`
    let aead_enc -> Crypto.AEAD.encrypt(aead_key, aead_nonce, secret_payload, aad)
    let ct_hex -> aead_enc[`ciphertext_hex`]
    let tag_hex -> aead_enc[`tag_hex`]
    writeln(`  AAD:         \x1b[90m` + aad + `\x1b[0m`)
    writeln(`  Ciphertext:  \x1b[1;35m` + ct_hex + `\x1b[0m`)
    writeln(`  Auth Tag:    \x1b[1;36m` + tag_hex + `\x1b[0m (128-bit MAC)`)
    let aead_dec -> Crypto.AEAD.decrypt_to_string(aead_key, aead_nonce, aead_enc[`ciphertext`], aead_enc[`tag`], aad)
    writeln(`  Decrypted:   \x1b[1;32m"` + aead_dec + `"\x1b[0m`)

    // Verify tamper protection
    let tampered_ct -> []
    let i -> 0
    let ct_bytes -> aead_enc[`ciphertext`]
    do while i < ct_bytes.length {
        tampered_ct.append(ct_bytes[i])
        i -> i + 1
    }
    tampered_ct[0] -> tampered_ct[0] ^^ 1
    let fail_check -> Crypto.AEAD.decrypt(aead_key, aead_nonce, tampered_ct, aead_enc[`tag`], aad)
    let tamper_rejected -> fail_check == Nothing
    writeln(`  Tamper Test: \x1b[1;32m` + String(tamper_rejected) + `\x1b[0m (Bit-flip safely rejected by Poly1305 MAC)`)
    writeln(``)

    // 3. FIPS-197 AES-128 Block Cipher (CBC Mode + PKCS#7 Padding)
    print_section(3, `AES-128 Block Cipher (FIPS 197 Rijndael / CBC Mode + PKCS#7 Padding)`)
    let aes_key -> `16-byte-aes-key!`
    let aes_iv  -> `16-byte-aes-iv!!`
    let aes_hex -> Crypto.AES.encrypt_hex(aes_key, aes_iv, secret_payload)
    writeln(`  Key:         \x1b[90m` + aes_key + `\x1b[0m`)
    writeln(`  IV:          \x1b[90m` + aes_iv + `\x1b[0m`)
    writeln(`  Ciphertext:  \x1b[1;35m` + aes_hex + `\x1b[0m`)
    let aes_dec -> Crypto.AES.decrypt_hex(aes_key, aes_iv, aes_hex)
    writeln(`  Decrypted:   \x1b[1;32m"` + aes_dec + `"\x1b[0m`)
    writeln(``)

    // 4. XTEA 64-bit Feistel Block Cipher (CBC Mode + PKCS#7 Padding)
    print_section(4, `XTEA 64-bit Block Cipher (64-Round Feistel / CBC Mode + PKCS#7 Padding)`)
    let xtea_key -> `16-byte-xtea-key`
    let xtea_iv  -> `8-byte-v`
    let xtea_hex -> Crypto.XTEA.encrypt_hex(xtea_key, xtea_iv, secret_payload)
    writeln(`  Ciphertext:  \x1b[1;35m` + xtea_hex + `\x1b[0m`)
    let xtea_dec -> Crypto.XTEA.decrypt_hex(xtea_key, xtea_iv, xtea_hex)
    writeln(`  Decrypted:   \x1b[1;32m"` + xtea_dec + `"\x1b[0m`)
    writeln(``)

    // 5. Asymmetric Diffie-Hellman Key Agreement
    print_section(5, `Diffie-Hellman Asymmetric Key Exchange (Discrete Logarithm Agreement)`)
    let alice_priv -> 4919
    let alice_pub  -> Crypto.DH.generate_public_key(Nothing, Nothing, alice_priv)
    let bob_priv   -> 7919
    let bob_pub    -> Crypto.DH.generate_public_key(Nothing, Nothing, bob_priv)

    let alice_shared -> Crypto.DH.compute_shared_secret(bob_pub, alice_priv, Nothing)
    let bob_shared   -> Crypto.DH.compute_shared_secret(alice_pub, bob_priv, Nothing)
    writeln(`  Alice Public:   \x1b[90m` + String(alice_pub) + `\x1b[0m`)
    writeln(`  Bob Public:     \x1b[90m` + String(bob_pub) + `\x1b[0m`)
    writeln(`  Alice Secret:   \x1b[1;34m` + String(alice_shared) + `\x1b[0m`)
    writeln(`  Bob Secret:     \x1b[1;34m` + String(bob_shared) + `\x1b[0m (Agreement: ` + String(alice_shared == bob_shared) + `)`)
    let agreed_key -> Crypto.DH.derive_shared_key_hex(alice_shared)
    writeln(`  Shared Sym Key: \x1b[1;32m` + agreed_key + `\x1b[0m`)
    writeln(``)

    // 6. Classical and Historical Ciphers
    print_section(6, `Classical and Historical Ciphers (Caesar, ROT13, Vigenère, Atbash, Rail Fence)`)
    let sample -> `Attack at dawn!`
    let caesar -> Crypto.Classical.caesar_encrypt(sample, 7)
    let rot    -> Crypto.Classical.rot13(sample)
    let vig    -> Crypto.Classical.vigenere_encrypt(sample, `LEMON`)
    let atb    -> Crypto.Classical.atbash(sample)
    let rf     -> Crypto.Classical.rail_fence_encrypt(sample, 3)

    writeln(`  Sample:     \x1b[90m` + sample + `\x1b[0m`)
    writeln(`  Caesar (+7): \x1b[1;36m` + caesar + `\x1b[0m -> recovered: \x1b[32m"` + Crypto.Classical.caesar_decrypt(caesar, 7) + `"\x1b[0m`)
    writeln(`  ROT13:       \x1b[1;36m` + rot + `\x1b[0m -> recovered: \x1b[32m"` + Crypto.Classical.rot13(rot) + `"\x1b[0m`)
    writeln(`  Vigenère:    \x1b[1;36m` + vig + `\x1b[0m -> recovered: \x1b[32m"` + Crypto.Classical.vigenere_decrypt(vig, `LEMON`) + `"\x1b[0m`)
    writeln(`  Atbash:      \x1b[1;36m` + atb + `\x1b[0m -> recovered: \x1b[32m"` + Crypto.Classical.atbash(atb) + `"\x1b[0m`)
    writeln(`  Rail Fence:  \x1b[1;36m` + rf + `\x1b[0m -> recovered: \x1b[32m"` + Crypto.Classical.rail_fence_decrypt(rf, 3) + `"\x1b[0m`)
    writeln(``)

    // 7. Data Integrity Checksums
    print_section(7, `Data Integrity Checksums (CRC-32 & Adler-32)`)
    let crc_val -> Crypto.CRC32.crc32(secret_payload)
    let crc_hex -> Crypto.CRC32.crc32_hex(secret_payload)
    let adler_val -> Crypto.CRC32.adler32(secret_payload)
    let adler_hex -> Crypto.CRC32.adler32_hex(secret_payload)
    writeln(`  CRC-32:   \x1b[1;34m` + crc_hex + `\x1b[0m (integer: ` + String(crc_val) + `)`)
    writeln(`  Adler-32: \x1b[1;34m` + adler_hex + `\x1b[0m (integer: ` + String(adler_val) + `)`)
    writeln(``)

    // 8. Cryptographic & Non-Cryptographic Hash Algorithms
    print_section(8, `Cryptographic & Non-Cryptographic Hash Suite (SHA-2, SHA-1, MD5, FNV-1a)`)
    let md5_hash    -> Crypto.md5(secret_payload)
    let sha1_hash   -> Crypto.sha1(secret_payload)
    let sha224_hash -> Crypto.sha224(secret_payload)
    let sha256_hash -> Crypto.sha256(secret_payload)
    let sha384_hash -> Crypto.sha384(secret_payload)
    let sha512_hash -> Crypto.sha512(secret_payload)
    let fnv32_hash  -> Crypto.fnv1a(secret_payload)
    let fnv64_hash  -> Crypto.fnv1a64(secret_payload)

    writeln(`  MD5:      \x1b[1;35m` + md5_hash + `\x1b[0m (128-bit RFC 1321)`)
    writeln(`  SHA-1:    \x1b[1;35m` + sha1_hash + `\x1b[0m (160-bit FIPS 180-1)`)
    writeln(`  SHA-224:  \x1b[1;36m` + sha224_hash + `\x1b[0m (224-bit FIPS 180-4)`)
    writeln(`  SHA-256:  \x1b[1;32m` + sha256_hash + `\x1b[0m (256-bit FIPS 180-4)`)
    writeln(`  SHA-384:  \x1b[1;36m` + sha384_hash + `\x1b[0m (384-bit FIPS 180-4)`)
    writeln(`  SHA-512:  \x1b[1;32m` + sha512_hash + `\x1b[0m (512-bit FIPS 180-4)`)
    writeln(`  FNV-1a32: \x1b[1;33m` + fnv32_hash + `\x1b[0m (32-bit non-crypto)`)
    writeln(`  FNV-1a64: \x1b[1;33m` + fnv64_hash + `\x1b[0m (64-bit non-crypto)`)
    writeln(``)

    // 9. Standard Binary Encodings Suite
    print_section(9, `Binary-to-Text Encodings Suite (Base16, Base32, Base58, Base64, Base85)`)
    let b16_enc -> Crypto.Base16.encode(secret_payload)
    let b32_enc -> Crypto.Base32.encode(secret_payload)
    let b58_enc -> Crypto.Base58.encode(secret_payload)
    let b58_chk -> Crypto.Base58.encode_check(secret_payload)
    let b64_enc -> Crypto.Base64.encode(secret_payload)
    let b85_enc -> Crypto.Base85.encode(secret_payload)

    writeln(`  Base16 (Hex): \x1b[1;36m` + Str.substring(b16_enc, 0, 48) + `...\x1b[0m (RFC 4648 §8)`)
    writeln(`  Base32:       \x1b[1;36m` + Str.substring(b32_enc, 0, 48) + `...\x1b[0m (RFC 4648 §6 / 2FA)`)
    writeln(`  Base58:       \x1b[1;32m` + b58_enc + `\x1b[0m (Bitcoin / IPFS)`)
    writeln(`  Base58Check:  \x1b[1;32m` + b58_chk + `\x1b[0m (Double-SHA256 checksum)`)
    writeln(`  Base64:       \x1b[1;35m` + b64_enc + `\x1b[0m (RFC 4648 §4)`)
    writeln(`  Ascii85:      \x1b[1;33m` + b85_enc + `\x1b[0m (Adobe / 25% overhead)`)
    writeln(``)

    // 10. Merkle Trees & Blockchain Ledger
    print_section(10, `Merkle Tree & Blockchain Distributed Ledger (Proof-of-Work, Audit Proofs)`)
    
    // 10a. Merkle Tree & Audit Proof
    let leaves -> [`doc1-alpha`, `doc2-beta`, `doc3-gamma`, `doc4-delta`]
    let mtree -> Crypto.Merkle.create_tree(leaves)
    writeln(`  Merkle Root:  \x1b[1;36m` + mtree[`root`] + `\x1b[0m (4 leaves)`)
    let proof -> Crypto.Merkle.get_proof(mtree, 2)
    let proof_valid -> Crypto.Merkle.verify_proof(`doc3-gamma`, proof, mtree[`root`])
    writeln(`  Audit Proof:  \x1b[1;32m` + String(proof_valid) + `\x1b[0m (Inclusion verified for leaf 2 "doc3-gamma")`)

    // 10b. Blockchain Ledger with PoW & Balances
    let chain -> Crypto.Blockchain.create_blockchain(1, 50, `Zenlang Genesis 2026`)
    let alice_addr -> Crypto.Blockchain.generate_wallet_address(`Alice`)
    let bob_addr   -> Crypto.Blockchain.generate_wallet_address(`Bob`)
    writeln(`  Alice Wallet: \x1b[90m` + alice_addr + `\x1b[0m`)
    writeln(`  Bob Wallet:   \x1b[90m` + bob_addr + `\x1b[0m`)

    // Mine Block 1 with Alice as miner (gets 50 reward)
    let block1 -> Crypto.Blockchain.mine_pending_transactions(chain, alice_addr)
    writeln(`  Block 1 Mined:\x1b[1;32m ` + block1[`hash`] + `\x1b[0m (Nonce: ` + String(block1[`nonce`]) + `)`)
    writeln(`  Alice Balance:\x1b[1;34m ` + String(Crypto.Blockchain.get_balance(chain, alice_addr)) + ` ZEN\x1b[0m`)

    // Alice transfers 20 to Bob (fee 1)
    let tx1 -> Crypto.Blockchain.create_transaction(alice_addr, bob_addr, 20, 1, `Payment for services`)
    Crypto.Blockchain.add_transaction(chain, tx1)

    // Mine Block 2 with Bob as miner (gets 50 reward + 1 fee)
    let block2 -> Crypto.Blockchain.mine_pending_transactions(chain, bob_addr)
    writeln(`  Block 2 Mined:\x1b[1;32m ` + block2[`hash`] + `\x1b[0m (Nonce: ` + String(block2[`nonce`]) + `)`)
    writeln(`  Alice Balance:\x1b[1;34m ` + String(Crypto.Blockchain.get_balance(chain, alice_addr)) + ` ZEN\x1b[0m (50 - 20 - 1 = 29)`)
    writeln(`  Bob Balance:  \x1b[1;34m ` + String(Crypto.Blockchain.get_balance(chain, bob_addr)) + ` ZEN\x1b[0m (20 + 50 + 1 = 71)`)

    // Verify chain integrity
    let valid_chain -> Crypto.Blockchain.is_chain_valid(chain)
    writeln(`  Chain Valid:  \x1b[1;32m` + String(valid_chain) + `\x1b[0m (All blocks, hashes, nonces & Merkle roots match)`)

    // Tamper test: modify transaction amount in block 2
    block2[`transactions`][1][`amount`] -> 9999
    let tamper_valid -> Crypto.Blockchain.is_chain_valid(chain)
    writeln(`  Tamper Test:  \x1b[1;32m` + String(tamper_valid == false) + `\x1b[0m (Tampered transaction amount correctly rejected)`)
    writeln(``)

    writeln(`\x1b[1;32m[✓] All cryptographic suites and verification stages executed successfully.\x1b[0m`)
    <- 0
}


