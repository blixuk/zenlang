/!
  10 — Count lines in a file (mini CLI)

  Run:
    ./bin/zen examples/getting_started/10_count_lines.zl examples/getting_started/README.md
    ./bin/zen -g examples/getting_started/10_count_lines.zl README.md

  Learn: file.exists / file.read, pure helper + main, usage + exit codes.
!/

import zen.io.file as file
import zen.text.string as Str

function count_lines(text) {
    when text == `` {
        <- 0
    }
    let lines -> Str.split(text, `\n`)
    <- lines.length
}

function usage() {
    writeln(`usage: 10_count_lines.zl <file>`)
}

function main(args) {
    when args.length < 2 {
        usage()
        <- 1
    }

    let path -> Str.to_string(args[args.length - 1])
    when not file.exists(path) {
        writeln(`not found: ` + path)
        <- 1
    }

    let text -> file.read(path)
    let n -> count_lines(text)
    writeln(path + `: ` + Str.to_string(n) + ` lines`)
    <- 0
}
