/!
  09 — CLI arguments

  Run:
    ./bin/zen examples/getting_started/09_cli_args.zl
    ./bin/zen examples/getting_started/09_cli_args.zl hello world

  Learn: function main(args), ambient args, built-in writeln.
!/

import zen.text.string as Str

function main(args) {
    let n -> args.length
    writeln(`argc = ` + Str.to_string(n))

    let i -> 0
    do while i < n {
        writeln(`  [` + Str.to_string(i) + `] ` + Str.to_string(args[i]))
        i -> i + 1
    }

    // Optional: require a user argument
    when n < 2 {
        writeln(`(tip: pass extra args after the script path)`)
        <- 0
    }

    writeln(`first user arg: ` + Str.to_string(args[1]))
    <- 0
}
