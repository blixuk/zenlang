/!
  08 — Closures (by-value capture)

  Run:
    ./bin/zen examples/getting_started/08_closures.zl

  Learn: function(...) { } as a value; outer locals captured by value.
!/

import zen.text.string as Str

function main() {
    let double -> function(x) { <- x * 2 }
    writeln(`double(21) = ` + Str.to_string(double(21)))

    let n -> 10
    let add_n -> function(x) { <- x + n }
    writeln(`add_n(5) = ` + Str.to_string(add_n(5)))

    // Capture is a snapshot: rebinding n does not change the closure
    n -> 99
    writeln(`after n->99, add_n(5) still = ` + Str.to_string(add_n(5)))

    <- 0
}
