/!
  02 — Variables and binding

  Run:
    ./bin/zen examples/getting_started/02_variables.zl

  Learn: let (mutable), set (constant), -> rebind, nothing.
!/

import zen.text.string as Str

function main() {
    let count -> 10
    set PI : Decimal -> 3.14
    let name -> `Zen`

    writeln(`count starts at ` + Str.to_string(count))
    count -> count + 5
    writeln(`after rebind: ` + Str.to_string(count))
    writeln(`PI (set) = ` + Str.to_string(PI))
    writeln(`name = ` + name)

    let maybe -> Nothing
    when maybe == Nothing {
        writeln(`maybe is Nothing (explicit empty)`)
    }

    <- 0
}
