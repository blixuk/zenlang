/!
  11 — Compose with the OS

  Run:
    ./bin/zen examples/getting_started/11_process.zl

  Learn: process.shell, process.ok, Str.trim — Unix composition.
!/

import zen.sys.process as process
import zen.text.string as Str

function main() {
    writeln(`=== process demo ===`)

    when process.ok(`test -d lib/zen`) {
        writeln(`ok: lib/zen is a directory`)
    } or {
        writeln(`note: run from repo root for best results`)
    }

    let uname -> Str.trim(process.shell(`uname -s`))
    writeln(`uname: ` + uname)

    let head -> process.shell(`printf 'alpha\nbeta\ngamma\n' | head -2`)
    write(`piped sample:\n` + head)

    <- 0
}
