/!
  01 — Hello, Zenlang

  Run:
    ./bin/zen examples/getting_started/01_hello.zl
    python3 bootstrap/Zen.py examples/getting_started/01_hello.zl
    ./bin/zen -g examples/getting_started/01_hello.zl

  Learn: entry point main(args), backtick strings, built-in writeln (no import needed), <- exit code.
!/

function main(args) {
    writeln(`Hello, Zenlang!`)
    writeln(`Visual flow: values move with -> and <-`)
    when args.length > 0 {
        writeln(`CLI argument: ` + args[0])
    }
    <- 0
}
