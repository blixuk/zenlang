/!
  04 — Functions

  Run:
    ./bin/zen examples/getting_started/04_functions.zl
    ./bin/zen -g examples/getting_started/04_functions.zl

  Learn: function, <- return, optional types, recursion.
!/

import zen.text.string as Str

function add(a, b) {
    <- a + b
}

function fib(n: Integer) : Integer {
    when n <= 1 {
        <- n
    }
    <- fib(n - 1) + fib(n - 2)
}

function main() {
    writeln(`2 + 3 = ` + Str.to_string(add(2, 3)))
    writeln(`fib(10) = ` + Str.to_string(fib(10)))
    <- 0
}
