/!
  zgrep — recursive content search (like `grep -rn`).

  Run:
    python3 bootstrap/Zen.py examples/zgrep.zl <pattern> [root]
    ./bin/zen examples/zgrep.zl walk lib/zen
    ./bin/zen -g examples/zgrep.zl function examples

  Prints path:line: matching line with the pattern highlighted when possible.
!/

import zen.sys.term as term
import zen.io.file as file
import zen.text.string as Str

function usage() {
    writeln(`zgrep — recursive text search`)
    writeln(`usage: zgrep <pattern> [root]`)
    writeln(`  pattern  substring to find (literal, not regex)`)
    writeln(`  root     directory or file (default .)`)
}

function is_probably_text(path) {
    // skip common binary / huge noise
    when Str.ends_with(path, `.o`) { <- false }
    when Str.ends_with(path, `.png`) { <- false }
    when Str.ends_with(path, `.jpg`) { <- false }
    when Str.ends_with(path, `.pdf`) { <- false }
    when Str.ends_with(path, `.log`) { <- false }
    <- true
}

function print_match(path, lineno, line, pattern) {
    term.color(`magenta`, `black`)
    term.write(path)
    term.reset()
    term.write(`:`)
    term.color(`yellow`, `black`)
    term.write(Str.to_string(lineno))
    term.reset()
    term.write(`:`)

    // highlight first occurrence of pattern
    let idx -> Str.index_of(line, pattern)
    when idx < 0 {
        term.write(line)
        io.writeln(``)
        <- nothing
    }
    let before -> Str.substring(line, 0, idx)
    let mid -> Str.substring(line, idx, idx + Str.length(pattern))
    let after -> Str.substring(line, idx + Str.length(pattern), Str.length(line))
    term.write(before)
    term.color(`black`, `yellow`)
    term.write(mid)
    term.reset()
    term.write(after)
    io.writeln(``)
}

function grep_file(path, pattern) {
    let n -> 0
    check {
        let lines -> file.read_lines(path)
        let i -> 0
        do while i < lines.length {
            let line -> lines[i]
            when Str.contains(line, pattern) {
                print_match(path, i + 1, line, pattern)
                n -> n + 1
            }
            i -> i + 1
        }
    } or {
        // unreadable — skip
        <- 0
    }
    <- n
}

function main(args) {
    when args.length < 2 {
        usage()
        <- 1
    }

    let pattern -> args[1]
    let root -> `.`
    when args.length > 2 {
        root -> args[2]
    }

    when pattern == `` {
        usage()
        <- 1
    }

    when not file.exists(root) {
        term.color(`red`, `black`)
        stderr.writeln(`zgrep: no such path: ` + root)
        term.reset()
        <- 1
    }

    let total -> 0
    when file.is_file(root) {
        total -> grep_file(root, pattern)
    } or {
        let files -> file.list_files(root)
        let i -> 0
        do while i < files.length {
            let p -> files[i]
            when is_probably_text(p) {
                total -> total + grep_file(p, pattern)
            }
            i -> i + 1
        }
    }

    term.color(`cyan`, `black`)
    writeln(`-- ` + Str.to_string(total) + ` match(es) for "` + pattern + `" --`)
    term.reset()
    when total > 0 { <- 0 } or { <- 1 }
}
